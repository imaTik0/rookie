{
    "imports": {
        "@openai/openai": "jsr:@openai/openai@^5.16.0",
        "@qdrant/js-client-rest": "npm:@qdrant/js-client-rest@^1.15.1",
        "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@^0.9.22",
        "@std/assert": "jsr:@std/assert@^1.0.16",
        "@std/fs": "jsr:@std/fs@^1.0.19",
        "@std/path": "jsr:@std/path@^1.1.2",
        "@xenova/transformers": "npm:@xenova/transformers@^2.17.2",
        "linkedom": "npm:linkedom@^0.18.5",
        "@mozilla/readability": "npm:@mozilla/readability@^0.5.0",
        "turndown": "npm:turndown@^7.2.0",
        "turndown-plugin-gfm": "npm:turndown-plugin-gfm@^1.0.2",
        "mongodb": "npm:mongodb@^6.19.0",
        "pino": "npm:pino@^9.9.1",
        "piscina": "npm:piscina@^5.1.3",
        "striptags": "npm:striptags@^3.2.0",
        "gpt-tokenizer": "npm:gpt-tokenizer@^2.9.0",
        "uuid": "npm:uuid@^13.0.0",
        "hono": "npm:hono@^4.10.3",
        "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.1.4",
        "zod": "npm:zod@^4.1.12",
        "reflect-metadata": "npm:reflect-metadata"
    },
    "workspace": ["./frontend"],
    "tasks": {
        "start": "deno run --allow-all --env-file src/init.ts",
        "watch": "deno run --watch --env-file --allow-all src/init.ts | pino-pretty -c -t 'SYS:HH:MM:ss.L'",
        "test": "deno test --allow-all",
        "test:cov": "deno test --allow-all --coverage=coverage && deno coverage coverage",
        "test:watch": "deno test --allow-all --watch",
        "eval": "deno run --allow-net --allow-env src/eval/runEval.ts",
        "dev": "deno run --allow-all scripts/run-both.ts dev",
        "prod": "deno run --allow-all scripts/run-both.ts start"
    },
    "compilerOptions": {
        "jsx": "precompile",
        "jsxImportSource": "hono/jsx",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "nodeModulesDir": "auto",
    "exclude": [
        "frontend",
        "dist",
        "node_modules",
        ".turbo"
    ],
    "fmt": {
        "useTabs": false,
        "lineWidth": 100,
        "indentWidth": 4,
        "singleQuote": false,
        "proseWrap": "preserve"
    }
}
