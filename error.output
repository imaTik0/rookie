o%20dynamically%20respond%20to%20changes%20in%20user%20context%20instantly.%20These%20events%20are%20automatically%20captured%20when%20relevant%20changes%20occur.%20You%20can%20subscribe%20to%20them%20by%20registering%20event%20listeners.%0A---%0A%0A%23%23%20Key%20Considerations%0A%0APlease%20note%20the%20following%3A%0A%0A-%20Events%20will%20only%20trigger%20for%20active%20connections.%0A-%20Events%20are%20not%20captured%20unless%20explicitly%20listened%20for.%0A-%20A%20single%20instance%20of%20the%20%60eventQueue%60%20is%20shared%20across%20all%20connections.%0A%0A%0A%0A%23%23%20Quick%20Start%20Guide%0A%0A%3Cdiv%20className%3D%7B'fd-steps'%7D%3E%0A%20%3Cdiv%20className%3D%7B'fd-step'%7D%3E%0A%0A%20%23%23%23%20Start%20listening%20in%20the%20loop%20with%20%60listenForEvents%60.%20%5C%0A%20The%20function%20%60EventQueue.waitEvent%60%20returns%20a%20event%20when%20one%20is%20captured.%0A%0A%20%60%60%60js%0A%20const%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%3B%0A%20function%20listenForEvents(eventsQueue)%20%7B%20%2F%2F%20%5B!code%20highlight%5D%0A%20eventsQueue.waitEvent().then(event%20%3D%3E%20%7B%0A%20console.log(%22onEvent%22%2C%20event)%3B%0A%20listenForEvents(eventsQueue)%3B%0A%20%7D)%3B%0A%20%7D%0A%20listenForEvents(eventQueue)%3B%0A%20%60%60%60%0A%20%3C%2Fdiv%3E%0A%20%3Cdiv%20className%3D%7B'fd-step'%7D%3E%0A%20%23%23%23%20Subscribe%20to%20Tool%20(e.g.%20Thread)%20events%3A%0A%0A%20%60%60%60js%0A%20await%20threadApi.subscribeForMessageEvents(threadID)%3B%0A%20%60%60%60%0A%20%3C%2Fdiv%3E%0A%20%3Cdiv%20className%3D%7B'fd-step'%7D%3E%0A%20%23%23%23%20Unsubscribe%2C%20if%20events%20no%20longer%20needed%3A%0A%0A%0A%20%60%60%60js%0A%20await%20threadApi.unsubscribeFromMessageEvents(threadID)%3B%0A%20%60%60%60%0A%20%3C%2Fdiv%3E%0A%3C%2Fdiv%3E%2C---%0Atitle%3A%20Files%0Adescription%3A%20Uploading%20and%20managing%20files.%0A---%0A%0A%0A%0A%3A%3A%3Ainfo%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Ffirst-app%23initial-assumptions)**%0A%0A%3A%3A%3A%0A%0A%23%23%20Managing%20Files%0A%0A%3CTabs%20items%3D%7B%5B%22Uploading%20a%20simple%20file%22%2C%22Reading%20a%20file%22%2C%22List%20of%20Files%22%5D%7D%3E%0A%0A%3CTab%20%3E%0ACreating%20files%20in%20Stores%20with%20additional%20metadata%3A%0A%0A%60%60%60js%0A%2F%2F%20for%20example%2C%20let's%20put%20some%20extra%20file%20info%20in%20the%20file's%20private%20meta%0Aconst%20sampleFileInfo%20%3D%20%7B%0A%20name%3A%20file.name%2C%0A%20mimetype%3A%20file.type%0A%7D%3B%0A%0Aconst%20sampleFileData%20%3D%20serializeObject(%22sample%20file%20data%22)%3B%0A%0Aconst%20fileHandle%20%3D%20await%20storeApi.createFile(storeId%2C%0A%20serializeObject(%22file's%20public%20meta-data%22)%2C%0A%20serializeObject(sampleFileInfo)%2C%0A%20sampleFileData.length%0A)%3B%0A%0Aawait%20storeApi.writeToFile(fileHandle%2C%20sampleFileData)%3B%0Aconst%20fileId%20%3D%20await%20storeApi.closeFile(fileHandle)%3B%0A%60%60%60%0AA%20detailed%20code%20sample%20of%20how%20to%20upload%20(stream)%20a%20large%20file%20can%20be%20found%20%5Bhere%5D(..%2Fstart%2Fstores%2Fuploading-files).%0A%3C%2FTab%3E%0A%0A%3CTab%20%3E%0A%0A%60%60%60js%0A%2F%2F%20read%20file%20contents%20of%20the%20file%20added%20to%20the%20Store%0Aconst%20fileInfo%20%3D%20await%20storeApi.getFile(fileId)%3B%0A%0Aconst%20fileHandle%20%3D%20await%20storeApi.openFile(fileId)%3B%0Aconst%20data%20%3D%20await%20storeApi.readFromFile(fileHandle%2C%20fileInfo.size)%3B%0Aawait%20storeApi.closeFile(fileHandle)%3B%0A%0Aconsole.log(%22File%20meta%5Cn%20public%3A%20%22%2C%20deserializeObject(fileInfo.publicMeta))%3B%0Aconsole.log(%22private%3A%20%22%2C%20deserializeObject(fileInfo.privateMeta))%3B%0Aconsole.log(%22data%3A%20%22%2C%20deserializeObject(data))%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20%3E%0AListing%20files%20in%20a%20chosen%20Store%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0Aconst%20filesList%20%3D%20await%20storeApi.listStores(%0A%20storeId%2C%0A%20defaultListQuery%0A)%3B%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60js%0A%2F%2F%20filesList%3A%0A%7B%0A%20readItems%3A%20%5B%3CfileObject1%3E%2C%20%3CfileObject2%3E%2C...%2C%20%3CfileObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_files_in_the_Store%3E%0A%7D%0A%60%60%60%0AA%20detailed%20description%20of%20the%20%60File%60%20object%20fields%20can%20be%20found%20%5Bhere%5D(%2Freference%2Fjs%2Fwebendpoint%2Fapi-reference%2Ftypes%23file).%0A%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Modifying%20Files%0A%0A%3CTabs%20items%3D%7B%5B%22Updating%20info%20about%20File%22%2C%22Deleting%20a%20File%22%5D%7D%3E%0A%3CTab%20%3E%0A%60%60%60js%0A%2F%2F%20Example%3A%20let's%20update%20given%20file's%20private%20meta%20to%20reflect%20the%20file's%20name%20change.%0Aconst%20currentFile%20%3D%20storeApi.getFile(fileId)%3B%0A%0Aconst%20currentFilePrivateMeta%20%3D%20deserializeObject(currentFile.privateMeta)%3B%0A%0Aconst%20newFilePrivateMeta%20%3D%20%7B%0A%20name%3A%20%22newFileName%22%0A%7D%3B%0Aawait%20storeApi.updateFile(%0A%20fileId%2C%0A%20currentFile.publicMeta%2C%0A%20serializeObject(newFilePrivateMeta)%2C%0A%20currentFile.fileSize%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20%3E%0A%60%60%60js%0Aawait%20storeApi.deleteFile(fileId)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C---%0Atitle%3A%20KVDB%20Entries%0Adescription%3A%20Setting%20Entries%20in%20KVDB.%0A---%0A%0A%3A%3A%3Ainfo%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%23%23%20Entries%20Inside%20KVDB%0A%0AEntries%20inside%20KVDBs%20are%20set%20in%20binary%20format.%20Before%20creating%20an%20entry%2C%20you%20need%20to%20decide%20on%20the%20entry%20format.%0A%0AFor%20more%20information%20about%20the%20KVDB's%20architecture%20and%20best%20practices%20for%20creating%20entries%2C%20visit%20the%0A%5BKVDBs%20Documentation%5D(..%2Fstart%2Fkvdbs%2Foverview).%0A%0A%23%23%20Creating%20or%20Updating%20an%20Entry%0A%0ATo%20create%20or%20update%20an%20entry%20in%20the%20given%20KVDB%2C%20you%20need%20to%20use%20the%20%60setEntry(...)%60%20method%3A%0A%0A%60%60%60js%0A%0A%2F%2F%20creating%2Fupdating%20entry%20to%20the%20KVDB%20represented%20by%20its%20kvdbId%2C%0A%2F%2F%20When%20you%20create%20entry%20ENTRY_VERSION%20must%20be%20set%20to%200.%20When%20updating%20it%20myst%20be%20set%20to%20current%20version%20of%20given%20entry%0Aawait%20kvdbApi.setEntry(%0A%20kvdbId%2C%20%0A%20%22entry_key%22%2C%0A%20this.strToUint8(%22some%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(%22some%20private%20meta-data%22)%2C%20%0A%20this.strToUint8(%22entry_data%22)%2C%0A%20ENTRY_VERSION%20%0A)%3B%0A%60%60%60%0A%23%23%20Listing%20All%20Keys%20in%20a%20KVDB%20%0ATo%20get%20a%20list%20of%20entry%20keys%20inside%20a%20KVDB%2C%20use%20%60listEntriesKeys%60%20method.%0AReading%20the%20entry%20keys%20of%20the%20KVDB%20(limited%20to%20the%20100%20newest%20entries%20as%20described%20by%20the%20%60PagingQuery%60%20object)%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%2050%2C%20limit%3A%2020%2C%20sortOrder%3A%20%22desc%22%7D%3B%0Aconst%20entriesKeys%20%3D%20await%20kvdbApi.listEntriesKeys(%0A%20kvdbId%2C%0A%20defaultListQuery%0A)%3B%0Afor%20(const%20key%20of%20entriesKeys.readItems)%20%7B%0A%20console.log(%22KVDB%20entry%20key%3A%20%22%2C%20key)%3B%0A%7D%0A%60%60%60%0A%23%23%20Listing%20All%20Entries%20in%20a%20KVDB%20%0ATo%20get%20a%20list%20of%20entry%20keys%20inside%20a%20KVDB%2C%20use%20%60listEntries%60%20method.%0AReading%20the%20entry%20keys%20of%20the%20KVDB%20(limited%20to%20the%20100%20newest%20entries%20as%20described%20by%20the%20%60PagingQuery%60%20object)%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%2050%2C%20limit%3A%2020%2C%20sortOrder%3A%20%22desc%22%7D%3B%0Aconst%20entries%20%3D%20await%20kvdbApi.listEntries(%0A%20kvdbId%2C%0A%20defaultListQuery%0A)%3B%0Afor%20(const%20entry%20of%20entries.readItems)%20%7B%0A%20console.log(%22KVDB%20entry%20key%3A%20%22%2C%20entry.info.key)%3B%0A%7D%0A%60%60%60%0A%0A%23%23%20Getting%20an%20Entry%20from%20KVDB%20%0ATo%20get%20an%20entry%20from%20a%20KVDB%2C%20use%20%60getEntry%60%20method.%0A%60%60%60js%0Aconst%20entry%20%3D%20await%20kvdbApi.getEntry(%0A%20kvdbId%2C%0A%20entryKey%0A)%3B%0A%60%60%60%0A%0A%23%23%20Deleting%20an%20Entry%20from%20KVDB%20%0ATo%20delete%20an%20entry%2C%20use%20the%20%60deleteEntry(...)%60%20method.%0A%60%60%60js%0Aawait%20kvdbApi.deleteEntry(%0A%20kvdbId%2C%0A%20entryKey%0A)%3B%0A%60%60%60%0A%2C---%0Atitle%3A%20Overview%0A---%0A%0A%0A%0A%0AThreads%20are%20a%20secure%20way%20for%20assigned%20members%20to%20exchange%20encrypted%20messages.%0A%0A%3A%3A%3Ainfo%0A%0ABefore%20working%20with%20Threads%2C%20follow%20our%20%5BGetting%20Started%20Guide%5D(.%2Fintroduction).%20It%20will%20show%20you%20how%20to%20set%20up%20your%20project%20to%20work%20with%20PrivMX%20Bridge.%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Ffirst-app%23initial-assumptions)**%0A%0A%3A%3A%3A%0A%0A%0A%23%23%20Working%20with%20Threads%0A%0AWhen%20working%20with%20Threads%2C%20you%20will%20use%20the%20following%3A%0A-%20%60ThreadApi%60%20-%20provides%20methods%20used%20to%20manage%20Threads%20in%20given%20Context%0A%0A%60%60%60js%0Aconst%20threadApi%20%3D%20await%20Endpoint.createThreadApi(connection)%3B%0A%60%60%60%0A%23%23%20Creating%20Threads%0A%3CTabs%20groupId%3D%22variant%22%20items%3D%7B%5B%22Basic%22%2C%22With%20a%20Name%22%2C%22Public%20Meta%22%5D%7D%3E%0A%3CTab%20%3E%0ACreating%20a%20basic%2C%20unnamed%20Thread%2C%20which%20can%20act%20as%20an%20encrypted%20data%20container%3A%0A%0A%60%60%60js%0Aconst%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%5D%3B%0A%0A%2F%2F%20create%20a%20new%20Thread%20with%20access%20for%20USER_1%20as%20manager%20and%20USER_2%20as%20regular%20user%0Aconst%20threadId%20%3D%20await%20threadApi.createThread(CONTEXT_ID%2C%20users%2C%20managers%2C%0A%20serializeObject(%22some%20thread's%20public%20meta-data%22)%2C%0A%20serializeObject(%22some%20thread's%20private%20meta-data%22)%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%20%3CTab%20%3E%0A%0AYou%20can%20assign%20any%20data%20to%20private%20and%20public%20meta%20fields%20(e.g.%20the%20Thread's%20name)%2C%20as%20long%20as%20they%20are%20serialized%20to%20%60Uint8Array%60.%0A%60%60%60js%0Aconst%20privateMeta%20%3D%20%7B%0A%20name%3A%20'First%20thread'%0A%7D%3B%0A%0Aconst%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%5D%3B%0A%0A%2F%2F%20create%20a%20new%20Thread%20with%20access%20for%20user_1%20as%20manager%20and%20user_2%20as%20regular%20user%0Aconst%20threadId%20%3D%20await%20threadApi.createThread(CONTEXT_ID%2C%20users%2C%20managers%2C%0A%20serializeObject(%22some%20thread's%20public%20meta-data%22)%2C%0A%20serializeObject(privateMeta)%0A)%3B%0A%60%60%60%0A%0A%0A%3C%2FTab%3E%0A%3CTab%20%3E%0A%0AYou%20can%20implement%20a%20tag%20system%20which%20allows%20you%20to%20create%20Threads%20with%20arbitrary%20tags.%0APutting%20them%20inside%20%60publicMeta%60%20gives%20your%20own%20server%20ability%20to%20access%20it%20using%20%5BPrivMX%20Bridge%20API%5D(https%3A%2F%2Fbridge.privmx.dev%2F).%0A%0A%60%60%60js%0Aconst%20privateMeta%20%3D%20%7B%0A%20name%3A%20'First%20Thread'%0A%7D%3B%0A%0Aconst%20publicMeta%20%3D%20%7B%0A%20tags%3A%20%5B'TAG1'%2C%20'TAG2'%2C%20'TAG3'%5D%0A%7D%3B%0A%0Aconst%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%5D%3B%0A%0A%2F%2F%20create%20a%20new%20Thread%20with%20access%20for%20USER_1%20as%20manager%20and%20USER_2%20as%20regular%20user%0Aconst%20threadId%20%3D%20await%20threadApi.createThread(CONTEXT_ID%2C%20users%2C%20managers%2C%0A%20serializeObject(publicMeta)%2C%0A%20serializeObject(privateMeta)%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0A%23%23%20Fetching%20Threads%0A%0A%3CTabs%20groupId%3D%22variant%22%20items%3D%7B%5B%22Recent%22%2C%22Sorting%22%2C%22ThreadID%22%2C%22Paging%22%5D%7D%3E%0A%3CTab%20value%3D%22recent%22%20label%3D%22Most%20Recent%22%3E%0AFetching%20the%20most%20recent%20Threads%20in%20given%20Context%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22desc%22%7D%3B%0Aconst%20threadList%20%3D%20await%20threadApi.listThreads(CONTEXT_ID%2C%20defaultListQuery)%3B%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60js%0A%2F%2F%20threadList%3A%0A%7B%0A%20readItems%3A%20%5B%3CthreadObject1%3E%2C%20%3CthreadObject2%3E%2C...%2C%20%3CthreadObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_threads%3E%0A%7D%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%0A%3CTab%20value%3D%7B%22sorting%22%7D%20label%3D%7B%22Oldest%20Threads%22%7D%3E%0AFetching%20the%20oldest%20Threads%20(by%20creation%20date)%20in%20given%20Context%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22asc%22%7D%3B%0Aconst%20threadList%20%3D%20await%20threadApi.listThreads(CONTEXT_ID%2C%20defaultListQuery)%3B%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60js%0A%2F%2F%20threadList%3A%0A%7B%0A%20readItems%3A%20%5B%3CthreadObject1%3E%2C%20%3CthreadObject2%3E%2C...%2C%20%3CthreadObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_threads%3E%0A%7D%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%0A%3CTab%20value%3D%7B%22threadID%22%7D%20label%3D%7B%22By%20Thread%20ID%22%7D%3E%0AYou%20can%20get%20info%20about%20a%20Thread%20using%20its%20%60threadId%60%3A%0A%0A%60%60%60js%0Aconst%20thread%20%3D%20await%20threadApi.getThread(%0A%20threadId%20%0A)%3B%0A%0Aconst%20privateMeta%20%3D%20deserializeObject(thread.privateMeta)%3B%0Aconst%20publicMeta%20%3D%20deserializeObject(thread.publicMeta)%3B%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20%60Thread%60%20object.%0A%3C%2FTab%3E%0A%0A%3CTab%20value%3D%7B%22paging%22%7D%20label%3D%7B%22Paging%22%7D%3E%0AYou%20can%20change%20how%20many%20items%20are%20on%20a%20page%20using%20%60limit%60%20in%20options%20object%3A%0A%60%60%60js%0A%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%2050%2C%20limit%3A%2020%2C%20sortOrder%3A%20%22asc%22%7D%3B%0Aconst%20threadList%20%3D%20await%20threadApi.listThreads(CONTEXT_ID%2C%20defaultListQuery)%3B%0A%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60js%0A%2F%2F%20threadList%3A%0A%7B%0A%20readItems%3A%20%5BTHREAD_1%2CTHREAD_2%2CTHREAD_3%5D%2C%0A%20totalAvailable%3A%20NUMBER_OF_THREADS%0A%7D%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0AA%20detailed%20description%20of%20the%20%60Thread%60%20object%20fields%20can%20be%20found%20%5Bhere%5D(..%2Freference%2Fwebendpoint%2Fapi-reference%2Ftypes%23thread).%0A%0A%23%23%20Modifying%20Threads%0A%0A%0A%23%23%23%20How%20Updates%20Work%0ATo%20update%20a%20Thread%20you%20must%20always%20provide%20a%20full%20list%20of%20parameters.%0A%0AThe%20%60updateThread(...)%60%20method%20needs%20all%20the%20parameters%20as%20in%20the%20%60createThread(...)%60%20method%20and%20a%20few%20more.%20If%20we%20want%20to%20update%0Aone%20of%20the%20parameters%20-%20we%20provide%20it%20in%20a%20new%20modified%20form.%20If%20-%20on%20the%20other%20hand%20-%20we%20want%20to%20leave%0Athe%20parameter%20unchanged%2C%20we%20provide%20it%20as%20it%20was%20before.%20All%20current%20values%20%E2%80%8B%E2%80%8Bof%20the%20parameters%20of%20a%20given%20Thread%20can%20be%0Aobtained%20using%20%60getThread(threadId)%60%0A%0A%3CTabs%20items%3D%7B%5B%22Renaming%20Thread%22%2C%22Removing%20User%22%2C%22Deleting%20Thread%22%5D%7D%3E%0A%3CTab%3E%0A%0A%60%60%60js%0Aconst%20thread%20%3D%20await%20threadApi.getThread(threadId)%3B%0A%0Aconst%20newUsers%20%3D%20thread.users.map(user%20%3D%3E%20(%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20userId%3A%20user%2C%0A%20pubKey%3A%20'USER_PUBLIC_KEY'%0A%20%7D)%0A)%3B%0A%0Aconst%20newManagers%20%3D%20newUsers.filter(user%20%3D%3E%0A%20thread.managers.find(manager%20%3D%3E%20manager%20%3D%3D%20user.userId))%3B%0A%0Aconst%20newPrivateMeta%20%3D%20%7B%0A%20title%3A%20'New%20thread%20name'%0A%7D%3B%0A%0Aawait%20threadApi.updateThread(%0A%20threadId%0A%20newUsers%2C%0A%20newManagers%2C%0A%20thread.publicMeta%2C%0A%20serializeObject(newPrivateMeta)%2C%0A%20thread.version%2C%0A%20false%2C%0A%20false%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%3E%0ATo%20remove%20a%20user%20from%20the%20Thread%20you%20must%20update%20a%20list%20of%20the%20users%2Fmanagers%20by%20removing%20the%20user%20you%20want%20to%20get%20rid%20of.%0AAll%20the%20other%20values%20required%20for%20update%20can%20be%20taken%20from%20the%20current%20Thread.%0A%0A%60%60%60js%0Aconst%20thread%20%3D%20await%20threadApi.getThread(threadId)%3B%0A%0A%2F%2F%20Get%20all%20users%20who%20were%20in%20the%20Thread%2C%0A%2F%2F%20besides%20the%20one%20you%20want%20to%20remove%3A%0Aconst%20newUsers%20%3D%20thread.users%0A%20.filter(user%20%3D%3E%20user%20!%3D%3D%20userToRemove)%0A%20.map(user%20%3D%3E%20(%7B%0A%20%2F%2F%20Your%20application%20must%20provide%20a%20way%2C%0A%20%2F%2F%20to%20get%20user's%20public%20key%20from%20their%20userId.%0A%20userId%3A%20user%2C%0A%20pubKey%3A%20'USER_PUBLIC_KEY'%0A%20%7D))%3B%0A%0Aconst%20newManagers%20%3D%20newUsers.filter(user%20%3D%3E%0A%20thread.managers.find(manager%20%3D%3E%20manager%20%3D%3D%20user.userId)%0A)%3B%0A%0Aawait%20threadApi.updateThread(%0A%20threadId%2C%0A%20newUsers%2C%0A%20newManagers%2C%0A%20thread.publicMeta%2C%0A%20thread.privateMeta%2C%0A%20thread.version%2C%0A%20false%2C%0A%20false%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%3E%0AThe%20snippet%20below%20deletes%20Thread%20and%20all%20its%20data.%20This%20action%20is%20irreversible.%0A%0A%60%60%60js%0Aawait%20threadApi.deleteThread(threadId)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C---%0Atitle%3A%20Handling%20Events%0A---%0A%0A%0A%0A%0AThe%20%60%40simplito%2Fprivmx-webendpoint%2Fextra%60%20package%20provides%20utilities%20for%20efficiently%20managing%20event%20subscriptions.%20These%20utilities%20simplify%20event%20handling%2C%20ensuring%20your%20application%20remains%20reactive%20and%20responsive.%0A%0A%23%23%20EventManager%20Features%0AWith%20%60EventManager%60%2C%20you%20can%3A%0A%0A-%20Start%20an%20event%20loop%20to%20listen%20for%20incoming%20events.%0A-%20Create%20scoped%20event%20managers%20for%20specific%20Tools%20(e.g.%2C%20Threads%2C%20Stores%2C%20Inboxes%2C%20connections).%0A-%20Dynamically%20subscribe%20and%20unsubscribe%20from%20events.%0A%0A%0A%23%23%20Usage%20Examples%0A%3CTabs%20groupId%3D%22tool%22%20items%3D%7B%5B%22Threads%22%2C%22Stores%22%2C%22Inboxes%22%2C%22Connection%22%5D%7D%3E%0A%3CTab%3E%0AThe%20example%20below%20demonstrates%20how%20to%20use%20the%20%60EventManager%60%20for%20Thread%20events.%0A%0A%60%60%60js%0Aimport%20%7B%20EventManager%20%7D%20from%20'%40simplito%2Fprivmx-webendpoint%2Fextra'%3B%0A%0A%2F%2F%20Get%20the%20event%20queue%20from%20the%20endpoint%0Aconst%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%3B%0A%0A%2F%2F%20Start%20the%20event%20loop%0Aconst%20eventManager%20%3D%20EventManager.startEventLoop(%7B%0A%20waitEvent%3A%20eventQueue.waitEvent%0A%7D)%3B%0A%0A%2F%2F%20Create%20a%20scoped%20event%20manager%20for%20thread%20events%0Aconst%20threadEventManager%20%3D%20eventManager.getThreadEventManager(YOUR_THREAD_API)%3B%0A%0A%2F%2F%20Subscribe%20to%20the%20'threadCreated'%20event%0Aconst%20unsubscribeFromThreadCreated%20%3D%20await%20threadEventManager.onThreadEvent(%7B%0A%20event%3A%20'threadCreated'%2C%0A%20callback%3A%20(payload)%20%3D%3E%20%7B%0A%20console.log(%22New%20thread%20created%3A%22%2C%20payload)%3B%0A%20%7D%0A%7D)%3B%0A%0A%2F%2F%20Subscribe%20to%20the%20'threadNewMessage'%20event%20for%20a%20specific%20thread%0Aconst%20unsubscribeFromMessageCreated%20%3D%20await%20threadEventManager.onMessageEvent(THREAD_ID%2C%20%7B%0A%20event%3A%20'threadNewMessage'%2C%0A%20callback%3A%20(payload)%20%3D%3E%20%7B%0A%20console.log(%22New%20message%20in%20thread%3A%22%2C%20payload)%3B%0A%20%7D%0A%7D)%3B%0A%0A%2F%2F%20Unsubscribe%20when%20needed%0Aawait%20unsubscribeFromThreadCreated()%3B%0Aawait%20unsubscribeFromMessageCreated()%3B%0A%0A%2F%2F%20Stop%20the%20event%20loop%20when%20needed%0AeventManager.stopEventLoop()%3B%0A%60%60%60%0A%0AFor%20more%20information%20regarding%20Thread-related%20events%20please%20visit%20%5BThreads%20docs%5D(..%2Fstart%2Fthreads%2Flistening-for-changes).%0A%3C%2FTab%3E%0A%3CTab%3E%0AThe%20example%20below%20demonstrates%20how%20to%20use%20the%20%60EventManager%60%20for%20Store%20events.%0A%0A%60%60%60js%0Aimport%20%7B%20EventManager%20%7D%20from%20'%40simplito%2Fprivmx-webendpoint%2Fextra'%3B%0A%0A%2F%2F%20Get%20the%20event%20queue%20from%20the%20endpoint%0Aconst%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%3B%0A%0A%2F%2F%20Start%20the%20event%20loop%0Aconst%20eventManager%20%3D%20EventManager.startEventLoop(%7B%0A%20waitEvent%3A%20eventQueue.waitEvent%0A%7D)%3B%0A%0A%2F%2F%20Create%20a%20scoped%20event%20manager%20for%20store%20events%0Aconst%20storeEventManager%20%3D%20eventManager.getStoreEventManager(YOUR_STORE_API)%3B%0A%0A%2F%2F%20Subscribe%20to%20the%20'storeCreated'%20event%0Aconst%20unsubscribeFromStoreCreated%20%3D%20await%20storeEventManager.onStoreEvent(%7B%0A%20event%3A%20'storeCreated'%2C%0A%20callback%3A%20(payload)%20%3D%3E%20%7B%0A%20console.log('New%20store%20created%3A'%2C%20payload)%3B%0A%20%7D%2C%0A%7D)%3B%0A%0A%2F%2F%20Subscribe%20to%20the%20'storeFileCreated'%20event%20for%20a%20specific%20thread%0Aconst%20unsubscribeFromFileCreated%20%3D%20await%20storeEventManager.onFileEvent(STORE_ID%2C%20%7B%0A%20event%3A%20'storeFileCreated'%2C%0A%20callback%3A%20(payload)%20%3D%3E%20%7B%0A%20console.log('New%20file%20in%20store%3A'%2C%20payload)%3B%0A%20%7D%0A%7D)%3B%0A%0A%2F%2F%20Unsubscribe%20when%20needed%0Aawait%20unsubscribeFromStoreCreated()%3B%0Aawait%20unsubscribeFromFileCreated()%3B%0A%0A%2F%2F%20Stop%20the%20event%20loop%20when%20needed%0AeventManager.stopEventLoop()%3B%0A%60%60%60%0A%0AFor%20more%20information%20regarding%20Store-related%20events%20please%20visit%20%5BStore%20docs%5D(.%2F..%2F..%2Fstores%2Fusing-stores%2F05-realtime-updating.mdx).%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AThe%20example%20below%20demonstrates%20how%20to%20use%20the%20%60EventManager%60%20for%20Inbox%20events.%0A%0A%0A%60%60%60js%0Aimport%20%7B%20EventManager%20%7D%20from%20'%40simplito%2Fprivmx-webendpoint%2Fextra'%3B%0A%0A%2F%2F%20Get%20the%20event%20queue%20from%20the%20endpoint%0Aconst%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%3B%0A%0A%2F%2F%20Start%20the%20event%20loop%0Aconst%20eventManager%20%3D%20EventManager.startEventLoop(%7B%0A%20waitEvent%3A%20eventQueue.waitEvent%0A%7D)%3B%0A%0A%2F%2F%20Create%20a%20scoped%20event%20manager%20for%20inbox%20events%0Aconst%20inboxEventManager%20%3D%20eventManager.getInboxEventManager(YOUR_INBOX_API)%3B%0A%0A%2F%2F%20Subscribe%20to%20the%20'inboxCreated'%20event%0Aconst%20unsubscribeFromInboxCreated%20%3D%20await%20inboxEventManager.onInboxEvent(%7B%0A%20event%3A%20'inboxCreated'%2C%0A%20callback%3A%20(payload)%20%3D%3E%20%7B%0A%20console.log('New%20inbox%20created%3A'%2C%20payload)%3B%0A%20%7D%2C%0A%7D)%3B%0A%0A%2F%2F%20Subscribe%20to%20the%20'storeFileCreated'%20event%20for%20a%20specific%20thread%0Aconst%20unsubscribeFromEntryCreated%20%3D%20await%20inboxEventManager.onEntryEvent(INBOX_ID%2C%20%7B%0A%20event%3A%20'inboxEntryCreated'%2C%0A%20callback%3A%20(payload)%20%3D%3E%20%7B%0A%20console.log('New%20entry%20in%20inbox%3A'%2C%20payload)%3B%0A%20%7D%2C%0A%7D)%3B%0A%0A%2F%2F%20Unsubscribe%20when%20needed%0Aawait%20unsubscribeFromInboxCreated()%3B%0Aawait%20unsubscribeFromEntryCreated()%3B%0A%0A%2F%2F%20Stop%20the%20event%20loop%20when%20needed%0AeventManager.stopEventLoop()%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AThe%20example%20below%20demonstrates%20how%20to%20use%20the%20%60EventManager%60%20for%20connection%20events.%0A%0A%60%60%60js%0Aimport%20%7B%20EventManager%20%7D%20from%20'%40simplito%2Fprivmx-webendpoint%2Fextra'%3B%0A%0A%2F%2F%20Get%20the%20event%20queue%20from%20the%20endpoint%0Aconst%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%3B%0A%0A%2F%2F%20Start%20the%20event%20loop%0Aconst%20eventManager%20%3D%20EventManager.startEventLoop(%7B%0A%20waitEvent%3A%20eventQueue.waitEvent%0A%7D)%3B%0A%0A%2F%2F%20Create%20a%20scoped%20event%20manager%20for%20connections%20events%0Aconst%20inboxEventManager%20%3D%20eventManager.getConnectionEventManager(await%20YOUR_CONNECTION.getConnectionId())%3B%0A%0A%2F%2F%20Subscribe%20to%20the%20'inboxCreated'%20event%0Aconst%20unsubscribeFromDisconnectedEvent%20%3D%20await%20inboxEventManager.onConnectionEvent(%7B%0A%20event%3A%20'libDisconnected'%2C%0A%20callback%3A%20(payload)%20%3D%3E%20%7B%0A%20console.log('Disconnected%3A'%2C%20payload)%3B%0A%20%7D%2C%0A%7D)%3B%0A%0A%2F%2F%20Unsubscribe%20when%20needed%0Aawait%20unsubscribeFromDisconnectedEvent()%3B%0A%0A%2F%2F%20Stop%20the%20event%20loop%20when%20needed%0AeventManager.stopEventLoop()%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C---%0Atitle%3A%20Overview%0A---%0A%0A%0A%0AInboxes%20are%20a%20way%20for%20users%20to%20send%20encrypted%20data%20to%20your%20app.%0A%0AThe%20advantage%20of%20Inboxes%20is%20that%20they%20don't%20require%20the%20user%20to%20be%20registered%20in%20order%20to%20send%20encrypted%20data.%0AThis%20opens%20up%20various%20possibilities%20in%20environments%20where%20you%20need%20to%20gather%20sensitive%20information%20from%20unregistered%20users%20(e.g.%20on%20your%20website).%0A%0ATo%20learn%20more%20about%20Inboxes%2C%20their%20structure%2C%20how%20they%20are%20encrypted%2C%20and%20what%20are%20their%20use%20cases%20-%20read%20%5BInbox%20Docs%5D(..%2Fstart%2Finboxes%2Foverview).%0A%0A%3A%3A%3Ainfo%0A%0ABefore%20working%20with%20Inboxes%2C%20follow%20our%20%5BGetting%20Started%20Guide%5D(.%2Fintroduction).%20It%20will%20show%20you%20how%20to%20set%20up%20your%20project%20to%20work%20with%20PrivMX%20Bridge.%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Ffirst-app%23initial-assumptions)**%0A%0A%3A%3A%3A%0A%0A%23%23%20Working%20with%20Inboxes%0A%0AWhen%20working%20with%20Inboxes%2C%20you%20will%20use%20the%20following%3A%0A-%20%60inboxApi%60%20-%20for%20methods%20used%20to%20manage%20Inboxes%20in%20given%20Context%0A%0A%60%60%60js%0Aconst%20threadApi%20%3D%20await%20Endpoint.createThreadApi(connection)%3B%0Aconst%20storeApi%20%3D%20await%20Endpoint.createStoreApi(connection)%3B%0Aconst%20inboxApi%20%3D%20await%20Endpoint.createInboxApi(connection%2C%20threadApi%2C%20storeApi)%3B%0A%60%60%60%0A%23%23%20Creating%20an%20Inbox%0A%0A%3CTabs%20groupId%3D%22variant%22%20items%3D%7B%5B%22Basic%22%2C%22With%20a%20structured%20Private%20Meta%22%2C%22With%20Public%20View%22%5D%7D%3E%0A%3CTab%3E%0ACreating%20a%20basic%20unnamed%20Inbox%2C%20which%20can%20be%20used%20if%20your%20app%20needs%20only%20one%20Inbox%20and%20you%20don't%20need%20a%20distinction%20between%20them%3A%0A%0A%60%60%60js%0Aconst%20users%20%3D%20%5B%7B%20userId%3A%20'MY_USER'%2C%20pubKey%3A%20'PUB_KEY'%20%7D%2C%20%7B%20userId%3A%20'MY_USER2'%2C%20pubKey%3A%20'PUB_KEY2'%20%7D%5D%3B%0Aconst%20managers%20%3D%20%5B%7B%20userId%3A%20'MY_USER'%2C%20pubKey%3A%20'PUB_KEY'%20%7D%5D%3B%0A%0A%0Aconst%20inboxId%20%3D%20await%20inboxApi.createInbox(%0A%20'CONTEXT_ID'%2C%0A%20users%2C%0A%20managers%2C%0A%20serializeObject(%22some%20public-meta%22)%2C%0A%20serializeObject(%22some%20private-meta%22)%2C%0A%20undefined%20%2F%2F%20optional%20files%20config%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%20%0A%3CTab%20%3E%0A%0AYou%20can%20assign%20any%20data%20to%20private%20and%20public%20meta%20fields%20(e.g.%20the%20name%20of%20the%20Inbox)%2C%20as%20long%20as%20they%20are%20serialized%20to%20Uint8Array.%0AIn%20this%20case%2C%20use%20the%20%60serializeObject%60%20function%20from%20the%20SDK%20to%20serialize%20a%20JavaScript%20object%20into%20a%20binary%20format%3A%0A%0A%60%60%60js%0Aconst%20privateMeta%20%3D%20%7B%0A%20name%3A%20'Contact%20Form'%0A%7D%3B%0Aconst%20users%20%3D%20%5B%7B%20userId%3A%20'MY_USER'%2C%20pubKey%3A%20'PUB_KEY'%20%7D%2C%20%7B%20userId%3A%20'MY_USER2'%2C%20pubKey%3A%20'PUB_KEY2'%20%7D%5D%3B%0Aconst%20managers%20%3D%20%5B%7B%20userId%3A%20'MY_USER'%2C%20pubKey%3A%20'PUB_KEY'%20%7D%5D%3B%0A%0Aconst%20inboxId%20%3D%20await%20inboxApi.createInbox(%0A%20'CONTEXT_ID'%2C%0A%20users%2C%0A%20managers%2C%0A%20serializeObject(%22some%20public-meta%22)%2C%0A%20serializeObject(privateMeta)%2C%0A%20undefined%20%2F%2F%20optional%20files%20config%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%0AIn%20Inboxes%2C%20%60publicMeta%60%20is%20exposed%20as%20%60InboxPublicView%60.%20To%20get%20it%20-%20call%20the%20getInboxPublicView(...)%20method.%0ANote%20that%20users%20don't%20have%20to%20be%20added%20to%20the%20Inbox%20to%20have%20access%20to%20this%20method%20-%20they%20only%20need%20it's%20ID%20and%20they%20can%20connect%20using%20connectPublic(...)%20method.%0A%0APutting%20data%20inside%20%60publicMeta%60%20also%20gives%20your%20own%20server%20the%20ability%20to%20access%20it%20using%20%5BPrivMX%20Bridge%20API%5D(https%3A%2F%2Fbridge.privmx.dev%2F).%0A%0A%60%60%60js%0Aconst%20users%20%3D%20%5B%7B%20userId%3A%20'MY_USER'%2C%20pubKey%3A%20'PUB_KEY'%20%7D%2C%20%7B%20userId%3A%20'MY_USER2'%2C%20pubKey%3A%20'PUB_KEY2'%20%7D%5D%3B%0Aconst%20managers%20%3D%20%5B%7B%20userId%3A%20'MY_USER'%2C%20pubKey%3A%20'PUB_KEY'%20%7D%5D%3B%0A%0Aconst%20privateMeta%20%3D%20%7B%0A%20name%3A%20'Album'%0A%7D%3B%0A%0Aconst%20publicMeta%20%3D%20%7B%0A%20formScheme%3A%20%5B%0A%20%7B%20question%3A%20'Your%20name'%20%7D%2C%0A%20%7B%20question%3A%20'E-mail'%20%7D%0A%20%5D%0A%7D%3B%0A%0Aconst%20inboxId%20%3D%20await%20inboxApi.createInbox(%0A%20'CONTEXT_ID'%2C%0A%20users%2C%0A%20managers%2C%0A%20serializeObject(publicMeta)%2C%0A%20serializeObject(privateMeta)%2C%0A%20undefined%20%2F%2F%20optional%20files%20config%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Fetching%20Inboxes%0A%0A%3CTabs%20groupId%3D%22variant%22%20items%3D%7B%5B%22Most%20Recent%22%2C%22Oldest%20Inboxes%22%2C%22By%20Inbox%20ID%22%2C%22Paging%22%5D%7D%3E%0A%3CTab%20%3E%0AFetching%20the%20most%20recent%20Inboxes%20in%20given%20Context%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A0%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22asc%22%7D%3B%0A%0Aconst%20inboxList%20%3D%20await%20inboxApi.listInboxes(%0A%20%22CONTEXT_ID%22%2C%0A%20defaultListQuery%0A)%3B%0A%0Aconst%20inboxListwithDeserializedMeta%20%3D%20inboxList.readItems.map(inbox%20%3D%3E%20%7B%0A%20return%20%7B%0A%20inbox%3A%20inbox%2C%0A%20privateMeta%3A%20deserializeObject(inbox.privateMeta)%2C%0A%20publicMeta%3A%20deserializeObject(inbox.publicMeta)%0A%20%7D%3B%0A%7D)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AFetching%20the%20oldest%20Inboxes%20(by%20creation%20date)%20in%20given%20Context%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A0%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0Aconst%20inboxList%20%3D%20await%20inboxApi.listInboxes(%0A%20%22CONTEXT_ID%22%2C%0A%20defaultListQuery%0A)%3B%0A%0Aconst%20inboxListwithDeserializedMeta%20%3D%20inboxList.readItems.map(inbox%20%3D%3E%20%7B%0A%20return%20%7B%0A%20inbox%3A%20inbox%2C%0A%20privateMeta%3A%20deserializeObject(inbox.privateMeta)%2C%0A%20publicMeta%3A%20deserializeObject(inbox.publicMeta)%0A%20%7D%3B%0A%7D)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AYou%20can%20get%20info%20about%20an%20Inbox%20using%20its%20%60inboxId%60%3A%0A%0A%60%60%60js%0Aconst%20inbox%20%3D%20await%20inboxApi.getInbox(%22INBOX_ID%22)%3B%0A%0Aconst%20privateMeta%20%3D%20deserializeObject(inbox.privateMeta)%3B%0Aconst%20publicMeta%20%3D%20deserializeObject(inbox.publicMeta)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AYou%20can%20change%20how%20many%20items%20are%20on%20a%20page%20using%20%60limit%60%20in%20options%20object%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A50%2C%20limit%3A%2020%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0Aconst%20inboxList%20%3D%20await%20inboxApi.listInboxes(%0A%20%22CONTEXT_ID%22%2C%0A%20defaultListQuery%0A)%3B%0A%0Aconst%20inboxListwithDeserializedMeta%20%3D%20inboxList.readItems.map(inbox%20%3D%3E%20%7B%0A%20return%20%7B%0A%20inbox%3A%20inbox%2C%0A%20privateMeta%3A%20deserializeObject(inbox.privateMeta)%2C%0A%20publicMeta%3A%20deserializeObject(inbox.publicMeta)%0A%20%7D%3B%0A%7D)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0ARemember%20that%20data%20is%20transmitted%20in%20binary%20format%2C%20so%20you'll%20need%20to%20parse%20it%20back%20into%20your%20desired%20format.%0AYou%20can%20use%20the%20%60deserializeObject%60%20function%20provided%20by%20the%20SDK%20for%20this%20purpose.%0A%0A%23%23%20Modifying%20Inboxes%0A%0A%3CTabs%20items%3D%7B%5B%22Renaming%20Inboxes%22%2C%22Removing%20Users%22%2C%22Deleting%20Inbox%22%5D%7D%3E%0A%3CTab%20default%3E%0ATo%20update%20an%20Inbox%20you%20must%20always%20provide%20its%20current%20version%2C%20as%20well%20as%3A%0A-%20list%20of%20users%2C%0A-%20list%20of%20managers%2C%0A-%20new%20private%20and%20public%20meta%20(even%20if%20it%20didn't%20change).%0A%0A%60%60%60%20js%0Aconst%20inbox%20%3D%20await%20inboxApi.getInbox(%0A%20inboxId%20%0A)%3B%0A%0Aconst%20newUsers%20%3D%20inbox.users.map(user%20%3D%3E%20(%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20userId%3A%20user%2C%0A%20pubKey%3A%20'USER_PUBLIC_KEY'%0A%20%7D)%0A)%3B%0A%0Aconst%20newManagers%20%3D%20newUsers.filter(user%20%3D%3E%0A%20inbox.managers.find(manager%20%3D%3E%20manager%20%3D%3D%20user.userId))%3B%0A%0Aconst%20newPrivateMeta%20%3D%20%7B%0A%20title%3A%20'New%20inbox%20name'%0A%7D%3B%0A%0Aawait%20inboxApi.updateInbox(%0A%20inboxId%20%0A%20newUsers%2C%0A%20newManagers%2C%0A%20inbox.publicMeta%2C%0A%20serializeObject(newPrivateMeta)%2C%0A%20inbox.filesConfig%2C%0A%20inbox.version%2C%0A%20false%2C%20%0A%20false%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0ATo%20remove%20a%20user%20from%20an%20Inbox%20you%20must%20provide%3A%0A-%20list%20of%20all%20the%20users%2C%20without%20the%20user%20you%20want%20to%20remove%3B%0A-%20list%20of%20managers%3B%0A-%20Inbox's%20current%20version%3B%0A-%20new%20private%20and%20public%20meta%20(even%20if%20it%20didn't%20change).%0A%0A%60%60%60%20js%20%0Aconst%20inbox%20%3D%20await%20inboxApi.getInbox(inboxId)%3B%0A%0Aconst%20newUsers%20%3D%20inbox.users%0A%20.filter(user%20%3D%3E%20user%20!%3D%3D%20userToRemove)%0A%20.map(user%20%3D%3E%20(%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20userId%3A%20user%2C%0A%20pubKey%3A%20'USER_PUBLIC_KEY'%0A%20%7D)%0A)%3B%0A%0Aconst%20newManagers%20%3D%20newUsers.filter(user%20%3D%3E%0A%20inbox.managers.find(manager%20%3D%3E%20manager%20%3D%3D%20user.userId))%3B%0A%0Aconst%20newPrivateMeta%20%3D%20%7B%0A%20title%3A%20'New%20inbox%20name'%0A%7D%3B%0A%0Aawait%20inboxApi.updateInbox(%0A%20inboxId%20%0A%20newUsers%2C%0A%20newManagers%2C%0A%20inbox.publicMeta%2C%0A%20serializeObject(newPrivateMeta)%2C%0A%20inbox.filesConfig%2C%0A%20inbox.version%2C%0A%20false%2C%20%0A%20false%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AThe%20snippet%20below%20deletes%20the%20Inbox%20and%20all%20its%20data.%20This%20action%20is%20irreversible.%0A%0A%60%60%60js%0Aawait%20inboxApi.deleteInbox(%22INBOX_ID%22)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%2C---%0Atitle%3A%20Store%20Overview%0A---%0A%0A%0A%0AStores%20provide%20encrypted%20block%20storage%2C%20enabling%20simple%20file%20uploading%20and%20downloading.%0A%0A%3A%3A%3Ainfo%0A%0ABefore%20working%20with%20Stores%2C%20follow%20our%20%5BGetting%20Started%20Guide%5D(.%2Fintroduction).%20It%20will%20show%20you%20how%20to%20set%20up%20your%20project%20to%20work%20with%20PrivMX%20Bridge.%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Ffirst-app%23initial-assumptions)**%0A%0A%3A%3A%3A%0A%0A%23%23%20Working%20with%20Stores%0A%0AWhen%20working%20with%20Stores%2C%20you%20will%20use%20the%20following%3A%0A%0AWhen%20working%20with%20Threads%2C%20you%20will%20use%20the%20following%3A%0A-%20%60storeApi%60%20-%20provides%20methods%20used%20to%20manage%20Stores%20in%20given%20Context%0A%0A%60%60%60js%0Aconst%20storeApi%20%3D%20await%20Endpoint.createStoreApi(CONNECTION_ID)%3B%0A%60%60%60%0A%23%23%20Creating%20Stores%0A%0A%3CTabs%20groupId%3D%22variant%22%20items%3D%7B%5B%22Basic%22%2C%22With%20a%20Name%22%2C%22With%20%60publicMeta%60%22%5D%7D%3E%0A%3CTab%3E%0ACreating%20a%20basic%20unnamed%20Store%2C%20which%20can%20act%20as%20an%20encrypted%20block%20container%3A%0A%0A%60%60%60js%0Aconst%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%5D%3B%0A%0A%2F%2F%20create%20a%20new%20Store%20with%20access%20for%20user_1%20as%20manager%20and%20user_2%20as%20regular%20user%0A%2F%2F%20for%20example%2C%20let's%20put%20the%20name%20of%20the%20store%20as%20an%20object%20in%20the%20store's%20private%20meta%0Aconst%20storeId%20%3D%20await%20storeApi.createStore(CONTEXT_ID%2C%20users%2C%20managers%2C%0A%20serializeObject(%22some%20store's%20public%20meta-data%22)%2C%0A%20serializeObject(%22some%20store's%20private%20meta-data%22)%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%0AYou%20can%20assign%20any%20data%20to%20private%20and%20public%20meta%20fields%20(e.g.%20the%20Store's%20name)%2C%20as%20long%20as%20they%20are%20serialized%20to%20%60Uint8Array%60.%0A%0A%60%60%60js%0Aconst%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20privateMeta%20%3D%20%7B%0A%20name%3A%20'Photo%20Album'%0A%7D%3B%0A%0Aconst%20storeId%20%3D%20storeApi.createStore(%0A%20CONTEXT_ID%2C%0A%20users%2C%0A%20managers%2C%0A%20serializeObject(%22some%20public-meta%22)%2C%0A%20serializeObject(privateMeta)%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%0AYou%20can%20implement%20a%20tag%20system%2C%20which%20allows%20to%20create%20Stores%20with%20arbitrary%20tags.%0APutting%20them%20inside%20%60publicMeta%60%20gives%20your%20own%20server%20the%20ability%20to%20access%20it%20using%20Bridge%20REST%20API.%0A%0A%60%60%60js%0Aconst%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20privateMeta%20%3D%20%7B%0A%20name%3A%20'Album'%0A%7D%3B%0A%0Aconst%20publicMeta%20%3D%20%7B%0A%20tags%3A%20%5B'TAG1'%2C%20'TAG2'%2C%20'TAG3'%5D%0A%7D%3B%0A%0Aconst%20storeId%20%3D%20storeApi.createStore(%0A%20CONTEXT_ID%2C%0A%20users%2C%0A%20managers%2C%0A%20serializeObject(publicMeta)%2C%0A%20serializeObject(privateMeta)%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Fetching%20Stores%0A%0A%3CTabs%20groupId%3D%22variant%22%20items%3D%7B%5B%22Most%20Recent%22%2C%22Oldest%20Stores%22%2C%22By%20Store%20ID%22%2C%22Paging%22%5D%7D%3E%0A%3CTab%3E%0AFetching%20the%20most%20recent%20Stores%20in%20given%20Context%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0Aconst%20storesList%20%3D%20await%20storeApi.listStores(%0A%20CONTEXT_ID%2C%0A%20defaultListQuery%0A)%3B%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%0A%60%60%60js%0A%2F%2F%20storesList%3A%0A%7B%0A%20readItems%3A%20%5B%3CstoreObject1%3E%2C%20%3CstoreObject2%3E%2C...%2C%20%3CstoreObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_stores%3E%0A%7D%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AFetching%20the%20oldest%20Stores%20(by%20creation%20date)%20in%20given%20Context%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22asc%22%7D%3B%0A%0Aconst%20storesList%20%3D%20await%20storeApi.listStores(%0A%20CONTEXT_ID%2C%0A%20defaultListQuery%0A)%3B%0A%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60js%0A%2F%2F%20storesList%3A%0A%7B%0A%20readItems%3A%20%5B%3CstoreObject1%3E%2C%20%3CstoreObject2%3E%2C...%2C%20%3CstoreObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_stores%3E%0A%7D%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20%3E%0AYou%20can%20get%20info%20about%20a%20Store%20using%20its%20%60storeId%60%3A%0A%0A%60%60%60js%0Aconst%20store%20%3D%20await%20wnd.storeApi.getStore(storeId)%3B%0Aconst%20privateMeta%20%3D%20deserializeObject(store.privateMeta)%3B%0Aconst%20publicMeta%20%3D%20deserializeObject(store.publicMeta)%3B%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20%60Store%60%20object.%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AYou%20can%20change%20how%20many%20items%20are%20on%20a%20page%20using%20%60limit%60%20in%20options%20object%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%2050%2C%20limit%3A%2020%2C%20sortOrder%3A%20%22asc%22%7D%3B%0A%0Aconst%20storesList%20%3D%20await%20storeApi.listStores(%0A%20CONTEXT_ID%2C%0A%20defaultListQuery%0A)%3B%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60js%0A%2F%2F%20storesList%3A%0A%7B%0A%20readItems%3A%20%5B%3CstoreObject1%3E%2C%20%3CstoreObject2%3E%2C...%2C%20%3CstoreObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_stores%3E%0A%7D%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0AA%20detailed%20description%20of%20the%20%60Store%60%20object%20fields%20can%20be%20found%20%5Bhere%5D(..%2Freference%2Fwebendpoint%2Fapi-reference%2Ftypes%23Store).%0A%0A%0A%23%23%20Modifying%20Stores%0A%0AThe%20%60updateStore(...)%60%20method%20needs%20all%20the%20parameters%20as%20in%20the%20%60createStore(...)%60%20method%20and%20a%20few%20more.%20If%20you%20want%20to%20update%20%0Aone%20of%20the%20parameters%20-%20provide%20it%20in%20a%20new%20modified%20form.%20If%2C%20on%20the%20other%20hand%2C%20you%20want%20to%20leave%20%0Athe%20parameter%20unchanged%2C%20provide%20it%20as%20it%20was%20before.%20All%20current%20values%20%E2%80%8B%E2%80%8Bof%20the%20parameters%20of%20a%20given%20Store%20can%20be%0Aobtained%20using%20%60getStore(threadId)%60.%0A%0A%3CTabs%20items%3D%7B%5B%22Renaming%20Store%22%2C%22Removing%20Users%22%2C%22Deleting%20Store%22%5D%7D%3E%0A%3CTab%3E%0A%0A%60%60%60js%0Aconst%20store%20%3D%20await%20storeApi.getStore(storeId)%3B%0A%0Aconst%20newUsers%20%3D%20store.users.map(user%20%3D%3E%20(%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20userId%3A%20user%2C%0A%20pubKey%3A%20'USER_PUBLIC_KEY'%0A%20%7D)%0A)%3B%0A%0Aconst%20newManagers%20%3D%20newUsers.filter(user%20%3D%3E%0A%20store.managers.find(manager%20%3D%3E%20manager%20%3D%3D%20user.userId))%3B%0A%0Aconst%20newPrivateMeta%20%3D%20%7B%0A%20title%3A%20'New%20store%20name'%0A%7D%3B%0A%0Aawait%20storeApi.updateStore(%0A%20storeId%0A%20newUsers%2C%0A%20newManagers%2C%0A%20store.publicMeta%2C%0A%20serializeObject(newPrivateMeta)%0A%20store.version%2C%0A%20false%2C%0A%20false%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0ATo%20remove%20a%20user%20from%20the%20Store%20you%20must%20update%20a%20list%20of%20the%20users%2Fmanagers%20by%20removing%20the%20user%20you%20want%20to%20get%20rid%20of.%0AAll%20the%20other%20values%20required%20for%20update%20can%20be%20taken%20from%20the%20current%20Store.%0A%0A%60%60%60js%0Aconst%20userToRemove%20%3D%20'USERID_TO_REMOVE'%3B%0A%0Aconst%20store%20%3D%20await%20storeApi.getStore(storeId)%3B%0A%0Aconst%20newUsers%20%3D%20store.users%0A%20.filter(user%20%3D%3E%20user%20!%3D%3D%20userToRemove)%0A%20.map(user%20%3D%3E%20(%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20userId%3A%20user%2C%0A%20pubKey%3A%20'USER_PUBLIC_KEY'%0A%20%7D)%0A)%3B%0A%0Aconst%20newManagers%20%3D%20newUsers.filter(user%20%3D%3E%0A%20store.managers.find(manager%20%3D%3E%20manager%20%3D%3D%20user.userId))%3B%0A%0Aconst%20newPrivateMeta%20%3D%20%7B%0A%20title%3A%20'New%20store%20name'%0A%7D%3B%0A%0Aawait%20storeApi.updateStore(%0A%20storeId%0A%20newUsers%2C%0A%20newManagers%2C%0A%20store.publicMeta%2C%0A%20serializeObject(newPrivateMeta)%0A%20store.version%2C%0A%20false%2C%0A%20false%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AThe%20snippet%20below%20deletes%20the%20Store%20and%20all%20its%20data.%20This%20action%20is%20irreversible.%0A%0A%60%60%60js%0Aawait%20storeApi.deleteStore(storeId)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%2C---%0Atitle%3A%20Entries%0A---%0A%0A%0AAll%20the%20data%20sent%20by%20someone%20to%20an%20Inbox%20is%20called%20an%20Entry.%0AIn%20Threads%20and%20Stores%2C%20a%20user%20must%20be%20assigned%20to%20the%20container%20to%20send%20data.%20In%20Inboxes%2C%20however%2C%20%0Aanyone%20who%20has%20Inbox%20ID%20can%20send%20a%20reply%20(assuming%20they%20have%20the%20Bridge%20URL%20and%20Solution%20ID).%0A%0A%3A%3A%3Ainfo%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Ffirst-app%23initial-assumptions)**%0A%0A%3A%3A%3A%0A%0A%23%23%20Accessing%20via%20Public%20API%0A%0AEndpoint%20provides%20different%20ways%20to%20connect%20to%20a%20Bridge%20instance.%0A%0AWhen%20using%20%22public%22%20connection%20you%20don't%20have%20to%20pass%20a%20private%20key.%20A%20random%20private%20key%20will%20be%20generated%20for%20each%20connection.%0A**The%20public%20connection%20provides%20only%20the%20methods%20related%20to%20sending%20Inbox%20entries%20and%20retrieving%20public%20metadata**%20related%20to%20the%20Inbox.%0A%0A%23%23%23%20Public%20Connection%0A%0ATo%20submit%20data%20as%20unregistered%20user%20you%20have%20to%20connect%20using%20connectPublic(...)%20and%20then%20-%20prepare%20and%20send%20an%20Entry.%0A%60%60%60ts%0Aconst%20publicConnection%20%3D%20await%20Endpoint.connectPublic(%0A%20%22SOLUTION_ID%22%2C%0A%20%22BRIDGE_URL%22%0A)%3B%0A%60%60%60%0A%0AYou%20have%20to%20pass%20required%20Bridge%20URL%20and%20Solution%20ID.%20Then%20use%20an%20%60inboxApi%60.%0A%0A%0A%23%23%23%20Submitting%20Entries%0A%0A%3CTabs%20groupId%3D%22variant%22%20items%3D%7B%5B%22Prepare%20Entry%22%2C%22With%20meta%22%2C%22With%20Files%22%5D%7D%3E%0A%3CTab%3E%0A%0A%60%60%60ts%0Aconst%20inboxHandle%20%3D%20await%20inboxApi.prepareEntry(%0A%20%22INBOX_ID%22%2C%0A%20serializeObject(%22text%20to%20send%22)%2C%0A%20%5B%5D%2C%20%2F%2F%20no%20files%20this%20time%0A%20undefined%20%2F%2F%20if%20logged%20with%20private%20connection%2C%20use%20user%20private%20key%20here.%0A)%3B%0A%0Aawait%20inboxApi.sendEntry(%0A%20inboxHandle%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%0A%60%60%60ts%0Aconst%20dataToSend%20%3D%20serializeObject(%7B%0A%20type%3A%20'General%20inquiry'%2C%0A%20answer%3A%20'Example%20answer'%0A%20%7D)%0A%0Aconst%20inboxHandle%20%3D%20await%20inboxApi.prepareEntry(%0A%20%22INBOX_ID%22%2C%0A%20dataToSend%2C%0A%20%5B%5D%2C%20%2F%2F%20no%20files%20this%20time%0A%20undefined%20%2F%2F%20if%20logged%20with%20private%20connection%2C%20use%20user%20private%20key%20here.%0A)%3B%0A%0Aawait%20inboxApi.sendEntry(inboxHandle)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AInboxes%20allow%20you%20to%20attach%20files%20when%20sending%20a%20reply.%20Each%20file%20is%20automatically%20streamed%20during%20submission.%0ASimilar%20to%20Stores%2C%20the%20files%20can%20contain%20private%2Fpublic%20metadata.%0A%0AFile%20info%20is%20located%20inside%20Entries%3A%0A%60%60%60ts%0Aconst%20dataToSend%20%3D%20serializeObject(%7B%0A%20type%3A%20'General%20inquiry'%2C%0A%20answer%3A%20'Example%20answer'%0A%7D)%0A%0Aconst%20fileHandle%20%3D%20await%20inboxApi.createFileHandle(%0A%20serializeObject(%22File%20publicMeta%22)%2C%0A%20serializeObject(%22File%20privateMeta%22)%2C%0A%20fileSize%0A)%3B%0A%0Aconst%20inboxHandle%20%3D%20await%20inboxApi.prepareEntry(%0A%20%22INBOX_ID%22%2C%0A%20dataToSend%2C%0A%20%5BfileHandle%5D%2C%20%2F%2F%20one%20file%20this%20time%0A%20undefined%20%2F%2F%20if%20logged%20with%20private%20connection%2C%20use%20user%20private%20key%20here.%0A)%3B%0A%0Aawait%20inboxApi.writeToFile(%0A%20inboxHandle%2C%0A%20fileHandle%2C%0A%20byteArray%0A)%3B%0A%2F%2F%20repeat%20in%20a%20loop%20if%20needed%0A%0Aawait%20inboxApi.sendEntry(inboxHandle)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0A%23%23%20Fetching%20Entries%0A%0AFetching%20entries%20requires%20a%20secure%20private%20connection.%0A%0A%3CTabs%20groupId%3D%7B'variant'%7D%20items%3D%7B%5B%22Fetching%20entries%22%2C%22Oldest%22%2C%22With%20Meta%22%5D%7D%3E%0A%3CTab%3E%0AFetching%20the%20most%20recent%20Entries%20submitted%20to%20Inbox%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A0%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22desc%22%7D%3B%0Aconst%20entries%20%3D%20await%20inboxApi.listEntries(%0A%20%22INBOX_ID%22%2C%0A%20defaultListQuery%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%20%3E%0AFetching%20the%20oldest%20Entries%20(by%20submission%20date)%20in%20given%20Inbox%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A0%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22asc%22%7D%3B%0Aconst%20entries%20%3D%20await%20inboxApi.listEntries(%0A%20%22INBOX_ID%22%2C%0A%20defaultListQuery%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3CTab%20%3E%0AEntries%20contain%20list%20of%20submitted%20files.%0AEach%20file%20can%20contain%20additional%20metadata%20useful%20for%20providing%20info%20about%20them%2C%20for%20e.g%3A%20file%20name%2C%20size%2C%20or%20author.%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A0%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22desc%22%7D%3B%0Aconst%20entries%20%3D%20await%20inboxApi.listEntries(%0A%20%22INBOX_ID%22%2C%0A%20defaultListQuery%0A)%3B%0A%0Aconst%20deserializedEntries%20%3D%20entries.readItems.map(entry%20%3D%3E%20%7B%0A%20return%20%7B%0A%20...entry%2C%0A%20privateMeta%3A%20deserializeObject(entry.privateMeta)%2C%0A%20data%3A%20deserializeObject(entry.data)%2C%0A%20files%3A%20entry.files.map(file%20%3D%3E%20(%7B%0A%20...file%2C%0A%20privateMeta%3A%20deserializeObject(file.privateMeta)%0A%20%7D))%0A%20%7D%3B%0A%7D)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3C%2FTabs%3E%0A%2C---%0Atitle%3A%20Overview%0Adescription%3A%20KVDBs%20provide%20encrypted%20key-value%20databases.%0A---%0A%0A%3A%3A%3Ainfo%0A%0ABefore%20working%20with%20KVDBs%2C%20follow%20our%20%5BGetting%20Started%20Guide%5D(.%2Fintroduction).%20It%20will%20show%20you%20how%20to%20set%20up%20your%20project%20to%20work%20with%20PrivMX%20Bridge.%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%0A%23%23%20Working%20with%20KVDBs%0A%0AWhen%20working%20with%20KVDBs%2C%20you%20will%20use%20the%20following%3A%0A-%20%60KvdbApi%60%20-%20provides%20methods%20used%20to%20manage%20KVDBs%20in%20given%20Context%0A%0A%60%60%60js%0Aconst%20kvdbApi%20%3D%20await%20Endpoint.createKvdbApi(connection)%3B%0A%60%60%60%0A%23%23%20Creating%20KVDBs%0A%3CTabs%20groupId%3D%22variant%22%20items%3D%7B%5B%22Basic%22%2C%22With%20a%20Name%22%2C%22Public%20Meta%22%5D%7D%3E%0A%3CTab%20%3E%0ACreating%20a%20basic%2C%20unnamed%20KVDB%2C%20which%20can%20act%20as%20an%20encrypted%20data%20container%3A%0A%0A%60%60%60js%0Aconst%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%5D%3B%0A%0A%2F%2F%20create%20a%20new%20KVDB%20with%20access%20for%20USER_1%20as%20manager%20and%20USER_2%20as%20regular%20user%0Aconst%20kvdbId%20%3D%20await%20kvdbApi.createKvdb(CONTEXT_ID%2C%20users%2C%20managers%2C%0A%20serializeObject(%22some%20kvdb's%20public%20meta-data%22)%2C%0A%20serializeObject(%22some%20kvdb's%20private%20meta-data%22)%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%20%3CTab%20%3E%0A%0AYou%20can%20assign%20any%20data%20to%20private%20and%20public%20meta%20fields%20(e.g.%20the%20KVDB's%20name)%2C%20as%20long%20as%20they%20are%20serialized%20to%20%60Uint8Array%60.%0A%60%60%60js%0Aconst%20privateMeta%20%3D%20%7B%0A%20name%3A%20'First%20KVDB'%0A%7D%3B%0A%0Aconst%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%5D%3B%0A%0A%2F%2F%20create%20a%20new%20KVDB%20with%20access%20for%20user_1%20as%20manager%20and%20user_2%20as%20regular%20user%0Aconst%20kvdbId%20%3D%20await%20kvdbApi.createKvdb(CONTEXT_ID%2C%20users%2C%20managers%2C%0A%20serializeObject(%22some%20kvdb's%20public%20meta-data%22)%2C%0A%20serializeObject(privateMeta)%0A)%3B%0A%60%60%60%0A%0A%0A%3C%2FTab%3E%0A%3CTab%20%3E%0A%0AYou%20can%20implement%20a%20tag%20system%20which%20allows%20you%20to%20create%20KVDBs%20with%20arbitrary%20tags.%0APutting%20them%20inside%20%60publicMeta%60%20gives%20your%20own%20server%20ability%20to%20access%20it%20using%20%5BPrivMX%20Bridge%20API%5D(https%3A%2F%2Fbridge.privmx.dev%2F).%0A%0A%60%60%60js%0Aconst%20privateMeta%20%3D%20%7B%0A%20name%3A%20'First%20KVDB'%0A%7D%3B%0A%0Aconst%20publicMeta%20%3D%20%7B%0A%20tags%3A%20%5B'TAG1'%2C%20'TAG2'%2C%20'TAG3'%5D%0A%7D%3B%0A%0Aconst%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%5D%3B%0A%0Aconst%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%5D%3B%0A%0A%2F%2F%20create%20a%20new%20KVDB%20with%20access%20for%20USER_1%20as%20manager%20and%20USER_2%20as%20regular%20user%0Aconst%20kvdbId%20%3D%20await%20kvdbApi.createKvdb(CONTEXT_ID%2C%20users%2C%20managers%2C%0A%20serializeObject(publicMeta)%2C%0A%20serializeObject(privateMeta)%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Fetching%20KVDBs%0A%0A%3CTabs%20groupId%3D%22variant%22%20items%3D%7B%5B%22Most%20Recent%22%2C%22Sorting%22%2C%22By%20KVDB%20ID%22%2C%22Paging%22%5D%7D%3E%0A%3CTab%3E%0AFetching%20the%20most%20recent%20KVDBs%20in%20given%20Context%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22desc%22%7D%3B%0Aconst%20kvdbList%20%3D%20await%20kvdbApi.listKvdbs(CONTEXT_ID%2C%20defaultListQuery)%3B%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60js%0A%2F%2F%20kvdbList%3A%0A%7B%0A%20readItems%3A%20%5B%3CkvdbObject1%3E%2C%20%3CkvdbObject2%3E%2C...%2C%20%3CkvdbObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_kvdbs%3E%0A%7D%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AFetching%20the%20oldest%20KVDBs%20(by%20creation%20date)%20in%20given%20Context%3A%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22asc%22%7D%3B%0Aconst%20kvdbList%20%3D%20await%20kvdbApi.listKvdbs(CONTEXT_ID%2C%20defaultListQuery)%3B%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60js%0A%2F%2F%20kvdbList%3A%0A%7B%0A%20readItems%3A%20%5B%3CkvdbObject1%3E%2C%20%3CkvdbObject2%3E%2C...%2C%20%3CkvdbObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_kvdbs%3E%0A%7D%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AYou%20can%20get%20info%20about%20a%20KVDB%20using%20its%20%60kvdbId%60%3A%0A%0A%60%60%60js%0Aconst%20kvdb%20%3D%20await%20kvdbApi.getKvdb(%0A%20kvdbId%20%0A)%3B%0A%0Aconst%20privateMeta%20%3D%20deserializeObject(kvdb.privateMeta)%3B%0Aconst%20publicMeta%20%3D%20deserializeObject(kvdb.publicMeta)%3B%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20%60Kvdb%60%20object.%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0AYou%20can%20change%20how%20many%20items%20are%20on%20a%20page%20using%20%60limit%60%20in%20options%20object%3A%0A%60%60%60js%0A%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%2050%2C%20limit%3A%2020%2C%20sortOrder%3A%20%22asc%22%7D%3B%0Aconst%20kvdbList%20%3D%20await%20kvdbApi.listKvdbs(CONTEXT_ID%2C%20defaultListQuery)%3B%0A%0A%60%60%60%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60js%0A%2F%2F%20kvdbList%3A%0A%7B%0A%20readItems%3A%20%5BKVDB_1%2CKVDB_2%2CKVDB_3%5D%2C%0A%20totalAvailable%3A%20NUMBER_OF_KVDBS%0A%7D%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0AA%20detailed%20description%20of%20the%20%60Kvdb%60%20object%20fields%20can%20be%20found%20in%20%5BAPI%20Reference%5D(..%2Freference%2Fendpoint%2Fkvdb%2Ftypes).%0A%0A%23%23%20Modifying%20KVDBs%0A%0A%23%23%23%20How%20Updates%20Work%0ATo%20update%20a%20KVDB%20you%20must%20always%20provide%20a%20full%20list%20of%20parameters.%0A%0AThe%20%60updateKvdb(...)%60%20method%20needs%20all%20the%20parameters%20as%20in%20the%20%60createKvdb(...)%60%20method%20and%20a%20few%20more.%20If%20we%20want%20to%20update%0Aone%20of%20the%20parameters%20%E2%80%93%20provide%20it%20in%20a%20new%20modified%20form.%20If%2C%20on%20the%20other%20hand%2C%20you%20want%20to%20leave%0Athe%20parameter%20unchanged%20%E2%80%93%20provide%20it%20as%20it%20was%20before.%20All%20current%20values%20%E2%80%8B%E2%80%8Bof%20the%20parameters%20of%20a%20given%20KVDB%20can%20be%20obtained%20using%20%60getKvdb(kvdbId)%60.%0A%0A%3CTabs%20items%3D%7B%5B%22Renaming%20a%20KVDB%22%2C%22Removing%20a%20user%22%2C%22Deleting%20a%20KVDB%22%5D%7D%3E%0A%3CTab%3E%0A%0A%60%60%60js%0Aconst%20kvdb%20%3D%20await%20kvdbApi.getKvdb(kvdbId)%3B%0A%0Aconst%20newUsers%20%3D%20kvdb.users.map(user%20%3D%3E%20(%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20userId%3A%20user%2C%0A%20pubKey%3A%20'USER_PUBLIC_KEY'%0A%20%7D)%0A)%3B%0A%0Aconst%20newManagers%20%3D%20newUsers.filter(user%20%3D%3E%0A%20kvdb.managers.find(manager%20%3D%3E%20manager%20%3D%3D%20user.userId))%3B%0A%0Aconst%20newPrivateMeta%20%3D%20%7B%0A%20title%3A%20'New%20kvdb%20name'%0A%7D%3B%0A%0Aawait%20kvdbApi.updateKvdb(%0A%20kvdbId%2C%0A%20newUsers%2C%0A%20newManagers%2C%0A%20kvdb.publicMeta%2C%0A%20serializeObject(newPrivateMeta)%2C%0A%20kvdb.version%2C%0A%20false%2C%0A%20false%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%3E%0ATo%20remove%20a%20user%20from%20the%20KVDB%20you%20must%20update%20a%20list%20of%20the%20users%2Fmanagers%20by%20removing%20the%20user%20you%20want%20to%20get%20rid%20of.%0AAll%20the%20other%20values%20required%20for%20update%20can%20be%20taken%20from%20the%20current%20KVDB.%0A%0A%60%60%60js%0Aconst%20kvdb%20%3D%20await%20kvdbApi.getKvdb(kvdbId)%3B%0A%0A%2F%2F%20Get%20all%20users%20who%20were%20in%20the%20KVDB%2C%0A%2F%2F%20besides%20the%20one%20you%20want%20to%20remove%3A%0Aconst%20newUsers%20%3D%20kvdb.users%0A%20.filter(user%20%3D%3E%20user%20!%3D%3D%20userToRemove)%0A%20.map(user%20%3D%3E%20(%7B%0A%20%2F%2F%20Your%20application%20must%20provide%20a%20way%2C%0A%20%2F%2F%20to%20get%20user's%20public%20key%20from%20their%20userId.%0A%20userId%3A%20user%2C%0A%20pubKey%3A%20'USER_PUBLIC_KEY'%0A%20%7D))%3B%0A%0Aconst%20newManagers%20%3D%20newUsers.filter(user%20%3D%3E%0A%20kvdb.managers.find(manager%20%3D%3E%20manager%20%3D%3D%20user.userId)%0A)%3B%0A%0Aawait%20kvdbApi.updateKvdb(%0A%20kvdbId%2C%0A%20newUsers%2C%0A%20newManagers%2C%0A%20kvdb.publicMeta%2C%0A%20kvdb.privateMeta%2C%0A%20kvdb.version%2C%0A%20false%2C%0A%20false%0A)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%3E%0AThe%20snippet%20below%20deletes%20KVDB%20and%20all%20its%20data.%20This%20action%20is%20irreversible.%0A%0A%60%60%60js%0Aawait%20kvdbApi.deleteKvdb(kvdbId)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C---%0Atitle%3A%20Getting%20Started%0A---%0A%0A%23%23%20Initial%20Requirements%0A%0ATo%20start%20developing%20end-to-end%20encrypted%20applications%20using%20PrivMX%20Web%20Endpoint%20you%20need%20a%20**PrivMX%20Bridge**%20instance%2C%20you%20can%20find%20quick%20start%20guide%20%5Bhere%5D(..%2Fstart%2Fquick-start).%0A%0ATo%20connect%20it%20to%20your%20environment%2C%20you%20need%3A%0A%20-%20%60Bridge%20URL%60%20-%20URL%20address%20of%20the%20instance%20of%20your%20PrivMX%20Bridge%0A%20-%20%60Solution%20ID%60%20-%20ID%20of%20the%20Solution%20provided%20by%20PrivMX%20Bridge%20during%20its%20initialization%20process%0A%20-%20%60User%20Private%20Key%60%20-%20the%20private%20key%20from%20the%20user's%20public-private%20key%20pair%0A%0AWhen%20you%20develop%20a%20project%20using%20PrivMX%2C%20you%20will%20most%20likely%20use%20some%20kind%20of%20application%20server%20%E2%80%93%20a%20server%20to%20manage%20users%20(and%20their%20keys)%2C%20Contexts%2C%20etc.%20%0AIt%20can%20be%20new%20or%20existing%2C%20depending%20on%20the%20specific%20requirements.%0A%0A%23%23%20Using%20Public%20and%20Private%20Keys%0AYou%20need%20a%20private%20key%20to%20connect%20the%20Endpoint%20to%20your%20Bridge.%20**Private%20key%20will%20never%20leave%20the%20Endpoint**.%0A-%20PrivMX%20Endpoint%20uses%20the%20user's%20private%20key%20to%20encrypt%2C%20decrypt%20and%20verify%20data%20on%20the%20client%20side%20only.%0A-%20PrivMX%20Bridge%20stores%20only%20the%20public%20part%2C%20i.e.%2C%20the%20user's%20public%20key%20and%20user's%20ID.%0A%0A%23%23%20Setting%20up%20Web%20Server%20to%20Host%20JavaScript%20Assets%0A%0ATo%20properly%20integrate%20PrivMX%20Web%20Endpoint%20library%2C%20it's%20crucial%20to%20configure%20your%20server.%20This%20will%20ensure%20the%20library%20functions%20correctly%20and%20maintain%20security.%20%0AYou%20need%20to%20set%20up%20specific%20HTTP%20headers%3A%20%0A-%20set%20%60Cross-Origin-Embedder-Policy%60%20to%20%60require-corp%60%3B%0A-%20set%20%60Cross-Origin-Opener-Policy%60%20to%20%60same-origin%60.%0A%0AThese%20headers%20are%20essential%20to%20prevent%20potential%20cross-origin%20attacks%20and%20to%20maintain%20a%20secure%20execution%20environment.%0A%0AFor%20detailed%20instructions%20on%20how%20to%20configure%20these%20headers%20in%20different%20environments%20like%20Vite%2C%20Next.js%2C%20Express%2C%20and%20Nginx%2C%20%0Arefer%20to%20our%20%5BServer%20Configuration%5D(.%2Fapplication-server)%20page.%0A%0AYou%20can%20also%20take%20a%20look%20at%20our%20%5Bexample%20projects%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-webendpoint%2Ftree%2Fmain%2Fexamples)%0Ato%20find%20server%20configuration%20samples.%0A%0A%23%23%20Setting%20up%20Web%20Endpoint%0A%0A%3A%3A%3Awarning%0A%0APrivMX%20Web%20Endpoint%20relies%20heavily%20on%20WebAssembly%20and%20browser%20Web%20Workers.%0ABecause%20of%20that%2C%20Web%20Endpoint%20is%20not%20compatible%20with%20the%20Node.js%20environments%20used%20on%20the%20server%20side%20and%20is%20limited%20to%20**browsers%20only**.%0AWe%20are%20actively%20working%20on%20the%20%60%40simplito%2Fprivmx-endpoint-node%60%20NPM%20package%20to%20support%20this%20kind%20of%20usage%20in%20the%20future.%0A%0A%3A%3A%3A%0A%0APrivMX%20Web%20Endpoint%20is%20distributed%20as%20an%20NPM%20package%20(%5B%40simplito%2Fprivmx-webendpoint%5D(https%3A%2F%2Fwww.npmjs.com%2Fpackage%2F%40simplito%2Fprivmx-webendpoint))%20that%20contains%0Aall%20the%20necessary%20assets%20and%20helpers%20to%20get%20started.%0A%0AFollow%20these%20steps%20to%20get%20started%3A%0A%0A1.%20Download%20the%20NPM%20package%20for%20your%20target%20project%20by%20calling%3A%20%60npm%20i%20%40simplito%2Fprivmx-webendpoint%60.%0A2.%20Set%20up%20your%20Web%20Server%20to%20host%20JavaScript%20assets%20properly%20%E2%80%93%20%5Bsee%20below%5D(%23setting-up-web-server-to-host-javascript-assets).%0A3.%20Copy%20the%20Endpoint's%20assets%20(all%20.js%20and%20.wasm%20files%20from%20%60.%2Fnode_modules%2F%40simplito%2Fprivmx-webendpoint%2Fassets%60)%20to%20your%20Web%20Server's%20public%20directory.%0A%0AFinally%2C%20to%20complete%20the%20setup%20process%2C%20you%20have%20two%20ways%20to%20import%20the%20package%20to%20your%20project%3A%0A%0A%23%23%23%20Importing%20NPM%20Package%0A%60%60%60ts%0Aimport%20%7B%20Endpoint%2C%20EventQueue%2C%20Types%20%7D%20from%20%22%40simplito%2Fprivmx-webendpoint%22%3B%0A%60%60%60%0A%0A%23%23%23%20Using%20Bundle%0A%0AFirst%20you%20should%20copy%20the%20%60privmx-endpoint-web.js%60%20file%20(bundle)%20from%20the%20%60.%2Fnode_modules%2F%40simplito%2Fprivmx-webendpoint%2Fdist%2Fbundle%60%20directory%20to%20your%20Web%20Server's%20public%20directory.%0A%0ANext%2C%20in%20your%20%60index.html%60%20add%20script%20tag%20to%20import%20the%20bundle%3A%0A%60%60%60html%0A%3C!DOCTYPE%20html%3E%0A%3Chtml%3E%0A%20%3Chead%3E%0A%20%3Cscript%20src%3D%22%3Cpublic_dir%3E%2Fprivmx-endpoint-web.js%22%3E%3C%2Fscript%3E%0A%20%3C%2Fhead%3E%0A%20%3Cbody%3E%0A%20%3C%2Fbody%3E%0A%3C%2Fhtml%3E%0A%60%60%60%0AYou%20can%20use%20it%20in%20your%20app%20in%20one%20of%20the%20following%20methods%3A%0A%0A-%20**From%20global%20scope**%0A%20%60%60%60js%0A%20%2F%2F%20this%2Fwindow%20binding%0A%20const%20Endpoint%20%3D%20PrivmxWebEndpoint.Endpoint%3B%0A%20%2F%2F%20or%0A%20const%20Endpoint%20%3D%20window.PrivmxWebEndpoint.Endpoint%3B%0A%20%60%60%60%0A-%20**CommonJS%20import**%0A%20%60%60%60js%0A%20const%20Endpoint%20%3D%20require(%22privmx-webendpoint%22).Endpoint%3B%0A%20%60%60%60%0A-%20**AMD%20import**%0A%20%60%60%60js%0A%20require(%5B'privmx-webendpoint'%5D%2C%20function%20(privmxWebEndpoint)%20%7B%0A%20%2F%2F%20Do%20something%20with%20the%20library...%0A%20%7D)%3B%0A%20%60%60%60%0A%0A%23%23%20Web%20Endpoint's%20APIs%0AYou%20need%20your%20Bridge's%20instance%20specific%20data%2C%20mentioned%20%5Bearlier%5D(%23initial-requirements)%2C%20which%20you%20should%20get%20during%20the%20Bridge's%20setup%20process.%0A%0A%60%60%60js%0Aconst%20bridgeUrl%20%3D%20%22http%3A%2F%2Flocalhost%3A9111%22%3B%0Aconst%20solutionId%20%3D%20%22SOLUTION_ID%22%3B%0A%0Aconst%20userPrivKey%20%3D%20%22USER_PRIVATE_KEY%22%3B%0Aconst%20userPubKey%20%3D%20%22USER_PUBLIC_KEY%22%3B%0A%60%60%60%0A%0AFirst%20connect%20to%20your%20PrivMX%20Bridge%20instance.%0AInitialize%20the%20Endpoint%20and%20its%20WebAssembly%20dependencies%0A(provide%20the%20Endpoint.setup()%20function%20with%20your%20Web%20Server's%20public%20directory%20URL%2Fpath%0A%20where%20the%20Endpoint%20assets%20were%20copied)%0A%60%60%60js%0Aawait%20Endpoint.setup(%22%3Cpublic_dir%3E%22)%3B%0A%2F%2F%20Create%20connection%20to%20the%20Bridge%20Server%0Aconst%20connection%20%3D%20await%20Endpoint.connect(userPrivKey%2C%20solutionId%2C%20bridgeUrl)%3B%0A%2F%2F%20Initialize%20the%20Threads%20API%0Aconst%20threadApi%20%3D%20await%20Endpoint.createThreadApi(connection)%3B%0A%2F%2F%20call%20some%20API%20methods%0Aconst%20threads%20%3D%20await%20threadApi.listThreads(...)%3B%0A%60%60%60%0A%0A%23%23%20Next%20Steps%0A%0AWith%20everything%20ready%20to%20go%2C%20now%20it's%20time%20to%20start%20using%20all%20the%20capabilities%20of%20Endpoint%20and%20Bridge.%0A%0ALearn%20how%20to%20use%3A%0A%0A-%20%5B**Threads**%5D(..%2Fstart%2Fthreads%2Foverview)%20-%20for%20exchanging%20encrypted%20messages%3B%0A-%20%5B**Stores**%5D(..%2Fstart%2Fstores%2Foverview)%20-%20for%20saving%20and%20sharing%20encrypted%20files%3B%0A-%20%5B**Inboxes**%5D(..%2Fstart%2Finboxes%2Foverview)%20-%20for%20one%20way%20communication%20with%20external%20users.%0A%0A%2C---%0Atitle%3A%20Messages%0Adescription%3A%20Sending%20messages%20in%20Threads.%0A---%0A%0A%0A%3A%3A%3Ainfo%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(..%2Fjs%2Ffirst-app%23initial-assumptions)**%20mentioned%20in%20%5BFirst%20App%5D(..%2Fjs%2Ffirst-app).%0A%0A%3A%3A%3A%0A%0A%23%23%20Messages%20Inside%20Threads%0A%0AMessages%20inside%20Threads%20are%20sent%20in%20binary%20format.%20Before%20sending%20a%20message%2C%20you%20need%20to%20decide%20on%20the%20message%20format%20and%20choose%0Athe%20appropriate%20data%20serialization%20method.%0A%0AFor%20more%20information%20about%20the%20Threads%20architecture%20and%20best%20practices%20for%20sending%20messages%2C%20visit%20the%0A%5BThreads%20Documentation%5D(..%2Fstart%2Fthreads%2Foverview).%0A%0A%23%23%20Serialization%20of%20Data%0A%0ATo%20send%20a%20message%20you%20have%20to%20use%20the%20Endpoint's%20%60sendMessage%60%20method.%20This%20method%20accepts%20arguments%20in%20%60Uint8Array%60%2C%20here%20are%20some%20of%0Athe%20ways%20you%20can%20serialize%20your%20JavaScript%20objects%3A%0A%0A%23%23%20Sending%20Messages%0A%0A%3CTabs%20groupId%3D%22variant%22%20items%3D%7B%5B%22basic%22%2C%22markdown%22%5D%7D%3E%0A%3CTab%3E%0AExample%20of%20sending%20a%20message%20in%20Plain%20Text%3A%0A%0A%60%60%60ts%0Aconst%20message%20%3D%20'Message%20text'%3B%0A%20%0Aconst%20encoder%20%3D%20new%20TextEncoder()%3B%0A%0Aawait%20threadApi.sendMessage(%0A%20threadId%2C%20%0A%20serializeObject(%22some%20public%20meta-data%22)%2C%20%0A%20serializeObject(%22some%20private%20meta-data%22)%2C%20%0A%20serializeObject(message)%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20value%3D'markdown'%20label%3D'Richtext'%3E%0A%0AYour%20app%20may%20require%20sending%20messages%20in%20more%20complex%20formats%20like%20Markdown%20or%20HTML.%20Because%20messages%20in%20Threads%0Adon't%20have%20a%20specified%20format%2C%20you%20can%20take%20any%20output%20from%20your%20text%20editor%2C%20serialize%2C%20and%20send%20it.%0A%0AThe%20example%20below%20uses%20%60type%60%20field%20in%20%60publicMeta%60%20to%20distinguish%20between%20different%20types%20of%20messages.%0A%0A%60%60%60ts%0Aconst%20messageObject%20%3D%20%7B%0A%20%2F%2Foutput%20from%20the%20chosen%20WYSIWYG%20editor%0A%20%2F%2For%20your%20own%20object%20definition%20%0A%7D%3B%0A%0Aconst%20privateMeta%20%3D%20%7B%0A%20type%3A%20'markdown'%0A%7D%3B%0A%0Aconst%20publicMeta%20%3D%20%7B%0A%20tag%3A%20'tag'%0A%7D%3B%0A%0Aawait%20threadApi.sendMessage(%0A%20threadId%2C%20%0A%20serializeObject(publicMeta)%2C%20%0A%20serializeObject(privateMeta)%2C%0A%20serializeObject(messageObject)%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Receiving%20Messages%0A%0ATo%20get%20a%20list%20of%20messages%20inside%20a%20Thread%2C%20use%20%60listMessages%60%20method.%20Because%20data%20inside%20messages%20is%20in%20Uint8Array%0Ayou%20have%20to%20deserialize%20it%20to%20human-readable%20string.%0A**Endpoint%20takes%20care%20of%20encrypting%20your%20data%20before%20sending%20it%20to%20PrivMX%20Bridge.**%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0Aconst%20messages%20%3D%20await%20threadApi.listMessages(threadId%2C%20defaultListQuery)%3B%0Aconst%20decodedMessages%20%3D%20messages.readItems.map(x%20%3D%3E%0A%20%7B%0A%20return%20%7B%0A%20publicMeta%3A%20deserializedObject(x.publicMeta)%2C%0A%20privateMeta%3A%20deserializedObject(x.privateMeta)%2C%0A%20data%3A%20deserializedObject(x.data)%0A%20%7D%0A%20%7D%0A)%0Aconsole.log(%22messages%22%2C%20messages)%3B%0Aconsole.log(%22messages%20in%20human-readable%20format%22%2C%20decodedMessages)%3B%0A%60%60%60%0A%0A%23%23%20Deleting%20a%20Message%0A%0ATo%20delete%20a%20message%2C%20you%20need%20to%20use%20the%20%60deleteMessage%60%20method.%0A%0A%60%60%60js%0Aawait%20threadApi.deleteMessage(messageId)%3B%0A%60%60%60%0A%2C---%0Atitle%3A%20First%20app%0A---%0A%0AA%20step-by-step%20tutorial%20that%20will%20guide%20you%20through%20creating%20your%20first%20app%20using%20JavaScript%20WebEndpoint%20with%20PrivMX%20Bridge.%0A%0A%23%23%23%20PrivMX%20Bridge%0ATo%20proceed%20with%20this%20tutorial%2C%20you%20should%20already%20have%20your%20Bridge%20Server%20up%20and%20running.%20If%20not%2C%20you%20can%20find%20step-by-step%20instructions%20on%20%5Bquick%20start%5D(..%2Fstart%2Fquick-start)%20page.%0A%0A%23%23%23%20Helpers%0AMost%20of%20the%20Endpoint's%20methods%20(for%20example%20creating%20or%20updating%20containers%20like%20Threads%2C%20Stores%2C%20etc.)%20require%20some%20data%20to%20be%20passed%20as%20a%20buffer.%20In%20JavaScript%20that%20buffer%20is%20represented%20as%20%60Uint8Array%60.%0A%0AA%20common%20way%20to%20serialize%20JS%20objects%20is%20to%20serialize%20them%20to%20a%20JSON%20string%20using%20%60JSON.stringify%60.%20Next%2C%20in%20order%20to%20encode%20strings%20you%20can%20use%0A%60TextEncoder%60.%20Because%20it's%20so%20common%2C%20in%20our%20examples%20we%20will%20use%20helper%20functions%20to%20do%20these%20conversions%20underneath.%0A%0A%60%60%60js%0Afunction%20strToUInt8(text)%20%7B%0A%20return%20(new%20TextEncoder()).encode(text)%3B%0A%7D%0A%0Afunction%20uInt8ToStr(arr)%20%7B%0A%20return%20(new%20TextDecoder()).decode(arr)%3B%0A%7D%0A%0Afunction%20deserializeObject(binary)%7B%0A%20return%20JSON.parse(uInt8ToStr(binary))%3B%0A%7D%0A%0Afunction%20serializeObject(object)%20%7B%0A%20return%20strToUInt8(JSON.stringify(object))%3B%0A%7D%0A%60%60%60%0A%0A%23%23%20Initial%20Assumptions%0A%0AAll%20the%20values%20below%20like%20%60BRIDGE_URL%60%2C%20%60SOLUTION_ID%60%2C%20%60CONTEXT_ID%60%0Ashould%20be%20replaced%20by%20the%20ones%20corresponding%20to%20your%20PrivMX%20Bridge%20instance.%0A%0AThe%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%0ANormally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0Aor%20generated%20from%20a%20password%20(see%20the%20%60derivePrivateKey2()%60%20method%20in%20the%20Crypto%20API)%0A%0AThe%20initial%20assumptions%20for%20all%20the%20code%20examples%20below%20are%20as%20follows%3A%0A%60%60%60js%0Aconst%20BRIDGE_URL%20%3D%20%22http%3A%2F%2Flocalhost%3A9111%22%3B%0Aconst%20SOLUTION_ID%20%3D%20%22YOUR_SOLUTION_ID%22%3B%0Aconst%20CONTEXT_ID%20%3D%20%22YOUR_CONTEXT_ID%22%3B%0A%0Aconst%20USER1_ID%20%3D%20%22user_1%22%3B%0Aconst%20USER1_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_1%22%3B%0Aconst%20USER1_PRIV%20%3D%20%22PRIVATE_KEY_1%22%3B%0A%0Aconst%20USER2_ID%20%3D%20%22user_2%22%3B%0Aconst%20USER2_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_2%22%3B%0A%0Aconst%20USER3_ID%20%3D%20%22user_3%22%3B%0Aconst%20USER3_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_3%22%3B%0A%0A%2F%2F%20Initialize%20Endpoint%20and%20its%20Wasm%20assets%0Aawait%20Endpoint.setup(%22%2Fpublic%22)%3B%0A%60%60%60%0A%0A%23%23%23%20Basic%20Serialization%20Example%20-%20JSON%0A%60%60%60ts%0Aconst%20dataObject%20%3D%20%7B%0A%20content%3A%20'MESSAGE_CONTENT'%2C%0A%20type%3A%20'text'%0A%7D%3B%0A%0Aconst%20binaryData%20%3D%20serializeObject(dataObject)%3B%20%2F%2F%20returns%20data%20encoded%20to%20Uint8Array%0Aconst%20deserializedObject%20%3D%20deserializeObject(binaryData)%3B%20%2F%2F%20returns%20JavaScript%20object%0A%60%60%60%0A%0A%0A%23%23%23%20Create%20Client%20App%0AFirst%2C%20you%20have%20to%20connect%20to%20your%20Bridge%20instance%20using%20%60Endpoint.connect%60%20method.%20It%20requires%20the%20API%20keys%0Agenerated%20while%20initializing%20your%20local%20instance%20earlier.%0A%0A%60%60%60js%0Aimport%20%7BEndpoint%7D%20from%20%22%40simplito%2Fprivmx-webendpoint%22%0A%0Aconst%20connection%20%3D%20await%20Endpoint.connect(USER1_PRIV%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%3B%0Aconst%20threadApi%20%3D%20await%20Endpoint.createThreadApi(connection)%3B%0A%60%60%60%0AWhen%20connected%2C%20you%20have%20access%20to%20all%20SDK%20methods.%20This%20example%20shows%20how%20to%20create%20a%20Thread%2C%20send%2C%20and%20download%0Aa%20message.%0A%0ATo%20create%20a%20Thread%20inside%20the%20Context%2C%20use%20proper%20methods.%20Note%20that%20you%20have%20to%20pass%20user%20ID%20-%20public%20key%0Apair%20to%20make%20a%20list%20of%20users%20and%20managers.%0A%0A%60%60%60js%0A%2F%2Fusing%20constants%20from%20initial%20assumptions%0Aconst%20exampleUser%20%3D%20%7B%0A%20userId%3A%20USER1_ID%2C%0A%20pubKey%3A%20USER1_PUBLIC_KEY%2C%0A%7D%3B%0A%0Aconst%20newThreadId%20%3D%20await%20threadApi.createThread(%0A%20CONTEXT_ID%2C%20%0A%20%5BexampleUser%5D%2C%20%2F%2F%20list%20of%20users%20who%20will%20have%20access%20to%20the%20created%20Thread%0A%20%5BexampleUser%5D%2C%20%2F%2F%20list%20of%20managers%20of%20that%20Thread%0A%20strToUInt8(%22some%20public%20meta-data%22)%2C%0A%20strToUInt8(%22some%20private%20meta-data%2C%20such%20as%20thread%20name%22)%0A)%3B%0A%60%60%60%0A%0AWith%20the%20Thread%20created%2C%20you%20can%20now%20send%20the%20first%20message.%0A%0A%60%60%60js%0Aawait%20threadApi.sendMessage(%0A%20threadId%2C%20%0A%20strToUInt8(%22some%20public%20meta-data%22)%2C%20%0A%20strToUInt8(%22some%20private%20meta-data%22)%2C%20%0A%20strToUInt8(%22some%20message%20content%22)%0A)%3B%0A%60%60%60%0A%0ATo%20get%20a%20list%20of%20messages%20inside%20a%20Thread%2C%20use%20%60listMessages%60%20method.%20Because%20data%20inside%20messages%20is%20in%20%60Uint8Array%60%0Ayou%20have%20to%20deserialize%20it%20to%20human-readable%20string.%0A**Endpoint%20takes%20care%20of%20encrypting%20your%20data%20before%20sending%20it%20to%20PrivMX%20Bridge.**%0A%0A%60%60%60js%0Aconst%20defaultListQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%20100%2C%20sortOrder%3A%20%22desc%22%7D%3B%0Aconst%20messagesList%20%3D%20await%20threadApi.listMessages(threadId%2C%20defaultListQuery)%3B%0Aconst%20decodedMessages%20%3D%20messages.readItems.map(x%20%3D%3E%20%7B%0A%20return%20%7B%0A%20publicMeta%3A%20deserializedObject(x.publicMeta)%2C%0A%20privateMeta%3A%20deserializedObject(x.privateMeta)%2C%0A%20data%3A%20deserializedObject(x.data)%0A%20%7D%0A%7D)%0A%0Aconsole.log(%22messages%22%2C%20messages)%3B%0Aconsole.log(%22messages%20in%20human-readable%20format%22%2C%20decodedMessages)%0A%60%60%60%0A%0A%0A%23%23%20Next%20Steps%0A%0AWith%20everything%20ready%20to%20go%2C%20now%20it's%20time%20to%20start%20using%20all%20the%20capabilities%20of%20Endpoint%20and%20Bridge.%0A%0ALearn%20how%20to%20use%3A%0A%0A-%20%5B**Threads**%5D(..%2Fstart%2Fthreads%2Foverview)%20-%20for%20exchanging%20encrypted%20messages%3B%0A-%20%5B**Stores**%5D(..%2Fstart%2Fstores%2Foverview)%20-%20for%20saving%20and%20sharing%20encrypted%20files%3B%0A-%20%5B**Inboxes**%5D(..%2Fstart%2Finboxes%2Foverview)%20-%20for%20one%20way%20communication%20with%20external%20users.%0A%0A%2C%7B%0A%20%22title%22%3A%20%22JavaScript%22%2C%0A%20%22description%22%3A%20%22%22%2C%0A%20%22root%22%3A%20true%2C%0A%20%22pages%22%3A%20%5B%0A%20%22---JavaScript---%22%2C%0A%20%22introduction%22%2C%0A%20%22application-server%22%2C%0A%20%22---Quick%20Starts---%22%2C%0A%20%22first-app%22%2C%0A%20%22---Threads---%22%2C%0A%20%22threads%22%2C%0A%20%22messages%22%2C%0A%20%22---Stores---%22%2C%0A%20%22stores%22%2C%0A%20%22files%22%2C%0A%20%22---Inboxes---%22%2C%0A%20%22inboxes%22%2C%0A%20%22entries%22%2C%0A%20%22---KVDBs---%22%2C%0A%20%22kvdbs%22%2C%0A%20%22kvdb-entries%22%2C%0A%20%22---Events---%22%2C%0A%20%22events%22%2C%0A%20%22handling-events%22%0A%20%5D%0A%7D%0A%2C---%0Atitle%3A%20Hosting%20Assets%0A---%0A%0A%23%20Hosting%20PrivMX%20Web%20Endpoint%20Assets%0A%0ATo%20ensure%20the%20proper%20functionality%20and%20security%20of%20our%20library%2C%20it%20is%20essential%20to%20configure%20your%20server%20with%20specific%20HTTP%20headers%20on%20**the%20page%20containing%20the%20scripts**%20and%20**the%20scripts%20themselves**%20(e.g.%2C%20those%20located%20in%20%60public%2Fprivmx-assets%2F%60).%0A%0ASet%20the%20following%20headers%3A%0A%0A-%20%60Cross-Origin-Embedder-Policy%3A%20require-corp%60%0A-%20%60Cross-Origin-Opener-Policy%3A%20same-origin%60%0A%0AThese%20headers%20are%20crucial%20for%20maintaining%20a%20secure%20execution%20environment%2C%20as%20they%20help%20prevent%20potential%20cross-origin%20attacks%20and%20ensure%20that%20resources%20are%20only%20shared%20with%20origins%20that%20comply%20with%20the%20same%20security%20policies.%20Implementing%20these%20headers%20will%20enable%20seamless%20integration%20and%20optimal%20performance%20of%20our%20library%20in%20your%20application.%0A%0A%23%23%23%20Setting%20Up%20Headers%20in%20Different%20Environments%0A%0A%3CTabs%20items%3D%7B%5B%22Vite%22%2C%22Next.js%22%2C%22Express%22%2C%22Nginx%22%2C%22Apache%22%2C%22Webpack%22%5D%7D%3E%0A%3CTab%3E%0A%0A%23%23%23%23%20Vite%0A%0ATo%20configure%20these%20headers%20in%20a%20Vite%20project%20for%20specific%20routes%20(such%20as%20the%20page%20containing%20the%20scripts%20and%20the%20scripts%20themselves)%2C%20you%20need%20to%20set%20up%20a%20middleware%20in%20the%20Vite%20configuration%20file%3A%0A%0A%60%60%60js%0A%2F%2F%20vite.config.js%0Aimport%20%7B%20defineConfig%20%7D%20from%20%22vite%22%3B%0A%0Aexport%20default%20defineConfig(%7B%0A%20plugins%3A%20%5B%0A%20%7B%0A%20name%3A%20'configure-response-headers'%2C%0A%20configureServer%3A%20server%20%3D%3E%20%7B%0A%20server.middlewares.use((req%2C%20res%2C%20next)%20%3D%3E%20%7B%0A%20%2F%2F%20Apply%20headers%20only%20to%20relevant%20paths%0A%20if%20(req.url.startsWith('%2Fprivmx-assets')%20%7C%7C%20req.url%20%3D%3D%3D%20'%2FYOUR_SUBPAGE')%20%7B%0A%20res.setHeader('Cross-Origin-Embedder-Policy'%2C%20'require-corp')%3B%0A%20res.setHeader('Cross-Origin-Opener-Policy'%2C%20'same-origin')%3B%0A%20%7D%0A%20next()%3B%0A%20%7D)%3B%0A%20%7D%2C%0A%20%7D%2C%0A%20%5D%2C%0A%7D)%3B%0A%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%3E%0A%0A%23%23%23%23%20Next.js%0AIn%20a%20Next.js%20project%2C%20you%20can%20set%20these%20headers%20specifically%20for%20the%20page%20containing%20the%20scripts%20and%20the%20script%20files%20(e.g.%2C%20public%2Fprivmx-assets%2F)%20in%20the%20next.config.js%20file%3A%0A%60%60%60js%0A%2F%2F%20next.config.mjs%0Aconst%20nextConfig%20%3D%20%7B%0A%20%2F%2F%20..rest%20of%20the%20configuration%0A%20headers%3A%20async%20()%20%3D%3E%20%7B%0A%20return%20%5B%0A%20%7B%0A%20source%3A%20'%2Fyour-page'%2C%20%2F%2F%20Page%20containing%20the%20scripts%0A%20headers%3A%20%5B%0A%20%7B%0A%20key%3A%20'Cross-Origin-Embedder-Policy'%2C%0A%20value%3A%20'require-corp'%2C%0A%20%7D%2C%0A%20%7B%0A%20key%3A%20'Cross-Origin-Opener-Policy'%2C%0A%20value%3A%20'same-origin'%2C%0A%20%7D%2C%0A%20%5D%2C%0A%20%7D%2C%0A%20%7B%0A%20source%3A%20'%2Fprivmx-assets%2F(.*)'%2C%20%2F%2F%20Script%20files%0A%20headers%3A%20%5B%0A%20%7B%0A%20key%3A%20'Cross-Origin-Embedder-Policy'%2C%0A%20value%3A%20'require-corp'%2C%0A%20%7D%2C%0A%20%7B%0A%20key%3A%20'Cross-Origin-Opener-Policy'%2C%0A%20value%3A%20'same-origin'%2C%0A%20%7D%2C%0A%20%5D%2C%0A%20%7D%2C%0A%20%5D%3B%0A%20%7D%2C%0A%7D%3B%0A%0A%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%3E%0A%0A%23%23%23%23%20Express%0AFor%20an%20Express.js%20server%2C%20you%20can%20set%20these%20headers%20in%20your%20middleware%3A%0A%0A%60%60%60js%0Aconst%20express%20%3D%20require('express')%3B%0Aconst%20app%20%3D%20express()%3B%0A%0Aapp.use('%2Fprivmx-assets'%2C%20(req%2C%20res%2C%20next)%20%3D%3E%20%7B%0A%20res.setHeader('Cross-Origin-Embedder-Policy'%2C%20'require-corp')%3B%0A%20res.setHeader('Cross-Origin-Opener-Policy'%2C%20'same-origin')%3B%0A%20next()%3B%0A%7D)%3B%0A%0Aapp.use('%2Fyour-page'%2C%20(req%2C%20res%2C%20next)%20%3D%3E%20%7B%0A%20res.setHeader('Cross-Origin-Embedder-Policy'%2C%20'require-corp')%3B%0A%20res.setHeader('Cross-Origin-Opener-Policy'%2C%20'same-origin')%3B%0A%20next()%3B%0A%7D)%3B%0A%0A%2F%2F%20your%20other%20middleware%20and%20routes%0A%0Aapp.listen(3000%2C%20()%20%3D%3E%20%7B%0A%20console.log('Server%20is%20running%20on%20port%203000')%3B%0A%7D)%3B%0A%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%3E%0A%0A%23%23%23%23%20Nginx%0ATo%20set%20these%20headers%20only%20for%20the%20page%20containing%20the%20scripts%20and%20the%20script%20files%2C%20you%20need%20to%20modify%20your%20Nginx%20configuration%20file%3A%0A%60%60%60%0A%23%20%2Fetc%2Fnginx%2Fnginx.conf%20or%20%2Fetc%2Fnginx%2Fsites-available%2Fyour-site%0Aserver%20%7B%0A%20listen%2080%3B%0A%20server_name%20your-site.com%3B%0A%0A%20location%20%2Fyour-page%20%7B%0A%20add_header%20Cross-Origin-Embedder-Policy%20require-corp%3B%0A%20add_header%20Cross-Origin-Opener-Policy%20same-origin%3B%0A%20%7D%0A%0A%20location%20%2Fprivmx-assets%2F%20%7B%0A%20add_header%20Cross-Origin-Embedder-Policy%20require-corp%3B%0A%20add_header%20Cross-Origin-Opener-Policy%20same-origin%3B%0A%20%7D%0A%7D%0A%0A%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%3E%0A%23%23%23%23%20Apache%0ATo%20configure%20these%20headers%20only%20for%20the%20page%20containing%20the%20scripts%20and%20the%20script%20files%2C%20add%20the%20following%20directives%20to%20your%20.htaccess%20file%20or%20your%20site's%20configuration%20file%3A%0A%0A%60%60%60%0A%23%20.htaccess%20or%20httpd.conf%0A%3CIfModule%20mod_headers.c%3E%0A%20%3CFilesMatch%20%22%5E%2Fyour-page%24%22%3E%0A%20Header%20set%20Cross-Origin-Embedder-Policy%20%22require-corp%22%0A%20Header%20set%20Cross-Origin-Opener-Policy%20%22same-origin%22%0A%20%3C%2FFilesMatch%3E%0A%0A%20%3CDirectory%20%22public%2Fprivmx-assets%2F%22%3E%0A%20Header%20set%20Cross-Origin-Embedder-Policy%20%22require-corp%22%0A%20Header%20set%20Cross-Origin-Opener-Policy%20%22same-origin%22%0A%20%3C%2FDirectory%3E%0A%3C%2FIfModule%3E%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0A%0A%23%23%23%23%20Webpack%20Dev%20Server%0A%0ABelow%20you%20will%20find%20an%20example%20configuration%20file%20for%20Webpack%20with%20a%20fully%20setup%20Webpack's%20Development%20Server%3A%0A%0A%60%60%60js%0A%2F%2F%20webpack.config.cjs%0Aconst%20path%20%3D%20require('path')%3B%0Aconst%20webpack%20%3D%20require('webpack')%3B%0Aconst%20HtmlWebpackPlugin%20%3D%20require(%22html-webpack-plugin%22)%3B%0Aconst%20host%20%3D%20process.env.HOST%20%7C%7C%20'localhost'%3B%0Amodule.exports%20%3D%20%7B%0A%20devServer%3A%20%7B%0A%20static%3A%20%5B%7B%0A%20directory%3A%20path.join(__dirname%2C%20'public')%2C%0A%20publicPath%3A%20'%2Fpublic'%0A%20%7D%5D%2C%0A%20compress%3A%20true%2C%0A%20liveReload%3A%20false%2C%0A%20host%2C%0A%20port%3A%204001%2C%0A%20headers%3A%20%7B%0A%20%22Cross-Origin-Embedder-Policy%22%3A%20%22require-corp%22%2C%0A%20%22Cross-Origin-Opener-Policy%22%3A%20%22same-origin%22%2C%0A%0A%20%22Access-Control-Allow-Origin%22%3A%20%22*%22%2C%0A%20%22Access-Control-Allow-Methods%22%3A%20%22GET%2C%20POST%2C%20PUT%2C%20DELETE%2C%20PATCH%2C%20OPTIONS%22%2C%0A%20%22Access-Control-Allow-Headers%22%3A%20%22X-Requested-With%2C%20content-type%2C%20Authorization%22%0A%20%7D%0A%20%7D%0A%7D%3B%0A%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C---%0Atitle%3A%20Events%0A---%0A%0AThis%20document%20provides%20a%20comprehensive%20guide%20on%20working%20with%20events%20in%20PrivMX%2C%20covering%20how%20to%20set%20up%20connections%20and%20event%20queues%2C%20listen%20for%20specific%20types%20of%20events%20like%20Thread%20or%20Store%20actions%2C%20and%20understand%20the%20structure%20of%20these%20events.%0A%0A%23%23%20Working%20with%20Events%0A%0ATo%20start%20working%20with%20Events%2C%20you%20must%3A%0A%0A%3Cdiv%20className%3D%7B'fd-steps'%7D%3E%0A%20%3Cdiv%20className%3D%7B'fd-step'%7D%3E%0A%20Create%20connection%20to%20PrivMX%20Bridge%20instance.%0A%20%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20auto%20connection%20%3D%20core%3A%3AConnection%3A%3Aconnect(PRIVATE_KEY%2CSOLUTION_ID%2CBRIDGE_URL)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60ts%0A%20const%20connection%20%3D%20await%20Endpoint.connect(PRIVATE_KEY%2CSOLUTION_ID%2CBRIDGE_URL)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3C%2FTabs%3E%0A%20%3C%2Fdiv%3E%0A%20%3Cdiv%20className%3D%7B'fd-step'%7D%3E%0A%20Create%20Event%20Queue.%0A%20%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%20%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20auto%20eventQueue%20%3D%20core%3A%3AEventQueue%3A%3AgetInstance()%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60ts%0A%20const%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3C%2FTabs%3E%0A%20%3C%2Fdiv%3E%0A%20%3Cdiv%20className%3D%7B'fd-step'%7D%3E%0A%20Start%20listening%20for%20events%20using%20%60waitEvent%60.%0A%20%60EventQueue%60%20provides%20%60waitEvent%60%20method%20that%20blocks%20main%20browser's%20thread.%0A%20To%20avoid%20freezing%20the%20entire%20app%3A%0A%0A%20%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%20%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20Map%20containing%20pairs%20of%20event%20type%20-%20list%20of%20callbacks%0A%20std%3A%3Ashared_mutex%20callbacksMapMutex%3B%0A%20std%3A%3Amap%3Cstd%3A%3Astring%2C%20std%3A%3Afunction%3Cvoid(std%3A%3Ashared_ptr%3Cprivmx%3A%3Aendpoint%3A%3Acore%3A%3AEvent%3E)%3E%3E%20callbacks%3B%20%0A%20std%3A%3Aatomic_bool%20listenForEventsPromise%20%3D%20true%3B%0A%20%2F%2F%20Start%20the%20EventQueue%20reading%20loop%0A%20std%3A%3Athread%20t(%5B%26%5D()%7B%0A%20while(listenForEventsPromise)%20%7B%0A%20core%3A%3AEventHolder%20event%20%3D%20eventQueue.waitEvent()%3B%0A%20std%3A%3Ashared_lock%3Cstd%3A%3Ashared_mutex%3E%20lock(callbacksMapMutex)%3B%0A%20auto%20search%20%3D%20callbacks.find(event.type)%3B%0A%20if%20(search%20!%3D%20_map.end())%20%7B%0A%20search-%3Esecond(event)%3B%0A%20%7D%0A%20%7D%0A%20%7D)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2Fprevious%20code%0A%20const%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%3B%0A%0A%20%2F%2Fmap%20containing%20pairs%20of%20event%20type%20-%20list%20of%20callbacks%0A%20const%20callbacks%20%3D%20new%20Map()%0A%0A%20%2F%2FWait%20event%20is%20blocking%20and%20must%20be%20executed%20in%20promise%20loop%2C%0A%20%2F%2Fto%20prevent%20blocking%20the%20main%20thread.%0A%20let%20listenForEventsPromise%20%3D%20null%3B%0A%20function%20listenForEvents(queue)%20%7B%0A%20if%20(!listenForEventsPromise)%20%7B%0A%20listenForEventsPromise%20%3D%20queue.waitEvent()%3B%0A%20listenForEventsPromise.then(result%20%3D%3E%20%7B%0A%20if(callbacks.has(result.type))%7B%0A%20const%20eventCallbacks%20%3D%20callbacks.get(result.type)%0A%20eventCallbacks.forEach((cb)%20%3D%3E%20cb(result))%0A%20%7D%0A%20listenForEventsPromise%20%3D%20null%3B%0A%20listenForEvents(queue)%3B%0A%20%7D)%0A%20%7D%0A%20%7D%0A%0A%20listenForEvents(eventQueue)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3C%2FTabs%3E%0A%20%3C%2Fdiv%3E%0A%20%3Cdiv%20className%3D%7B'fd-step'%7D%3E%0A%20Subscribe%20to%20channels.%0A%20%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20auto%20threadApi%20%3D%20thread%3A%3AThreadApi%3A%3Acreate(connection)%3B%0A%20threadApi.subscribeForThreadEvents()%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2Fusing%20connection%20from%20first%20step%0A%20const%20threadApi%20%3D%20await%20Endpoint.createThreadApi(connection)%0A%20await%20threadApi.subscribeForThreadEvents()%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3C%2FTabs%3E%0A%20%3C%2Fdiv%3E%0A%20%3Cdiv%20className%3D%7B'fd-step'%7D%3E%0A%20Add%20callback%20methods.%20%5C%0A%20Add%20a%20list%20with%20callback%20methods%20that%20will%20be%20called%20on%20event%20with%20matching%20event%20type.%0A%20In%20this%20example%20it's%20%60threadCreated%60%3A%0A%20%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20callbacks%5B%22threadCreated%22%5D%20%3D%20%5B%26%5D(std%3A%3Ashared_ptr%3Cprivmx%3A%3Aendpoint%3A%3Acore%3A%3AEvent%3E%20event)%7Bstd%3A%3Acout%20%3C%3C%20event.type%20%3C%3C%20std%3A%3Aendl%3B%7D%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2Fprevious%20code%0A%20callbacks.set(%22threadCreated%22%2C%5B(payload)%20%3D%3E%20%7Bconsole.log(payload)%7D%5D)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3C%2FTabs%3E%0A%20%3C%2Fdiv%3E%0A%0A%3C%2Fdiv%3E%0A%0A%23%23%20Channels%0A%0ABefore%20receiving%20Events%2C%20your%20application%20must%20first%20subscribe%20to%20a%20group%20of%20events.%20Internally%20those%20groups%0Aare%20called%20%22Channels%22.%0A%0AChannels%20can%20be%20divided%20into%20two%20types%3A%0A%0A-%20**Container%20related**%3A%20Those%20channels%20notify%20about%20changes%20related%20to%20a%20given%20Container%20type.%20After%20subscribing%20to%20these%20channels%2C%20you%0A%20will%20receive%20events%20when%20someone%20creates%2C%20updates%2C%20or%20deletes%20a%20Container%20with%20matching%20type%20in%20your%20Solution.%0A-%20**Item%20related**%3A%20Those%20channels%20are%20related%20to%20a%20specific%20Container.%20When%20subscribed%2C%20you%20will%20receive%20events%20related%0A%20to%20item%20changes%20in%20a%20given%20Container.%0A%0APrivMX%20Endpoint%20provides%20subscribing%20methods%20for%20each%20Container.%0A%0A%23%23%20Types%20of%20Events%0A%0AEvery%20change%20in%20PrivMX%20corresponds%20to%20a%20specific%20event%20type.%20Event%20names%20follow%20common%20schema%3A%0A%0AExample%20Container%20events%3A%0A%0A-%20%60Created%60%20-%20triggers%20when%20a%20new%20Container%20is%20created%20in%20your%20Context%0A-%20%60Deleted%60%20-%20triggers%20when%20a%20Container%20is%20deleted%20from%20your%20Context%0A-%20%60Updated%60%20-%20triggers%20when%20a%20Container%20is%20updated%20in%20your%20Context%0A-%20%60Stats%20Changed%60%20-%20triggers%20when%20a%20Container%20is%20updated%20in%20your%20Context%0A%0AExample%20Item%20events%3A%0A%0A-%20%60Created%60%20-%20triggers%20when%20an%20item%20is%20sent%20to%20a%20Container%0A-%20%60Deleted%60%20-%20triggers%20when%20an%20item%20is%20deleted%20from%20a%20Container%0A-%20%60Updated%60%20-%20triggers%20when%20an%20item%20is%20deleted%20from%20a%20Container%0A%0A%23%23%23%20Examples%0A%0A-%20Inboxes%20have%20an%20%60inboxEntryCreated%60%20event%20triggered%20when%20an%20entry%20is%20sent%20to%20an%20Inbox.%0A-%20Stores%20have%20a%20%60storeCreated%60%20event%20triggered%20when%20new%20Store%20is%20created%20in%20Context.%0A%0APrivMX%20Endpoint%20provides%20methods%20in%20each%20Container's%20API%20for%20subscribing%20to%20these%20channels.%0AYou%20can%20refer%20to%20platform-specific%20documentation%20on%20how%20to%20subscribe%20for%20necessary%20channels.%0A%0A%23%23%20Structure%0A%0AThe%20main%20strength%20of%20events%20is%20that%20they%20contain%20data%20related%20to%20the%20occurred%20changes.%0AEach%20Event%20related%20to%20a%20Container%20has%20the%20following%20format%3A%0A%0A%7C%20**Field**%20%7C%20**Type**%20%7C%20**Description**%20%7C%0A%7C%20------------%20%7C%20--------%20%7C%20---------------------------------------------------------------------%20%7C%0A%7C%20channel%20%7C%20%60string%60%20%7C%20Name%20of%20channel%20related%20to%20this%20event%20%7C%0A%7C%20connectionId%20%7C%20%60string%60%20%7C%20ID%20of%20one%20of%20your%20current%20connections%20%7C%0A%7C%20type%20%7C%20%60string%60%20%7C%20Type%20of%20received%20event%20e.g.%2C%20%60%22storeCreated%22%60%20or%20%60%22threadNewMessage%22%60%20%7C%0A%7C%20data%20%7C%20%60T%60%20%7C%20%60T%60%20depends%20on%20%60type%60%20of%20event%20and%20contains%20new%2Fupdated%20data%20%7C%0A%0ABecause%20events%20are%20triggered%20after%20every%20change%2C%20you%20don't%20have%20to%20constantly%20refetch%20all%20data.%0AA%20good%20practice%20is%20to%20fetch%20data%20on%20initial%20user%20entry%20and%20only%20modify%20your%20existing%20data%20based%20on%20received%20event.%0A%0A%23%23%20Next%20Steps%0A%0AFor%20more%20details%2C%20refer%20to%20each%20Container's%20specific%20documentation%3A%0A%0A-%20%5BThread%20Events%5D(..%2Fstart%2Fthreads%2Fthread-events)%0A-%20%5BStore%20Events%5D(..%2Fstart%2Fstores%2Fstore-events)%0A-%20%5BInbox%20Events%5D(..%2Fstart%2Finboxes%2Finbox-events)%0A-%20%5BKVDB%20Events%5D(..%2Fstart%2Fkvdbs%2Fkvdb-events)%0A%0A%2C---%0Atitle%3A%20Public%2FPrivate%20Meta%0A---%0A%0AIn%20PrivMX%2C%20you%20create%20apps%20using%20Containers.%20Containers%20are%20a%20collection%20of%20versatile%20building%20blocks%20that%20can%20be%20used%20to%20implement%0Aanything%20from%20a%20basic%20chat%20to%20an%20encrypted%20file%20storage.%0AContainers%20can%20contain%20items%3B%20for%20instance%2C%20in%20the%20Threads%20Container%2C%20these%20items%20are%20messages.%0ABoth%20Containers%20and%20items%20have%20two%20common%20fields%20%60publicMeta%60%20and%20%60privateMeta%60%3A%0A%0A%7C%20**Field**%20%7C%20**Encrypted**%20%7C%20**Format**%20%7C%20**Description**%20%7C%0A%7C--------------%7C---------------%7C--------------%7C---------------------------------------------------------------------%7C%0A%7C%20Private%20Meta%20%7C%20Yes%20%7C%20Binary%20Array%20%7C%20Can%20be%20read%20only%20by%20Container%20members.%20%7C%0A%7C%20Public%20Meta%20%7C%20No%20%7C%20Binary%20Array%20%7C%20Can%20be%20fetched%20and%20queried%20using%20PrivMX%20Bridge%20API%20and%20be%20readable%20by%20all%20members.%20%7C%0A%0A%0A%23%23%20Defining%20Structure%0ABoth%20private%20and%20public%20meta%20is%20sent%20as%20a%20binary%20array.%0AThis%20makes%20the%20fields%20very%20versatile%2C%20both%20in%20terms%20of%20the%20format%20they%20use%20and%20the%20structure%20they%20contain.%0A%0AContainer's%20architecture%20does%20not%20require%20you%20to%20use%20a%20specific%20data%20structure%20inside%20the%20public%20and%20private%20meta.%0ASo%20before%20working%20with%20a%20Container%2C%20define%20what%20kind%20of%20info%20you%20will%20need%20in%20your%20application.%0A%0ALet's%20say%20you%20want%20to%20assign%20name%20to%20your%20Container.%0AYou%20may%20decide%20to%20put%20the%20name%20in%20%60publicMeta%60%20if%20it%20doesn't%20contain%20sensitive%20data%2C%0Aor%20you%20will%20need%20to%20download%20or%20query%20it%20on%20the%20server.%0AIn%20case%20the%20name%20contains%20sensitive%20user%20data%2C%20a%20better%20choice%20is%20to%20place%20it%20in%20%60privateMeta%60%2C%0Aso%20that%20it%20will%20be%20encrypted%20before%20sending.%0A%0AThis%20will%20greatly%20increase%20the%20security%20of%20your%20application%20at%20the%20cost%0Aof%20your%20application%20server%20not%20having%20access%20to%20this%20data.%0A%0A%23%23%20Serializing%20Data%0AThe%20easiest%20and%20most%20common%20format%20for%20serialization%20is%20JSON.%0AAll%20modern%20languages%20have%20a%20way%20to%20serialize%20key-value%20data%20structures%20to%20a%20JSON%20string%20and%20from%20string%20to%20a%20binary%20array.%0A%0AFollowing%20the%20previous%20example%20we%20can%20define%20simple%20structure%20with%20%60name%60%20property.%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20std%3A%3Astring%20publicMeta%20%3D%20%22%7B%5C%22name%5C%22%3A%20%5C%22NAME_OF_YOUR_CONTAINER%5C%22%7D%22%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20publicMeta%20%3D%20%7B%0A%20name%3A%20NAME_OF_YOUR_CONTAINER%0A%20%7D%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0ASerialize%20it%20to%20binary%20array%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20std%3A%3Astring%20publicMeta%20%3D%20%22%7B%5C%22name%5C%22%3A%20%5C%22NAME_OF_YOUR_CONTAINER%5C%22%7D%22%3B%0A%20core%3A%3ABuffer%20serialized%20%3D%20core%3A%3ABuffer%3A%3Aform(publicMeta)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20publicMeta%20%3D%20%7B%0A%20name%3A%20NAME_OF_YOUR_CONTAINER%0A%20%7D%0A%20const%20encoder%20%3D%20new%20TextEncoder()%0A%20const%20serialized%20%3D%20encoder.encode(JSON.stringify(publicMeta))%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0AYou%20can%20now%20pass%20it%20while%20creating%20your%20Container%2C%20e.g.%2C%20Thread%3A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20std%3A%3Astring%20publicMeta%20%3D%20%22%7B%5C%22name%5C%22%3A%20%5C%22NAME_OF_YOUR_CONTAINER%5C%22%7D%22%3B%0A%20core%3A%3ABuffer%20serialized%20%3D%20core%3A%3ABuffer%3A%3Aform(publicMeta)%3B%0A%20threadApi.createThread(%0A%20CONTEXT_ID%2C%0A%20%7BTHREAD_MEMBERS%7D%2C%0A%20%7BTHREAD_MANAGERS%7D%2C%0A%20serialized%2C%0A%20core%3A%3ABuffer()%20%2F%2F%20this%20thread%20doesn't%20have%20privateMeta%20so%20we%20pass%20empty%20core%3A%3ABuffer%0A%20)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20publicMeta%20%3D%20%7B%0A%20name%3A%20NAME_OF_YOUR_CONTAINER%0A%20%7D%0A%20const%20encoder%20%3D%20new%20TextEncoder()%0A%20const%20serialized%20%3D%20encoder.encode(JSON.stringify(publicMeta))%0A%0A%20await%20threadApi.createThread(%0A%20CONTEXT_ID%2C%0A%20%5BTHREAD_MEMBERS%5D%2C%0A%20%5BTHREAD_MANAGERS%5D%2C%0A%20serialized%2C%0A%20new%20Uint8Array()%20%2F%2F%20this%20thread%20doesn't%20have%20privateMeta%20so%20we%20pass%20empty%20Uint8Array%0A%20)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0ARemember%20that%20it%20is%20only%20an%20example%20and%20you%20should%20always%20consider%20your%20app's%20requirements%20and%20limitations.%0A%0A%23%23%20Querying%20by%20Public%20Meta%0A%0ATo%20query%20%60publicMeta%60%2C%20the%20data%20uploaded%20to%20the%20server%20must%20be%20serialized%20as%20JSON%20so%20that%20the%20server%20can%20read%20it.%0ANext%20you%20can%20use%20list%20functions%20and%20PagingQuery%20to%20query%20by%20fields%20from%20publicMeta.%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20core%3A%3APagingQuery%20query%20%3D%20core%3A%3APagingQuery%7B%0A%20.skip%3D0%2C%0A%20.limit%3D100%2C%0A%20.sortOrder%3D%22desc%22%2C%0A%20.queryAsJson%3D%22%7B%5C%22name%5C%22%3A%5C%22NAME_OF_YOUR_CONTAINER%5C%22%7D%22%0A%20%7D%3B%0A%20auto%20listThreads%20%3D%20threadApi-%3ElistThreads(%0A%20CONTEXT_ID%2C%0A%20query%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20query%20%3D%20%7B%0A%20name%3A%20NAME_OF_YOUR_CONTAINER%0A%20%7D%0A%20const%20queryAsJson%20%3D%20JSON.stringify(publicMeta)%0A%0A%20auto%20listThreads%20%3D%20await%20threadApi.listThreads(%0A%20CONTEXT_ID%2C%0A%20%7Bskip%3A%200%2C%20limit%3A%201%2C%20sortOrder%3A%20%22desc%22%2C%20queryAsJson%3A%20queryAsJson%7D%0A%20)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Good%20Practices%0A%0AWe%20recommend%20future-proofing%20your%20meta%20right%20from%20the%20start.%0A%0A%23%23%23%20Using%20Easily%20Modifiable%20Format%0AWhile%20it's%20possible%20to%20pass%20plain%20text%20or%20a%20number%20(encoded%20to%20a%20binary%20array)%2C%20it's%20advised%20to%20use%0Asomething%20like%20JSON%20or%20other%20key-value%20format.%0AIn%20case%20of%20changes%20in%20app%20requirements%2C%20it%20is%20easier%20to%20add%20or%20remove%20a%20field%20than%20change%20an%20entire%20type%0Aof%20field.%0A%0A%60%60%60json%20title%3D%22Bad%20practice%22%0A%2F%2F%20rest%20of%20container%20fields%0ApublicMeta%3A%22published%22%0A%60%60%60%0A%0A%60%60%60json%20title%3D%22Good%20practice%22%0A%2F%2F%20rest%20of%20container%20fields%0ApublicMeta%3A%7B%0A%20status%3A%22published%22%0A%7D%0A%60%60%60%0A%0A%23%23%23%20Adding%20Schema%20Version%0AThis%20simplifies%20adding%20support%20for%20backwards%20compatibility.%20Versions%20can%20have%20different%20fields%20or%20may%20introduce%0Achanges%20in%20field%20types.%0A%0A%60%60%60json%20title%3D%22Good%20practice%22%0A%2F%2F%20rest%20of%20container%20fields%0ApublicMeta%3A%7B%0A%20_ver%3A%202%20%2F%2F%20%5B!code%20highlight%5D%0A%20status%3A%22published%22%0A%7D%0A%60%60%60%0A%0A%2C---%0Atitle%3A%20Quick%20Start%0A---%0APrivMX%20is%20a%20**Zero-Knowledge%20software**%20%E2%80%93%20it%20has%20no%20possibility%20of%20reading%20(decrypting)%20data%20it%20transmits%20and%20stores.%0A%0APrivMX%20Bridge%20is%20a%20server-side%2C%20zero-knowledge%20software%20that%20intermediates%20in%20the%20transfer%20of%20encrypted%20data%20and%20notifications.%0A%0A**User%E2%80%99s%20registration%20in%20PrivMX%20Bridge%20Contexts%20only%20requires%20providing%20user%E2%80%99s%20public%20key%20and%20any%20textual%20%60userId%60%20assigned%20by%20the%20application.**%0AAs%20a%20result%2C%20PrivMX%20communication%20channels%20can%20be%20easily%20used%20in%20existing%20applications%2C%20with%20no%20necessary%20changes%20to%20the%20authorization%20system%20currently%20in%20use.%0A%0A%23%23%20Installation%0A%3A%3A%3Atip%0A%0ABefore%20you%20start%2C%20make%20sure%20you%20have%20Docker%20installed%20on%20your%20machine.%20If%20you%20don't%20have%20it%20yet%2C%20you%20can%20download%20it%20from%20%5BDocker's%20official%20website%5D(https%3A%2F%2Fwww.docker.com%2Fget-started).%0AYou%20might%20also%20want%20to%20use%20PrivMX%20Bridge%20in%20non%20dockerized%20version%2C%20which%20requires%20more%20configuration%20and%20is%20recommended%20for%20advanced%20users.%20In%20that%20case%2C%20please%20refer%20to%20PrivMX%20Bridge%20%5BGitHub%20repository%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-bridge)%0A%0A%3A%3A%3A%0A%0ATo%20install%20PrivMX%20Bridge%20on%20your%20machine%20you%20can%20use%20our%20CLI.%0A%0A1.%20Clone%20Bridge%20CLI%0A%20%60%60%60shell%0A%20git%20clone%20https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-bridge-docker%0A%20%60%60%60%0A2.%20Run%20setup%20script%0A%20%60%60%60shell%0A%20.%2Fsetup.sh%0A%20%60%60%60%0A%20This%20will%20fetch%20the%20necessary%20Docker%20images%2C%20create%20Access%20Keys%20and%20your%20first%20Context.%20After%20a%20successful%20setup%2C%20CLI%0A%20will%0A%20display%20all%20the%20API%20keys%20necessary%20for%20connection.%20%3Cbr%2F%3E%0A%0A%23%23%23%20Registering%20First%20Users%20(optionally)%0A%0AYou%20can%20create%20first%20two%20users%20using%20provided%20CLI.%20This%20can%20come%20in%20handy%20if%20you%20just%20want%20to%20test%20PrivMX%20in%20one%20of%20our%20example%20projects.%0A%0A1.%20Generate%20keys%0A%20In%20your%20terminal%2C%20generate%20private-public%20key%20pair%20for%20your%20user.%20The%20keys%20must%20be%20in%20WIF%20format%0A%20To%20learn%20more%20about%20private%20and%20public%20keys%2C%20browse%20our%20%5Bdedicated%20section%5D(..%2Fstart%2Fgenerating-keys)%0A%20%60%60%60shell%0A%20.%2FgenKeyPair.sh%0A%20%60%60%60%0A2.%20Register%20user%0A%0A%20With%20the%20keys%20ready%2C%20register%20%60userId%60%20-%20public%20key%20pair%20in%20your%20Context.%20Don't%20forget%20to%20replace%20placeholder%20values%0A%20with%20the%20ones%20created%20earlier%3A%0A%20%60%60%60shell%0A%20.%2Fcli.sh%20context%2FaddUserToContext%20'%7B%22contextId%22%3A%20%22CONTEXT_ID%22%2C%20%22userId%22%3A%22USER_ID%22%2C%20%22userPubKey%22%3A%22USER_PUBLIC_KEY%22%20%7D'%0A%20%60%60%60%0A%23%23%23%20After%20Installing%0A%0AAfter%20you've%20successfully%20installed%20a%20PrivMX%20Bridge%20instance%2C%20browse%20our%20SDKs%20and%20APIs%20to%20learn%20what%20you%20can%20do%20next%3A%0A%20-%20%5BC%2B%2B%5D(..%2Fcpp%2Fintroduction)%0A%20-%20%5BJavaScript%5D(..%2Fjs%2Fintroduction)%0A%20-%20%5BJava%5D(..%2Fjava%2Fgetting-started)%0A%20-%20%5BKotlin%5D(..%2Fkotlin%2Fintroduction)%0A%20-%20%5BSwift%5D(..%2Fswift%2Fgetting-started)%0A%20-%20%5BC%23%5D(..%2Fcsharp%2Fintroduction)%0A%20-%20%5BAPI%20Reference%5D(..%2Fstart%2Fapi-reference)%2C---%0Atitle%3A%20Generating%20Keys%0Ahide_table_of_contents%3A%20false%0A---%0A%0APrivMX%20Endpoint%20supports%20**Wallet%20Import%20Format%20(WIF)**%20keys%20by%20default%20and%20offers%20tools%20such%20as%20converting%20PEM%20keys%20(OpenSSL)%20and%20deterministic%20private%20key%20generation%20from%20any%20text%2C%20such%20as%20a%20user's%20password%20or%20a%20given%20file.%0A%0A%3A%3A%3Awarning%0A%0A**Private%20keys%20should%20always%20be%20known%20only%20to%20their%20owners.**%0AGenerate%20them%20client-side%20and%20don't%20save%20them%20anywhere.%0AThis%20practice%20ensures%20that%20only%20the%20rightful%20owner%20has%20access%20to%20their%20private%20keys%2C%20significantly%20reducing%20the%20risk%20of%20unauthorized%20access%20or%20theft.%0A%0A%3A%3A%3A%0A%0A%5BFind%20out%20more%20about%20keys%20in%20Encryption%5D(..%2Fstart%2Fencryption%23users-keys)%0A%0A%23%23%23%20Generating%20Keys%20for%20PrivMX%0A%3CTabs%20items%3D%7B%5B%22With%20PrivMX%20Bridge%22%2C%22Python%22%2C%22C%2B%2B%22%5D%7D%3E%0A%20%3CTab%3E%0A%20The%20PrivMX%20Bridge%20Docker%20repo%20contains%20helper%20scripts%20for%20generating%20keys.%0A%20Clone%20it%20by%20running%20following%20script%20in%20your%20favorite%20terminal%0A%20%60%60%60shell%0A%20git%20clone%20https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-bridge-docker%0A%20%60%60%60%0A%20and%20go%20to%20created%20%60%22privmx-bridge-docker%22%60%20folder.%0A%0A%20Scripts%20require%20active%20running%20PrivMX%20Bridge%20docker%20container.%20You%20can%20run%20it%20using%3A%0A%20%60%60%60shell%0A%20.%2Fsetup.sh%0A%20%60%60%60%0A%20or%20if%20you%20already%20started%20created%20one%20earlier%3A%0A%0A%20%60%60%60shell%0A%20docker%20compose%20-f%20docker-compose.yaml%20up%0A%20%60%60%60%0A%0A%20You%20can%20generate%20Endpoint%20compatible%20key%20pair%20using%20following%20script.%0A%20%60%60%60shell%0A%20.%2FgenKeyPair.sh%0A%20%60%60%60%0A%20Generated%20keys%20will%20be%20displayed%20in%20your%20terminal.%20They%20aren't%20stored%20anywhere%2C%20so%20make%20sure%20to%20copy%20them.%0A%0A%20In%20Windows%20environment%20you%20must%20use%20bash%20compatible%20terminal%20like%20WSL%20or%20Git%20Bash.%0A%0A%20You%20must%20register%20**public%20key**%20in%20PrivMX%20Bridge%20first%2C%20before%20using%20it's%20matching%20**private%20key**%20in%20PrivMX%20Endpoint.%0A%20To%20do%20this%20you%20can%20use%20%5B%60context%2FaddUserToContext%60%5D(https%3A%2F%2Fbridge.privmx.dev%2F%23context-addusertocontext)%20PrivMX%20Bridge%20method.%0A%0A%20%3C%2FTab%3E%0A%20%3CTab%20%3E%0A%0A%20Example%20snippet%20for%20generating%20a%20pair%20of%20keys%20in%20Python%3A%0A%0A%20%60%60%60python%0A%20import%20hashlib%0A%20import%20base58%0A%20import%20ecdsa%0A%20import%20os%0A%0A%0A%20def%20generate_wif_public_key(hex_public_key)%3A%0A%20extended_key%20%3D%20bytes.fromhex(hex_public_key)%0A%20checksum%20%3D%20hashlib.sha256(hashlib.sha256(extended_key).digest()).digest()%5B%3A4%5D%0A%20wif_key%20%3D%20extended_key%20%2B%20checksum%0A%20wif_encoded%20%3D%20base58.b58encode(wif_key).decode('utf-8')%0A%20return%20wif_encoded%0A%0A%20def%20generate_wif_private_key(hex_private_key%2C%20testnet%3DFalse)%3A%0A%20prefix_byte%20%3D%20b'%5Cxef'%20if%20testnet%20else%20b'%5Cx80'%0A%20extended_key%20%3D%20prefix_byte%20%2B%20bytes.fromhex(hex_private_key)%0A%20checksum%20%3D%20hashlib.sha256(hashlib.sha256(extended_key).digest()).digest()%5B%3A4%5D%0A%20wif_key%20%3D%20extended_key%20%2B%20checksum%0A%20wif_encoded%20%3D%20base58.b58encode(wif_key).decode('utf-8')%0A%20return%20wif_encoded%0A%0A%20def%20generate_public_key(hex_private_key)%3A%0A%20sk%20%3D%20ecdsa.SigningKey.from_string(bytes.fromhex(hex_private_key)%2C%20curve%3Decdsa.SECP256k1)%0A%20vk%20%3D%20sk.get_verifying_key()%0A%20public_key%20%3D%20vk.to_string(%22compressed%22).hex()%0A%20return%20public_key%0A%0A%0A%20print(f%22Generating%2032bit%20hex%20with%20openssl%22)%0A%20output%20%3D%20os.popen(%22openssl%20rand%20-hex%2032%22).read()%0A%20hex_private_key%20%3D%20output.rstrip()%0A%0A%0A%20print(f%22Private%20Key%3A%20%7Bhex_private_key%7D%22)%0A%20wif_private_key%20%3D%20generate_wif_private_key(hex_private_key)%0A%20hex_public_key%20%3D%20generate_public_key(hex_private_key)%0A%20wif_public_key%20%3D%20generate_wif_public_key(hex_public_key)%0A%20print(f%22Private%20Key%20in%20WIF%20format%3A%20%7Bwif_private_key%7D%22)%0A%20print(f%22Public%20Key%3A%20%7Bhex_public_key%7D%22)%0A%20print(f%22Public%20Key%20in%20WIF%20format%3A%20%7Bwif_public_key%7D%22)%0A%20%60%60%60%0A%0A%20How%20to%20run%3A%0A%0A%20%60%60%60python%0A%20pup%20install%20base58%0A%20pip%20install%20ends%0A%20python%20generate.py%0A%20%60%60%60%0A%0A%20%3C%2FTab%3E%0A%20%3CTab%20%3E%0A%20Example%20snippet%20for%20generating%20a%20pair%20of%20keys%20in%20C%2B%2B%2C%20using%20PrivMX%20Endpoint%20Library%3A%0A%0A%20%60%60%60cpp%0A%20%23include%20%3Coptional%3E%0A%20%23include%20%3Ciostream%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fcrypto%2FCryptoApi.hpp%3E%0A%0A%20using%20namespace%20privmx%3A%3Aendpoint%3A%3Acrypto%3B%0A%20int%20main()%20%7B%0A%20auto%20cryptoApi%20%7BCryptoApi%3A%3Acreate()%7D%3B%0A%20auto%20priv%20%7BcryptoApi.generatePrivateKey(std%3A%3Anullopt)%7D%3B%0A%20auto%20pub%20%7BcryptoApi.derivePublicKey(priv)%7D%3B%0A%20std%3A%3Acout%20%3C%3C%20%22Generated%20private%20key%3A%20%22%20%3C%3C%20priv%20%3C%3C%20std%3A%3Aendl%0A%20%3C%3C%20%22Generated%20public%20key%3A%20%22%20%3C%3C%20pub%20%3C%3C%20std%3A%3Aendl%3B%0A%20return%200%3B%0A%20%7D%0A%20%60%60%60%0A%20A%20full%20code%20example%20can%20be%20found%20on%20%5BSimplito's%20GitHub%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint%2Ftree%2Fmain%2Fexamples%2FCryptoSample).%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0A%0A%2C---%0Atitle%3A%20Queries%20Pagination%0A---%0A%0A%3CCallout%20type%3D%7B%22warn%22%7D%3E%0A%20General%20documentation%20for%20queries%20pagination%20is%20work%20in%20progress.%0A%3C%2FCallout%3E%0A%2C---%0Atitle%3A%20Welcome%20to%20PrivMX%20Docs%0Adescription%3A%20PrivMX%20allows%20developers%20to%20build%20end-to-end%20encrypted%20apps%20used%20for%20communication%20in%20any%20environment.%0A---%0A%0A%23%23%20Client%20Libraries%0APrivMX%20Client%20libraries%20allow%20developers%20to%20implement%20PrivMX%20functionalities%20using%20various%20programming%20languages%20and%20popular%20frameworks.%0A%0A%3CCards%3E%0A%20%3CCard%20href%3D%7B'.%2Fcpp%2Fintroduction'%7D%20title%3D%7B'C%2B%2B'%7D%20icon%3D%7B%3CIcon%20icon%3D%7B'cpp'%7D%2F%3E%20%7D%20%2F%3E%0A%20%3CCard%20href%3D%7B'.%2Fjs%2Fintroduction'%7D%20title%3D%7B'JavaScript'%7D%20icon%3D%7B%3CIcon%20icon%3D%7B'js'%7D%2F%3E%20%7D%2F%3E%0A%20%3CCard%20href%3D%7B'.%2Fjava%2Fgetting-started'%7D%20title%3D%7B'Java%2FKotlin'%7D%20icon%3D%7B%3CIcon%20icon%3D%7B'java'%7D%2F%3E%20%7D%2F%3E%0A%20%3CCard%20href%3D%7B'.%2Fkotlin%2Fgetting-started'%7D%20title%3D%7B'Kotlin'%7D%20icon%3D%7B%3CIcon%20icon%3D%7B'kotlin'%7D%2F%3E%20%7D%2F%3E%0A%20%3CCard%20href%3D%7B'.%2Fswift%2Fgetting-started'%7D%20title%3D%7B'Swift'%7D%20icon%3D%7B%3CIcon%20icon%3D%7B'swift'%7D%2F%3E%20%7D%2F%3E%0A%20%3CCard%20href%3D%7B'.%2Fcsharp%2Fintroduction'%7D%20title%3D%7B'C%23'%7D%20icon%3D%7B%3CIcon%20icon%3D%7B'csharp'%7D%2F%3E%20%7D%2F%3E%0A%0A%3C%2FCards%3E%0A%0A%23%23%20Containers%0APrivMX%20enables%20communication%20through%20**text%20messages**%2C%20**secure%20file%20storage**%20and%20**real-time%20data%20streaming**.%20**PrivMX%20Containers**%20are%20sets%20of%20APIs%20designed%20to%20setup%20your%20app%20for%20specific%20types%20of%20communication.%0A%0A%3CCards%3E%0A%20%3CCard%20href%3D%7B'.%2Fstart%2Fthreads%2Foverview'%7D%20title%3D%7B'Thread'%7D%0A%20description%3D%7B%22Sending%20messages%20of%20various%20formats%2C%20between%20authorized%20users%20or%20devices.%20%22%7D%20icon%3D%7B%3CIcon%20icon%3D%7B'threads'%7D%2F%3E%20%7D%2F%3E%0A%20%3CCard%20href%3D%7B'.%2Fstart%2Fstores%2Foverview'%7D%20title%3D%7B'Store'%7D%0A%20description%3D%7B%22Storing%20different%20types%20of%20data%20and%20files%20and%20sharing%20them%20with%20authorized%20users%20or%20devices.%20%22%7D%20icon%3D%7B%3CIcon%20icon%3D%7B'stores'%7D%2F%3E%20%7D%2F%3E%0A%20%3CCard%20href%3D%7B'.%2Fstart%2Finboxes%2Foverview'%7D%20title%3D%7B'Inbox'%7D%0A%20description%3D%7B%22One%20way%20communication%20with%20external%20users.%22%7D%20icon%3D%7B%3CIcon%20icon%3D%7B'inboxes'%7D%2F%3E%20%7D%2F%3E%0A%20%3CCard%20href%3D%7B'.%2Fstart%2Fkvdbs%2Foverview'%7D%20title%3D%7B'KVDB'%7D%20%0A%20description%3D%7B%22Encrypted%20key-value%20databases.%22%7D%20icon%3D%7B%3CIcon%20icon%3D%7B'kvdb'%7D%2F%3E%20%7D%2F%3E%0A%3C%2FCards%3E%0A%2C---%0Atitle%3A%20Overview%0Adescription%3A%20KVDBs%20provide%20encrypted%20key-value%20databases.%0A---%0A%0AUsers%20create%20KVDBs%20to%20organize%20collections%20where%20they%20can%20securely%20**exchange%20encrypted%20data**%20with%20designated%20participants.%0AAll%20the%20active%20users%20are%20**notified**%20right%20away%20when%20a%20new%20entry%20arrives%2C%20is%20modified%2C%20or%20anything%20within%20the%20KVDB%20changes.%20%0A%0AAll%20the%20data%20is%20stored%20in%20%5BPrivMX%20Bridge%5D(..%2Fprivmx-bridge)%20and%20can%20be%20freely%20shared%20between%20its%20users.%0A%0A%23%23%20Prerequisites%0A%0ABefore%20working%20with%20KVDBs%2C%20you%20need%20to%20have%20a%20PrivMX%20Bridge%20instance.%0A%0ATo%20install%20it%2C%20%5Bfollow%20PrivMX%20quick%20start%20guide%5D(..%2Fquick-start).%0A%0A%23%23%20Architecture%0A%0AThink%20of%20a%20KVDB%20as%20a%20simple%20key-value%20database%20that%20allows%20you%20to%20**publish%20entries%2C%20which%20can%20include%20any%20binary%20as%20well%20as%20metadata.**%0AEach%20KVDB%20has%20its%20own%20set%20of%20permissions%2C%20managed%20by%20assigning%20the%20users%E2%80%99%20public%20keys%20to%20the%20KVDB.%20**Only%20the%20users%20with%20assigned%20public%20keys%20can%20read%20the%20entries%20posted%20in%20that%20KVDB.**%0ADecryption%20of%20these%20entries%20is%20possible%20only%20with%20the%20corresponding%20private%20keys.%20%0A%0A**Each%20entry%20is%20protected%20by%20a%20synchronous%20key%2C%20which%20is%20further%20secured%20using%20an%20asynchronous%20pair%20of%20public%20and%20private%20user%20keys.**%0AThis%20dual-layer%20encryption%20ensures%20that%20the%20system%20remains%20both%20safe%20and%20efficient.%0A%0A%5BLearn%20more%5D(.%2Fencryption)%20about%20our%20advanced%20encryption%20methods%20and%20how%20they%20safeguard%20your%20entries.%0A%0A%23%23%20Entries%20in%20KVDBs%0A%0AThe%20main%20data%20units%20in%20KVDBs%20are%20entries%2C%20which%20contain%20binary%20%60data%60%2C%20as%20well%20as%20metadata.%0A%0A-%20%60privateMeta%60%20-%20encrypted%20data%20about%20the%20entry%0A-%20%60publicMeta%60%20-%20**decrypted**%20additional%20data%20about%20the%20entry%2C%20with%20can%20be%20used%20ro%20advanced%20queries%0A%0AEach%20entry%20also%20has%20information%20assigned%20by%20the%20Bridge.%0A%0ATo%20learn%20more%20about%20entries%2C%20go%20to%20%5BManaging%20Entries%5D(.%2Fentries).%0A%0A%23%23%20Encryption%0A%0AEach%20entry%20is%20protected%20by%20a%20synchronous%20key%2C%20which%20is%20further%20secured%20using%20an%20asynchronous%20pair%20of%20public%20and%20private%20user%20keys.%20%0AThis%20dual-layer%20encryption%20ensures%20that%20the%20system%20remains%20both%20safe%20and%20efficient.%0A%0AOnly%20an%20end%20user%20can%20create%20a%20KVDB%2C%20by%20providing%20a%20set%20of%20public%20keys%20for%20the%20users%20who%20should%20have%20access%20to%20the%20KVDB.%0A%0AA%20symmetric%20key%20for%20the%20KVDB%20(KVDB%20Encryption%20Key)%20is%20then%20**generated%20by%20the%20KVDB%20author**%20and%20securely%20stored%20on%20the%20server%2C%20encrypted%20using%20public%20keys%20of%20**users%20assigned%20to%20the%20KVDB**.%20%0AThis%20ensures%20that%20only%20the%20authorized%20users%20have%20access%20to%20the%20KVDB's%20Encryption%20Key.%20**Unencrypted%20keys%20never%20leave%20User%20Endpoints.**%0A%0AWhen%20accessing%20a%20KVDB%2C%20the%20encrypted%20KVDB%20Encryption%20Key%20is%20sent%20to%20each%20user%20based%20on%20their%20assignment%20to%20the%20KVDB.%20Only%20the%20users%20with%20proper%20Private%20Keys%20can%20decrypt%20KVDB%20Encryption%20Key.%20%0AUsing%20the%20decrypted%20key%2C%20entries%20are%20encrypted%20and%20signed%20with%20the%20users%E2%80%99%20Private%20Keys%20before%20being%20sent%20to%20PrivMX%20Bridge.%20%0A%0AThis%20process%20is%20handled%20by%20PrivMX%20Endpoint%20and%20is%20completely%20seamless%20for%20the%20users.%0A%0A%23%23%20Examples%0A%0A-%20Simple%2C%20minimal%20examples%0A%20A%20set%20of%20short%20code%20snippets%20showing%20you%20how%20to%20start%20interacting%20with%20PrivMX%20Endpoint%20Library.%0A%0A%20%5BGithub%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint%2Ftree%2Fdevel%2Fexamples%2Fusing_Kvdb)%2C---%0Atitle%3A%20Managing%20Entries%0Adescription%3A%20The%20structure%20of%20entries%2C%20how%20to%20send%20them%2C%20and%20good%20practices%20when%20working%20with%20KVDBs.%0A---%0A%0A%23%23%20About%20Entries%0A%0AThe%20structure%20of%20an%20entry%20and%20a%20brief%20description%20of%20its%20elements%20is%20outlined%20in%20the%20following%20table%3A%0A%7C**Field**%7C**Type**%7C**Encrypted**%7C**Description**%7C%0A%7C---%7C---%7C---%7C---%7C%0A%7C%60data%60%7Cbinary%7Cyes%7Ccontent%20of%20the%20entry%0A%7C%60info%60%7CServerKvdbEntryInfo%7Cno%7Cadditional%20information%20assigned%20by%20the%20server%20e.g.%20author%2C%20%60creationDate%60%2C%20%60key%60%20and%20%60kvdbID%60%0A%7C%60privateMeta%60%7Cbinary%7Cyes%7Cadditional%20information%20about%20the%20entry%0A%7C%60publicMeta%60%7Cbinary%7Cno%7Cadditional%20public%20information%20about%20the%20entry%2C%20also%20accessible%20through%20PrivMX%20Bridge%20API%0A%0A%23%23%20Define%20Structure%0A%0AKVDB's%20architecture%20does%20not%20require%20you%20to%20use%20a%20specific%20data%20structure%20inside%20the%20entry.%0ASo%20before%20working%20with%20KVDBs%2C%20define%20what%20what%20kind%20of%20entries%20you%20want%20to%20send.%0A%0AWe%20recommend%20future-proofing%20your%20entries%20right%20from%20the%20start%2C%20i.e.%20choosing%20an%20easily%20modifiable%20format.%0A%0AIt%20is%20also%20a%20good%20idea%20to%20include%20its%20type%20and%20version%20in%20the%20structure%20of%20the%20entries.%0A%0AHere%20is%20an%20example%20entries%20structure%20that%20you%20can%20use%20in%20your%20project.%0A%0A%60%60%60%20json%20title%3D%22JSON%22%0A%7B%0A%20%E2%80%9Cdata%E2%80%9D%3A%7B%0A%20%E2%80%9Ccontent%E2%80%9D%3A%20%22string%22%2C%20%2F%2F%20string%20%2F%20binary%20data%20containing%20for%20example%3A%20markdown%2C%20html%20or%20json%0A%20%7D%2C%0A%20%E2%80%9Cinfo%E2%80%9D%3A%20%22ServerKvdbEntryInfo%22%2C%20%2F%2F%20assigned%20by%20server%2C%0A%20%E2%80%9CpublicMeta%E2%80%9D%3A%7B%0A%20%E2%80%9Cversion%E2%80%9D%3Anumber%2C%0A%20%E2%80%9Ctype%E2%80%9D%3A%20%E2%80%9Ctext%E2%80%9D%2C%20%2F%2F%20some%20kind%20of%20enum%20describing%20type%20of%20entry%20like%20%E2%80%9Cevent%E2%80%9D%2C%20%E2%80%9Chtml%E2%80%9D%2C%20%E2%80%9Cmarkdown%E2%80%9D%20etc.%0A%20%7D%2C%0A%20%E2%80%9CprivateMeta%E2%80%9D%3A%7B%0A%20%2F%2F%20meta%20fields%0A%20%7D%0A%7D%0A%60%60%60%0ARemember%20that%20it%20is%20only%20an%20example%20and%20you%20should%20consider%20your%20app's%20requirements%20and%20limitations.%0A%0A%23%23%20Sending%0A%0AWith%20the%20structure%20ready%2C%20its%20time%20to%20start%20creating%20entries.%0A%0A%3A%3A%3Ainfo%0A%0ARemember%20that%20before%20creating%20anything%2C%20you%20have%20to%20be%20connected%20to%20PrivMX%20Bridge%20-%20using%20%60connect%60.%0A%0A%3A%3A%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%20%22JavaScript%22%2C%20%22Swift%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20creating%20entry%0A%20std%3A%3Astring%20entryKey%20%7B%22entry%20key%22%7D%3B%0A%20kvdbApi.setEntry(%0A%20kvdbId%2C%20%0A%20entryKey%2C%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20private%20meta-data%22)%2C%0A%20core%3A%3ABuffer%3A%3Afrom(%22entry_data%22)%2C%0A%200%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20creating%20entry%0A%20const%20entryKey%20%3D%20%22entry%20key%22%3B%0A%20await%20kvdbApi.setEntry(%0A%20kvdbId%2C%20%0A%20entryKey%2C%0A%20this.strToUint8(%22some%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(%22some%20private%20meta-data%22)%2C%20%0A%20this.strToUint8(%22entry_data%22)%2C%0A%200%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20%2F%2F%20creating%20Entries%0A%20try%20kvdbApi.setEntry(%0A%20in%3A%20KVDB_ID%2C%0A%20for%3A%20KVDB_ENTRY_KEY%2C%0A%20withPublicMeta%3A%20Data(%22Some%20public%20metadata%22.utf8)%2C%0A%20withPrivateMeta%3A%20Data(%22Some%20private%20metadata%22.utf8)%2C%0A%20containing%3A%20Data(%22Some%20entry%20data%22.utf8))%0A%20%0A%20%2F%2Fupdating%20Entries%0A%20%0A%20try%20kvdbApi.setEntry(%0A%20in%3A%20KVDB_ID%2C%0A%20for%3A%20KVDB_ENTRY_KEY%2C%0A%20atVersion%3A%201%2C%0A%20withPublicMeta%3A%20Data(%22NEW%20PUBLIC%20META%22.utf8)%2C%0A%20withPrivateMeta%3A%20Data(%22NEW%20PRIVATE%20META%22.utf8)%2C%0A%20containing%3A%20Data(%22New%20entry%20data%22.utf8))%0A%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0AAfter%20creating%20the%20entry%2C%20you%20can%20get%20it%20by%20the%20key%20set%20while%20creation.%0A%0AEntry%20Keys%20are%20unique%20within%20a%20KVDB.%0A%0A%23%23%20Listing%20Entries%0A%0AYour%20application%20may%20include%20multiple%20entries%2C%20each%20associated%20with%20different%20KVDBs.%20%0AYou%20can%20retrieve%20a%20**list%20of%20all%20entries%20within%20a%20given%20KVDB.**%20%0A%0AHere's%20an%20example%20of%20how%20to%20download%20the%20last%2030%20entries%20created%20within%20a%20KVDB%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20list%20KVDBs%0A%20core%3A%3APagingQuery%20query%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%2030%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%20%0A%20auto%20result%20%7BkvdbApi.listEntries(KVDB_ID%2C%20query)%7D%3B%0A%20for%20(const%20auto%26%20entry%20%3A%20result.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22KVDB%20entry%20key%3A%20%22%20%3C%3C%20entry.info.key%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20query%3A%20Types.PagingQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%2030%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0A%20const%20result%20%3D%20await%20kvdbApi.listEntries(CONTEXT_ID%2C%20query)%3B%0A%20for%20(const%20entry%20of%20result.readItems)%20%7B%0A%20console.log(%22KVDB%20entry%20key%3A%20%22%2C%20entry.info.key)%3B%0A%20%7D%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0ATo%20limit%20collecting%20too%20much%20data%20when%20downloading%20entries%2C%20specify%20the%20page%20index%20(starting%20from%200)%20and%20the%20number%20of%20items%20to%20be%20included%20on%20each%20page.%0A%0A%23%23%20Modifying%20Entries%0A%0ADepending%20on%20your%20project's%20specification%2C%20it%20may%20be%20necessary%20to%20modify%20an%20entry.%0AIt%20could%20be%20e.g.%20changing%20entry%20data%2C%20publicMeta%2C%20privateMeta.%0AEach%20user%20with%20management%20rights%20is%20able%20to%20modify%20and%20delete%20entries.%0A%0AUpdating%20an%20entry%20means%20overwriting%20it%20with%20the%20provided%20data.%20%0ATo%20successfully%20update%20an%20entry%2C%20you%20must%20be%20entry%20creator%20or%20KVDB%20moderator.%0A%0ABelow%20there%20is%20an%20example%20of%20modifying%20an%20entry%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20auto%20entry%20%7BkvdbApi.getEntry(%0A%20kvdbId%2C%20%0A%20entryKey%0A%20)%7D%3B%20%0A%20kvdbApi.setEntry(%0A%20entry.info.kvdbId%2C%0A%20entry.info.key%2C%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20new%20entry%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20new%20entry%20private%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22entry%20new%20data%22)%2C%0A%20entry.version%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20entry%20%3D%20await%20kvdbApi.getEntry(%0A%20kvdbId%2C%20%0A%20entryKey%0A%20)%3B%20%0A%20await%20kvdbApi.setEntry(%0A%20entry.info.kvdbId%2C%0A%20entry.info.key%2C%0A%20this.strToUint8(%22some%20new%20entry%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(%22some%20new%20entry%20private%20meta-data%22)%2C%20%0A%20this.strToUint8(%22entry%20new%20data%22)%0A%20entry.version%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Deleting%20an%20Entry%0A%0ATo%20successfully%20delete%20an%20entry%2C%20you%20must%20be%20the%20entry%20creator%20or%20a%20KVDB%20moderator.%0A%0ABelow%20there%20is%20an%20example%20of%20deleting%20an%20entry%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20kvdbApi.deleteEntry(kvdbId%2C%20entryKey)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20await%20kvdbApi.deleteEntry(kvdbId%2C%20entryKey)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C---%0Atitle%3A%20KVDB%20Events%0Adescription%3A%20Listening%20for%20events%20related%20to%20KVDBs%20and%20updating%20your%20app's%20state%20accordingly%20will%20allow%20you%20to%20build%20e.g.%2C%20instant%20mapping%20features.%0A---%0A%0A%23%23%20Types%20of%20Events%0AThe%20lists%20below%20outline%20all%20the%20event%20types%20available%20in%20KVDBs%20and%20entries%20in%20PrivMX.%0A%0AKVDB%20events%3A%20%0A-%20%60kvdbCreated%60%20-%20triggers%20when%20a%20new%20KVDB%20is%20created%20in%20your%20Context%0A-%20%60kvdbDeleted%60%20-%20triggers%20when%20a%20KVDB%20is%20deleted%20from%20your%20Context%0A-%20%60kvdbUpdated%60%20-%20triggers%20when%20a%20KVDB%20is%20updated%0A-%20%60kvdbStatsChanged%60%20-%20triggers%20when%20an%20entry%20is%20created%20to%20a%20KVDB%20or%20an%20entry%20has%20been%20deleted%0A%0AEntries%20events%3A%20%0A-%20%60kvdbNewEntry%60%20-%20triggers%20when%20an%20entry%20was%20created%20in%20a%20KVDB%0A-%20%60kvdbEntryDeleted%60%20triggers%20when%20an%20entry%20was%20deleted%20from%20a%20KVDB%0A-%20%60kvdbEntryUpdated%60%20-%20triggers%20when%20an%20entry%20was%20updated%0A%0A%23%23%20Handling%20KVDB%20and%20Entries%20Events%0A%0ABefore%20receiving%20Events%2C%20your%20application%20has%20to%20start%20an%20event%20loop%20and%20subscribe%20to%20a%20specific%20channel.%0AAfterwards%20you%20can%20setup%20a%20listener.%0A%0AHere%20is%20an%20example%20how%20to%20do%20it%20in%20your%20own%20project%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%20%22Swift%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20handle%20events%0A%20core%3A%3AEventQueue%20eventQueue%20%7Bcore%3A%3AEventQueue%3A%3AgetInstance()%7D%3B%0A%20std%3A%3Athread%20t(%5B%26%5D()%7B%0A%20while(true)%20%7B%0A%20core%3A%3AEventHolder%20event%20%3D%20eventQueue.waitEvent()%3B%0A%20std%3A%3Acout%20%3C%3C%20%22onEvent%3A%20%22%20%3C%3C%20event.type()%20%3C%3C%20std%3A%3Aendl%3B%0A%20std%3A%3Acout%20%3C%3C%20event.toJSON()%20%3C%3C%20std%3A%3Aendl%3B%0A%20if(core%3A%3AEvents%3A%3AisLibBreakEvent(event))%20%7B%0A%20%2F%2F%20way%20to%20stop%20Event%20listener%0A%20break%3B%0A%20%7D%0A%20%7D%0A%20%7D)%3B%0A%20t.detach()%3B%0A%20%2F%2F%20subscribe%20for%20KVDBs%20general%20events%0A%20kvdbApi.subscribeForKvdbEvents()%3B%0A%0A%20%2F%2F%20subscribe%20for%20particular%20KVDB%20events%0A%20kvdbApi.subscribeForEntryEvents(kvdbId)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20getting%20the%20Event%20Queue%0A%20const%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%3B%0A%0A%20%2F%2F%20simple%20function%20to%20listen%20for%20events%20in%20a%20loop%0A%20function%20listenForEvents(eventsQueue)%20%7B%0A%20eventsQueue.waitEvent().then(event%20%3D%3E%20%7B%0A%20console.log(%22onEvent%22%2C%20event)%3B%0A%20listenForEvents(eventsQueue)%3B%0A%20%7D)%3B%0A%20%7D%0A%20%2F%2F%20start%20listening%20to%20events%0A%20listenForEvents(eventQueue)%3B%0A%0A%2F%2F%20subscribe%20for%20KVDBs%20general%20events%0AkvdbsApi.subscribeForKvdbEvents()%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%0A%20%60%60%60swift%0A%20try%3F%20endpointSession%3F.registerCallback(%0A%20for%3A%20privmx.endpoint.kvdb.KvdbDeletedEvent.self%2C%0A%20from%3A%20.kvdb%2C%20identified%3A%20%22SOME_UNIQUE_IDENTIFIER%22%2C%0A%20%7B%20eventData%20in%0A%20%2F%2F%20some%20actions%20when%20kvdb%20deleted%0A%20%7D)%0A%0A%20var%20kvdbId%20%3D%20%22KVDB_ID%22%0A%20%0A%20try%3F%20endpointSession%3F.registerCallback(%0A%20for%3A%20privmx.endpoint.kvdb.KvdbNewEntryEvent.self%2C%0A%20from%3A%20.kvdbEntries(kvdbId%3A%20kvdbId)%2C%20identified%3A%20%22SOME_UNIQUE_IDENTIFIER%22%2C%0A%20%7B%20eventData%20in%0A%20%2F%2F%20some%20actions%20when%20new%20kvdb%20entry%20created%0A%20%7D)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3C%2FTabs%3E%2C---%0Atitle%3A%20Managing%20KVDBs%0Adescription%3A%20At%20their%20core%2C%20KVDBs%20provide%20a%20secure%20way%20for%20assigned%20members%20to%20exchange%20encrypted%20entries.%0A---%0A%0A-%20KVDBs%20allow%20users%20to%20access%20key-value%20databases.%0A-%20Each%20Context%20can%20contain%20any%20number%20of%20KVDBs%20with%20a%20unique%20identifier%20(%60kvdbId%60)%20used%20to%20distinguish%20them.%0A-%20KVDBs%20do%20not%20need%20to%20have%20unique%20names%20or%20assigned%20public%20keys.%0A%0A%23%23%20Permissions%0AKVDBs%20differentiate%20two%20types%20of%20users%20-%20Managers%20and%20Regular%20Users.%20The%20table%20below%20shows%20the%20differences%20in%20their%20permissions%3A%0A%0A%7C%20**Activity**%20%7C%20**User**%20%7C%20**Manager**%20%7C%0A%7C-------------------%7C----------------%7C--------------%7C%0A%7C%20Sending%20entries%20%7C%20yes%20%7C%20yes%20%7C%0A%7C%20Editing%20KVDB%20%7C%20no%20%7C%20yes%20%7C%0A%7C%20Deleting%20entries%20%7C%20only%20their%20own%20%7C%20all%20entries%20%7C%0A%0AThe%20values%20above%20are%20the%20default%20policy%20values%20defined%20by%20PrivMX.%20To%20read%20more%20about%20Policies%20and%20learn%20how%20to%20modify%20them%2C%20go%20to%20%5BPolicies%5D(..%2Fconcepts%2Fpolicies).%0A%0A%0A%23%23%20Initial%20Assumptions%0AThe%20initial%20assumptions%20for%20all%20the%20code%20examples%20below%20are%20as%20follows%3A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FConnection.hpp%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fkvdb%2FKvdbApi.hpp%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FBuffer.hpp%3E%0A%0A%20using%20namespace%20privmx%3A%3Aendpoint%3B%0A%20%2F%2F%20...%0A%0A%20%2F*%20%0A%20All%20the%20values%20below%20like%20BRIDGE_URL%2C%20SOLUTION_ID%2C%20CONTEXT_ID%20%0A%20should%20be%20replaced%20by%20the%20ones%20corresponding%20to%20your%20Bridge%20Server%20instance.%0A%20The%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%20%0A%20Normally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0A%20or%20generated%20from%20a%20password%20(see%20the%20derivePrivateKey2()%20method%20in%20the%20Crypto%20API).%0A%20*%2F%0A%0A%20std%3A%3Astring%20BRIDGE_URL%20%7B%22http%3A%2F%2Flocalhost%3A9111%22%7D%3B%0A%20std%3A%3Astring%20SOLUTION_ID%20%7B%22YOUR_SOLUTION_ID%22%7D%3B%0A%20std%3A%3Astring%20CONTEXT_ID%20%7B%22YOUR_CONTEXT_ID%22%7D%3B%0A%0A%20std%3A%3Astring%20USER1_ID%20%7B%22user_1%22%7D%3B%0A%20std%3A%3Astring%20USER1_PUBLIC_KEY%20%7B%22PUBLIC_KEY_1%22%7D%3B%0A%20std%3A%3Astring%20USER1_PRIV%20%7B%22PRIVATE_KEY_1%22%7D%3B%0A%0A%20std%3A%3Astring%20USER2_ID%20%7B%22user_2%22%7D%3B%0A%20std%3A%3Astring%20USER2_PUBLIC_KEY%20%7B%22PUBLIC_KEY_2%22%7D%3B%0A%0A%20std%3A%3Astring%20USER3_ID%20%7B%22user_3%22%7D%3B%0A%20std%3A%3Astring%20USER3_PUBLIC_KEY%20%7B%22PUBLIC_KEY_3%22%7D%3B%0A%0A%20%2F%2F%20initialize%20Endpoint%20connection%20and%20KVDBs%20API%0A%20auto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIV%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0A%20auto%20kvdbApi%20%7Bkvdb%3A%3AKvdbApi%3A%3Acreate(connection)%7D%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F*%20%0A%20All%20the%20values%20below%20like%20BRIDGE_URL%2C%20SOLUTION_ID%2C%20CONTEXT_ID%20%0A%20should%20be%20replaced%20by%20the%20ones%20corresponding%20to%20your%20Bridge%20Server%20instance.%0A%20%0A%20The%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%20%0A%20Normally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0A%20or%20generated%20from%20a%20password%20(see%20the%20derivePrivateKey2()%20method%20in%20the%20Crypto%20API).%0A%20*%2F%0A%0A%20const%20BRIDGE_URL%20%3D%20%22http%3A%2F%2Flocalhost%3A9111%22%3B%0A%20const%20SOLUTION_ID%20%3D%20%22YOUR_SOLUTION_ID%22%3B%0A%20const%20CONTEXT_ID%20%3D%20%22YOUR_CONTEXT_ID%22%3B%0A%0A%20const%20USER1_ID%20%3D%20%22user_1%22%3B%0A%20const%20USER1_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_1%22%3B%0A%20const%20USER1_PRIV%20%3D%20%22PRIVATE_KEY_1%22%3B%0A%0A%20const%20USER2_ID%20%3D%20%22user_2%22%3B%0A%20const%20USER2_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_2%22%3B%0A%0A%20const%20USER3_ID%20%3D%20%22user_3%22%3B%0A%20const%20USER3_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_3%22%3B%0A%0A%0A%20class%20App%20%7B%0A%20uint8ToStr(arr)%20%7B%0A%20return%20(new%20TextDecoder()).decode(arr)%3B%0A%20%7D%0A%0A%20strToUint8(text)%20%7B%0A%20return%20(new%20TextEncoder()).encode(text)%3B%0A%20%7D%0A%0A%20%2F%2F%20...%0A%0A%20run()%20%7B%0A%20%2F%2F%20Initialize%20Endpoint%20and%20its%20Wasm%20assets%0A%20await%20Endpoint.setup(%22%2Fpublic%22)%3B%0A%0A%20%2F%2F%20initialize%20Endpoint%20connection%20and%20Kvdbs%20API%0A%20const%20connection%20%3D%20await%20Endpoint.connect(USER1_PRIV%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%3B%0A%20const%20kvdbApi%20%3D%20await%20Endpoint.createKvdbApi(connection)%3B%0A%0A%20%2F%2F%20...%0A%20%7D%0A%20%7D%0A%20new%20App().run()%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%60%60%60swift%0A%20var%20endpointContainer%3A%20PrivMXEndpointContainer%3F%0A%20var%20endpointSession%3A%20PrivMXEndpoint%3F%0A%20var%20publicEndpointSession%3A%20PrivMXEndpoint%3F%0A%20var%20endpointId%3A%20Int64%20%3D%200%0A%20%0A%20%2F*%0A%20All%20the%20values%20below%20like%20BRIDGE_URL%2C%20SOLUTION_ID%2C%20CONTEXT_ID%0A%20should%20be%20replaced%20by%20the%20ones%20corresponding%20to%20your%20Bridge%20Server%20instance.%0A%20%0A%20The%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%0A%20Normally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0A%20or%20generated%20from%20a%20password%20(see%20the%20derivePrivateKey2()%20method%20in%20the%20Crypto%20API)%0A%20*%2F%0A%0A%20let%20BRIDGE_URL%20%3D%20%22YOUR_BRIDGE_URL%22%3B%0A%20let%20SOLUTION_ID%20%3D%20%22YOUR_SOLUTION_ID%22%3B%0A%20let%20CONTEXT_ID%20%3D%20%22YOUR_CONTEXT_ID%22%3B%0A%0A%20let%20USER1_ID%20%3D%20%22user_1%22%3B%0A%20let%20USER1_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_1%22%3B%0A%20let%20USER1_PRIVATE_KEY%20%3D%20%22PRIVATE_KEY_1%22%3B%0A%0A%20let%20USER2_ID%20%3D%20%22user_2%22%3B%0A%20let%20USER2_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_2%22%3B%0A%0A%20let%20USER3_ID%20%3D%20%22user_3%22%3B%0A%20let%20USER3_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_3%22%3B%0A%0A%20let%20PAGE_SIZE%20%3AInt64%20%3D%2030%0A%20let%20pageIndex%20%3AInt64%20%3D%202%0A%0A%20try%20endpointContainer.setCertsPath(to%3A%20pathToCerts)%0A%0A%20%2F%2F%20Establish%20a%20new%20%60PrivMXEndpoint%60%20session%0A%20var%20endpointSession%20%3D%20try%20await%20endpointContainer.newEndpoint(%0A%20enabling%3A%20%5B.kvdb%5D%2C%0A%20connectingAs%3A%20USER1_PRIVATE_KEY%2C%0A%20to%3A%20SOLUTION_ID%2C%0A%20on%3A%20BRIDGE_URL%0A%20)%0A%60%60%60%0A%0A%0A%23%23%20Creating%20KVDBs%0A%0ATo%20create%20a%20KVDB%2C%20you%20need%20a%20name%20and%20a%20list%20of%20**public%20key%20-%20userID**%20pairs.%0ADue%20to%20the%20fact%20that%20each%20KVDB%20is%20inside%20a%20Context%2C%20all%20the%20public%20keys%20have%20to%20be%20registered%20inside%20the%20given%20Context.%20%0AYou%20can%20do%20it%20using%20%5BPrivMX%20Bridge%20API%5D(https%3A%2F%2Fbridge.privmx.dev%2F).%0A%0AAfter%20creating%20a%20KVDB%2C%20all%20the%20users%20with%20management%20rights%20will%20be%20able%20to%20edit%20the%20KVDB.%0A%0ABelow%20you%20can%20see%20some%20examples%20of%20creating%20KVDBs%20that%20function%20as%20a%20database%20feature%20in%20your%20application%2C%20with%20access%20management%20capabilities.%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20users%20and%20managers%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%0A%20%7D%3B%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%2C%0A%20core%3A%3AUserWithPubKey%7BUSER2_ID%2C%20USER2_PUBLIC_KEY%7D%0A%20%7D%3B%0A%0A%20auto%20kvdbId%20%7BkvdbApi.createKvdb(%0A%20CONTEXT_ID%2C%20users%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20kvdb's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20kvdb's%20private%20meta-data%22)%0A%20)%7D%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20const%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%20%5D%3B%0A%0A%20const%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%20%5D%3B%0A%0A%20%2F%2F%20create%20a%20new%20Kvdb%20with%20access%20for%20user_1%20as%20manager%20and%20user_2%20as%20regular%20user%0A%20%2F%2F%20for%20example%2C%20let's%20put%20the%20name%20of%20the%20kvdb%20as%20an%20object%20in%20the%20kvdb's%20private%20meta%0A%20const%20kvdbId%20%3D%20await%20kvdbApi.createKvdb(%0A%20CONTEXT_ID%2C%20users%2C%20managers%2C%20%0A%20this.strToUint8(%22some%20kvdb's%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(%22some%20kvdb's%20private%20meta-data%22)%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%60%60%60swift%0Aguard%20let%20kvdbApi%20%3D%20endpointSession%3F.kvdbApi%20else%20%7Breturn%7D%0Alet%20kvdbId%20%3D%20try%20kvdbApi.createKvdb(%0A%20in%3A%20CONTEXT_ID%2C%0A%20for%3A%20%5Bprivmx.endpoint.core.UserWithPubKey(%0A%20userId%3A%20USER1_ID%2C%0A%20pubKey%3A%20USER1_PUBLIC_KEY)%0A%20%5D%2C%0A%20managedBy%3A%20%5Bprivmx.endpoint.core.UserWithPubKey(%0A%20userId%3A%20USER1_ID%2C%0A%20pubKey%3A%20USER1_PUBLIC_KEY)%0A%20%5D%2C%0A%20withPublicMeta%3A%20Data()%2C%0A%20withPrivateMeta%3A%20Data())%0A%0A%60%60%60%0A%0A%23%23%20Listing%20KVDBs%0A%0AYour%20application%20may%20include%20multiple%20KVDBs%2C%20each%20associated%20with%20different%20Contexts.%20%0AYou%20can%20retrieve%20a%20**list%20of%20all%20KVDBs%20within%20a%20given%20Context.**%20%0AThis%20list%20will%20include%20useful%20metadata%20about%20the%20KVDBs%2C%20such%20as%20the%20creation%20date%2C%20last%20message%20upload%20date%2C%20user%20list%2C%20and%20information%20about%20the%20last%20modification.%20%0AHowever%2C%20to%20optimize%20performance%2C%20the%20list%20will%20only%20include%20the%20total%20number%20of%20entries%20in%20each%20KVDB%2C%20not%20the%20full%20entry%20content.%0A%0AHere's%20an%20example%20of%20how%20to%20download%20the%20last%2030%20KVDBs%20created%20within%20a%20Context%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20list%20KVDBs%0A%20core%3A%3APagingQuery%20query%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%2030%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%20%0A%20auto%20result%20%7BkvdbApi.listKvdbs(CONTEXT_ID%2C%20query)%7D%3B%0A%20for%20(const%20auto%26%20kvdb%20%3A%20result.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22KVDB%20ID%3A%20%22%20%3C%3C%20kvdb.kvdbId%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20query%3A%20Types.PagingQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%2030%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0A%20const%20result%20%3D%20await%20kvdbApi.listKvdbs(CONTEXT_ID%2C%20query)%3B%0A%20for%20(const%20kvdb%20of%20result.readItems)%20%7B%0A%20console.log(%22KVDB%20ID%3A%20%22%2C%20kvdb.kvdbId)%3B%0A%20%7D%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0ATo%20limit%20collecting%20too%20much%20data%20when%20downloading%20KVDBs%2C%20specify%20the%20page%20index%20(starting%20from%200)%20and%20the%20number%20of%20items%20to%20be%20included%20on%20each%20page.%0A%0A%23%23%20Modifying%20KVDBs%0A%0ADepending%20on%20your%20project's%20specification%2C%20it%20may%20be%20necessary%20to%20modify%20a%20KVDB.%0AIt%20could%20be%20e.g.%20changing%20the%20name%20or%20adding%2Fremoving%20users.%0AEach%20user%20with%20management%20rights%20is%20able%20to%20modify%20KVDB%2C%20delete%20them%20as%20a%20whole%20or%20only%20particular%20entries.%0A%0AUpdating%20a%20KVDB%20means%20overwriting%20it%20with%20the%20provided%20data.%20%0ATo%20successfully%20update%20a%20KVDB%2C%20you%20must%20specify%20its%20current%20%60version%60.%20%0AThe%20%60version%60%20field%20is%20mandatory%20to%20handle%20multiple%20updates%20on%20the%20server%20and%20it%20is%20incremented%20by%201%20with%20each%20update.%0A%0ABelow%20there%20is%20an%20example%20of%20modifying%20a%20KVDB%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20newUsersList%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%2C%0A%20core%3A%3AUserWithPubKey%7BUSER2_ID%2C%20USER2_PUBLIC_KEY%7D%0A%20core%3A%3AUserWithPubKey%7BUSER3_ID%2C%20USER3_PUBLIC_KEY%7D%0A%20%7D%3B%0A%0A%20auto%20kvdbInfo%20%7BkvdbApi.getKvdb(kvdbId)%7D%3B%0A%0A%20kvdbApi.updateKvdb(kvdbId%2C%20newUsersList%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20new%20kvdb's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20new%20kvdb's%20private%20meta-data%22)%2C%20kvdbInfo.version%2C%20false%2C%20false%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20Let's%20add%20a%20new%20user%20to%20the%20existing%20ones%20in%20the%20Kvdb%0A%20const%20newUsersList%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER3_ID%2C%20pubKey%3A%20USER3_PUBLIC_KEY%7D%0A%20%5D%3B%20%0A%0A%20const%20kvdbInfo%20%3D%20await%20kvdbApi.getKvdb(kvdbId)%3B%0A%0A%20await%20kvdbApi.updateKvdb(kvdbId%2C%20newUsersList%2C%20managers%2C%20%0A%20this.strToUint8(%22some%20new%20kvdb's%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(%22some%20new%20kvdb's%20private%20meta-data%22)%2C%20kvdbInfo.version%2C%20false%2C%20false%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0AThree%20additional%20options%20are%20available%20when%20changing%20the%20list%20of%20users%20inside%20a%20KVDB%3A%0A-%20%60force%60%20-%20applies%20an%20update%2C%20without%20checking%20the%20current%20version%3B%0A-%20%60forceGenerateNewKey%60%20-%20re-encrypts%20entries%20in%20the%20KVDB.%20It's%20useful%20when%20a%20user%20is%20removed%20and%20we%20want%20to%20prevent%20them%20from%20accessing%20the%20KVDB.%0A-%20%60policies%60%20-%20allow%20you%20to%20manage%20access%20to%20KVDB%20and%20entries.%20%5BRead%20more%20about%20Policies%5D(..%2Fconcepts%2Fpolicies).%0A%0A%23%23%20Deleting%20KVDBs%0A%0ADeleting%20a%20KVDB%20means%20also%20removing%20all%20entries%20data%20of%20related%20deleted%20KVDB.%20%0A%0ABelow%20there%20is%20an%20example%20of%20deleting%20a%20KVDB%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20kvdbApi.deleteKvdb(kvdbId)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20await%20kvdbApi.deleteKvdb(kvdbId)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C%7B%0A%20%22icon%22%3A%20%22kvdb%22%2C%0A%20%22title%22%3A%20%22KVDBs%22%2C%0A%20%22pages%22%3A%20%5B%22overview%22%2C%20%22managing-kvdbs%22%2C%20%22entries%22%2C%20%22kvdb-events%22%5D%0A%7D%0A%2C---%0Atitle%3A%20Encryption%0A---%0A%0APrivMX%20uses%20**elliptic%20curve%20cryptography**%20(ECC)%2C%20a%20public-key%20cryptography%20technique%20that%20leverages%20the%20mathematical%20properties%20of%20elliptic%20curves.%20ECC%20enables%20secure%20cryptographic%20operations%20such%20as%20key%20exchange%2C%20digital%20signatures%2C%20and%20encryption.%0A%0AHere%20are%20the%20general%20principles%20of%20elliptic%20curves%3A%0A%0A-%20ECC%20relies%20on%20elliptic%20curves%20as%20the%20fundamental%20mathematical%20technique.%20These%20curves%20are%20defined%20by%20the%20equation%3A%20%60y%5E2%3Dx%5E3%2Bax%2Bb%60%2C%20where%20%60a%60%20and%20%60b%60%20are%20constant%20parameters.%20Elliptic%20curves%20have%20unique%20properties%20that%20make%20them%20suitable%20for%20cryptography.%20ECC%20is%20a%20core%20component%20of%20the%20digital%20signature%20system%20used%20in%20Bitcoin.%0A%0A-%20ECC%20security%20is%20based%20on%20the%20computational%20complexity%20of%20discrete%20logarithms%20on%20elliptic%20curves%20(known%20as%20the%20Elliptic%20Curve%20Discrete%20Logarithm%20Problem%2C%20ECDLP).%20The%20digital%20signature%20algorithm%20using%20ECC%20is%20called%20ECDSA.%20ECC%20offers%20comparable%20security%20to%20the%20RSA%20algorithm%20but%20with%20significantly%20shorter%20key%20lengths.%0A%0A-%20ECC%20is%20an%20attractive%20algorithm%20for%20applications%20that%20require%20high-performance%20asymmetric%20encryption.%20It%20is%20particularly%20useful%20in%20resource-constrained%20computational%20environments%2C%20such%20as%20microprocessor%20cards.%0A%0APrivMX%20uses%20a%20256-bit%20ECC%20key%2C%20and%20keys%20required%20for%20private%20or%20public%20key%20input%20should%20be%20provided%20in%20Wallet%20Import%20Format%20(WIF).%0A%0ALearn%20more%20about%20%5Bkeys%20and%20how%20to%20generate%20them%5D(..%2Fstart%2Fgenerating-keys).%0A%0A%23%23%20User's%20Keys%0A%0APrivMX%20Endpoint%20uses%20a%20private-public%20key%20pair%20to%20encrypt%20data%20before%20sending%20it%20to%20PrivMX%20Bridge.%0A%0A**Private%20key**%20is%20a%20string%20of%20characters%20accessible%20only%20to%20its%20owner%2C%0Aeither%20explicitly%20e.g.%20stored%20in%20a%20password%20manager%2C%20or%20discreetly%20e.g.%20produced%20deterministically%20from%20a%20password.%0A%0A**Public%20key**%20is%20derived%20from%20the%20private%20key%2C%20it%20is%20publicly%20available%20to%20all%20members%20of%20the%20data%20exchange.%0AIn%20PrivMX%2C%20the%20Bridge%20stores%20public%20keys.%0A%0A%23%23%20Detailed%20Encryption%20Scenario%0A%0AIn%20the%20Bridge%2C%20end%20users%20can%20create%20Containers%20such%20as%20%5BThreads%5D(.%2Fthreads%2Foverview)%2C%20%5BStores%5D(.%2Fstores%2Foverview)%2C%20and%20%5BInboxes%5D(.%2Finboxes%2Foverview).%0AOnly%20an%20end%20user%20can%20create%20a%20Container%2C%20by%20providing%20a%20set%20of%20public%20keys%20for%20the%20users%20who%20should%20have%20access%20to%20the%20Container.%0AA%20symmetric%20key%20for%20the%20Container%20(Container%20Encryption%20Key)%20is%20then%20**generated%20by%20the%20Container%20author**%20and%20securely%20stored%20on%20the%20server%2C%20encrypted%20using%20public%20keys%20of%20**users%20assigned%20to%20the%20Container**.%0AThis%20ensures%20that%20only%20the%20authorized%20users%20have%20access%20to%20the%20Container's%20Encryption%20Key.%20**Unencrypted%20keys%20never%20leave%20User%20Endpoints.**%0A%0AWhen%20accessing%20a%20Container%2C%20the%20encrypted%20Container%20Encryption%20Key%20is%20sent%20to%20each%20user%20based%20on%20their%20assignment%20to%20the%20Container.%20Only%20the%20users%20with%20proper%20Private%20Keys%20can%20decrypt%20this%20key.%0AUsing%20the%20decrypted%20key%2C%20messages%20are%20encrypted%20and%20signed%20with%20the%20users%E2%80%99%20Private%20Keys%20before%20being%20sent%20to%20the%20Bridge.%0A%0AThis%20process%20is%20handled%20by%20the%20PrivMX%20Endpoint%20Library%20and%20is%20completely%20seamless%20for%20PrivMX%20Endpoint%20users.%0A%0AHere's%20a%20visual%20reference%20for%20the%20encryption%20process%20in%20PrivMX%3A%0A%0A!%5Bencryption%5D(%2Fimg%2Fprivmx-encryption.svg)%2C---%0Atitle%3A%20Features%0A---%0A%0A%23%23%20What%20is%20PrivMX%3F%0A%0APrivMX%20is%20a%20comprehensive%20platform%20designed%20for%20developers%2C%20enabling%20seamless%20integration%20of%20end-to-end%20encrypted%20communication%20into%20any%20application.%20It%20also%20provides%20the%20foundation%20for%20building%20new%2C%20encryption-focused%20communication%20apps.%0A%0APrivMX%20consists%20of%20two%20key%20components%3A%0A%0A-%20%5BPrivMX%20Bridge%5D(..%2Fstart%2Finstallation)%20%E2%80%93%20server%20deployed%20within%20your%20infrastructure%2C%20ensuring%20secure%20communication.%0A-%20%5BPrivMX%20Endpoint%5D(%23privmx-endpoint)%20%E2%80%93%20a%20set%20of%20libraries%20and%20wrappers%20ready%20to%20be%20configured%20and%20used%20with%20various%20programming%20languages%20and%20frameworks.%0A%0A%23%23%23%20Application%20Server%0A%0APrivMX%20only%20provides%20containers%20for%20implementing%20features%2C%20for%20example%20Threads%2C%20Stores%2C%20etc.%20To%20create%20and%20manage%20user%20accounts%2C%20you%20need%20a%20basic%20Application%20Server%2C%20connected%20to%20your%20app%20built%20with%20PrivMX.%20PrivMX%20identifies%20users%20using%20their%20public%20keys%2C%20but%20your%20Application%20Server%20has%20to%20handle%20them%20and%20store%20information%20about%20user%20profiles%20etc.%0A%0A%23%23%20PrivMX%20Bridge%0A%0ABridge%20is%20a%20**zero-knowledge%20server**%20that%20intermediates%20in%20the%20**transfer%20of%20encrypted%20data**%20and%20notifications%0Abetween%20PrivMX%20Endpoints%20and%20**stores%20encrypted%20data**%20for%20containers%3A%20Threads%2C%20Stores%2C%20and%20Inboxes.%0A%0A%5BMore%20information%20and%20Bridge%20installation%20guides%5D(..%2Fstart%2Finstallation)%0A%0A%23%23%23%20Solution%0A%0AA%20Solution%20represents%20an%20isolated%20data%20environment%2C%20**designed%20for%20specific%20applications%20or%20IT%20solutions**.%0A%0A%5BLearn%20more%20about%20Solutions%20in%20Architecture%5D(.%2Farchitecture)%0A%0A%23%23%23%20Context%0A%0AEach%20Context%20represents%20a%20distinct%20space%20within%20a%20Solution%2C%20where%20users%20can%20be%20assigned%20specific%20roles%20and%20permissions%0Ausing%20public%20keys.%0A%0A%5BLearn%20more%20about%20Contexts%20in%20Architecture%5D(.%2Farchitecture)%0A%0A%23%23%23%20API%20keys%0A%0AYou%20can%20use%20API%20keys%20to%20receive%20Access%20Tokens%20required%20for%20authorizing%20requests%20between%20your%20application%20backend%20and%20PrivMX%20Bridge.%0A%0A%5BMore%20information%20about%20API%20keys%20and%20authorization%20in%20PrivMX%20Bridge%5D(..%2Fstart%2Fauthorization)%0A%0A%23%23%20PrivMX%20Endpoint%0A%0APrivMX%20Endpoint%20is%20a%20set%20of%20libraries%20and%20wrappers%20ready%20to%20be%20configured%20and%20used%20with%20various%20programming%20languages%20and%20frameworks.%20Its%20core%20is%20a%20modular%20library%20written%20in%20C%2B%2B.%0A%0ALearn%20more%20about%20how%20to%20use%20PrivMX%20Endpoint%20in%20your%20favorite%20language%3A%0A%0A%3CCards%3E%0A%20%3CCard%0A%20href%3D%7B%22..%2Fcpp%2Fintroduction%22%7D%0A%20title%3D%7B%22C%2B%2B%22%7D%0A%20icon%3D%7B%3CIcon%20icon%3D%7B%22cpp%22%7D%20%2F%3E%7D%0A%20%2F%3E%0A%20%3CCard%0A%20href%3D%7B%22..%2Fjs%2Fintroduction%22%7D%0A%20title%3D%7B%22JavaScript%22%7D%0A%20icon%3D%7B%3CIcon%20icon%3D%7B%22js%22%7D%20%2F%3E%7D%0A%20%2F%3E%0A%20%3CCard%0A%20href%3D%7B%22..%2Fjava%2Fgetting-started%22%7D%0A%20title%3D%7B%22Java%2FKotlin%22%7D%0A%20icon%3D%7B%3CIcon%20icon%3D%7B%22java%22%7D%20%2F%3E%7D%0A%20%2F%3E%0A%20%3CCard%0A%20href%3D%7B%22..%2Fkotlin%2Fintroduction%22%7D%0A%20title%3D%7B%22Kotlin%22%7D%0A%20icon%3D%7B%3CIcon%20icon%3D%7B%22kotlin%22%7D%20%2F%3E%7D%0A%20%2F%3E%0A%20%3CCard%0A%20href%3D%7B%22..%2Fswift%2Fgetting-started%22%7D%0A%20title%3D%7B%22Swift%22%7D%0A%20icon%3D%7B%3CIcon%20icon%3D%7B%22swift%22%7D%20%2F%3E%7D%0A%20%2F%3E%0A%20%3CCard%0A%20href%3D%7B%22..%2Fcsharp%2Fintroduction%22%7D%0A%20title%3D%7B%22C%23%22%7D%0A%20icon%3D%7B%3CIcon%20icon%3D%7B%22csharp%22%7D%20%2F%3E%7D%0A%20%2F%3E%0A%3C%2FCards%3E%0A%0A%23%23%23%20User's%20Keys%0A%0APrivMX%20Endpoint%20uses%20a%20private-public%20key%20pair%20to%20encrypt%20data%20before%20sending%20it%20to%20PrivMX%20Bridge.%0A%0A%5BMore%20information%20about%20encryption%20in%20PrivMX%20Endpoint%5D(.%2Fencryption)%0A%0A%23%23%20Containers%0A%0A%23%23%23%20Threads%0A%0AThread%20container%20is%20a%20structured%20communication%20tool%20used%20for%20**message%20based%20communication**.%0A%0AUsers%20create%20Threads%20to%20organize%20topic-specific%20conversations%20where%20they%20can%20securely%20**exchange%20encrypted%20messages**%20with%20designated%0Aparticipants.%20All%20the%20active%20users%20are%20**notified**%20right%20away%20when%20a%20new%20message%20arrives%20or%20anything%20within%20the%20Thread%20changes.%0A%0A%5BLearn%20more%20about%20working%20with%20Threads%5D(..%2Fstart%2Fthreads%2Foverview)%0A%0A%23%23%23%20Stores%0A%0AStore%20container%20is%20a%20structured%20data%20storage%20and%20communication%20tool%20used%20for%20**file%20exchange%20and%20management**.%0A%0AUsers%20create%20Stores%20to%20organize%20topic-specific%20spaces%20where%20they%20can%20securely%20**upload%20encrypted%20files**%20and%20share%20them%20with%20designated%0Aparticipants.%20All%20the%20active%20users%20are%20**notified**%20right%20away%20when%20a%20file%20is%20uploaded%20or%20modified.%20Stores%20can%20be%20integrated%20with%20Threads.%0A%0A%5BLearn%20more%20about%20working%20with%20Stores%5D(..%2Fstart%2Fstores%2Foverview)%0A%0A%23%23%23%20Inboxes%0A%0AInbox%20container%20is%20a%20special%20kind%20of%20communication%20tool%20used%20for%20**one%20way%20communication%20with%20external%20users**.%0A%0AAn%20authorized%20PrivMX%20user%20can%20create%20an%20Inbox%2C%20configure%20its%20snippet%20and%20place%20it%20in%20a%20desired%20place%20(like%20a%20webpage%20or%20an%20app).%0A**Anonymous%2C%20unregistered%20users%20can%20send%20data%20to%20the%20Inbox**.%20This%20procedure%20uses%20Inbox%20Public%20Key%2C%20which%20allows%20to%20write%20data%20to%20an%20Inbox.%0AOne%20time%20access%20assures%20that%20the%20writer%20has%20no%20possibility%20of%20reading%20the%20data%20once%20it's%20sent.%0A%0A%5BLearn%20more%20about%20working%20with%20Inboxes%5D(..%2Fstart%2Finboxes%2Foverview)%0A%0A%23%23%23%20KVDBs%0A%0AKVDBs%20provide%20encrypted%20key-value%20databases.%20%0A%0AUsers%20create%20KVDBs%20to%20organize%20collections%20where%20they%20can%20securely%20**exchange%20encrypted%20data**%20with%20designated%20participants.%0AAll%20the%20active%20users%20are%20**notified**%20right%20away%20when%20a%20new%20entry%20arrives%2C%20is%20modified%2C%20or%20anything%20within%20the%20KVDB%20changes.%20%0A%0A%5BLearn%20more%20about%20working%20with%20KVDBs%5D(..%2Fstart%2Fkvdbs%2Foverview)%0A%2C---%0Atitle%3A%20Store%20Events%0A---%0A%0AEvents%20play%20a%20crucial%20role%20in%20modern%20applications%2C%20allowing%20them%20to%20instantly%20respond%20to%20changes%20in%20stored%20data.%20Monitoring%20and%20reacting%20to%20file%20and%20store-related%20events%2C%20such%20as%20the%20creation%2C%20modification%2C%20or%20deletion%20of%20files%2C%20is%20essential%20for%20maintaining%20up-to-date%20records%2C%20triggering%20workflows%2C%20and%20ensuring%20synchronization%20across%20various%20parts%20of%20the%20system.%0A%0A%23%23%20Types%20of%20Events%0A%0AStore%20events%3A%0A%0A-%20%60storeCreated%60%20-%20triggers%20when%20a%20new%20Store%20is%20created%20in%20your%20Context%0A-%20%60storeDeleted%60%20-%20triggers%20when%20a%20Store%20is%20deleted%20from%20your%20Context%0A-%20%60storeUpdated%60%20-%20triggers%20when%20a%20Store%20is%20updated%20in%20your%20Context%0A-%20%60storeStatsChanged%60%20-%20triggers%20when%20a%20file%20is%20created%20or%20deleted%20from%20a%20Store%0A%0AFile%20events%3A%20%0A-%20%60storeFileCreated%60%20-%20triggers%20when%20a%20file%20is%20uploaded%20to%20a%20Store%0A-%20%60storeFileDeleted%60%20-%20triggers%20when%20a%20file%20is%20deleted%20from%20a%20Store%0A-%20%60storeFileUpdated%60%20-%20triggers%20when%20a%20file%20is%20updated%20in%20a%20Store%0A%0A%23%23%20Handling%20Store%20Events%0A%0A%3A%3A%3Ainfo%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Fmanaging%23initial-assumptions)**%20mentioned%20in%20%5BManaging%20Stores%5D(.%2Fmanaging).%0A%0A%3A%3A%3A%0A%0ABefore%20receiving%20Events%2C%20your%20application%20must%20first%20start%20an%20event%20loop%20and%20subscribe%20to%20a%20specific%20channel.%0AAfterwards%20you%20can%20setup%20a%20listener.%0A%0AHere%20is%20an%20example%20of%20how%20to%20do%20it%20in%20your%20own%20project%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22cpp%22%2C%22js%22%2C%22java%22%2C%22kotlin%22%2C%22swift%22%5D%7D%3E%0A%3CTab%20value%3D%22cpp%22%20label%3D%22C%2B%2B%22%3E%0A%60%60%60cpp%0A%20%2F%2F%20handle%20events%0A%20core%3A%3AEventQueue%20eventQueue%20%7Bcore%3A%3AEventQueue%3A%3AgetInstance()%7D%3B%0A%20std%3A%3Athread%20t(%5B%26%5D()%7B%0A%20while(true)%20%7B%0A%20core%3A%3AEventHolder%20event%20%3D%20eventQueue.waitEvent()%3B%0A%20std%3A%3Acout%20%3C%3C%20%22onEvent%3A%20%22%20%3C%3C%20event.type()%20%3C%3C%20std%3A%3Aendl%3B%0A%20std%3A%3Acout%20%3C%3C%20event.toJSON()%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%7D)%3B%0A%20t.detach()%3B%0A%0A%20%2F%2F%20subscribe%20for%20Stores%20general%20events%0A%20storesApi.subscribeForStoreEvents()%3B%0A%0A%20%2F%2F%20subscribe%20for%20particular%20Store%20events%0A%20storesApi.subscribeForFileEvents(storeId)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3CTab%20value%3D%22js%22%20label%3D%22JavaScript%22%3E%0AStarting%20the%20Event%20Loop%0A%60%60%60js%0A%20listenForEvents(eventsQueue)%20%7B%0A%20eventsQueue.waitEvent().then(event%20%3D%3E%20%7B%0A%20console.log(%22onEvent%22%2C%20event)%3B%0A%20this.listenForEvents(eventsQueue)%3B%0A%20%7D)%3B%0A%20%7D%0A%20%2F%2F%20...%0A%20run()%20%7B%0A%20%2F%2F%20...%0A%20%0A%20%2F%2F%20handle%20events%0A%20const%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%3B%0A%20this.listenForEvents(eventQueue)%3B%0A%20%2F%2F%20...%0A%0A%20%2F%2F%20subscribe%20for%20Stores%20general%20events%0A%20await%20threadsApi.subscribeForStoreEvents()%3B%0A%20%2F%2F%20...%0A%0A%20%2F%2F%20subscribe%20for%20particular%20Store%20events%0A%20await%20threadsApi.subscribeForFileEvents(storeId)%3B%0A%20%7D%0A%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%20value%3D%22java%22%20label%3D%22Java%22%3E%0A%60%60%60java%0APrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0ALong%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0AString%20callbacksID%20%3D%20%22%3CYOUR_CALLBACK_ID%3E%22%3B%0AString%20storeID%20%3D%20%22%3CYOUR_STORE_ID%22%3B%0A%2F%2F%20Starting%20the%20Event%20Loop%0Acontainer.startListening()%3B%0A%0A%2F%2F%20Handling%20Store%20Events%0Acontainer.getEndpoint(connectionID).registerCallback(%0A%20callbacksID%2C%0A%20EventType.StoreCreatedEvent%2C%0A%20newStore%20-%3E%20%7B%0A%20System.out.println(newStore.storeId)%3B%0A%20%7D%0A)%3B%0A%0A%2F%2F%20Handling%20File%20Events%0Acontainer.getEndpoint(connectionID).registerCallback(%0A%20callbacksID%2C%0A%20EventType.StoreFileCreatedEvent(storeID)%2C%0A%20newFile%20-%3E%20%7B%0A%20System.out.println(newFile.info.fileId)%3B%0A%20%7D%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20value%3D%22kotlin%22%20label%3D%22Kotlin%22%3E%0A%60%60%60kotlin%0Aval%20container%20%3D%20PrivmxEndpointContainer()%0Aval%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0Aval%20callbacksID%20%3D%20%22%3CYOUR_CALLBACK_ID%3E%22%0Aval%20storeID%20%3D%20%22%3CYOUR_STORE_ID%22%0A%2F%2F%20Starting%20the%20Event%20Loop%0Acontainer.startListening()%0A%0A%2F%2F%20Handling%20Store%20Events%0Acontainer.getEndpoint(connectionID).registerCallback(%0A%20callbacksID%2C%0A%20EventType.StoreCreatedEvent%0A)%20%7B%20newStore%20-%3E%0A%20println(newStore.storeId)%0A%7D%0A%0A%2F%2F%20Handling%20File%20Events%0Acontainer.getEndpoint(connectionID).registerCallback(%0A%20callbacksID%2C%0A%20EventType.StoreFileCreatedEvent(storeID)%0A)%20%7B%20newFile%20-%3E%0A%20println(newFile.info.fileId)%0A%7D%0A%60%60%60%0A%3C%2FTab%3E%0A%3CTab%20value%3D%22swift%22%20label%3D%22Swift%22%3E%0A%0A%60%60%60swift%0Aguard%20let%20privMXEndpoint%20%3D%20endpointContainer.getEndpoint(connectionId)%20else%20%7Breturn%7D%0Alet%20connectionId%20%3D%20%22CONNECTION_ID%22%0Alet%20storeId%20%3D%20%22STORE_ID%22%0A%0Atry%20privMXEndpoint.registerCallback(%0A%20for%3A%20privmx.endpoint.store.StoreFileUpdatedEvent.self%2C%0A%20from%3A%20.storeFiles(storeID%3A%20storeId)%2C%20%0A%20identified%3A%20%22%22%2C%0A%20%7B%20eventData%20in%0A%20%2F%2F%20some%20actions%20when%20file%20updated%0A%20%7D)%0Atry%20privMXEndpoint.registerCallback(%0A%20for%3A%20privmx.endpoint.store.StoreCreatedEvent.self%2C%0A%20from%3A%20.store%2C%20%0A%20identified%3A%20%22%22%2C%0A%20%7B%20eventData%20in%0A%20%2F%2F%20some%20actions%20when%20new%20store%20created%0A%20%7D)%0A%20%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%2C---%0Atitle%3A%20Overview%0A---%0A%0AStore%20container%20is%20a%20structured%20data%20storage%20and%20communication%20tool%20used%20for%20**file%20exchange%20and%20management**.%0A%0AUsers%20create%20Stores%20to%20organize%20topic-specific%20spaces%20where%20they%20can%20securely%20**upload%20encrypted%20files**%20and%20share%20them%20with%20designated%20participants.%0AAll%20the%20active%20users%20are%20**notified**%20right%20away%20when%20a%20file%20is%20uploaded%20or%20modified.%20%0AStores%20can%20be%20integrated%20with%20Threads.%0A%0A%23%23%20Prerequisites%0A%0ABefore%20working%20with%20Stores%2C%20you%20need%20to%20have%20a%20PrivMX%20Bridge%20instance.%0A%0ATo%20install%20it%2C%20%5Bfollow%20our%20PrivMX%20quick%20start%20guide%5D(..%2Fquick-start).%0A%0A%23%23%20Architecture%0A%0AThink%20of%20a%20Store%20like%20a%20folder%20that%20allows%20you%20to%20store%20files%2C%20which%20**can%20include%20any%20binary%20or%20text%20data%20as%20well%20as%20metadata**.%20%0AEach%20Store%20has%20its%20own%20set%20of%20permissions%2C%20managed%20by%20assigning%20the%20users%E2%80%99%20public%20keys%20to%20the%20Store.%0A**Only%20the%20users%20with%20assigned%20public%20keys%20can%20read%20or%20write%20files%20from%20that%20Store**.%20%0ADecryption%20of%20these%20files%20is%20possible%20only%20with%20the%20corresponding%20private%20keys.%0A%0A**Each%20file%20is%20protected%20by%20a%20synchronous%20key%2C%20which%20is%20further%20secured%20using%20an%20asynchronous%20pair%20of%20public%20and%20private%20user%20keys**.%20%0AThis%20dual-layer%20encryption%20ensures%20that%20the%20system%20remains%20both%20safe%20and%20efficient.%20%0ALearn%20more%20about%20our%20advanced%20%5Bencryption%20methods%20and%20how%20they%20safeguard%20your%20files%5D(.%2Fencryption).%0A%0AA%20distinguishing%20feature%20of%20Stores%20is%20that%20the%20files%20are%20stored%20using%20segmentation%2C%20and%20access%20to%20them%20is%20via%20streaming.%20%0AThis%20allows%20for%20asynchronous%20reading%20and%20writing%20to%20these%20files%20without%20the%20need%20to%20download%20the%20entire%20file%20to%20memory%20or%20the%20local%20machine%E2%80%99s%20storage.%20%0AThere%20is%20also%20no%20upper%20limit%20on%20the%20size%20of%20these%20files.%20All%20of%20this%20remains%20perfectly%20secure%20using%20dual-layer%20encryption.%0A%0AThe%20following%20diagram%20is%20a%20visual%20reference%20for%20the%20architecture%20of%20Stores%3A%0A!%5Bprivmx%20stores%20encryption%5D(%2Fimg%2Fprivmx-stores.svg)%0A%0A%23%23%20Files%0A%0AThe%20main%20data%20units%20in%20Stores%20are%20files%2C%20which%20contain%20binary%20%60data%60%2C%20as%20well%20as%20%5Bmetadata%5D(.%2Fhandling-files%23about-files)%3A%0A%0A-%20%60privateMeta%60%20-%20encrypted%20data%20about%20the%20file%0A-%20%60publicMeta%60%20-%20**decrypted**%20additional%20data%20about%20the%20file%0A%0AEach%20file%20also%20has%20information%20assigned%20by%20the%20Bridge%2C%20which%20is%20impossible%20to%20modify.%0A%0ATo%20learn%20more%20about%20files%2C%20go%20to%20%5BUploading%20Files%5D(.%2Fuploading-files).%0A%0A%23%23%20Encryption%0A%0AEach%20file%20is%20protected%20by%20a%20synchronous%20key%2C%20which%20is%20further%20secured%20using%20an%20asynchronous%20pair%20of%20public%20and%20private%20user%20keys.%20%0AThis%20dual-layer%20encryption%20ensures%20that%20the%20system%20remains%20both%20safe%20and%20efficient.%0A%0AOnly%20an%20end%20user%20can%20create%20a%20Store%2C%20by%20providing%20a%20set%20of%20public%20keys%20for%20the%20users%20who%20should%20have%20access%20to%20the%20Store.%0A%0AA%20symmetric%20key%20for%20the%20Store%20(Store%20Encryption%20Key)%20is%20then%20**generated%20by%20the%20Store%20author%2Fowner**%20and%20securely%20stored%20on%20the%20server%2C%20encrypted%20using%20public%20keys%20of%20**users%20assigned%20to%20the%20Store**.%20%0AThis%20ensures%20that%20only%20the%20authorized%20users%20have%20access%20to%20the%20Store's%20Encryption%20Key.%20**Unencrypted%20keys%20never%20leave%20user%20Endpoints.**%0A%0AWhen%20accessing%20a%20Store%2C%20the%20encrypted%20Store%20Encryption%20Key%20is%20sent%20to%20each%20user%20based%20on%20their%20assignment%20to%20the%20Store.%20Only%20the%20users%20with%20proper%20Private%20Keys%20can%20decrypt%20Store%20Encryption%20Key.%20%0AUsing%20the%20decrypted%20key%2C%20messages%20are%20encrypted%20and%20signed%20with%20the%20users%E2%80%99%20Private%20Keys%20before%20being%20sent%20to%20the%20Bridge.%20%0A%0AThis%20process%20is%20handled%20by%20PrivMX%20Endpoint%20and%20is%20completely%20seamless%20for%20the%20users.%2C---%0Atitle%3A%20Downloading%20Files%0A---%0A%0A%3A%3A%3Ainfo%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Fmanaging%23initial-assumptions)**%20mentioned%20in%20%5BManaging%20Stores%5D(.%2Fmanaging).%0A%0A%3A%3A%3A%0A%0AThe%20code%20example%20below%20shows%20how%20to%20download%20a%20file%20from%20a%20Store%20in%20PrivMX%3A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%22Kotlin%22%2C%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20read%20large%20file%20chunk-by-chunk%0A%20auto%20bFileInfo%20%7BstoreApi.getFile(binaryFileId)%7D%3B%0A%20auto%20bHandle%20%7BstoreApi.openFile(binaryFileId)%7D%3B%0A%20size_t%20read%20%3D%200%3B%0A%20while%20(read%20%3C%20bFileInfo.size)%20%7B%0A%20auto%20data%20%7BstoreApi.readFromFile(bHandle%2C%201024)%7D%3B%0A%20read%20%2B%3D%20data.size()%3B%0A%20std%3A%3Acout%20%3C%3C%20%22Read%20(from%20store)%20%22%20%3C%3C%20read%20%3C%3C%20%22%20out%20of%3A%20%22%20%3C%3C%20bFileInfo.size%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20storeApi.closeFile(bHandle)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20read%20file%20contents%20of%20the%20file%20added%20to%20the%20Store%0A%20const%20fileInfo%20%3D%20await%20storeApi.getFile(fileId)%3B%0A%0A%20const%20fileHandle%20%3D%20await%20storeApi.openFile(fileId)%3B%0A%20const%20data%20%3D%20await%20storeApi.readFromFile(fileHandle%2C%20fileInfo.size)%3B%0A%20await%20storeApi.closeFile(fileHandle)%3B%0A%0A%20console.log(%22File%20meta%5Cn%20public%3A%20%22%2C%20this.uint8ToStr(fileInfo.publicMeta))%3B%0A%20console.log(%22private%3A%20%22%2C%20this.uint8ToStr(fileInfo.privateMeta))%3B%0A%20console.log(%22data%3A%20%22%2C%20this.uint8ToStr(data))%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60java%0A%20PrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0A%20Long%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0A%20StoreApi%20storeApi%20%3D%20container.getEndpoint(connectionID).storeApi%3B%0A%20String%20fileId%20%3D%20%22%3CYOUR_FILE_ID%3E%22%3B%0A%0A%20StoreFileStream.Controller%20controller%20%3D%20new%20StoreFileStream.Controller()%7B%0A%20%40Override%0A%20public%20void%20onChunkProcessed(Long%20processedBytes)%20%7B%0A%20System.out.println(%22Downloaded%20bytes%3A%20%22%20%2B%20processedBytes)%3B%0A%20%7D%0A%20%7D%3B%0A%0A%20try(OutputStream%20oS%20%3D%20new%20FileOutputStream(%22%3CPATH_TO_FILE%3E%22))%20%7B%0A%20StoreFileStreamReader.openFile(%0A%20storeApi%2C%0A%20fileId%2C%0A%20oS%2C%0A%20controller%0A%20)%3B%0A%20%7Dcatch%20(Exception%20e)%7B%0A%20System.out.println(%22Cannot%20download%20file%3A%20%22%20%2B%20e.getMessage())%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60kotlin%0A%20val%20container%20%3D%20PrivmxEndpointContainer()%0A%20val%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0A%20val%20storeApi%20%3D%20container.getEndpoint(connectionID).storeApi%0A%20val%20fileId%20%3D%20%22%3CYOUR_FILE_ID%3E%22%0A%0A%20val%20controller%3A%20StoreFileStream.Controller%20%3D%20object%20%3A%20StoreFileStream.Controller()%20%7B%0A%20override%20fun%20onChunkProcessed(processedBytes%3A%20Long)%20%7B%0A%20println(%22Downloaded%20bytes%3A%20%24processedBytes%22)%0A%20%7D%0A%20%7D%0A%0A%20FileOutputStream(%22%3CPATH_TO_FILE%3E%22).use%20%7B%20oS%20-%3E%0A%20StoreFileStreamReader.openFile(%0A%20storeApi%2C%0A%20fileId%2C%0A%20oS%2C%0A%20controller%0A%20)%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%0A%3CTab%20label%3D%22Swift%22%20value%3D%22swift%22%3E%0A%60%60%60swift%0Alet%20fileID%20%3D%20%22FILE_ID%22%0A%20let%20URL%20%3D%20URL(fileURLWithPath%3A%20%22%2Fpath%2Fto%2Ffile%2FFilename.txt%22)%0A%0A%20guard%20let%20fileHandle%20%3D%20try%3F%20FileHandle(forWritingTo%3A%20URL)%20else%20%7B%20return%20%7D%0A%20%0A%20Task%7B%0A%20try%3F%20await%20endpointSession%3F.startDownloadingToFile(fileHandle%2C%20from%3A%20fileID)%0A%20%7D%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C---%0Atitle%3A%20Uploading%20Files%0A---%0A%0A%3A%3A%3Ainfo%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Fmanaging%23initial-assumptions)**%20mentioned%20in%20%5BManaging%20Stores%5D(.%2Fmanaging).%0A%0A%3A%3A%3A%0A%0AIn%20this%20section%2C%20we%20will%20guide%20you%20through%20the%20process%20of%20uploading%20a%20file%20to%20a%20Store.%20This%20process%20involves%20both%20uploading%20the%20file%20content%20and%20managing%20its%20associated%20metadata.%20Storing%20metadata%2C%20such%20as%20the%20file's%20name%2C%20and%20type%2C%20allows%20for%20easier%20identification%20and%20retrieval%20of%20files%20when%20needed.%0A%0AWe%20highly%20recommend%20storing%20the%20file's%20metadata%20along%20with%20the%20file%20content%20to%20make%20it%20easier%20to%20manage%20and%20interact%20with%20the%20uploaded%20file%20in%20the%20future.%0A%0A%23%23%20Small%20Files%0AWriting%20whole%20file%20at%20once%3A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%22Kotlin%22%2C%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20add%20file%20to%20the%20specified%20Store%0A%20auto%20sampleFileMeta%20%7Bcore%3A%3ABuffer%3A%3Afrom(%22sample%20file%20data%22)%7D%3B%0A%0A%20std%3A%3Astring%20exampleFileMeta%20%3D%20%22%7B%5C%22name%5C%22%3A%5C%22some_file_name%5C%22%7D%22%3B%0A%0A%20auto%20fileHandle%20%7BstoreApi.createFile(storeId%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22file's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(exampleFileMeta)%2C%0A%20sampleFileData.size()%0A%20)%7D%3B%0A%0A%20storeApi.writeToFile(fileHandle%2C%20sampleFileData)%3B%0A%20auto%20fileId%20%7BstoreApi.closeFile(fileHandle)%7D%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20for%20example%2C%20let's%20put%20some%20extra%20file%20info%20in%20the%20file's%20private%20meta%0A%20const%20privateMeta%20%3D%20this.strToUint8(JSON.stringify(%7B%0A%20name%3A%20file.name%2C%0A%20mimetype%3A%20file.type%0A%20%7D))%3B%0A%20const%20sampleFileData%20%3D%20this.strToUint8(%22sample%20file%20data%22)%3B%0A%0A%20const%20fileHandle%20%3D%20await%20storeApi.createFile(storeId%2C%20%0A%20this.strToUint8(%22file's%20public%20meta-data%22)%2C%20%0A%20privateMeta%2C%0A%20sampleFileData.length%0A%20)%3B%0A%0A%20await%20storeApi.writeToFile(fileHandle%2C%20sampleFileData)%3B%0A%20const%20fileId%20%3D%20await%20storeApi.closeFile(fileHandle)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60java%0A%20PrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0A%20Long%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0A%20StoreApi%20storeApi%20%3D%20container.getEndpoint(connectionID).storeApi%3B%0A%20String%20storeID%20%3D%20%22%3CYOUR_STORE_ID%3E%22%3B%0A%0A%20byte%5B%5D%20publicMeta%20%3D%20%22File%20public%20meta%22.getBytes(StandardCharsets.UTF_8)%3B%0A%20byte%5B%5D%20privateMeta%20%3D%20%22File%20private%20meta%22.getBytes(StandardCharsets.UTF_8)%3B%0A%20byte%5B%5D%20fileContent%20%3D%20%22Text%20file%20content%22.getBytes(StandardCharsets.UTF_8)%3B%0A%20try%20%7B%0A%20StoreFileStreamWriter%20writer%20%3D%20StoreFileStreamWriter.createFile(%0A%20storeApi%2C%0A%20storeID%2C%0A%20publicMeta%2C%0A%20privateMeta%2C%0A%20fileContent.length%0A%20)%3B%0A%20writer.write(fileContent)%3B%0A%20String%20fileId%20%3D%20writer.close()%3B%0A%20%7Dcatch%20(Exception%20e)%7B%0A%20System.out.println(%22Cannot%20upload%20file%3A%20%22%20%2B%20e.getMessage())%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60kotlin%0A%20val%20container%20%3D%20PrivmxEndpointContainer()%0A%20val%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0A%20val%20storeApi%20%3D%20container.getEndpoint(connectionID).storeApi%0A%20val%20storeID%20%3D%20%22%3CYOUR_STORE_ID%3E%22%0A%0A%20val%20publicMeta%20%3D%20%22File%20public%20meta%22.encodeToByteArray()%0A%20val%20privateMeta%20%3D%20%22File%20private%20meta%22.encodeToByteArray()%0A%20val%20fileContent%20%3D%20%22Text%20file%20content%22.encodeToByteArray()%0A%0A%20val%20fileId%20%3D%20StoreFileStreamWriter.createFile(%0A%20storeApi%2C%0A%20storeID%2C%0A%20publicMeta%2C%0A%20privateMeta%2C%0A%20fileContent.size.toLong()%0A%20).run%20%7B%0A%20write(fileContent)%0A%20close()%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60swift%0A%20struct%20FilePrivateMeta%3ACodable%7B%0A%20let%20name%3A%20String%0A%20let%20mimetype%3A%20String%0A%20%7D%0A%0A%20let%20storeID%20%3D%20%22STORE_ID%