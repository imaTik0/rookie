%2B%20%22%5C%22%7D%22%3B%0A%20auto%20sizeTotal%20%3D%20std%3A%3Afilesystem%3A%3Afile_size(filePath)%3B%0A%0A%20auto%20binaryFileHandle%20%7BstoreApi.createFile(storeId%2C%20core%3A%3ABuffer%3A%3Afrom(%22file's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(filePrivMeta)%2C%20sizeTotal%0A%20)%7D%3B%0A%20%0A%20%2F%2F%20read%20from%20disk%20and%20upload%20chunks%20to%20the%20Bridge%0A%20std%3A%3Aifstream%20fin(filePath%2C%20std%3A%3Aios%3A%3Abinary)%3B%0A%20std%3A%3Avector%3Cchar%3E%20buffer%20(1024%2C0)%3B%0A%0A%20while(!fin.eof())%20%7B%0A%20auto%20chunkSize%20%7Bfin.read(buffer.data()%2C%20buffer.size()).gcount()%7D%3B%0A%20storeApi.writeToFile(binaryFileHandle%2C%20core%3A%3ABuffer%3A%3Afrom(buffer.data()%2C%20chunkSize))%3B%0A%20if%20(!fin.good())%20%7B%0A%20break%3B%0A%20%7D%0A%20%7D%0A%20auto%20binaryFileId%20%7BstoreApi.closeFile(binaryFileHandle)%7D%3B%0A%20fin.close()%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20Let's%20say%20you%20have%20an%20Html%20input%20element%20in%20the%20page%20body%3A%0A%20%60%60%60html%0A%20%3Cinput%20type%3D%22file%22%20id%3D%22inp%22%2F%3E%0A%20%60%60%60%0A%20Now%2C%20access%20that%20above%20input%20element%20from%20the%20JS%20code%20and%20get%20a%20file%20from%20there%3A%0A%20%60%60%60js%0A%0A%20const%20fileInput%20%3D%20document.getElementById('inp')%3B%0A%20if%20(!fileInput.files%20%7C%7C%20fileInput.files.length%20%3D%3D%3D%200)%20%7B%0A%20return%3B%0A%20%7D%0A%0A%20%2F%2F%20prepare%20a%20stream%20to%20read%20from%20the%20file%0A%20const%20stream%20%3D%20fileInput.files%5B0%5D.stream()%3B%0A%20const%20name%20%3D%20fileInput.files%5B0%5D.name%3B%0A%0A%20const%20fHandle%20%3D%20await%20storeApi.createFile(storeId%2C%20%0A%20this.strToUint8(%22file's%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(JSON.stringify(%7Bname%7D))%2C%20%0A%20fileSize%0A%20)%3B%0A%0A%20const%20reader%20%3D%20stream.getReader()%3B%0A%20while(%20true%20)%20%7B%0A%20const%20result%20%3D%20await%20reader.read()%3B%0A%20if(%20!result%20%7C%7C%20result.done%20)%20%7B%20%0A%20break%3B%20%0A%20%7D%0A%20console.log(%22Writing%20the%20file's%20chunk%20to%20the%20Store...%22)%3B%0A%20await%20storeApi.writeToFile(fHandle%2C%20result.value)%3B%0A%20%7D%0A%20await%20storeApi.closeFile(fHandle)%3B%0A%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60java%0A%20PrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0A%20Long%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0A%20StoreApi%20storeApi%20%3D%20container.getEndpoint(connectionID).storeApi%3B%0A%20String%20storeID%20%3D%20%22%3CYOUR_STORE_ID%3E%22%3B%0A%0A%20byte%5B%5D%20publicMeta%20%3D%20%22File%20public%20meta%22.getBytes(StandardCharsets.UTF_8)%3B%0A%20byte%5B%5D%20privateMeta%20%3D%20%22File%20private%20meta%22.getBytes(StandardCharsets.UTF_8)%3B%0A%20StoreFileStream.Controller%20controller%20%3D%20new%20StoreFileStream.Controller()%7B%0A%20%40Override%0A%20public%20void%20onChunkProcessed(Long%20processedBytes)%20%7B%0A%20System.out.println(%22Uploaded%20bytes%3A%20%22%20%2B%20processedBytes)%3B%0A%20%7D%0A%20%7D%3B%0A%0A%20try(InputStream%20iS%20%3D%20new%20FileInputStream(%22%3CPATH_TO_FILE%3E%22))%20%7B%0A%20String%20fileId%20%3D%20StoreFileStreamWriter.createFile(%0A%20storeApi%2C%0A%20storeID%2C%0A%20publicMeta%2C%0A%20privateMeta%2C%0A%20iS.available()%2C%0A%20iS%2C%0A%20controller%0A%20)%3B%0A%20%7Dcatch%20(Exception%20e)%7B%0A%20System.out.println(%22Cannot%20download%20file%3A%20%22%20%2B%20e.getMessage())%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60kotlin%0A%20val%20container%20%3D%20PrivmxEndpointContainer()%0A%20val%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0A%20val%20storeApi%20%3D%20container.getEndpoint(connectionID).storeApi%0A%20val%20storeID%20%3D%20%22%3CYOUR_STORE_ID%3E%22%0A%0A%20val%20publicMeta%20%3D%20%22File%20public%20meta%22.encodeToByteArray()%0A%20val%20privateMeta%20%3D%20%22File%20private%20meta%22.encodeToByteArray()%0A%20val%20controller%3A%20StoreFileStream.Controller%20%3D%20object%20%3A%20StoreFileStream.Controller()%20%7B%0A%20override%20fun%20onChunkProcessed(processedBytes%3A%20Long)%20%7B%0A%20println(%22Downloaded%20bytes%3A%20%24processedBytes%22)%0A%20%7D%0A%20%7D%0A%0A%20val%20fileId%20%3D%20FileInputStream(%22%3CPATH_TO_FILE%3E%22).use%20%7B%20iS%20-%3E%0A%20StoreFileStreamWriter.createFile(%0A%20storeApi%2C%0A%20storeID%2C%0A%20publicMeta%2C%0A%20privateMeta%2C%0A%20iS.available().toLong()%2C%0A%20iS%2C%0A%20controller%0A%20)%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%0A%3CTab%20label%3D%22Swift%22%20value%3D%22swift%22%3E%0A%60%60%60swift%0Astruct%20FilePrivateMeta%3ACodable%7B%0A%20let%20name%3A%20String%0A%20let%20mimetype%3A%20String%0A%7D%0A%0ATask%7B%0A%20let%20storeID%20%3D%20%22STORE_ID%22%0A%20let%20URL%20%3D%20URL(fileURLWithPath%3A%20%22%2Fpath%2Fto%2Ffile%2FFilename.txt%22)%0A%20guard%20let%20fileHandle%20%3D%20try%3F%20FileHandle(forReadingFrom%3A%20URL)%20else%20%7B%20return%20%7D%0A%20let%20fileSize%3AInt64%20%3D%200%20%2F%2Fto%20be%20provided%20by%20app%0A%20let%20filePrivateMeta%20%3D%20FilePrivateMeta(name%3A%20%22Filename.txt%22%2C%20mimetype%3A%20%22text%2Fplain%22)%0A%20guard%20let%20filePrivateMetaData%20%3D%20try%3F%20JSONEncoder().encode(filePrivateMeta)%20else%20%7Breturn%7D%0A%20let%20newFileId%20%3D%20try%3F%20await%20endpointSession%3F.startUploadingNewFile(fileHandle%2C%0A%20to%3A%20storeID%2C%0A%20withPublicMeta%3A%20Data()%2C%0A%20withPrivateMeta%3A%20filePrivateMetaData%2C%0A%20sized%3A%20fileSize)%0A%7D%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Notes%0A%0A-%20**Metadata**%3A%20helps%20you%20identify%20files%20later%20on%20by%20storing%20additional%20information%20about%20them.%20You%20can%20use%20both%20private%20metada%20(which%20might%20contain%20sensitive%20or%20internal%20data)%20and%20public%20metada%20(which%20can%20be%20shared%20publicly).%0A-%20**Error%20Handling**%3A%20During%20the%20streaming%20process%2C%20it's%20important%20to%20handle%20potential%20errors%2C%20such%20as%20network%20interruptions%2C%20by%20using%20try-catch%20blocks%20and%20the%20ability%20to%20abort%20the%20upload.%0A-%20**Progress%20Monitoring**%3A%20Streaming%20enables%20you%20to%20monitor%20the%20progress%20of%20the%20file%20upload%2C%20allowing%20you%20to%20display%20the%20current%20upload%20percentage%20to%20the%20user.%0A%0A%2C---%0Atitle%3A%20Managing%20Files%0A---%0A%0A%0A%0A%0AStores%20allow%20you%20to%20exchange%20and%20save%20files.%20In%20this%20section%2C%20we'll%20take%20a%20closer%20look%20at%20file%20structures%20and%20how%20to%20manage%20them%20effectively.%20We'll%20also%20cover%20some%20best%20practices%20when%20working%20with%20Stores.%0A%0A%23%23%20About%20Files%0A%0AAlong%20with%20a%20file's%20main%20content%2C%20additional%20**metadata**%20is%20stored%20to%20allow%20easy%20file%20management.%20Below%20is%20the%20structure%20of%20the%20metadata%20associated%20with%20each%20file%3A%0A%0A%7C**field**%7C**type**%7C**encrypted**%7C**description**%7C%0A%7C---%7C---%7C---%7C---%7C%0A%7C%60info%60%7CServerFileInfo%7Cyes%7Cadditional%20information%20assigned%20by%20the%20server%20e.g.%20author%2C%20%60creationDate%60%2C%20%60storeID%60%20and%20%60fileID%60%0A%7C%60publicMeta%60%7Cbinary%7Cno%7Cadditional%20public%20information%20about%20the%20message%2C%20also%20accessible%20through%20Bridge%20API%0A%7C%60privateMeta%60%7Cbinary%7Cyes%7Cadditional%20information%20about%20the%20message%0A%7C%60size%60%7Cnumber%7Cyes%7CThe%20size%20of%20file%20in%20getBytes%0A%7C%60authorPubKey%60%7Cstring%7Cyes%7CThe%20public%20key%20of%20the%20author%20of%20the%20file%0A%7C%60statusCode%60%7Cnumber%7Cno%7C0%20if%20the%20file%20was%20decrypted%20successfully%0A%0A%0A%23%23%20Listing%20Files%0A%0A%3A%3A%3Ainfo%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Fmanaging%23initial-assumptions)**%20mentioned%20in%20%5BManaging%20Stores%5D(.%2Fmanaging).%0A%0A%3A%3A%3A%0A%0AHere's%20how%20you%20can%20retrieve%20and%20list%20files%20from%20a%20Store%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%22Kotlin%22%2C%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20core%3A%3APagingQuery%20query%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%2030%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%0A%20%2F%2F%20list%20files%20of%20the%20Store%20specified%20by%20storeId%0A%20auto%20filesResult%20%7BstoreApi.listFiles(storeId%2C%20query)%7D%3B%0A%20for%20(auto%20file%3A%20filesResult.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22File%20ID%3A%20%22%20%3C%3C%20file.info.fileId%20%3C%3C%20std%3A%3Aendl%3B%0A%20std%3A%3Acout%20%3C%3C%20%22File%20size%3A%20%22%20%3C%3C%20file.size%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20const%20filesResult%20%3D%20await%20storeApi.listFiles(storeId%2C%20query)%3B%0A%20for%20(const%20f%20of%20filesResult.readItems)%20%7B%0A%20console.log(%22File%20ID%3A%20%22%2C%20f.info.fileId)%3B%0A%20console.log(%22File%20public%20meta%3A%20%22%2C%20this.uint8ToStr(f.publicMeta))%3B%0A%20console.log(%22File%20private%20meta%3A%20%22%2C%20this.uint8ToStr(f.privateMeta))%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60java%0A%20PrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0A%20Long%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0A%20String%20storeID%20%3D%20%22%3CSTORE_ID%3E%22%3B%0A%0A%20long%20limit%20%3D%2030L%3B%0A%20long%20skip%20%3D%200L%3B%0A%0A%20PagingList%3CFile%3E%20files%20%3D%20container.getEndpoint(connectionID).storeApi.listFiles(%0A%20storeID%2C%0A%20skip%2C%0A%20limit%2C%0A%20SortOrder.DESC%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60kotlin%0A%20val%20container%20%3D%20PrivmxEndpointContainer()%0A%20val%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0A%20val%20storeID%20%3D%20%22%3CSTORE_ID%3E%22%0A%0A%20val%20limit%20%3D%2030L%0A%20val%20skip%20%3D%200L%0A%0A%20val%20files%20%3D%20container.getEndpoint(connectionID).storeApi.listFiles(%0A%20storeID%2C%0A%20skip%2C%0A%20limit%2C%0A%20SortOrder.DESC%0A%20)%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20label%3D%22Swift%22%20value%3D%22swift%22%3E%0A%0A%60%60%60swift%20%0Alet%20storeId%20%3D%20%22STORE_ID%22%0Aguard%20let%20pagingList%20%3D%20try%3F%20endpointSession%3F.storeApi%3F%0A%20.listFiles(%0A%20from%3AstoreId%2C%0A%20basedOn%3A%20.init(skip%3A%20startIndex%2C%20limit%3A%20pageSize%2C%20sortOrder%3A%20.desc))%20else%20%7Breturn%7D%0Alet%20files%20%3D%0ApagingList.readItems.map%20%7B%20%240%20%7D%0A%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Deleting%20Files%0A%0ADeleting%20a%20file%20is%20straightforward%2C%20but%20be%20aware%20that%20this%20action%20is%20irreversible%3A%0A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%22Kotlin%22%2C%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20deleting%20file%20specified%20by%20fileId%0A%20storeApi.deleteFile(fileId)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20delete%20the%20file%0A%20await%20storeApi.deleteFile(fileId)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60java%0A%20PrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0A%20Long%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0A%20String%20fileID%20%3D%20%22%3CYOUR_FILE_ID%3E%22%3B%0A%20container.getEndpoint(connectionID).storeApi.deleteFile(fileID)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60kotlin%0A%20val%20container%20%3D%20PrivmxEndpointContainer()%0A%20val%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0A%20val%20fileID%20%3D%20%22%3CYOUR_FILE_ID%3E%22%0A%20container.getEndpoint(connectionID).storeApi.deleteFile(fileID)%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20label%3D%22Swift%22%20value%3D%22swift%22%3E%0A%0A%60%60%60swift%0Alet%20fileId%20%3D%20%22FILE_ID%22%0Atry%20endpointSession%3F.storeApi%3F.deleteFile(fileId)%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%2C---%0Atitle%3A%20Managing%20Stores%0A---%0A%0AAt%20the%20core%2C%20Stores%20provide%20a%20secure%20way%20for%20assigned%20members%20to%20upload%20encrypted%20files.%0A%0A-%20Stores%20allow%20users%20to%20upload%20files%20to%20separate%20file%20containers.%0A-%20Each%20%5BContext%5D(..%2Farchitecture%23contexts)%20can%20contain%20any%20number%20of%20Stores%20with%20a%20unique%20identifier%20(%60storeId%60)%20used%20to%20distinguish%20them.%0A-%20Stores%20do%20not%20need%20to%20have%20unique%20names%20or%20assigned%20public%20keys.%0A%0A%23%23%20Permissions%0A%0AStores%20differentiate%20two%20types%20of%20users%3A%20Managers%20and%20Regular%20Users.%20The%20table%20below%20shows%20the%20differences%20in%20their%20permissions%3A%0A%0A%7C**Activity**%7C**User**%7C**Manager**%7C%0A%7C---%7C---%7C---%7C%0A%7CUploading%20files%7Cyes%7Cyes%7C%0A%7CEditing%20files%7Cyes%7Cyes%7C%0A%7CEditing%20Store%7Cno%7Cyes%7C%0A%7CDeleting%20files%7Conly%20their%20own%7Call%20files%7C%0A%0AThe%20values%20above%20are%20the%20default%20policy%20values%20defined%20by%20PrivMX.%20To%20read%20more%20about%20Policies%20and%20learn%20how%20to%20modify%20them%2C%20go%20to%20%5BPolicies%5D(..%2Fconcepts%2Fpolicies).%0A%0A%23%23%20Initial%20Assumptions%0AThe%20initial%20assumptions%20for%20all%20the%20code%20examples%20below%20are%20as%20follows%3A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%22Kotlin%22%2C%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FConnection.hpp%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fstore%2FStoreApi.hpp%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FBuffer.hpp%3E%0A%20%2F%2F%20...%0A%0A%20%2F*%20%0A%20All%20the%20values%20below%20like%20BRIDGE_URL%2C%20SOLUTION_ID%2C%20CONTEXT_ID%20%0A%20should%20be%20replaced%20by%20the%20ones%20corresponding%20to%20your%20Bridge%20Server%20instance.%0A%20%0A%20The%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%20%0A%20Normally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0A%20or%20generated%20from%20a%20password%20(see%20the%20derivePrivateKey2()%20method%20in%20the%20Crypto%20API).%0A%20*%2F%0A%0A%20std%3A%3Astring%20BRIDGE_URL%20%7B%22http%3A%2F%2Flocalhost%3A9111%22%7D%3B%0A%20std%3A%3Astring%20SOLUTION_ID%20%7B%22YOUR_SOLUTION_ID%22%7D%3B%0A%20std%3A%3Astring%20CONTEXT_ID%20%7B%22YOUR_CONTEXT_ID%22%7D%3B%0A%0A%20std%3A%3Astring%20USER1_ID%20%7B%22user_1%22%7D%3B%0A%20std%3A%3Astring%20USER1_PUBLIC_KEY%20%7B%22PUBLIC_KEY_1%22%7D%3B%0A%20std%3A%3Astring%20USER1_PRIV%20%7B%22PRIVATE_KEY_1%22%7D%3B%0A%0A%20std%3A%3Astring%20USER2_ID%20%7B%22user_2%22%7D%3B%0A%20std%3A%3Astring%20USER2_PUBLIC_KEY%20%7B%22PUBLIC_KEY_2%22%7D%3B%0A%0A%20std%3A%3Astring%20USER3_ID%20%7B%22user_3%22%7D%3B%0A%20std%3A%3Astring%20USER3_PUBLIC_KEY%20%7B%22PUBLIC_KEY_3%22%7D%3B%0A%0A%20%2F%2F%20initialize%20Endpoint%20connection%20and%20Store%20API%0A%20auto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIV%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0A%20auto%20storeApi%20%7Bstore%3A%3AStoreApi%3A%3Acreate(connection)%7D%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20%2F*%20%0A%20All%20the%20values%20below%20like%20BRIDGE_URL%2C%20SOLUTION_ID%2C%20CONTEXT_ID%20%0A%20should%20be%20replaced%20by%20the%20ones%20corresponding%20to%20your%20Bridge%20Server%20instance.%0A%20%0A%20The%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%20%0A%20Normally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0A%20or%20generated%20from%20a%20password%20(see%20the%20derivePrivateKey2()%20method%20in%20the%20Crypto%20API).%0A%20*%2F%0A%0A%20const%20BRIDGE_URL%20%3D%20%22http%3A%2F%2