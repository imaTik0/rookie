22grantType%22%3A%20%22api_key_credentials%22%2C%0A%20%22apiKeyId%22%3A%20%2265ad8f6b2e4f4f1adb40bf68%22%2C%0A%20%22apiKeySecret%22%3A%20%225ZTUQ7VBxoqRKn3pEyPjHeavXHVw7JcJF3MvAV43yfsR%22%0A%20%7D%0A%20%7D'%20%5C%0A%20https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%0A%60%60%60%0A%0AYou%20will%20receive%20an%20%60access_token%60%20and%20a%20%60refresh_token%60%3A%0A%0A%3Cdiv%20class%3D%22center-column%22%3E%3C%2Fdiv%3E%0A%0A%60%60%60c%0A%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%20128%2C%0A%20%22result%22%3A%20%7B%0A%20%22accessToken%22%3A%20%22SXRzIGEgcmFuZG9tIHRleHQgZW5jb2RlZCBmb3IgdGhlIHRlc3RpbmcgcHVycG9zZSwgaWYgeW91IGRlY29kZWQgdGhpcyB0ZXh0LCB0cmVhdCBpcyBhcyBhIHNvcnQgb2YgZWFzdGVyIGVnZyA6KS4%3D%22%2C%0A%20%22accessTokenExpiry%22%3A%201726652150623%2C%0A%20%22refreshToken%22%3A%20%22TG9yZW0gaXBzdW1Mb3JlbSBpcHN1bUxvcmVtIGlwc3VtTG9yZW0gaXBzdW1Mb3JlbSBpcHN1bUxvcmVtIGlwc3VtTG9yZW0gaXBzdW0%3D%22%2C%0A%20%22refreshTokenExpiry%22%3A%201726952150623%2C%0A%20%22tokenType%22%3A%20%22Bearer%22%2C%0A%20%22scope%22%3A%20%5B%0A%20%22apiKey%22%2C%0A%20%22solution%22%2C%0A%20%22context%22%0A%20%5D%0A%20%7D%0A%7D%0A%60%60%60%0A%0AThe%20Access%20Token%20can%20be%20used%20to%20authorize%20your%20request%20by%20placing%20it%20in%20the%0A%60Authorization%60%20header%3A%0A%0A%3Cdiv%20class%3D%22center-column%22%3E%3C%2Fdiv%3E%0A%0A%60%60%60c%0Acurl%20-X%20POST%20%5C%0A%20-H%20%22Content-Type%3A%20application%2Fjson%22%20%5C%0A%20-H%20%22Authorization%3A%20Bearer%20SXRzIGEgcmFuZG9tIHRleHQgZW5jb2RlZCBmb3IgdGhlIHRlc3RpbmcgcHVycG9zZSwgaWYgeW91IGRlY29kZWQgdGhpcyB0ZXh0LCB0cmVhdCBpcyBhcyBhIHNvcnQgb2YgZWFzdGVyIGVnZyA6KS4%3D%22%20%5C%0A%20--data-binary%20'%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%20128%2C%0A%20%22method%22%3A%20%22solution%2FlistSolutions%22%2C%0A%20%22params%22%3A%20%7B%7D%0A%20%7D'%20%5C%0A%20https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%0A%60%60%60%0A%0AAccess%20Tokens%20can%20be%20refreshed%20using%20refresh%20tokens%20by%20calling%20the%0A%5Bmanager%2Fauth%5D(%23auth-token)%20method%3A%0A%0A%3Cdiv%20class%3D%22center-column%22%3E%3C%2Fdiv%3E%0A%0A%60%60%60c%0Acurl%20-X%20POST%20%5C%0A%20-H%20%22Content-Type%3A%20application%2Fjson%22%20%5C%0A%20--data-binary%20'%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%20128%2C%0A%20%22method%22%3A%20%22manager%2Fauth%22%2C%0A%20%22params%22%3A%20%7B%0A%20%22grantType%22%3A%20%22refresh_token%22%2C%0A%20%22refreshToken%22%3A%20%22TG9yZW0gaXBzdW1Mb3JlbSBpcHN1bUxvcmVtIGlwc3VtTG9yZW0gaXBzdW0%3D%22%2C%0A%20%7D%0A%20%7D'%20%5C%0A%20https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%0A%60%60%60%0A%0AIn%20response%2C%20you%20will%20receive%20a%20new%20pair%20of%20tokens%2C%20and%20the%20old%20pair%20will%20be%0Arevoked.%0A%0A%23%23%23%20API%20Scopes%0A%0AWhen%20requesting%20an%20Access%20Token%2C%20you%20can%20specify%20the%20scope%2C%20which%20defines%20the%0Alevel%20of%20access%20granted.%20Here's%20a%20breakdown%20of%20the%20available%20scopes%3A%0A%0A%7C%20Scope%20%7C%20Description%20%7C%0A%7C%20------------------------%20%7C%20----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------%20%7C%0A%7C%20**session%3ANAME**%20%7C%20Creates%20a%20new%20session%20with%20the%20provided%20name%2C%20generating%20tokens%20bound%20to%20that%20session.%20Access%20is%20granted%20for%20the%20session's%20lifetime.%20A%20user%20can%20have%20up%20to%2016%20sessions%3B%20when%20this%20limit%20is%20reached%2C%20the%20oldest%20session%20is%20removed.%20%7C%0A%7C%20**ipAddr%3AADDR**%20%7C%20Restricts%20the%20token%20to%20connections%20from%20a%20specific%20IPv4%20address%20(ADDR).%20%7C%0A%7C%20**expiresIn%3ANUMBER**%20%7C%20Access%20Token%20will%20expire%20after%20NUMBER%20of%20milliseconds.%20Max%20value%20is%20refresh%20token%20TTL.%20%7C%0A%7C%20**apiKey**%20%7C%20Restricts%20the%20token%20to%20manager%20API%20scope.%20%7C%0A%7C%20**solution**%20%7C%20Restricts%20the%20token%20to%20Solution%20API%20scope.%20%7C%0A%7C%20**context**%20%7C%20Restricts%20the%20token%20to%20Context%20API%20scope.%20%7C%0A%7C%20**thread**%20%7C%20Restricts%20the%20token%20to%20Thread%20API%20scope.%20%7C%0A%7C%20**store**%20%7C%20Restricts%20the%20token%20to%20Store%20API%20scope.%20%7C%0A%7C%20**inbox**%20%7C%20Restricts%20the%20token%20to%20Inbox%20API%20scope.%20%7C%0A%7C%20**stream**%20%7C%20Restricts%20the%20token%20to%20stream%20API%20scope.%20%7C%0A%7C%20**solution%3ASOLUTION_ID**%20%7C%20Restricts%20the%20token%20to%20manage%20Contexts%20only%20under%20given%20SOLUTION_ID.%20%7C%0A%7C%20**solution%3A%5C***%20%7C%20Restricts%20the%20token%20to%20manage%20all%20Contexts.%20%7C%0A%0AThese%20scopes%20allow%20fine-grained%20control%20over%20what%20actions%20can%20be%20performed%20with%0Athe%20generated%20tokens%2C%20making%20it%20easier%20to%20manage%20permissions%20across%20different%0Aparts%20of%20the%20system.%0A%0A%23%20Metrics%20Documentation%0A%0A%23%23%23%20Overview%0A%0AThe%20application%20provides%20a%20%60%2Fmetrics%60%20endpoint%20that%20returns%20various%20metrics%20in%20a%0Aformat%20compatible%20with%20%5BPrometheus%5D(https%3A%2F%2Fprometheus.io%2F).%20The%20endpoint%20is%0Aprotected%20by%20HTTP%20Basic%20Authorization%20for%20security.%0A%0A%23%23%23%20Metrics%20Endpoint%0A%0A-%20**Endpoint%3A**%20%60%2Fmetrics%60%0A-%20**Access%20Control%3A**%20Requires%20HTTP%20Basic%20Authorization%0A-%20**Scrape%20Interval%3A**%201%20minute%20(data%20older%20than%201%20minute%20is%20discarded)%0A-%20**Bucket%20Clearing%3A**%20After%20each%20metric%20collection%20via%20the%20%60%2Fmetrics%60%20endpoint%2C%0A%20the%20internal%20metrics%20bucket%20is%20cleared.%20This%20enables%20the%20endpoint%20to%20support%0A%20scrape%20intervals%20shorter%20than%201%20minute%2C%20if%20desired.%0A%0A%23%23%23%20Metrics%20Collected%0A%0AThe%20following%20metrics%20are%20available%20from%20the%20%60%2Fmetrics%60%20endpoint%3A%0A%0A1.%20**privmx_bridge_error_gauge**%0A%20-%20**Type%3A**%20Gauge%0A%20-%20**Description%3A**%20Tracks%20the%20number%20of%20errors.%0A2.%20**privmx_bridge_cpu_execution_time_gauge**%0A%20-%20**Type%3A**%20Gauge%0A%20-%20**Description%3A**%20Measures%20the%20CPU%20time%20taken%20for%20executions.%0A3.%20**privmx_bridge_in_traffic_gauge**%0A%20-%20**Type%3A**%20Gauge%0A%20-%20**Description%3A**%20Records%20incoming%20traffic%20volume%20in%20bytes.%0A4.%20**privmx_bridge_out_traffic_gauge**%0A%20-%20**Type%3A**%20Gauge%0A%20-%20**Description%3A**%20Records%20outgoing%20traffic%20volume%20in%20bytes.%0A5.%20**privmx_bridge_request_gauge**%0A%20-%20**Type%3A**%20Gauge%0A%20-%20**Description%3A**%20Counts%20the%20number%20of%20requests.%0A%0AEach%20of%20these%20metrics%20is%20exposed%20with%20the%20%60%23%20TYPE%20%3Cmetric_name%3E%20gauge%60%20format.%0A%2C%23%23%20store%2FdeleteStoreFilesOlderThan%0A%0ADeletes%20all%20files%20older%20than%20given%20timestamp%0A%0A%23%23%23%20Parameters%0A%0A%60%60%60javascript%0Aconst%20response%20%3D%20await%20fetch(%22https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%22%2C%20%7B%0A%20method%3A%20%22POST%22%2C%0A%20body%3A%20JSON.stringify(%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%20128%2C%0A%20%22method%22%3A%20%22store%2FdeleteStoreFilesOlderThan%22%2C%0A%20%22params%22%3A%20%7B%0A%20%22storeId%22%3A%20%2266477724276e411b86fe6d73%22%2C%0A%20%22timestamp%22%3A%201715959588042%2C%0A%20%7D%2C%0A%20%7D)%2C%0A%20headers%3A%20%7B%0A%20%22Content-type%22%3A%20%22application%2Fjson%22%2C%0A%20%22Authorization%22%3A%20%22Bearer%20TOKEN%22%2C%0A%20%7D%2C%0A%7D)%3B%0A%60%60%60%0A%0A%60%60%60shell%0Acurl%20-X%20POST%20%5C%0A%20-H%20%22Content-Type%3A%20application%2Fjson%22%20-H%20%22Authorization%3A%20Bearer%20TOKEN%22%20%5C%0A%20--data-binary%20'%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%20128%2C%0A%20%22method%22%3A%20%22store%2FdeleteStoreFilesOlderThan%22%2C%0A%20%22params%22%3A%20%7B%0A%20%22storeId