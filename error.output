C%20SOLUTION_ID%2C%20CONTEXT_ID%0A%20should%20be%20replaced%20by%20the%20ones%20corresponding%20to%20your%20Bridge%20Server%20instance.%0A%20%0A%20The%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%0A%20Normally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0A%20or%20generated%20from%20a%20password%20(see%20the%20derivePrivateKey2()%20method%20in%20the%20Crypto%20API)%0A%20*%2F%0A%0A%20let%20BRIDGE_URL%20%3D%20%22YOUR_BRIDGE_URL%22%3B%0A%20let%20SOLUTION_ID%20%3D%20%22YOUR_SOLUTION_ID%22%3B%0A%20let%20CONTEXT_ID%20%3D%20%22YOUR_CONTEXT_ID%22%3B%0A%0A%20let%20USER1_ID%20%3D%20%22user_1%22%3B%0A%20let%20USER1_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_1%22%3B%0A%20let%20USER1_PRIVATE_KEY%20%3D%20%22PRIVATE_KEY_1%22%3B%0A%0A%20let%20USER2_ID%20%3D%20%22user_2%22%3B%0A%20let%20USER2_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_2%22%3B%0A%0A%20let%20USER3_ID%20%3D%20%22user_3%22%3B%0A%20let%20USER3_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_3%22%3B%0A%0A%20let%20PAGE_SIZE%20%3AInt64%20%3D%2030%0A%20let%20pageIndex%20%3AInt64%20%3D%202%0A%0A%20try%20endpointContainer.setCertsPath(to%3A%20pathToCerts)%0A%0A%20%2F%2F%20Establish%20a%20new%20%60PrivMXEndpoint%60%20session%0A%20var%20endpointSession%20%3D%20try%20await%20endpointContainer.newEndpoint(%0A%20enabling%3A%20%5B.store%5D%2C%0A%20connectingAs%3A%20USER1_PRIVATE_KEY%2C%0A%20to%3A%20SOLUTION_ID%2C%0A%20on%3A%20BRIDGE_URL%0A%20)%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0A%23%23%20Creating%20Stores%0A%0ATo%20create%20a%20Store%2C%20you%20need%20a%20name%20and%20a%20list%20of%20**public%20key%20-%20userID**%20pairs.%20See%20how%20to%20get%20them%20%5Bhere%5D(..%2Finstallation).%0ADue%20to%20the%20fact%20that%20each%20Store%20is%20inside%20a%20Context%2C%20all%20the%20public%20keys%20have%20to%20be%20registered%20inside%20the%20given%20Context.%20%0AYou%20can%20do%20it%20using%20Bridge%20API.%0A%0AAfter%20creating%20a%20Store%2C%20all%20the%20users%20with%20management%20rights%20will%20be%20able%20to%20edit%20the%20Store.%20Skip%20to%20%5BModifying%20Stores%5D(%23modifying-stores)%20for%20more%20info.%0A%0ABelow%20you%20can%20see%20some%20examples%20of%20creating%20Stores%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%22Kotlin%22%2C%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%0A%20%7D%3B%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%2C%0A%20core%3A%3AUserWithPubKey%7BUSER2_ID%2C%20USER2_PUBLIC_KEY%7D%0A%20%7D%3B%0A%20%2F%2F%20create%20a%20new%20Store%20with%20access%20for%20user_1%20as%20manager%20and%20user_2%20as%20regular%20user%0A%20auto%20storeId%20%7BstoreApi.createStore(CONTEXT_ID%2C%20users%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20store's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20store's%20private%20meta-data%22)%0A%20)%7D%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20const%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%20%5D%3B%0A%0A%20const%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%20%5D%3B%0A%0A%20%2F%2F%20create%20a%20new%20Store%20with%20access%20for%20user_1%20as%20manager%20and%20user_2%20as%20regular%20user%0A%20%2F%2F%20for%20example%2C%20let's%20put%20the%20name%20of%20the%20store%20as%20an%20object%20in%20the%20store's%20private%20meta%0A%20const%20storeId%20%3D%20await%20storeApi.createStore(CONTEXT_ID%2C%20users%2C%20managers%2C%20%0A%20this.strToUint8(%22some%20store's%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(JSON.stringify(%7Bname%3A%20%22some_store%22%7D))%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60java%0A%20PrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0A%20Long%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0A%20String%20contextID%20%3D%20%22%3CCONTEXT_ID%3E%22%3B%0A%0A%20byte%5B%5D%20privateMeta%20%3D%20%22My%20private%20data%22.getBytes(StandardCharsets.UTF_8)%3B%0A%20byte%5B%5D%20publicMeta%20%3D%20%22My%20public%20data%22.getBytes(StandardCharsets.UTF_8)%3B%0A%20List%3CUserWithPubKey%3E%20users%20%3D%20List.of(%0A%20new%20UserWithPubKey(%22MY_USER%22%2C%20%22PUB_KEY%22)%2C%0A%20new%20UserWithPubKey(%22MY_USER2%22%2C%20%22PUB_KEY2%22)%0A%20)%3B%0A%20List%3CUserWithPubKey%3E%20managers%20%3D%20List.of(%0A%20new%20UserWithPubKey(%22MY_USER%22%2C%20%22PUB_KEY%22)%0A%20)%3B%0A%0A%20String%20storeID%20%3D%20container.getEndpoint(connectionID).storeApi.createStore(%0A%20contextID%2C%0A%20users%2C%0A%20managers%2C%0A%20publicMeta%2C%0A%20privateMeta%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60kotlin%0A%20val%20container%20%3D%20PrivmxEndpointContainer()%0A%20val%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0A%20val%20contextID%20%3D%20%22%3CCONTEXT_ID%3E%22%0A%0A%20val%20privateMeta%20%3D%20%22My%20private%20data%22.encodeToByteArray()%0A%20val%20publicMeta%20%3D%20%22My%20public%20data%22.encodeToByteArray()%0A%20val%20users%20%3D%20listOf(%0A%20UserWithPubKey(%22MY_USER%22%2C%20%22PUB_KEY%22)%2C%0A%20UserWithPubKey(%22MY_USER2%22%2C%20%22PUB_KEY2%22)%0A%20)%0A%20val%20managers%20%3D%20listOf(%0A%20UserWithPubKey(%22MY_USER%22%2C%20%22PUB_KEY%22)%0A%20)%0A%0A%20val%20storeID%20%3D%20container.getEndpoint(connectionID).storeApi.createStore(%0A%20contextID%2C%0A%20users%2C%0A%20managers%2C%0A%20publicMeta%2C%0A%20privateMeta%0A%20)%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20value%3D%22swift%22%20label%3D%22Swift%22%3E%0A%0A%60%60%60swift%0Alet%20users%20%3D%20%5B%0A%20privmx.endpoint.core.UserWithPubKey(%0A%20userId%3A%20USER1_ID%2C%0A%20pubKey%3A%20USER1_PUBLIC_KEY)%2C%0A%20privmx.endpoint.core.UserWithPubKey(%0A%20userId%3A%20USER2_ID%2C%0A%20pubKey%3A%20USER2_PUBLIC_KEY)%2C%0A%5D%0A%0Alet%20managers%20%3D%20%5B%0A%20privmx.endpoint.core.UserWithPubKey(%0A%20userId%3A%20USER1_ID%2C%0A%20pubKey%3A%20USER1_PUBLIC_KEY)%0A%5D%0A%0Alet%20newThreadID%20%3D%20try%20enspointSession%3F.threadApi%3F.createThread(%20%0A%20%22New%20Thread%22%2C%0A%20with%3A%20users%2C%20%0A%20managedBy%3A%20managers%2C%20%0A%20in%3A%20contextId%0A)%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A**Important%20note%3A**%20Managers%20declared%20while%20creating%20the%20Store%2C%20also%20have%20to%20be%20included%20in%20the%20regular%20user%20list.%0A%0AThe%20user%20list%20in%20Stores%20is%20designed%20to%20be%20flexible%2C%20accommodating%20a%20wide%20range%20of%20use%20cases.%0A%0A%23%23%20Listing%20Stores%0A%0AYour%20application%20may%20include%20multiple%20Stores%2C%20each%20associated%20with%20different%20Contexts.%20%0AYou%20can%20retrieve%20a%20**list%20of%20all%20Stores%20within%20a%20given%20Context.**%20%0AThis%20list%20will%20include%20useful%20metadata%20about%20the%20Stores%2C%20such%20as%20the%20creation%20date%2C%20last%20file%20upload%20date%2C%20user%20list%2C%20and%20information%20about%20the%20last%20modification.%20%0AHowever%2C%20to%20optimize%20performance%2C%20the%20list%20will%20only%20include%20the%20total%20number%20of%20files%20in%20each%20Store%2C%20not%20the%20full%20file%20content.%0A%0AHere's%20an%20example%20of%20how%20to%20download%20the%20last%2030%20Stores%20created%20within%20a%20Context%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%22Kotlin%22%2C%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20list%20stores%0A%20core%3A%3APagingQuery%20query%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%2030%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%20%0A%20auto%20result%20%7BstoreApi.listStores(CONTEXT_ID%2C%20query)%7D%3B%0A%20for%20(auto%20store%3A%20result.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22Store%20ID%3A%20%22%20%3C%3C%20store.storeId%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20const%20query%3A%20Types.PagingQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%2030%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0A%20const%20result%20%3D%20await%20storeApi.listStores(CONTEXT_ID%2C%20query)%3B%0A%20for%20(const%20store%20of%20result.readItems)%20%7B%0A%20console.log(%22Store%20ID%3A%20%22%2C%20store.storeId)%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60java%0A%20PrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0A%20Long%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0A%20String%20contextID%20%3D%20%22%3CCONTEXT_ID%3E%22%3B%0A%0A%20Long%20limit%20%3D%2030L%3B%0A%20Long%20skip%20%3D%200L%3B%0A%0A%20PagingList%3CStore%3E%20stores%20%3D%20container.getEndpoint(connectionID).storeApi.listStores(%0A%20contextID%2C%0A%20skip%2C%0A%20limit%2C%0A%20SortOrder.DESC%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60kotlin%0A%20val%20container%20%3D%20PrivmxEndpointContainer()%0A%20val%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0A%20val%20contextID%20%3D%20%22%3CCONTEXT_ID%3E%22%0A%0A%20val%20limit%20%3D%2030L%0A%20val%20skip%20%3D%200L%0A%0A%20val%20stores%20%3D%20container.getEndpoint(connectionID).storeApi.listStores(%0A%20contextID%2C%0A%20skip%2C%0A%20limit%2C%0A%20SortOrder.DESC%0A%20)%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20value%3D'swift'%20label%3D%22Swift%22%3E%0A%60%60%60swift%0Alet%20storeList%20%3D%20try%20endpointSession%3F.storeApi%3F.listStores(%0A%20from%3A%20CONTEXT_ID%2C%0A%20query%3A%20privmx.endpoint.core.ListQuery(%0A%20skip%3A%20pageIndex%2C%0A%20limit%3A%20PAGE_SIZE%2C%0A%20sortOrder%3A%20.desc)%0A)%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0ATo%20limit%20collecting%20too%20much%20data%20when%20downloading%20Stores%2C%20specify%20the%20amount%20of%20results%20to%20be%20skipped%20(minimum%200)%20and%20the%20amount%20of%20results%20to%20be%20downloaded.%0A%0A%0A%23%23%20Modifying%20Stores%0A%0ADepending%20on%20your%20project's%20specification%2C%20it%20may%20be%20necessary%20to%20modify%20a%20Store.%0AIt%20could%20be%20e.g.%20changing%20the%20name%20or%20adding%2Fremoving%20users.%0AEach%20user%20with%20management%20rights%20is%20able%20to%20modify%20Stores%2C%20delete%20them%20as%20a%20whole%20or%20only%20particular%20files.%0A%0AUpdating%20a%20Store%20means%20overwriting%20it%20with%20the%20provided%20data.%20%0ATo%20successfully%20update%20a%20Store%2C%20you%20must%20specify%20its%20current%20%60version%60.%20%0AThe%20%60version%60%20field%20is%20mandatory%20to%20handle%20multiple%20updates%20on%20the%20server%20and%20it%20is%20incremented%20by%201%20with%20each%20update.%0A%0ABelow%20there%20is%20an%20example%20of%20modifying%20a%20Store%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%22Kotlin%22%2C%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%20%7B%7D%3B%0A%20managers.push_back(%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D)%3B%0A%0A%20%2F%2F%20Let's%20add%20a%20new%20user%20to%20the%20existing%20ones%20in%20the%20Store%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20newUsersList%20%7B%7D%3B%0A%20newUsersList.push_back(%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D)%3B%0A%20newUsersList.push_back(%7B.userId%20%3D%20USER2_ID%2C%20.pubKey%20%3D%20USER2_PUBLIC_KEY%7D)%3B%0A%20newUsersList.push_back(%7B.userId%20%3D%20USER3_ID%2C%20.pubKey%20%3D%20USER3_PUBLIC_KEY%7D)%3B%0A%0A%20auto%20storeInfo%20%7BstoreApi.getStore(storeId)%7D%3B%0A%0A%20storeApi.updateStore(storeId%2C%20newUsersList%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20new%20store's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20new%20store's%20private%20meta-data%22)%2C%20storeInfo.version%2C%20false%2C%20false%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20Let's%20add%20a%20new%20user%20to%20the%20existing%20ones%20in%20the%20Store%0A%20const%20newUsersList%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER3_ID%2C%20pubKey%3A%20USER3_PUBLIC_KEY%7D%0A%20%5D%3B%20%0A%0A%20const%20storeInfo%20%3D%20await%20storeApi.getStore(storeId)%3B%0A%0A%20await%20storeApi.updateStore(storeId%2C%20newUsersList%2C%20managers%2C%20%0A%20this.strToUint8(%22some%20new%20store's%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(%22some%20new%20store's%20private%20meta-data%22)%2C%20storeInfo.version%2C%20false%2C%20false%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60java%0A%20PrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0A%20Long%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0A%20String%20storeID%20%3D%20%22YOUR_STORE_ID%22%3B%0A%0A%20StoreApi%20storeApi%20%3D%20container.getEndpoint(connectionID).storeApi%3B%0A%20Store%20store%20%3D%20storeApi.getStore(storeID)%3B%0A%0A%20List%3CUserWithPubKey%3E%20newUsers%20%3D%20store.users.stream().map(userID%20-%3E%20%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%0A%20return%20new%20UserWithPubKey(%0A%20userID%2C%0A%20%22USER_PUBLIC_KEY%22%0A%20)%3B%0A%0A%20%7D).toList()%3B%0A%20List%3CUserWithPubKey%3E%20newManagers%20%3D%20store.managers.stream().map(userID%20-%3E%20%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20return%20new%20UserWithPubKey(%0A%20userID%2C%0A%20%22USER_PUBLIC_KEY%22%0A%20)%3B%0A%0A%20%7D).toList()%3B%0A%20byte%5B%5D%20newPrivateMeta%20%3D%20%22New%20store%20name%22.getBytes(StandardCharsets.UTF_8)%3B%0A%0A%20container.getEndpoint(connectionID).storeApi.updateStore(%0A%20storeID%2C%0A%20newUsers%2C%0A%20newManagers%2C%0A%20store.publicMeta%2C%0A%20newPrivateMeta%2C%0A%20store.version%2C%0A%20false%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60kotlin%0A%20val%20container%20%3D%20PrivmxEndpointContainer()%0A%20val%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0A%20val%20storeID%20%3D%20%22YOUR_STORE_ID%22%0A%0A%20val%20storeApi%20%3D%20container.getEndpoint(connectionID).storeApi%0A%20val%20store%20%3D%20storeApi.getStore(storeID)%0A%0A%20val%20newUsers%20%3D%20store.users.map%20%7B%20userID%20-%3E%0A%20UserWithPubKey(%0A%20userID%2C%0A%20%22USER_PUBLIC_KEY%22%0A%20)%0A%20%7D.toList()%0A%20val%20newManagers%20%3D%20store.managers.map%20%7B%20userID%20-%3E%0A%20UserWithPubKey(%0A%20userID%2C%0A%20%22USER_PUBLIC_KEY%22%0A%20)%0A%20%7D.toList()%0A%20val%20newPrivateMeta%20%3D%20%22New%20store%20name%22.encodeToByteArray()%0A%0A%20container.getEndpoint(connectionID).storeApi.updateStore(%0A%20storeID%2C%0A%20newUsers%2C%0A%20newManagers%2C%0A%20store.publicMeta%2C%0A%20newPrivateMeta%2C%0A%20store.version%2C%0A%20false%0A%20)%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20value%3D'swift'%20label%3D%22Swift%22%3E%0A%60%60%60swift%0Avar%20storeId%20%3D%20%22STORE_ID%22%0A%20%0Aguard%20let%20store%20%3D%20try%3F%20endpointSession%3F.storeApi%3F%0A%20.getStore(storeId)%20else%20%7Breturn%7D%0A%0A%2F%2Fusers%20list%20to%20be%20extracted%20from%20store%0Alet%20users%20%3D%20store.users%0A%20.map%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20privmx.endpoint.core.UserWithPubKey(userId%3A%20%240%2C%20pubKey%3A%20%22PUB%22)%0A%7D%0A%2F%2Fmanagers%20list%20to%20be%20extracted%20from%20store%0Alet%20managers%20%3D%20store.managers.map%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20privmx.endpoint.core.UserWithPubKey(userId%3A%20%240%2C%20pubKey%3A%20%22PUB%22)%0A%7D%0A%0Aguard%20let%20newPrivateMeta%20%3D%20%22New%20store%20name%22.data(using%3A%20.utf8)%20else%20%7Breturn%7D%0A%0A_%20%3D%20try%3F%20endpointSession%3F.storeApi%3F.updateStore(%0A%20storeId%2C%0A%20atVersion%3A%20store.version%2C%0A%20replacingUsers%3A%20users%2C%0A%20replacingManagers%3A%20managers%2C%0A%20replacingPublicMeta%3A%20store.publicMeta.getData()%20%3F%3F%20Data()%2C%0A%20replacingPrivateMeta%3A%20newPrivateMeta%2C%0A%20force%3Afalse%2C%0A%20forceGenerateNewKey%3A%20false%2C%0A%20replacingPolicies%3Anil)%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0AThree%20additional%20options%20are%20available%20when%20changing%20the%20list%20of%20users%20inside%20a%20Store%3A%0A-%20%60force%60%20-%20applies%20an%20update%2C%20without%20checking%20the%20current%20version%3B%0A-%20%60forceGenerateNewKey%60%20-%20re-encrypts%20messages%20in%20the%20Store.%20It's%20useful%20when%20a%20user%20is%20removed%20and%20we%20want%20to%20prevent%20them%20from%20accessing%20the%20Store.%0A-%20%60policies%60%20-%20allow%20you%20to%20manage%20access%20to%20Stores%20and%20files.%20%5BRead%20more%20about%20Policies%5D(..%2Fconcepts%2Fpolicies).%0A%0A%23%23%20Deleting%20Stores%0A%0ADeleting%20a%20Store%20also%20removes%20all%20file%20data%20associated%20with%20it.%20%0A%0ABelow%20there%20is%20an%20example%20of%20deleting%20a%20Store%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20storeApi.deleteStore(storeId)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20await%20storeApi.deleteStore(storeId)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C%7B%0A%20%22icon%22%3A%20%22stores%22%2C%0A%20%22title%22%3A%20%22Stores%22%2C%0A%20%22pages%22%3A%20%5B%0A%20%22overview%22%2C%0A%20%22managing%22%2C%0A%20%22handling-files%22%2C%0A%20%22uploading-files%22%2C%0A%20%22downloading-files%22%2C%0A%20%22store-events%22%0A%20%5D%0A%7D%0A%2C---%0Atitle%3A%20API%20Reference%0A---%0A%0A%23%23%20PrivMX%20Endpoint%20API%0AUse%20PrivMX%20Endpoint%20API%20to%20develop%20and%20manage%20client%20apps%20using%20any%20of%20our%20libraries%20and%20wrappers.%0A%0A%5BPrivMX%20Endpoint%20API%20Reference%5D(..%2Freference%2Fstart)%0A%0A%0A%23%23%20PrivMX%20Bridge%20API%0AUse%20PrivMX%20Bridge%20API%20to%20manage%20your%20Bridge%20server%20instance%2C%20manage%20Solutions%20and%20Contexts%2C%20create%20containers%20and%20more.%0A%0A%5BPrivMX%20Bridge%20API%20Reference%5D(https%3A%2F%2Fbridge.privmx.dev%2F)%0A%2C---%0Atitle%3A%20Architecture%0A---%0A%23%23%20PrivMX%20Bridge%3A%20Fundamentals%0APrivMX%20Bridge%20is%20a%20server-side%2C%20zero-knowledge%20software%20that%20intermediates%20in%20the%20transfer%20of%20encrypted%20data%20and%20notifications%20between%20PrivMX%20Endpoints%20and%20stores%20encrypted%20data%20for%20Threads%2C%20Stores%2C%20Inboxes%2C%20and%20KVDBs.%0A%5BMore%20information%20and%20PrivMX%20Bridge%20installation%20guides.%5D(..%2Fstart%2Finstallation)%0A%0AWithin%20PrivMX%20Bridge%20there%20are%20fundamental%20concepts%20defining%20it's%20architecture%3A%0A%0A%23%23%23%20Solutions%0A%0AA%20Solution%20represents%20an%20isolated%20data%20environment%2C%20**designed%20for%20specific%20applications%20or%20IT%20solutions**.%0AEach%20Solution%20is%20completely%20separate%20from%20the%20others%2C%20to%20ensure%20that%20data%2C%20user%20interactions%2C%20and%20%5BContexts%5D(%23contexts)%20do%20not%20leak%20between%20them.%0A%0AA%20key%20architectural%20feature%20is%20that%20PrivMX%20Endpoint%20requires%20a%20specific%20Solution%20ID%20during%20connection.%20As%20a%20result%2C%20PrivMX%20Endpoint%20must%20first%20identify%20and%20request%20access%0Ato%20a%20particular%20Solution%20to%20interact%20with%20its%20internal%20resources.%0A%0A%23%23%23%23%20Key%20Features%0A%0A-%20**Solution%20Separation%3A**%20All%20the%20data%20inside%20Solutions%20is%20strictly%20isolated.%20There%20is%20no%20automatic%20sharing%20or%20access%20between%20Solutions%2C%20even%20though%20they%20are%20hosted%20within%20the%20same%20PrivMX%20Bridge%20instance.%0A%0A-%20**Creation%20and%20Management%3A**%20Each%20new%20Solution%20is%20created%20with%20its%20own%20unique%20ID%2C%20which%20is%20provided%20while%20connecting%20to%20PrivMX%20Bridge.%0A%0A-%20**Security%20Model%3A**%20Each%20Solution%20operates%20with%20its%20own%20Contexts%20and%20keys%2C%20ensuring%20strong%20data%20integrity%20and%20separation.%0AThe%20Solution%20itself%20does%20not%20manage%20or%20store%20information%20about%20its%20users%3B%20this%20is%20delegated%20to%20the%20Contexts.%0A%0A-%20**User%20Management%3A**%20Importantly%2C%20the%20Solution%20itself%20does%20not%20maintain%20a%20global%20user%20list.%0AUsers%20are%20associated%20only%20with%20the%20specific%20Contexts.%20This%20enhances%20the%20security%20and%20privacy%20model%20by%20minimizing%20exposure%20to%20unnecessary%20information%20about%20other%20Contexts%20or%20users.%0A%0AIn%20summary%2C%20a%20Solution%20provides%20a%20compartmentalized%20space%20for%20managing%20resources%20relevant%20to%20specific%20IT%20environments%20or%20applications%2C%20ensuring%20clear%20and%20strict%20separation%20of%20data.%0A%0A%23%23%23%20Contexts%0A%0AContexts%20provide%20another%20level%20of%20organization%20and%20are%20crucial%20for%20**user%20management**%20and%20**data%20access%20control**.%0AEach%20Context%20represents%20a%20distinct%20space%20within%20a%20%5BSolution%5D(%23solutions)%2C%20where%20users%20can%20be%20assigned%20specific%20roles%20and%20permissions%20using%20public%20keys.%20Every%20Context%20has%20to%20be%20assigned%20to%20a%20Solution.%0A%0A%23%23%23%23%20Key%20Features%0A%0A-%20**Public%20Key%20Assignment**%3A%20a%20Context%20is%20defined%20by%20the%20developer%20(it%20could%20be%20referring%20to%20a%20specific%20app%20feature%20or%20area).%0AUsers%20are%20associated%20with%20a%20Context%20by%20registering%20their%20public%20keys%20through%20the%20REST%20API%20provided%20by%20PrivMX%20Bridge.%0A%0A-%20**User%20Authentication%20and%20Authorization**%3A%20once%20users%20are%20assigned%20to%20a%20Context%2C%20they%20can%20authenticate%20themselves%20using%20their%20private%20keys.%0AAuthentication%20involves%20the%20verification%20of%20a%20digital%20signature%2C%20which%20is%20generated%20by%20the%20user%E2%80%99s%20private%20key%2C%20and%20verified%20using%20their%20public%20key%20stored%20in%20the%20Context.%0AIt%20is%20a%20seamless%20process%20for%20the%20developer%2C%20as%20it%20is%20fully%20handled%20by%20**PrivMX%20Endpoint**.%0A%0A-%20**Access%20Control**%3A%20user%20permissions%20within%20the%20Context%20are%20determined%20by%20Access%20Control%20Lists%20(ACL).%0AThese%20permissions%20define%20the%20actions%20users%20can%20perform%20within%20the%20Context%2C%20such%20as%20creating%2C%20updating%2C%20or%20accessing%20resources%20like%20Threads%2C%20Stores%2C%20and%20Inboxes.%0AThe%20ACL%20model%20ensures%20that%20each%20user%20has%20appropriate%20rights%20based%20on%20their%20role%20and%20the%20requirements%20of%20a%20particular%20Context.%0A%0A-%20**Resource%20Creation**%3A%20Within%20a%20Context%2C%20authorized%20users%20can%20create%20different%20types%20of%20encrypted%20tools%3A%0A%20-%20%5BThreads%5D(.%2Fthreads%2Foverview)%3A%20Secure%20chat%20spaces%20where%20users%20can%20exchange%20messages.%20Threads%20are%20end-to-end%20encrypted%20and%20accessible%20only%20for%20users%20with%20proper%20permissions.%0A%20-%20%5BStores%5D(.%2Fstores%2Foverview)%3A%20Encrypted%20containers%20for%20file%20storage%2C%20allowing%20non-sequential%20access%20and%20efficient%20file%20streaming.%0A%20-%20%5BInboxes%5D(.%2Finboxes%2Foverview)%3A%20Containers%20used%20for%20one%20way%20communication%20with%20external%20users%2C%20useful%20for%20scenarios%20like%20receiving%20encrypted%20data%20from%20web%20forms.%0A%20-%20%5BKVDBs%5D(.%2Fkvdbs%2Foverview)%3A%20Encrypted%20key-value%20databases.%0A%0AThe%20diagram%20below%20visualizes%20the%20structure%20and%20corelation%20between%20Contexts%20and%20Solutions%3A%0A%0A!%5BSolutions%20and%20Contexts%5D(%2Fimg%2Fprivmx-solution-context.png)%0A%2C---%0Atitle%3A%20Inbox%20Events%0A---%0A%0A%0AEvents%20play%20a%20crucial%20role%20in%20modern%20applications%2C%20allowing%20them%20to%20instantly%20respond%20to%20changes%20in%20stored%20data.%20Monitoring%20and%20reacting%20to%20entries%20and%20Inbox-related%20events%2C%20is%20essential%20for%20maintaining%20up-to-date%20records%2C%20triggering%20workflows%2C%20and%20ensuring%20synchronization%20across%20various%20parts%20of%20the%20system.%0A%0A%23%23%20Types%20of%20Events%0A%0ABefore%20receiving%20Events%2C%20your%20application%20must%20first%20subscribe%20to%20a%20group%20of%20events.%0AIn%20the%20case%20of%20Inbox%2C%20types%20of%20events%20are%20the%20following%3A%0A%0AInbox%20events%3A%0A-%20%60inboxCreated%60%20-%20triggers%20when%20a%20new%20Inbox%20is%20created%20in%20your%20Context%0A-%20%60inboxDeleted%60%20-%20triggers%20when%20an%20Inbox%20is%20deleted%20from%20your%20Context%0A-%20%60inboxUpdated%60%20-%20triggers%20when%20an%20Inbox%20is%20updated%20in%20your%20Context%0A%0AEntry%20events%3A%0A-%20%60inboxEntryCreated%60%20-%20triggers%20when%20an%20entry%20is%20sent%20to%20an%20Inbox%0A-%20%60inboxEntryDeleted%60%20-%20triggers%20when%20an%20entry%20is%20deleted%20from%20an%20Inbox%0A%0A%23%23%20Handling%20Inbox%20Events%0A%0A%3A%3A%3Ainfo%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Fusage%23initial-assumptions)**%20mentioned%20in%20%5BWorking%20with%20Inboxes%5D(.%2Fusage).%0A%0A%3A%3A%3A%0A%0AHere%20is%20an%20example%20of%20how%20to%20do%20it%20in%20your%20own%20project%3A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%20%22JavaScript%22%2C%20%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20Start%20by%20getting%20%60eventQueue%60%20instance%3A%0A%0A%20%60%60%60cpp%0A%20core%3A%3AEventQueue%20eventQueue%20%3D%20core%3A%3AEventQueue%3A%3AgetInstance()%3B%0A%20%60%60%60%0A%0A%20%60EventQueue%60%20provides%20%60waitEvent%60%20method%20that%20blocks%20main%20thread.%0A%20To%20avoid%20freezing%20the%20entire%20app%3A%0A%0A%20%60%60%60cpp%0A%20std%3A%3Athread%20t(%5B%26%5D()%7B%0A%20while(true)%20%7B%0A%20core%3A%3AEventHolder%20event%20%3D%20eventQueue.waitEvent()%3B%0A%20std%3A%3Acout%20%3C%3C%20%22Event%20Type%3A%20%22%20%3C%3C%20event.type()%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%7D)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20Start%20by%20getting%20%60eventQueue%60%20instance%20using%20Endpoint%3A%0A%0A%20%60%60%60js%0A%20const%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%0A%20%60%60%60%0A%0A%20%60EventQueue%60%20provides%20%60waitEvent%60%20method%20that%20blocks%20main%20browser's%20thread.%0A%20To%20avoid%20freezing%20the%20entire%20app%3A%0A%0A%20%60%60%60js%0A%20const%20eventQueue%20%3D%20await%20Endpoint.getEventQueue()%3B%0A%20let%20listenForEventsPromise%20%3D%20null%3B%0A%0A%20function%20listenForEvents(queue)%20%7B%0A%20if%20(!listenForEventsPromise)%20%7B%0A%20listenForEventsPromise%20%3D%20queue.waitEvent()%3B%0A%20listenForEventsPromise.then(result%20%3D%3E%20%7B%0A%20console.log(%22Event%20Received%3A%22%2C%20result)%3B%0A%20listenForEventsPromise%20%3D%20null%3B%0A%20listenForEvents(queue)%3B%0A%20%7D)%0A%20%7D%0A%20%7D%0A%0A%20listenForEvents(eventQueue)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0APrivMXEndpointSwiftExtra%20provides%20an%20implementation%20of%20event%20queue.%20You%20can%20start%20the%20processing%20by%20calling%3A%0A%60%60%60swift%0ATask%7B%0A%20try%3F%20await%20endpointContainer%3F.startListening()%0A%7D%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0AYou%20can%20now%20subscribe%20for%20events%20you%20need%3A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%20%22JavaScript%22%2C%20%22Swift%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20inboxApi.subscribeForInboxEvents()%0A%20%60%60%60%0A%20or%0A%20%60%60%60cpp%0A%20inboxApi.subscribeForEntryEvents(inboxID)%0A%20%60%60%60%0A%20When%20no%20longer%20needed%2C%20you%20can%20unsubscribe%20from%20events%3A%0A%0A%20%60%60%60cpp%0A%20inboxApi.unsubscribeFromInboxEvents()%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20await%20inboxApi.subscribeForInboxEvents()%0A%20%60%60%60%0A%20or%0A%20%60%60%60js%0A%20await%20inboxApi.subscribeForEntryEvents(inboxID)%0A%20%60%60%60%0A%20When%20no%20longer%20needed%2C%20you%20can%20unsubscribe%20from%20events%3A%0A%0A%20%60%60%60js%0A%20await%20inboxApi.unsubscribeFromInboxEvents()%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20try%3F%20endpointSession%3F.registerCallback(%0A%20for%3A%20privmx.endpoint.inbox.InboxCreatedEvent.self%2C%0A%20from%3A%20.inbox%2C%20%0A%20identified%3A%20%22some_id%22%2C%0A%20%7B%20eventData%20in%0A%20%2F%2F%20some%20actions%20when%20new%20inbox%20created%0A%20%7D)%0A%20%60%60%60%0A%20When%20no%20longer%20needed%2C%20you%20can%20remove%20the%20callbacks%2C%20event%20subscriptions%20will%20be%20managed%20automatically.%0A%0A%20%60%60%60swift%0A%20endpointContainer%3F.getEndpoint(endpointId)%3F.clearCallbacks(for%3A%20.inbox%20)%0A%0A%20endpointContainer%3F.getEndpoint(endpointId)%3F.clearCallbacks(identified%3A%20%22some_id%22)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C---%0Atitle%3A%20Overview%0A---%0A%0AInbox%20is%20a%20special%20kind%20of%20communication%20tool%20used%20for%20**one-way%20communication%20with%20external%20users**.%0A%0AAn%20authorized%20PrivMX%20user%20can%20create%20an%20Inbox%2C%20configure%20its%20snippet%20and%20place%20it%20in%20a%20desired%20place%20(like%20a%20webpage%20or%20an%20app).%20**Anonymous%2C%20unregistered%20users%20can%20send%20data%20to%20the%20Inbox**.%0AThis%20procedure%20uses%20Inbox%20Public%20Key%2C%20which%20allows%20to%20write%20data%20to%20an%20Inbox.%20One%20time%20access%20assures%20that%20the%20writer%20has%20no%20possibility%20of%20reading%20the%20data%20once%20it's%20sent.%0A%20%0AInboxes%20can%20be%20organized%20as%20source-specific%20containers%2C%20where%20anonymous%20users%20from%20each%20source%20can%20**securely%20submit%20encrypted%20data**%20(messages%2Fforms%2Ffiles).%20%0AAll%20the%20active%20users%20are%20notified%20right%20away%20when%20new%20data%20arrives.%20The%20data%20can%20be%20plain%20text%20or%20binary.%0A%0AAll%20the%20data%20is%20stored%20in%20the%20Bridge%20and%20can%20be%20freely%20accessed%20by%20authorized%20users.%0A%0A%23%23%20Use%20Cases%0A%0AInboxes%20are%20ideal%20for%20creating%20public%20online%20forms%20that%20collect%20sensitive%20information.%0AAll%20submitted%20data%20is%20encrypted%20before%20transmission%2C%20using%20a%20one-time%20private%20key%20generated%20on%20the%20user%E2%80%99s%20device.%0ASubmitted%20entries%20are%20only%20available%20to%20users%20with%20access%20to%20the%20given%20Inbox.%0A%0A%23%23%20Prerequisites%0A%0ABefore%20working%20with%20Inboxes%2C%20you%20need%20to%20have%20a%20PrivMX%20Bridge%20instance.%0A%0ATo%20install%20it%2C%20%5Bfollow%20our%20PrivMX%20quick%20start%20guide%5D(..%2Fquick-start).%0A%0A%23%23%20Architecture%0A%0AInboxes%20are%20containers%20for%20anonymous%20submissions.%20Think%20of%20an%20Inbox%20as%20a%20container%20that%20allows%20anonymous%20sources%20to%20send%20submissions%20with%20attachments%20(such%20as%20a%20form%20from%20your%20company's%20webpage).%20%0AEach%20Inbox%20has%20its%20own%20set%20of%20permissions%2C%20managed%20by%20assigning%20the%20users%E2%80%99%20public%20keys.%20**Only%20the%20users%20with%20assigned%20public%20keys%20can%20read%20data%20submitted%20to%20that%20Inbox**.%0ADecryption%20of%20the%20data%20is%20possible%20only%20with%20the%20corresponding%20private%20keys.%0A%0AInboxes%20use%20public%20key%20access%20for%20submitting%20any%20data%20by%20anonymous%20users.%20Dual-layer%20encryption%20for%20accessing%20this%20data%2C%20ensures%20that%20the%20system%20remains%20both%20safe%20and%20efficient.%20%0A%0AThe%20following%20diagram%20is%20a%20visual%20reference%20for%20the%20architecture%20of%20Inboxes%3A%0A!%5Bprivmx%20inboxes%20encryption%5D(%2Fimg%2Fprivmx-inboxes.svg)%0A%0A%23%23%20Encryption%20in%20Inboxes%0A%0AOnly%20an%20end%20user%20can%20create%20an%20Inbox%2C%20by%20providing%20a%20set%20of%20public%20keys%20for%20the%20users%20who%20should%20have%20access%20to%20the%20Inbox.%0A%0AAn%20asymmetric%20public%20key%20is%20used%20to%20write%20to%20the%20Inbox%2C%20which%20allows%20anonymous%20external%20users%20to%20submit%20Inbox%20entries.%0A%0AA%20key%20for%20reading%20the%20Inbox%20(Inbox%20Encryption%20Key)%20is%20generated%20always%20**by%20the%20Inbox%20author%2Fowner**%20and%20securely%20stored%20on%20the%20server%2C%20encrypted%20using%20public%20keys%20of%20**users%20assigned%20to%20the%20Inbox%20and%20all%20its%20submissions**.%0AThis%20ensures%20that%20only%20the%20authorized%20users%20can%20access%20the%20Inbox%20Encryption%20Key.%20**Unencrypted%20keys%20never%20leave%20user%20Endpoints.**%0A%0AWhen%20accessing%20an%20Inbox%20and%20its%20submissions%2C%20the%20encrypted%20Inbox%20Encryption%20Key%20is%20securely%20transmitted%20based%20on%20the%20users'%20permissions.%20Only%20the%20users%20with%20proper%20Private%20Keys%20can%20decrypt%20Inbox%20Encryption%20Key.%0AUsing%20this%20key%2C%20submissions%20are%20decrypted%20in%20the%20Endpoint%20environment.%0A%0AThis%20process%20is%20handled%20by%20PrivMX%20Endpoint%20library%20and%20is%20completely%20seamless%20for%20Endpoint%20users.%0A%2C---%0Atitle%3A%20Working%20with%20Inboxes%0A---%0A%0AInboxes%20provide%20a%20secure%20way%20to%20receive%20entries%20from%20both%20internal%20and%20external%20sources.%0A%0A-%20Entries%20can%20contain%20binary%20data%20and%20files.%0A-%20Each%20%5BContext%5D(..%2Farchitecture%23contexts)%20can%20contain%20any%20number%20of%20Inboxes%20with%20unique%20identifiers%20(%60inboxId%60)%20used%20to%20distinguish%20them.%0A-%20Everyone%20with%20access%20to%20%60inboxID%60%2C%20%60solutionID%60%2C%20and%20Bridge%20URL%20can%20send%20an%20entry%2C%20but%20only%20the%20users%20who%20are%20added%20to%20given%20Inbox%20can%20read%20them.%0A%0A%23%23%20Permissions%0A%0AThe%20user%20list%20in%20Inbox%20is%20designed%20to%20be%20flexible%2C%20accommodating%20a%20wide%20range%20of%20use%20cases.%0A%0AInboxes%20differentiate%20three%20types%20of%20users%3A%20Regular%20Users%2C%20Managers%2C%20and%20External%20Users.%20The%20table%20below%20shows%20what%20actions%20can%20be%20performed%20by%20each%20type%20of%20users%3A%0A%0A%7C%20**Activity**%20%7C%20**User**%20%7C%20**Manager**%20%7C%20**External**%20%7C%0A%7C--------------------%7C----------%7C-------------%7C--------------%7C%0A%7C%20Submitting%20entries%20%7C%20yes%20%7C%20yes%20%7C%20yes%20%7C%0A%7C%20Fetching%20entries%20%7C%20yes%20%7C%20yes%20%7C%20no%20%7C%0A%7C%20Deleting%20entries%20%7C%20no%20%7C%20yes%20%7C%20no%20%7C%0A%7C%20Editing%20Inbox%20%7C%20no%20%7C%20yes%20%7C%20no%20%7C%0A%0AThe%20values%20above%20are%20the%20default%20policy%20values%20defined%20by%20PrivMX.%20To%20read%20more%20about%20Policies%20and%20learn%20how%20to%20modify%20them%2C%20go%20to%20%5BPolicies%5D(..%2Fconcepts%2Fpolicies).%0A%0A%23%23%20Initial%20Assumptions%0AThe%20initial%20assumptions%20for%20all%20the%20code%20examples%20below%20are%20as%20follows%3A%0A%0A%3A%3A%3Ainfo%0A%0AReplace%20placeholder%20values%20such%20as%20%60BRIDGE_URL%60%2C%20%60SOLUTION_ID%60%2C%20%60CONTEXT_ID%60%0Awith%20those%20corresponding%20to%20your%20PrivMX%20Bridge%20instance.%5C%0A%5C%0AThe%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%0ANormally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0Aor%20generated%20from%20a%20password%20(see%20the%20%5B%60derivePrivateKey2()%60%5D(..%2F..%2Freference%2Fendpoint%2Fcrypto%2Fcrypto-api%23deriveprivatekey2)%20method%20in%20Crypto%20API)%0A%0A%3A%3A%3A%0A%0A%3CTabs%20items%3D%7B%5B%22C%2B%2B%22%2C%20%22JavaScript%22%2C%20%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FConnection.hpp%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fthread%2FThreadApi.hpp%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fstore%2FStoreApi.hpp%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Finbox%2FInboxApi.hpp%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FBuffer.hpp%3E%0A%20%2F%2F%20...%0A%0A%20%2F*%20%0A%20All%20the%20values%20below%20like%20BRIDGE_URL%2C%20SOLUTION_ID%2C%20CONTEXT_ID%20%0A%20should%20be%20replaced%20by%20the%20ones%20corresponding%20to%20your%20Bridge%20Server%20instance.%0A%0A%20The%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%20%0A%20Normally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0A%20or%20generated%20from%20a%20password%20(see%20the%20derivePrivateKey2()%20method%20in%20the%20Crypto%20API).%0A%20*%2F%0A%0A%20std%3A%3Astring%20BRIDGE_URL%20%7B%22http%3A%2F%2Flocalhost%3A9111%22%7D%3B%0A%20std%3A%3Astring%20SOLUTION_ID%20%7B%22YOUR_SOLUTION_ID%22%7D%3B%0A%20std%3A%3Astring%20CONTEXT_ID%20%7B%22YOUR_CONTEXT_ID%22%7D%3B%0A%0A%20std%3A%3Astring%20USER1_ID%20%7B%22user_1%22%7D%3B%0A%20std%3A%3Astring%20USER1_PUBLIC_KEY%20%7B%22PUBLIC_KEY_1%22%7D%3B%0A%20std%3A%3Astring%20USER1_PRIV%20%7B%22PRIVATE_KEY_1%22%7D%3B%0A%0A%20std%3A%3Astring%20USER2_ID%20%7B%22user_2%22%7D%3B%0A%20std%3A%3Astring%20USER2_PUBLIC_KEY%20%7B%22PUBLIC_KEY_2%22%7D%3B%0A%0A%20std%3A%3Astring%20USER3_ID%20%7B%22user_3%22%7D%3B%0A%20std%3A%3Astring%20USER3_PUBLIC_KEY%20%7B%22PUBLIC_KEY_3%22%7D%3B%0A%0A%20%2F%2F%20initialize%20Endpoint%20connection%20and%20Threads%20API%0A%20auto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIV%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0A%20auto%20threadApi%20%7Bthread%3A%3AThreadApi%3A%3Acreate(connection)%7D%3B%0A%20auto%20storeApi%20%7Bstore%3A%3AStoreApi%3A%3Acreate(connection)%7D%3B%0A%20auto%20inboxApi%20%7Binbox%3A%3AInboxApi%3A%3Acreate(connection%2C%20threadApi%2C%20storeApi)%7D%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20const%20BRIDGE_URL%20%3D%20%22http%3A%2F%2Flocalhost%3A9111%22%3B%0A%20const%20SOLUTION_ID%20%3D%20%22YOUR_SOLUTION_ID%22%3B%0A%20const%20CONTEXT_ID%20%3D%20%22YOUR_CONTEXT_ID%22%3B%0A%0A%20const%20USER1_ID%20%3D%20%22user_1%22%3B%0A%20const%20USER1_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_1%22%3B%0A%20const%20USER1_PRIV%20%3D%20%22PRIVATE_KEY_1%22%3B%0A%0A%20const%20USER2_ID%20%3D%20%22user_2%22%3B%0A%20const%20USER2_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_2%22%3B%0A%0A%20const%20USER3_ID%20%3D%20%22user_3%22%3B%0A%20const%20USER3_PUBLIC_KEY%20%3D%20%22PUBLIC_KEY_3%22%3B%0A%0A%20%2F%2Fhelper%20functions%20for%20encoding%20and%20decoding%20strings%0A%20function%20uint8ToStr(arr)%20%7B%0A%20return%20(new%20TextDecoder()).decode(arr)%3B%0A%20%7D%0A%0A%20function%20strToUint8(text)%20%7B%0A%20return%20(new%20TextEncoder()).encode(text)%3B%0A%20%7D%0A%0A%20%2F%2F%20Initialize%20Endpoint%20and%20its%20Wasm%20assets%0A%20await%20Endpoint.setup(%22%2Fpublic%22)%3B%0A%0A%20%2F%2F%20initialize%20Endpoint%20connection%2C%20Threads%20API%2C%20Store%20API%0A%20const%20connection%20%3D%20await%20Endpoint.connect(USER1_PRIV%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%3B%0A%20const%20threadApi%20%3D%20await%20Endpoint.createThreadApi(connection)%3B%0A%20const%20storeApi%20%3D%20await%20Endpoint.createStoreApi(connection)%3B%0A%0A%20%2F%2F%20Inbox%20API%20require%20Thread%20API%20and%20Store%20API%20instance%0A%20const%20inboxApi%20%3D%20await%20Endpoint.createInboxApi(connection%2CthreadApi%2CstoreApi)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0A%60%60%60swift%0Atry%20endpointContainer.setCertsPath(to%3A%20pathToCerts)%0A%0A%2F%2F%20Establish%20a%20new%20%60PrivMXEndpoint%60%20session%0Avar%20endpointSession%20%3D%20try%20await%20endpointContainer.newEndpoint(%0A%20enabling%3A%20%5B.thread%2C.store%2C.inbox%2C.event%5D%2C%0A%20connectingAs%3A%20USER1_PRIVATE_KEY%2C%0A%20to%3A%20SOLUTION_ID%2C%0A%20on%3A%20BRIDGE_URL%0A)%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0A%23%23%20Creating%20Inbox%0A%0ATo%20create%20an%20Inbox%2C%20you%20need%20to%20name%20it%20and%20provide%20a%20list%20of%20**public%20key%20-%20userID**%20pairs.%0ADue%20to%20the%20fact%20that%20each%20Inbox%20is%20inside%20a%20Context%2C%20all%20the%20public%20keys%20have%20to%20be%20registered%20inside%20the%20given%20Context.%0AYou%20can%20do%20it%20using%20Bridge%20API%20%5B%60context%2FaddUserToContext%60%5D(https%3A%2F%2Fbridge.privmx.dev%2F%23context-addusertocontext)%20method.%0A%0AWhile%20creating%20an%20Inbox%2C%20you%20can%20also%20provide%20additional%20information%3A%0A%0A-%20%60publicMeta%60%20contains%20additional%20info%20about%20the%20Inbox.%20It%20is%20not%20encrypted%20before%20sending%20to%20PrivMX%20Bridge.%0A%20Inbox%20API%20provides%20methods%20for%20accessing%20this%20field%20as%20%60publicView%60.%20For%20more%20information%20about%20Inbox%20%60publicView%60%20and%0A%20its%20common%20use%20cases%20go%20to%20%5BUsing%20Public%20View%5D(%23using-public-view).%0A%0A-%20%60privateMeta%60%20this%20field%20will%20be%20encrypted%20by%20PrivMX%20Endpoint%20before%20sending%20to%20PrivMX%20Bridge.%0A%20It's%20meant%20to%20store%20additional%20sensitive%20information%20about%20the%20Inbox.%20%60privateMeta%60%20is%20accessible%20only%20for%20users%20registered%20to%20the%20given%20Inbox.%0A%0A-%20%60filesConfig%60%20you%20can%20specify%20up%20front%20file%20requirements%20for%20each%20entry%20submitted%20to%20the%20Inbox.%0A%20This%20config%20includes%20min%20and%20max%20count%20of%20files%20in%20an%20entry%2C%20their%20max%20size%2C%20but%20also%20max%20size%20of%20whole%20upload.%0A%0A-%20%60policy%60%20determines%20what%20actions%20will%20be%20available%20to%20specific%20users.%20For%20more%20information%20and%20use%20cases%2C%20go%20to%20%5BPolicies%5D(..%2Fconcepts%2Fpolicies).%0A%0APublic%20and%20private%20metadata%20is%20sent%20in%20binary%20format.%0A%0AAfter%20creating%20an%20Inbox%2C%20all%20the%20users%20with%20management%20rights%20will%20be%20able%20to%20edit%20it.%20Skip%20to%20%5BModifying%20Inboxes%5D(%23modifying-inboxes)%20for%20more%20info.%0A%0AThe%20examples%20below%20demonstrate%20how%20to%20create%20Inboxes%3A%0A%0A%3CTabs%20items%3D%7B%5B%22C%2B%2B%22%2C%20%22JavaScript%22%5D%7D%3E%0A%3CTab%3E%0A%20Create%20a%20new%20Inbox%20with%20access%20for%20%60user_1%60%20as%20a%20manager%20and%20%60user_2%60%20as%20a%20regular%20user.%0A%20You%20can%20include%20the%20name%20of%20the%20Inbox%20within%20the%20%60privateMeta%60%20object.%20This%20metadata%20is%20encrypted%20before%20being%20sent%20to%20PrivMX%20Bridge%2C%20ensuring%20its%20confidentiality.%0A%0A%20%60%60%60cpp%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%0A%20%7D%3B%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%2C%0A%20core%3A%3AUserWithPubKey%7BUSER2_ID%2C%20USER2_PUBLIC_KEY%7D%0A%20%7D%3B%0A%20%2F%2F%20create%20a%20new%20Inbox%20with%20access%20for%20user_1%20as%20manager%20and%20user_2%20as%20regular%20user%0A%20auto%20storeId%20%7BinboxApi.createInbox(CONTEXT_ID%2C%20users%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20store's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20store's%20private%20meta-data%22)%0A%20)%7D%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20Create%20a%20new%20Inbox%20with%20access%20for%20%60user_1%60%20as%20a%20manager%20and%20%60user_2%60%20as%20a%20regular%20user.%0A%20You%20can%20include%20the%20name%20of%20the%20Inbox%20within%20the%20%60privateMeta%60%20object.%20This%20metadata%20is%20encrypted%20before%20being%20sent%20to%20PrivMX%20Bridge%2C%20ensuring%20its%20confidentiality.%0A%0A%20%60%60%60js%0A%20const%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%20%5D%3B%0A%0A%20const%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%20%5D%3B%0A%0A%20const%20storeId%20%3D%20await%20inboxApi.createInbox(%0A%20CONTEXT_ID%2C%0A%20users%2C%0A%20managers%2C%0A%20this.strToUint8(%22some%20store's%20public%20meta-data%22)%2C%0A%20this.strToUint8(JSON.stringify(%7B%0A%20name%3A%20%22some_store%22%0A%20%7D))%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%3CCallout%3E%0AManagers%20declared%20while%20creating%20the%20Inbox%2C%20also%20have%20to%20be%20included%20in%20the%20regular%20user%20list.%0A%3C%2FCallout%3E%0A%0A%23%23%20Listing%20Inboxes%0A%0AYour%20application%20may%20include%20multiple%20Inboxes%2C%20each%20associated%20with%20different%20Contexts.%0AYou%20can%20retrieve%20a%20**list%20of%20all%20Inboxes%20within%20a%20given%20Context.**%0AThis%20list%2C%20alongside%20the%20metadata%20you%20sent%20while%20creating%20the%20Inbox%2C%20will%20include%20useful%20metadata%20about%20the%20Inbox%2C%20such%20as%20the%20creation%20date%2C%0Alast%20file%20upload%20date%2C%20user%20list%2C%20and%20information%20about%20the%20last%20modification.%0A%0APrivMX%20Endpoint%20**takes%20care%20of%20decrypting%20received%20data**%2C%20which%20means%20you%20only%20have%20to%20take%20care%20of%20decoding%20them%20from%0Abinary%20format.%0A%0AHere's%20an%20example%20of%20how%20to%20download%20the%20last%2030%20Inboxes%20created%20within%20a%20Context%3A%0A%0A%3CTabs%20items%3D%7B%5B%22C%2B%2B%22%2C%20%22JavaScript%22%2C%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20core%3A%3APagingQuery%20defaultListQuery%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%2030%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%0A%20%2F%2F%20fetching%20Inboxes%0A%20auto%20inboxList%20%7BinboxApi.listInboxes(CONTEXT_ID%2C%20defaultListQuery)%7D%3B%0A%20for%20(const%20auto%26%20inbox%20%3A%20inboxList.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22Inbox%20ID%3A%20%22%20%3C%3C%20inbox.inboxId%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20const%20query%3A%20Types.PagingQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%2030%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0A%20const%20result%20%3D%20await%20inboxApi.listInboxes(CONTEXT_ID%2C%20query)%3B%0A%20for%20(const%20inbox%20of%20result.readItems)%20%7B%0A%20console.log(%22Inbox%20ID%3A%20%22%2C%20store.storeId)%3B%0A%0A%20%2F%2F%20Decode%20the%20data%20back%20into%20a%20string%20and%20parse%20its%20content%0A%20const%20privateMeta%20%3D%20JSON.parse(uint8ToStr(inbox.privateMeta))%0A%20console.log(privateMeta)%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%60%60%60swift%0A%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0ATo%20limit%20collecting%20too%20much%20data%20when%20downloading%20Inboxes%2C%20specify%20the%20amount%20of%20results%20to%20be%20skipped%20(minimum%200)%20and%20the%20amount%20of%20results%20to%20be%20downloaded.%0A%0A%0A%23%23%20Modifying%20Inboxes%0A%0ADepending%20on%20your%20project's%20specification%2C%20it%20may%20be%20necessary%20to%20modify%20an%20Inbox.%0AIt%20could%20be%2C%20for%20example%2C%20changing%20the%20name%20or%20adding%2Fremoving%20users.%0AEach%20user%20with%20management%20rights%20is%20able%20to%20modify%20Inboxes%2C%20delete%20them%20as%20a%20whole%20or%20only%20particular%20entries.%0A%0AUpdating%20an%20Inbox%20means%20overwriting%20it%20with%20the%20provided%20data.%0ATo%20successfully%20update%20an%20Inbox%2C%20you%20must%20specify%20its%20current%20%60version%60.%0AThe%20%60version%60%20field%20is%20mandatory%20to%20handle%20multiple%20updates%20on%20the%20server%2C%20and%20it%20is%20incremented%20by%201%20with%20each%20update.%0A%0ABelow%20there%20is%20an%20example%20of%20modifying%20an%20Inbox%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Swift%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20Add%20a%20new%20user%20to%20the%20existing%20ones%20in%20the%20Inbox%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20newUsersList%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%2C%0A%20core%3A%3AUserWithPubKey%7BUSER2_ID%2C%20USER2_PUBLIC_KEY%7D%0A%20core%3A%3AUserWithPubKey%7BUSER3_ID%2C%20USER3_PUBLIC_KEY%7D%0A%20%7D%3B%0A%20%2F%2F%20Getting%20a%20single%20Inbox%0A%20auto%20currentInbox%20%7BinboxApi.getInbox(inboxId)%7D%3B%0A%0A%20%2F%2F%20Update%20a%20new%20Inbox%20with%20access%20for%20USER_1%20as%20the%20only%20user.%0A%20inboxApi.updateInbox(%0A%20inboxId%2C%20%0A%20users%2C%20managers%2C%0A%20currentInbox.publicMeta%2C%20%0A%20currentInbox.privateMeta%2C%0A%20currentInbox.filesConfig%2C%0A%20currentInbox.version%2C%20%2F%2F%20%3C-%20pass%20the%20version%20of%20the%20Inbox%20you%20will%20perform%20the%20update%20on%0A%20false%2C%20%2F%2F%20%3C-%20force%20update%20(without%20checking%20version)%0A%20false%20%2F%2F%20%3C-%20force%20to%20regenerate%20a%20key%20for%20the%20Store%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20Add%20a%20new%20user%20to%20the%20existing%20ones%20in%20the%20Inbox%0A%20const%20newUsersList%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER3_ID%2C%20pubKey%3A%20USER3_PUBLIC_KEY%7D%0A%20%5D%3B%0A%0A%20const%20inbox%20%3D%20await%20inboxApi.getInbox(inboxId)%3B%0A%0A%20%2F%2F%20Edit%20the%20Inbox%20name%0A%20const%20privateMeta%20%3D%20JSON.parse(uint8ToStr(inbox.privateMeta))%3B%0A%20privateMeta.name%20%3D%20%22New%20Inbox%20Name%22%3B%0A%0A%20await%20inboxApi.updateInbox(%0A%20inboxId%2C%0A%20newUsersList%2C%0A%20managers%2C%0A%20inbox.publicMeta%2C%0A%20strToUint8(JSON.stringify(privateMeta))%2C%0A%20inbox.version%2C%0A%20false%2C%20%2F%2F%20force%0A%20false%20%2F%2F%20forceGenerateNewKey%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0A%0A%60%60%60swift%0Alet%20inboxId%20%3D%20%22INBOX_ID%22%0Alet%20inboxPublicMeta%20%3D%20InboxPublicMeta(tags%3A%20%5B%22TAG1%22%2C%22TAG2%22%2C%22TAG3%22%5D)%0Aguard%20let%20publicMeta%20%3D%20try%3F%20JSONEncoder().encode(inboxPublicMeta)%20else%20%7Breturn%7D%0Aguard%20let%20inbox%20%3D%20try%3F%20endpointSession%3F.inboxApi%3F%0A%20.getInbox(inboxId)%20else%20%7Breturn%7D%0A%0A%2F%2Fusers%20list%20to%20be%20extracted%20from%20inbox%0Alet%20users%20%3D%20inbox.users.map%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20privmx.endpoint.core.UserWithPubKey(userId%3A%20%240%2C%20pubKey%3A%20%22PUB%22)%0A%7D%0A%2F%2Fmanagers%20list%20to%20be%20extracted%20from%20inbox%0Alet%20managers%20%3D%20inbox.managers.map%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20privmx.endpoint.core.UserWithPubKey(userId%3A%20%240%2C%20pubKey%3A%20%22PUB%22)%0A%7D%0A%0Aguard%20let%20newPrivateMeta%20%3D%20%22New%20Inbox%20name%22.data(using%3A%20.utf8)%20else%20%7Breturn%7D%0Aguard%20let%20filesConfig%3Aprivmx.endpoint.inbox.FilesConfig%20%3D%20inbox.filesConfig.value%20else%20%7Breturn%7D%0A%0A_%20%3D%20try%3F%20endpointSession%3F.inboxApi%3F.updateInbox(%0A%20inboxId%2C%0A%20replacingUsers%3A%20users%2C%0A%20replacingManagers%3A%20managers%2C%0A%20replacingPublicMeta%3A%20inbox.publicMeta.getData()%20%3F%3F%20Data()%2C%0A%20replacingPrivateMeta%3A%20newPrivateMeta%2C%0A%20replacingFilesConfig%3A%20filesConfig%2C%0A%20atVersion%3A%20inbox.version%2C%0A%20force%3Afalse%2C%0A%20forceGenerateNewKey%3A%20false%2C%0A%20replacingPolicies%3Anil)%0A%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%0A%3C%2FTabs%3E%0A%0AThree%20additional%20options%20are%20available%20when%20changing%20the%20list%20of%20users%20inside%20an%20Inbox%3A%0A-%20%60force%60%20-%20applies%20an%20update%2C%20without%20checking%20the%20current%20version.%0A-%20%60forceGenerateNewKey%60%20-%20re-encrypts%20entries%20in%20the%20Inbox.%20It's%20useful%20when%20a%20user%20is%20removed%2C%20and%20you%20want%20to%20prevent%20them%20from%20accessing%20the%20Inbox.%0A-%20%60policy%60%20-%20you%20can%20also%20pass%20a%20new%20policy%20object%20as%20the%20last%20optional%20argument.%0A%0A%23%23%20Deleting%20an%20Inbox%0A%0AYou%20can%20delete%20an%20Inbox%20using%20the%20%60deleteInbox%60%20method.%0A%0ABelow%20there%20is%20an%20example%20of%20deleting%20an%20Inbox%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20inboxApi.deleteInbox(inboxId)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20await%20inboxApi.deleteInbox(inboxId)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0A%23%23%20Using%20Public%20View%0A%0AYou%20can%20fetch%20Inbox%20public%20view%20using%20%60getInboxPublicView%60.%0APublic%20view%20contains%20the%20%5B%60publicMeta%60%5D(%23creating-inbox)%20field%20from%20Inbox.%0A%0A%3A%3A%3Ainfo%0A%0AKeep%20in%20mind%20that%20every%20user%20with%20access%20to%20Inbox%20ID%20can%20get%20its%20public%20view.%0A%0A%3A%3A%3A%0A%0AIn%20Inboxes%2C%20%60publicMeta%60%20can%20store%20information%20about%20the%20required%20structure%20of%20an%20entry.%0A%0AFor%20example%2C%20while%20creating%20an%20Inbox%2C%20you%20could%20save%20the%20required%20fields%3A%0A%0A%60%60%60json%20title%3D%22publicMeta%22%0A%7B%0A%20%22fields%22%3A%20%5B%0A%20%7B%0A%20%22type%22%3A%20%22text%22%2C%0A%20%22question%22%3A%20%22Your%20Name%22%0A%20%7D%2C%0A%20%7B%0A%20%22type%22%3A%20%22select%22%2C%0A%20%22question%22%3A%20%22Favorite%20Language%22%2C%0A%20%22options%22%3A%20%5B%22JavaScript%22%2C%22Java%22%2C%22Swift%22%2C%22C%23%22%5D%0A%20%7D%0A%20%5D%0A%7D%0A%60%60%60%0A%0AThen%2C%20you%20can%20dynamically%20create%20a%20form%20based%20on%20this%20schema%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Swift%22%5D%7D%20%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20Retrieve%20and%20print%20the%20public%20view%20of%20the%20Inbox%0A%20auto%20publicView%20%7BinboxApi.getInboxPublicView(inboxId)%7D%3B%0A%20std%3A%3Acout%20%3C%3C%20%22Public%20meta%3A%20%22%20%3C%3C%20publicView.publicMeta.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20publicView%20%3D%20await%20inboxApi.getInboxPublicView(INBOX_ID)%0A%20const%20publicMeta%20%3D%20JSON.parse(uint8ToStr(publicView.publicMeta))%0A%20%60%60%60%0A%20In%20React%2C%20for%20example%2C%20you%20could%20map%20each%20of%20the%20fields%20to%20its%20input%20types%3A%0A%0A%20%60%60%60jsx%0A%20%2F%2Frest%20of%20your%20component%0A%0A%20%3Cform%3E%0A%20%7BpublicMeta.fields.map(field%20%3D%3E%20%7B%0A%20switch%20(field.type)%20%7B%0A%20case%20%22text%22%3A%0A%20return%20(%0A%20%3C%3E%0A%20%3Clabel%3E%7Bfield.question%7D%3C%2Flabel%3E%0A%20%3Cinput%20type%3D%7B%22text%22%7D%20name%3D%7Bfield.question%7D%20%2F%3E%0A%20%3C%2F%3E%0A%20)%0A%20case%20%22select%22%3A%0A%20return%20(%0A%20%3C%3E%0A%20%3Clabel%3E%7Bfield.question%7D%3C%2Flabel%3E%0A%20%3Cselect%20name%3D%7Bfield.question%7D%3E%0A%20%7Bfield.options.map(option%20%3D%3E%20(%0A%20%3Coption%20value%3D%7Boption%7D%3E%7Boption%7D%3C%2Foption%3E%0A%20))%7D%0A%20%3C%2Fselect%3E%0A%20%3C%2F%3E%0A%20)%0A%20default%3A%0A%20return%20%3C%3E%3C%2F%3E%0A%20%7D%0A%20%7D)%7D%0A%20%3C%2Fform%3E%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20struct%20InboxPublicMeta%3ACodable%7B%0A%20let%20tags%3A%20%5BString%5D%0A%20%2F%2Fdefinition%20by%20developer%0A%20%7D%0A%0A%20let%20inboxID%20%3D%20%22INBOX_ID%22%20%0A%20guard%20let%20inboxPublicView%20%3D%20try%3F%20publicEndpointSession%3F.inboxApi%3F.getInboxPublicView(for%3A%20inboxID)%20else%20%7Breturn%7D%0A%20guard%20let%20inboxPublicMetaData%20%3D%20inboxPublicView.publicMeta.getData()%20else%20%7Breturn%7D%0A%20let%20inboxPublicMetaDecoded%20%3D%20try%3F%20JSONDecoder().decode(InboxPublicMeta.self%2C%20from%3A%20inboxPublicMetaData)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%2C---%0Atitle%3A%20Inbox%20Entries%0A---%0A%0A%0A%0AInboxes%20allow%20users%20to%20receive%20encrypted%20entries%2C%20either%20from%20external%20or%20internal%20sources.%0A%0A-%20Internal%20sources%20are%20people%20who%20have%20access%20to%20an%20Inbox%2C%20or%20are%20simply%20registered%20in%20a%20given%20Context.%0AThose%20users%20are%20known%20to%20your%20application%2C%20and%20their%20entries%20can%20be%20linked%20to%20their%20accounts.%0A%0A-%20External%20sources%20are%20people%20from%20the%20outside%3B%20they%20do%20not%20have%20an%20account%20linked%20with%20your%20app.%20For%20example%2C%0Asomeone%20who%20fills%20out%20an%20online%20contact%20form%20without%20the%20need%20to%20create%20an%20account.%0A%0AThe%20key%20difference%20between%20Inboxes%20and%20other%20PrivMX%20containers%20is%20that%20people%20don't%20need%20accounts%20in%20your%20app%20to%20be%20able%20to%20submit%20entries.%0A%0A%23%23%20About%20Entries%0A%0AThe%20structure%20of%20an%20entry%20and%20a%20brief%20description%20of%20its%20elements%20is%20outlined%20in%20the%20following%20table%3A%0A%0A%7C%20**Field**%20%7C%20**Type**%20%7C%20**Encrypted**%20%7C%20**Description**%20%7C%0A%7C----------------%7C----------%7C%3A--------------------%3A%7C--------------------------%7C%0A%7C%20%60data%60%20%7C%20binary%20%7C%20%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20Content%20of%20the%20entry%20%7C%0A%7C%20%60files%60%20%7C%20File%5B%5D%20%7C%20%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20List%20of%20attached%20files%20%7C%0A%7C%20%60authorPubKey%60%20%7C%20string%20%7C%20%7C%20Public%20key%20of%20the%20author%20%7C%0A%0A%0A%0A%23%23%20Define%20Data%20Structure%0A%0AInbox's%20architecture%20does%20not%20require%20you%20to%20use%20a%20specific%20data%20structure%20inside%20the%20entries.%0A**Before%20working%20with%20Inboxes%2C%20define%20the%20structure%20of%20your%20entries**.%0A%0A%3A%3A%3Ainfo%0A%0AWe%20recommend%20future-proofing%20your%20entries%20by%20choosing%20an%20easily%20modifiable%20format.%20It%20is%20a%20good%20idea%20to%20include%20both%20a%20%60type%60%20and%20a%20%60version%60%20field%20in%20the%20structure.%0A%0A%3A%3A%3A%0A%0A%23%23%23%20Example%3A%20Form%20with%20Text%20Answer%0A%0A%60%60%60%20json%20title%3D%22JSON%22%20%0A%7B%0A%20%E2%80%9Ccontent%E2%80%9D%3A%20%7B%0A%20%22answer%22%3A%20USER_PROVIDED_TEXT%0A%20%7D%2C%0A%20%E2%80%9Cversion%E2%80%9D%3Anumber%2C%0A%20%E2%80%9Ctype%E2%80%9D%3A%20%22text_answer%22%2C%0A%7D%0A%60%60%60%0AThe%20%60type%60%20field%20allows%20future%20support%20for%20different%20types%20of%20entries%20like%3A%20%60%22select_answer%22%60%2C%20or%20%60%22multi_select%22%60.%0AAnd%20in%20case%20of%20changing%20the%20schema%2C%20you%20can%20always%20distinguish%20between%20them%20using%20%60%22version%22%60%20field.%0A%0ARemember%20that%20this%20is%20only%20an%20example%20and%20you%20should%20consider%20your%20app's%20requirements%20and%20limitations.%0A%0A%23%23%20Submitting%20Entries%0A%0ATo%20submit%20an%20entry%2C%20you%20need%3A%0A%0A-%20URL%20of%20your%20PrivMX%20Bridge%20Instance%0A-%20Solution%20ID%20with%20at%20least%20one%20Inbox%20created%0A-%20ID%20of%20the%20Inbox%20to%20submit%20the%20entry%0A%0AIf%20you%20need%20more%20information%20about%20how%20to%20create%20an%20Inbox%2C%20go%20to%20%5BCreating%20Inbox%5D(.%2Fusage%23creating-inbox).%0A%0A%23%23%20Sending%20Process%0A%0ASending%20entries%20is%20carried%20out%20in%20two%20(or%20three%20if%20files%20are%20attached)%20steps.%0A%0A%0A%3Cdiv%20className%3D%22fd-steps%22%3E%0A%3Cdiv%20className%3D%22fd-step%22%3E%0A%0A%20%23%23%23%20Preparing%20Entry%0A%0A%20Use%20the%20%60prepareEntry%60%20method%20to%20provide%20the%20Inbox%20ID%20and%20the%20data%20you%20want%20to%20submit.%20Optionally%2C%20you%20can%20provide%20file%20handles%20and%20a%20private%20key.%0A%0A%20If%20you%20don't%20want%20to%20send%20any%20files%2C%20pass%20an%20empty%20array%20for%20the%20file%20handles.%0A%0A%20%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%20%22Swift%22%5D%7D%3E%0A%20%3CTab%20%3E%0A%20%60%60%60cpp%0A%20core%3A%3ABuffer%20entryData%20%3D%20core%3A%3ABuffer%3A%3Afrom(%22%7B%5C%22content%5C%22%3A%20%7B%5C%22answer%5C%22%3A%20USER_PROVIDED_TEXT%7D%2C%20%5C%22version%5C%22%3ANUMBER%2C%20%5C%22type%5C%22%3A%20%5C%22text_answer%5C%22%7D%22)%3B%0A%20auto%20entryHandle%20%3D%20inboxApi.prepareEntry(%0A%20inboxID%2C%0A%20entryData%2C%0A%20%7B%7D%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%20%3E%0A%20%60%60%60js%0A%20const%20entryData%20%3D%20%7B%0A%20content%3A%20%7B%0A%20%22answer%22%3A%20USER_PROVIDED_TEXT%0A%20%7D%2C%0A%20version%3Anumber%2C%0A%20type%3A%20%22text_answer%22%2C%0A%20%7D%0A%0A%20const%20entryHandle%20%3D%20await%20inboxApi.prepareEntry(%0A%20inboxID%2C%0A%20this.strToUint8(JSON.stringify(entryData))%2C%0A%20%5B%5D%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20struct%20InboxPublicEntry%3ACodable%7B%0A%20let%20name%3A%20String%0A%20let%20surname%3A%20String%0A%20let%20email%3A%20String%0A%20let%20comment%3A%20String%0A%20%7D%0A%0A%20let%20inboxID%20%3D%20%22INBOX_ID%22%0A%20let%20inboxPublicEntry%20%3D%20InboxPublicEntry(%0A%20name%3A%20%22name%22%2C%0A%20surname%3A%20%22surname%22%2C%0A%20email%3A%20%22email%22%2C%0A%20comment%3A%20%22comment%22)%0A%20guard%20let%20inboxPublicEntryData%20%3D%20try%3F%20JSONEncoder().encode(inboxPublicEntry)%20else%20%7Breturn%7D%0A%20guard%20let%20inboxHandle%20%3D%20try%3F%20publicEndpointSession%3F.inboxApi%3F.prepareEntry(%0A%20in%3A%20inboxID%2C%0A%20containing%3A%20inboxPublicEntryData%2C%0A%20attaching%3A%20%5B%5D%2C%0A%20publicKeyDerivedFrom%3A%20nil)%20else%20%7Breturn%7D%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%3C%2Fdiv%3E%0A%0A%3Cdiv%20className%3D%22fd-step%22%3E%0A%20%23%23%23%20Sending%20Entry%0A%0AAfter%20preparing%20an%20entry%20you%20will%20receive%20an%20Inbox%20handle.%0AIn%20this%20case%2C%20all%20you%20have%20to%20do%20is%20pass%20it%20to%20%60sendEntry%60%20method.%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Swift%22%5D%7D%3E%0A%20%3CTab%20%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20previous%20code%0A%20inboxApi.sendEntry(entryHandle)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%20%3E%0A%20%60%60%60js%0A%20%2F%2F%20previous%20code%0A%20await%20inboxApi.sendEntry(entryHandle)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20try%3F%20publicEndpointSession%3F.inboxApi%3F.sendEntry(inboxHandle)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%3C%2Fdiv%3E%0A%3C%2Fdiv%3E%0A%0A%0A%23%23%20Working%20With%20Files%0A%0AInbox%20entries%20can%20include%20any%20number%20of%20files%20(in%20accordance%20with%20the%20predefined%20Inbox%20file%20configuration).%0A%0AEach%20file%20may%20include%20its%20own%20public%20and%20private%20metadata%20to%20store%20additional%20information.%0A%0AFor%20example%2C%20to%20include%20file%20name%20and%20mimetype%20information%2C%20pass%20this%20data%20as%20JSON%20to%20the%20%60publicMeta%60%20(or%20%60privateMeta%60%2C%20if%20the%20file%20name%20contains%20sensitive%20information)%3A%0A%0AFor%20example%3A%0A%0A%60%60%60%20json%20title%3D%22privateMeta%22%0A%7B%0A%20%22name%22%3AFILE_NAME%2C%0A%20%22mimetype%22%3A%20FILE_MIMETYPE%0A%7D%0A%60%60%60%0A%0A%0A%23%23%20Attaching%20Files%0A%0ASending%20entries%20with%20attached%20files%20follows%20a%20similar%20process%20to%20sending%20entries%20without%20files.%0AThe%20main%20difference%20is%20that%20you%20must%20create%20file%20handles%20for%20each%20file%20and%20stream%20their%20content.%0A%0A%3Cdiv%20className%3D%22fd-steps%22%3E%0A%20%3Cdiv%20className%3D%22fd-step%22%3E%0A%20%23%23%23%20Preparing%20Entry%0A%20For%20each%20file%20you%20want%20to%20send%2C%20create%20a%20file%20handle.%0A%20You%20can%20provide%20additional%20data%2C%20e.g.%20file%20name%20or%20its%20metadata.%0A%0A%20If%20you%E2%80%99re%20creating%20a%20questionnaire%2C%20you%20can%20relate%20files%20with%20questions%0A%20by%20putting%20question%20info%20in%20the%20file's%20metadata.%0A%0A%20%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%20%22Swift%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20std%3A%3Astring%20filePrivateMeta%20%7BFILE_META%7D%3B%20%2F%2F%20file%3A%20name%2C%20mimetype%20%0A%20auto%20fileData%20%7BFILE_DATA%7D%3B%0A%0A%20auto%20fileHandle%20%3D%20inboxApi.createFileHandle(%0A%20core%3A%3ABuffer%3A%3Afrom(%22%22)%2C%0A%20core%3A%3ABuffer%3A%3Afrom(filePrivateMeta)%2C%0A%20fileData.size()%0A%20)%0A%0A%20%2F%2F%20preparing%20entry%20as%20shown%20before%0A%20core%3A%3ABuffer%20entryData%20%3D%20core%3A%3ABuffer%3A%3Afrom(%22%7B%5C%22content%5C%22%3A%20%7B%5C%22answer%5C%22%3A%20USER_PROVIDED_TEXT%7D%2C%20%5C%22version%5C%22%3ANUMBER%2C%20%5C%22type%5C%22%3A%20%5C%22text_answer%5C%22%7D%22)%3B%0A%20auto%20entryHandle%20%3D%20inboxApi.prepareEntry(%0A%20inboxID%2C%0A%20entryData%2C%0A%20%7BfileHandle%7D%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20selectedFile%20%3D%20%2F%2FFile%20selected%20by%20user%0A%0A%20const%20filePrivateMeta%20%3D%20%7B%0A%20name%3A%20selectedFile.name%2C%0A%20mimetype%3A%20selectedFile.type%0A%20%7D%0A%0A%20const%20fileHandle%20%3D%20inboxApi.createFileHandle(%0A%20strToUin8(%22%22)%2C%0A%20strToUin8(JSON.stringify(filePrivateMeta))%2C%0A%20selectedFile.size%0A%20)%0A%0A%20%2F%2F%20preparing%20entry%20as%20shown%20before%0A%20const%20entryHandle%20%3D%20await%20inboxApi.prepareEntry(%0A%20inboxID%2C%0A%20this.strToUint8(JSON.stringify(entryData))%2C%0A%20%5BfileHandle%5D%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20guard%20let%20inboxFileHandle%20%3D%20try%3F%20publicEndpointSession%3F.inboxApi%3F.createFileHandle(%0A%20withPublicMeta%3A%20Data()%2C%0A%20withPrivateMeta%3A%20Data()%2C%0A%20forSize%3A%20fileSize)%20else%20%7Breturn%7D%0A%0A%20guard%20let%20entryHandle%20%3D%20try%3F%20publicEndpointSession%3F.inboxApi%3F.prepareEntry(%0A%20in%3A%20inboxID%2C%0A%20containing%3A%20inboxPublicEntryData%2C%20%2F%2Fas%20in%20Basic%20Example%0A%20attaching%3A%20%5BinboxFileHandle%5D%2C%0A%20publicKeyDerivedFrom%3A%20nil)%20else%20%7Breturn%7D%0A%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3C%2FTabs%3E%0A%20%3C%2Fdiv%3E%0A%20%3Cdiv%20className%3D%7B'fd-step'%7D%3E%0A%20%23%23%23%20Sending%20File%20Contents%0A%20For%20large%20files%2C%20it%20is%20recommended%20to%20stream%20the%20file%20content%20in%20small%20buffers%20rather%20than%20loading%20the%20entire%0A%20file%20into%20memory.%0A%20PrivMX%20Endpoint%20divides%20those%20buffers%20if%20required%2C%20then%20streams%0A%20them%20to%20your%20PrivMX%20Bridge.%0A%0A%20It%20is%20important%20to%20NOT%20CLOSE%20the%20file%20handles.%0A%0A%20%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Swift%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20previous%20code%0A%20inboxApi.writeToFile(entryHandle%2C%20fileHandle%2C%20sampleFileData)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20previous%20code%0A%20const%20reader%20%3D%20await%20selectedFile.stream().getReader()%0A%0A%20while(true)%7B%0A%20const%20%7Bdone%2C%20value%7D%20%3D%20await%20reader.read()%3B%0A%0A%20if(done)%7B%0A%20break%3B%0A%20%7D%0A%0A%20await%20inboxApi.writeToFile(entryHandle%2C%20fileHandle%2C%20value)%0A%20%7D%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20try%3F%20publicEndpointSession%3F.inboxApi%3F.writeToFile(inboxFileHandle%2C%20of%3A%20entryHandle%2C%20uploading%3A%20data)%0A%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3C%2FTabs%3E%0A%20%3C%2Fdiv%3E%0A%20%3Cdiv%20className%3D%7B%22fd-step%22%7D%3E%0A%20%23%23%23%20Sending%20Entry%0A%20Finally%2C%20send%20the%20entry%20in%20the%20same%20way%20as%20described%20before%3A%0A%20%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Swift%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20previous%20code%0A%20inboxApi.sendEntry(entryHandle)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20previous%20code%0A%20await%20inboxApi.sendEntry(entryHandle)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20try%3F%20publicEndpointSession%3F.inboxApi%3F.sendEntry(entryHandle)%0A%20%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3C%2FTabs%3E%0A%20%3C%2Fdiv%3E%0A%3C%2Fdiv%3E%0A%23%23%20Fetching%20Entries%0A%0A%3A%3A%3Ainfo%0A%0AFetching%20entries%20requires%20decoding%20them%20back%20into%20their%20original%20format.%20Depending%20on%20your%20data%20structure%2C%20you%20will%20need%20to%20parse%20and%20decode%20the%20fetched%20entries.%5C%0A%5C%0AThe%20process%20for%20fetching%20entries%20heavily%20depends%20on%20your%20entry%20format.%20Refer%20back%20to%20%5BDefine%20Data%20Structure%5D(%23define-data-structure)%20if%20you%20need%20guidance%20on%20how%20to%20structure%20your%20entry.%0A%0A%3A%3A%3A%0A%0A%23%23%23%20Basic%20Entries%0A%0AAfter%20fetching%20entries%2C%20you%20must%20first%20decrypt%20them%20back%20to%20their%20original%20format.%0AFor%20schema%20used%20%5Bearlier%5D(%23example-form-with-text-answer)%2C%20this%20process%20looks%20like%20this%3A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%20%22JavaScript%22%2C%22Swift%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20define%20how%20much%20you%20want%20to%20fetch%20and%20skip%0A%20core%3A%3APagingQuery%20defaultListQuery%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%20100%2C%20.sortOrder%20%3D%20%22asc%22%7D%3B%0A%20auto%20entryList%20%3D%20inboxApi.listEntries(inboxId%2C%20defaultQuery)%3B%0A%20for%20(const%20auto%26%20entry%20%3A%20entryList.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22Inbox%20entry%20ID%3A%20%22%20%3C%3C%20entry.entryId%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20define%20how%20much%20you%20want%20to%20fetch%20and%20skip%0A%20const%20defaultQuery%20%3D%20%7Bskip%3A0%2C%20limit%3A100%2C%20sortOrder%3A%20%22asc%22%7D%0A%20const%20readList%20%3D%20inboxApi.listEntries(inboxId%2C%20defaultQuery)%0A%0A%20const%20decodedEntries%20%3D%20readList.readItems(entry%20%3D%3E%20%7B%0A%20return%20%7B%0A%20...entry%2C%0A%20data%3A%20JSON.parse(uint8ToStr(entry.data))%0A%20%7D%0A%20%7D)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20let%20inboxID%20%3D%20%22INBOX_ID%22%0A%0A%20var%20entires%20%3D%20try%3F%20endpointSession%3F.inboxApi%3F.listEntries(%0A%20from%3A%20inboxID%2C%0A%20basedOn%3A%20privmx.endpoint.core.PagingQuery(skip%3A%20startIndex%2C%20limit%3A%20pageSize%2C%20sortOrder%3A%20.desc)%0A%20)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%23%20Entries%20with%20Files%0A%0AEntries%20include%20only%20file%20metadata%2C%20without%20their%20contents.%0ASimilar%20to%20entries%20data%2C%20you%20have%20to%20decode%20them%20before%20using.%0A%0AFor%20example%2C%20if%20you%20saved%20name%20and%20metadata%20of%20a%20file%20in%20its%20%60privateMeta%60%2C%0Ayou%20can%20read%20them%20like%20this%3A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%20%22JavaScript%22%2C%20%22Swift%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20define%20how%20much%20you%20want%20to%20fetch%20and%20skip%0A%20core%3A%3APagingQuery%20defaultListQuery%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%20100%2C%20.sortOrder%20%3D%20%22asc%22%7D%3B%0A%20auto%20entryList%20%3D%20inboxApi.listEntries(inboxId%2C%20defaultQuery)%3B%0A%0A%20for%20(const%20auto%26%20entry%20%3A%20entryList.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22Inbox%20entry%20ID%3A%20%22%20%3C%3C%20entry.entryId%20%3C%3C%20std%3A%3Aendl%3B%0A%20for%20(const%20auto%26%20file%20%3A%20entry.files)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22Inbox%20entry%20file%20ID%3A%20%22%20%3C%3C%20file.info.fileId%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%7D%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20define%20how%20much%20you%20want%20to%20fetch%20and%20skip%0A%20const%20defaultQuery%20%3D%20%7Bskip%3A0%2C%20limit%3A100%2C%20sortOrder%3A%20%22asc%22%7D%0A%20const%20readList%20%3D%20inboxApi.listEntries(inboxId%2C%20defaultQuery)%0A%0A%20const%20decodedEntries%20%3D%20readList.readItems(entry%20%3D%3E%20%7B%0A%20%2F%2F%20decoding%20file%20meta%20first%0A%20const%20decodedFiles%20%3D%20entry.files.map(file%20%3D%3E%20%7B%0A%20return%20%7B%0A%20...file%2C%0A%20privateMeta%3AJSON.parse(uint8ToStr(file.privateMeta))%2C%0A%20%7D%0A%20%7D)%0A%20return%20%7B%0A%20...entry%2C%0A%20data%3A%20JSON.parse(uint8ToStr(entry.data))%2C%0A%20files%3AdecodedFiles%0A%20%7D%0A%20%7D)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20let%20inboxID%20%3D%20%22INBOX_ID%22%0A%20let%20entryID%20%3D%20%22ENTRY_ID%22%20%0A%0A%20let%20inboxEntry%20%3D%20try%3F%20endpointSession%3F.inboxApi%3F.readEntry(entryID)%0A%0A%20var%20files%20%3D%20inboxEntry%3F.files%0A%0A%20var%20filesContents%20%3D%20files.map%20%7B%20file%20in%0A%20try%3F%20endpointSession%3F.inboxApi%3F.openFile(%22%5C(file%5B0%5D.info.fileId)%22)%0A%20%7D%3F.map%7B%20fileHandle%20in%0A%20var%20content%20%3D%20Data()%0A%20var%20chunk%20%3A%20Data%0A%20repeat%20%7B%0A%20chunk%20%3D%20(try%3F%20endpointSession%3F.inboxApi%3F.readFromFile(withHandle%3A%20fileHandle%2C%20length%3A%20PrivMXStoreFileHandler.RecommendedChunkSize))%20%3F%3F%20Data()%0A%20content.append(chunk)%0A%20%7D%20while%20chunk.count%20%3D%3D%20PrivMXStoreFileHandler.RecommendedChunkSize%0A%20return%20content%0A%20%7D%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%2C%7B%0A%20%22icon%22%3A%20%22inboxes%22%2C%0A%20%22title%22%3A%20%22Inboxes%22%2C%0A%20%22pages%22%3A%20%5B%22overview%22%2C%20%22usage%22%2C%20%22inbox-entries%22%2C%20%22inbox-events%22%5D%0A%7D%0A%2C---%0Atitle%3A%20Versioning%0A---%0A%23%23%20A.B.C-rcX%20versioning%0A%0AEach%20version%20of%20the%20project%20is%20marked%20with%20semantic%20numbering.%20Here%20are%20the%20detailed%20rules%3A%0A%0A%23%23%23%20New%20features%0A%0AChanges%20in%20%60A%60%20and%20%60B%60%20numbers%20introduce%20new%20features%3A%0A%0A%E2%80%A2%20%60A%60%20(major)%3A%20changes%20in%20the%20event%20of%20major%20updates%20or%20the%20introduction%20of%20incompatible%20features.%0A%0A%E2%80%A2%20%60B%60%20(minor)%3A%20changes%20in%20the%20event%20of%20minor%20updates%2C%20which%20are%20**in%20most%20cases**%20compatible%20with%20previous%20versions.%0A%0A%23%23%23%20Consistency%20of%20numbering%0A%0AThe%20main%20library%20and%20all%20the%20wrappers%20use%20the%20same%20%60A%60%20and%20%60B%60%20versioning.%0A%0A%23%23%23%20Updates%20within%20the%20version%3A%0A%0A%E2%80%A2%20%60C%60%20changes%20consist%20of%20fixes%20and%20updates%20that%20do%20not%20introduce%20new%20features%20%E2%80%93%20they%20are%20only%20bug%20and%20optimization%20fixes.%0A%0A%E2%80%A2%20%60C%60%20does%20not%20have%20to%20be%20synchronized%20between%20the%20library%20and%20the%20wrappers.%0A%0A%23%23%23%20Release%20Candidate%20(rc)%0A%0AThe%20%60X%60%20in%20%60A.B.C-rcX%60%20stands%20for%20the%20consecutive%20release%20candidates%20for%20given%20version.%0A%0A%23%23%23%20Before%20official%20release%0A%0A%E2%80%A2%20Before%20making%20a%20final%20release%20decision%20in%20the%20team%2C%20all%20the%20components%20(the%20library%20and%20the%20wrappers)%20are%20released%20as%20%60A.B.C-rcX%60.%0A%0A%E2%80%A2%20At%20the%20%60rc%60%20stage%2C%20changes%20connected%20to%20the%20new%20API%20are%20possible%20and%20they%20change%20the%20%60X%60.%0A%0A%23%23%23%20Finalizing%20a%20version%0A%0AWhen%20the%20main%20library%20and%20the%20wrappers%20reach%20full%20compatibility%20in%20a%20given%20version%2C%20a%20stable%20version%20of%20A.B.C%20is%20published%2C%20with%20all%20the%20components%20synchronized.%0A%0A%23%23%23%20Minor%20changes%20(B)%0A%0A%E2%80%A2%20Adding%20small%20features%20or%20items%20to%20replace%20older%20functionality%20bumps%20up%20the%20%60B%60%20number.%0A%0A%E2%80%A2%20Replaced%20and%20changed%20functions%20will%20be%20marked%20as%20deprecated%2C%20but%20still%20work%20until%20a%20version%20with%20a%20bumped%20up%20%60A%60%20number%20is%20released.%0A%0A%E2%80%A2%20However%2C%20we%20do%20not%20exclude%20the%20**possibility%20that%20compatibility%20will%20be%20broken**%20at%20this%20stage.%20We%20will%20inform%20about%20it%20in%20release-notes.%0A%0A%23%23%23%20Major%20changes%20(A)%0A%0AIntroducing%20major%20changes%20or%20features%2C%20requires%20the%20%60A%60%20number%20increase.%0A%2C---%0Atitle%3A%20Overview%0A---%0A%0AThread%20container%20is%20a%20structured%20communication%20tool%20used%20for%20**message%20based%20communication**.%20%0A%0AUsers%20create%20Threads%20to%20organize%20topic-specific%20conversations%20where%20they%20can%20securely%20**exchange%20encrypted%20messages**%20with%20designated%20participants.%0AAll%20the%20active%20users%20are%20**notified**%20right%20away%20when%20a%20new%20message%20arrives%20or%20anything%20within%20the%20Thread%20changes.%20%0A%0AAll%20the%20data%20is%20stored%20in%20%5BPrivMX%20Bridge%5D(..%2Fprivmx-bridge)%20and%20can%20be%20freely%20shared%20between%20its%20users.%0A%0A%23%23%20Prerequisites%0A%0ABefore%20working%20with%20Threads%2C%20you%20need%20to%20have%20a%20PrivMX%20Bridge%20instance.%0A%0ATo%20install%20it%2C%20%5Bfollow%20our%20PrivMX%20quick%20start%20guide%5D(..%2Fquick-start).%0A%0A%23%23%20Architecture%0A%0AThreads%20are%20time-sorted%20containers%20for%20messages.%20Think%20of%20a%20Thread%20as%20a%20container%20that%20allows%20you%20to%20**post%20messages%2C%20which%20can%20include%20any%20binary%20or%20text%20data%20as%20well%20as%20metadata.**%0AEach%20Thread%20has%20its%20own%20set%20of%20permissions%2C%20managed%20by%20assigning%20the%20users%E2%80%99%20public%20keys%20to%20the%20Thread.%20**Only%20the%20users%20with%20assigned%20public%20keys%20can%20read%20the%20messages%20posted%20in%20that%20Thread.**%0ADecryption%20of%20these%20messages%20is%20possible%20only%20with%20the%20corresponding%20private%20keys.%20%0A%0A**Each%20message%20is%20protected%20by%20a%20synchronous%20key%2C%20which%20is%20further%20secured%20using%20an%20asynchronous%20pair%20of%20public%20and%20private%20user%20keys.**%0AThis%20dual-layer%20encryption%20ensures%20that%20the%20system%20remains%20both%20safe%20and%20efficient.%0A%0A%5BLearn%20more%5D(.%2Fencryption)%20about%20our%20advanced%20encryption%20methods%20and%20how%20they%20safeguard%20your%20messages.%0A%0AThe%20following%20diagram%20is%20a%20visual%20reference%20for%20the%20architecture%20of%20Threads%3A%0A!%5Bthreads%20architecture%5D(%2Fimg%2Fprivmx-threads.svg)%0A%0A%23%23%20Messages%20in%20Threads%0A%0AThe%20main%20data%20units%20in%20Threads%20are%20messages%2C%20which%20contain%20binary%20%60data%60%2C%20as%20well%20as%20metadata%0A%0A-%20%60privateMeta%60%20-%20encrypted%20data%20about%20the%20message%0A-%20%60publicMeta%60%20-%20**decrypted**%20additional%20data%20about%20the%20message%0A%0AEach%20message%20also%20has%20information%20assigned%20by%20the%20Bridge.%0A%0ATo%20learn%20more%20about%20messages%2C%20go%20to%20%5BSending%20Messages%5D(.%2Fmessages).%0A%0A%23%23%20Encryption%0A%0AEach%20message%20is%20protected%20by%20a%20synchronous%20key%2C%20which%20is%20further%20secured%20using%20an%20asynchronous%20pair%20of%20public%20and%20private%20user%20keys.%20%0AThis%20dual-layer%20encryption%20ensures%20that%20the%20system%20remains%20both%20safe%20and%20efficient.%0A%0AOnly%20an%20end%20user%20can%20create%20a%20Thread%2C%20by%20providing%20a%20set%20of%20public%20keys%20for%20the%20users%20who%20should%20have%20access%20to%20the%20Thread.%0A%0AA%20symmetric%20key%20for%20the%20Thread%20(Thread%20Encryption%20Key)%20is%20then%20**generated%20by%20the%20Thread%20author**%20and%20securely%20stored%20on%20the%20server%2C%20encrypted%20using%20public%20keys%20of%20**users%20assigned%20to%20the%20Thread**.%20%0AThis%20ensures%20that%20only%20the%20authorized%20users%20have%20access%20to%20the%20Thread's%20Encryption%20Key.%20**Unencrypted%20keys%20never%20leave%20User%20Endpoints.**%0A%0AWhen%20accessing%20a%20Thread%2C%20the%20encrypted%20Thread%20Encryption%20Key%20is%20sent%20to%20each%20user%20based%20on%20their%20assignment%20to%20the%20Thread.%20Only%20the%20users%20with%20proper%20Private%20Keys%20can%20decrypt%20Thread%20Encryption%20Key.%20%0AUsing%20the%20decrypted%20key%2C%20messages%20are%20encrypted%20and%20signed%20with%20the%20users%E2%80%99%20Private%20Keys%20before%20being%20sent%20to%20the%20Bridge.%20%0A%0AThis%20process%20is%20handled%20by%20the%20PrivMX%20Endpoint%20and%20is%20completely%20seamless%20for%20the%20users.%0A%0A%23%23%20Examples%0A-%20Chatee%0A%20A%20demo%20project%20of%20Chat%20Application%2C%20containing%20server-side%20logic%20and%20web%20client.%20Created%20with%20Next.js.%0A%0A%20%5BGithub%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-chatee)%0A%0A-%20Simple%2C%20minimal%20examples%0A%20A%20set%20of%20short%20code%20snippets%20showing%20you%20how%20to%20start%20interacting%20with%20PrivMX%20Endpoint%20Library.%0A%0A%20%5BGithub%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-webendpoint%2Ftree%2Fmain%2Fexamples)%2C---%0Atitle%3A%20Messages%0A---%0A%0AThreads%20allow%20the%20exchange%20of%20messages.%0AIn%20this%20section%2C%20let's%20take%20a%20closer%20look%20at%20the%20structure%20of%20messages%20and%20how%20to%20send%20them.%20We%20will%20also%20discuss%20some%20good%20practice%20when%20working%20with%20Threads.%0A%0A%23%23%20About%20Messages%0A%0AThe%20structure%20of%20a%20message%20and%20a%20brief%20description%20of%20its%20elements%20is%20outlined%20in%20the%20following%20table%3A%0A%7C**field**%7C**type**%7C**encrypted**%7C**description**%7C%0A%7C---%7C---%7C---%7C---%7C%0A%7C%60data%60%7Cbinary%7Cyes%7Ccontent%20of%20the%20message%0A%7C%60info%60%7CServerInfo%7Cno%7Cadditional%20information%20assigned%20by%20the%20server%20e.g.%20author%2C%20%60creationDate%60%2C%20%60messageID%60%20and%20%60threadID%60%0A%7C%60privateMeta%60%7Cbinary%7Cyes%7Cadditional%20information%20about%20the%20message%0A%7C%60publicMeta%60%7Cbinary%7Cno%7Cadditional%20public%20information%20about%20the%20message%2C%20also%20accessible%20through%20Platform%20REST%20API%0A%0A%23%23%20Define%20structure%0A%0AThread's%20architecture%20does%20not%20require%20you%20to%20use%20a%20specific%20data%20structure%20inside%20the%20messages.%0ASo%20before%20working%20with%20Threads%2C%20define%20what%20what%20kind%20of%20messages%20you%20want%20to%20send.%0A%0AWe%20recommend%20future-proofing%20your%20messages%20right%20from%20the%20start%2C%20i.e.%20choosing%20an%20easily%20modifiable%20format.%0A%0AIt%20is%20also%20a%20good%20idea%20to%20include%20its%20type%20and%20version%20in%20the%20structure%20of%20the%20message.%0A%0AHere%20is%20an%20example%20message%20structure%20that%20you%20can%20use%20in%20your%20project.%0A%0A%60%60%60%20json%20title%3D%22JSON%22%0A%7B%0A%20%E2%80%9Cdata%E2%80%9D%3A%7B%0A%20%E2%80%9Ccontent%E2%80%9D%3A%20%22string%22%2C%20%2F%2F%20string%20%2F%20binary%20data%20containing%20for%20example%3A%20markdown%2C%20html%20or%20json%0A%20%7D%2C%0A%20%E2%80%9Cinfo%E2%80%9D%3A%20%22ServerInfo%22%2C%20%2F%2F%20assigned%20by%20server%2C%0A%20%E2%80%9CpublicMeta%E2%80%9D%3A%7B%0A%20%E2%80%9Cversion%E2%80%9D%3Anumber%2C%0A%20%E2%80%9Ctype%E2%80%9D%3A%20%E2%80%9Ctext%E2%80%9D%2C%20%2F%2F%20some%20kind%20of%20enum%20describing%20type%20of%20message%20like%20%E2%80%9Cevent%E2%80%9D%2C%20%E2%80%9Chtml%E2%80%9D%2C%E2%80%9Cmarkdown%E2%80%9D%20etc.%0A%20%7D%2C%0A%20%E2%80%9CprivateMeta%E2%80%9D%3A%7B%0A%20%2F%2F%20meta%20fields%0A%20%7D%0A%7D%0A%60%60%60%0ARemember%20that%20it%20is%20only%20an%20example%20and%20you%20should%20consider%20your%20app's%20requirements%20and%20limitations.%0A%0A%23%23%20Sending%0A%0AWith%20the%20structure%20ready%2C%20its%20time%20to%20start%20sending%20messages.%0A%0A%3A%3A%3Ainfo%0A%0ARemember%20that%20before%20sending%20anything%2C%20you%20have%20to%20be%20connected%20to%20the%20Bridge%20-%20using%20%60connect%60.%0A%0A%3A%3A%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%22Kotlin%22%2C%22Swift%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20auto%20msgId%20%7BthreadApi.sendMessage(%0A%20THREAD_ID%2C%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20message%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20message%20private%20meta-data%22)%0A%20core%3A%3ABuffer%3A%3Afrom(%22message%20data%22)%0A%20)%7D%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20msgId%20%3D%20await%20Endpoint.connection().thread('THREAD_ID').sendMessage(%7B%0A%20data%3A%20new%20TextEncoder().encode('My%20message')%2C%0A%20privateMeta%3A%20new%20TextEncoder().encode('My%20private%20data')%2C%0A%20publicMeta%3A%20serializeObject(%7B%0A%20type%3A%20'type_of_message'%0A%20%7D)%0A%20%7D)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60java%0A%20PrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0A%20Long%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0A%20String%20threadId%20%3D%20%22%3CTHREAD_ID%3E%22%3B%0A%0A%20byte%5B%5D%20privateMeta%20%3D%20%22My%20private%20meta%22.getBytes(StandardCharsets.UTF_8)%3B%0A%20byte%5B%5D%20publicMeta%20%3D%20%22My%20public%20meta%22.getBytes(StandardCharsets.UTF_8)%3B%0A%20byte%5B%5D%20message%20%3D%20%22My%20message%22.getBytes(StandardCharsets.UTF_8)%3B%0A%0A%20String%20msgId%20%3D%20container.getEndpoint(connectionID).threadApi.sendMessage(%0A%20threadId%2C%0A%20publicMeta%2C%0A%20privateMeta%2C%0A%20message%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60kotlin%0A%20val%20container%20%3D%20PrivmxEndpointContainer()%0A%20val%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0A%20val%20threadId%20%3D%20%22%3CTHREAD_ID%3E%22%0A%0A%20val%20privateMeta%20%3D%20%22My%20private%20data%22.encodeToByteArray()%0A%20val%20publicMeta%20%3D%20%22My%20public%20data%22.encodeToByteArray()%0A%20val%20message%20%3D%20%22This%20is%20my%20message%22.encodeToByteArray()%0A%0A%20val%20msgId%20%3D%20container.getEndpoint(connectionID).threadApi.sendMessage(%0A%20threadId%2C%0A%20publicMeta%2C%0A%20privateMeta%2C%0A%20message%0A%20)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%0A%20%60%60%60swift%0A%20let%20threadId%3A%20String%3B%20%2F%2F%20ID%20of%20thread%20taken%20from%20threadApi.threadList%0A%0A%20%2F%2Ffor%20now%20we%20can%20leave%20them%20empty%0A%20let%20privateMeta%20%3D%20Data(%22My%20private%20data%22.utf8)%0A%20let%20publicMeta%20%3D%20Data(%22My%20public%20data%22.utf8)%0A%0A%20let%20message%20%3D%20Data(%22This%20is%20my%20message%22.utf8)%0A%0A%20let%20msgId%3A%20String%20%3D%20threadApi.sendMessage(%0A%20in%3A%20threadId%2C%0A%20publicMeta%3A%20publicMeta%2C%0A%20privateMeta%3A%20privateMeta%2C%0A%20data%3A%20message)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0AAfter%20sending%20the%20message%2C%20you%20will%20get%20its%20ID%20returned.%0A%0AMessage%20IDs%20are%20unique%20within%20a%20Context%2C%20allowing%20you%20to%20locate%20a%20message%20solely%20by%20its%20ID%2C%20without%20the%20need%20to%20know%20the%20associated%20Thread%20ID.%0A%0A%0A%23%23%20Using%20Message%20Metadata%0A%0AMetadata%20fields%20inside%20messages%20make%20it%20easier%20to%20integrate%20Threads%20into%20new%20and%20existing%20projects.%0AThreads%20are%20scheme%20agnostic%20by%20design%2C%20which%20makes%20them%20easy%20to%20integrate%20into%20any%20application.%0AMetadata%20also%20allows%20developers%20to%20add%20any%20functionalities%20required%20by%20their%20app.%0A%0A%23%23%23%20PrivateMeta%0A%0A%60privateMeta%60%20includes%20additional%20sensitive%20information%20about%20the%20message.%0AIt's%20useful%20when%20we%20need%20to%20include%20the%20user's%20private%20data%20(personal%20information%2C%20activity%20details)%20in%20the%20message.%0A%0ALike%20the%20content%20of%20the%20message%20itself%2C%20%60privateMeta%60%20is%20**encrypted**%20before%20sending.%20Since%20it%20is%20saved%20as%20binary%20data%2C%20you%20are%20free%20to%20choose%20any%20format.%0AIt%20can%20be%20a%20JSON%20parsed%20to%20a%20binary%20array%20or%20a%20more%20efficient%20binary%20format%20such%20as%20Protocol%20Buffers.%0A%0A%23%23%23%20PublicMeta%0A%0AUnlike%20%60privateMeta%60%2C%20%60publicMeta%60%20is%20**not%20encrypted**.%0AIt's%20useful%20when%20you%20want%20to%20include%20some%20additional%20info%20that%20does%20not%20require%20encryption.%0A%0A%60publicMeta%60%20also%20does%20not%20have%20a%20specified%20structure%20and%20supports%20any%20binary%20format.%0A%0A%23%23%23%20Example%3A%20Response%20To%20Another%20Message%0A%0ALet's%20say%20that%20you%20need%20to%20implement%20replies%20to%20other%20messages%20inside%20a%20Thread%20using%20%60publicMeta%60.%0A%0AWhen%20sending%20a%20message%2C%20include%20the%20ID%20of%20the%20message%20you%20want%20to%20reply%20to.%0AExpanding%20on%20the%20example%20from%20the%20section%20on%20sending%2C%20it%20would%20look%20like%20that%3A%0A%0A%60%60%60%20json%20title%3D%22JSON%22%0A%7B%0A%20%22data%22%3A%7B%0A%20%22content%22%3A%20%22string%22%20%2F%2F%20string%20%2F%20binary%20data%20containing%20for%20example%3A%20markdown%2C%20html%20or%20json%0A%20%7D%2C%0A%20%22info%22%3A%20%22ServerInfo%22%2C%20%2F%2F%20assigned%20by%20server%2C%0A%20%22publicMeta%22%3A%7B%0A%20%22version%22%3A%22number%22%2C%0A%20%22type%22%3A%20%E2%80%9Ctext%E2%80%9D%2C%20%2F%2F%20some%20kind%20of%20enum%20describing%20type%20of%20message%20like%20%E2%80%9Cevent%E2%80%9D%2C%20%E2%80%9Chtml%E2%80%9D%2C%E2%80%9Cmarkdown%E2%80%9D%20etc.%0A%20%22responseTo%22%3A%E2%80%9D%7BmessageID%7D%E2%80%9D%0A%20%7D%2C%0A%7D%0A%60%60%60%0A%0AWhen%20displaying%20the%20message%20in%20a%20chat%2C%20you%20will%20be%20able%20to%20find%20the%20message%20that%20was%20mentioned%20and%20display%20it%20according%20to%20the%20application's%20requirements.%0A%0A%0A%23%23%20Listing%20Messages%0A%0AYour%20application%20may%20include%20multiple%20messages%2C%20each%20associated%20with%20different%20Threads.%20%0AYou%20can%20retrieve%20a%20**list%20of%20all%20messages%20within%20a%20given%20Thread.**%20%0A%0AHere's%20an%20example%20of%20how%20to%20download%20the%20last%2030%20messages%20created%20within%20a%20Thread%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20list%20threads%0A%20core%3A%3APagingQuery%20query%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%2030%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%20%0A%20auto%20result%20%7BthreadApi.listMessages(THREAD_ID%2C%20query)%7D%3B%0A%20for%20(const%20auto%26%20message%20%3A%20result.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22Message%20ID%3A%20%22%20%3C%3C%20message.info.messageId%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20const%20query%3A%20Types.PagingQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%2030%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0A%20const%20result%20%3D%20await%20threadApi.listMessages(CONTEXT_ID%2C%20query)%3B%0A%20for%20(const%20message%20of%20result.readItems)%20%7B%0A%20console.log(%22Message%20ID%3A%20%22%2C%20message.info.messageId)%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0ATo%20limit%20collecting%20too%20much%20data%20when%20downloading%20messages%2C%20specify%20the%20page%20index%20(starting%20from%200)%20and%20the%20number%20of%20items%20to%20be%20included%20on%20each%20page.%0A%0A%0A%23%23%20Modifying%20Messages%0A%0ADepending%20on%20your%20project's%20specification%2C%20it%20may%20be%20necessary%20to%20modify%20a%20message.%0AIt%20could%20be%20e.g.%20changing%20message%20data%2C%20publicMeta%2C%20privateMeta.%0AEach%20user%20with%20management%20rights%20is%20able%20to%20modify%20message.%0A%0AUpdating%20a%20message%20means%20overwriting%20it%20with%20the%20provided%20data.%20%0ATo%20successfully%20update%20a%20message%2C%20you%20must%20be%20the%20message%20creator%20or%20a%20Thread%20moderator.%0A%0ABelow%20there%20is%20an%20example%20of%20modifying%20a%20message%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20threadApi.updateMessage(%0A%20msgId%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20new%20message%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20new%20message%20private%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22message%20data%22)%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%3E%0A%20%60%60%60js%0A%20await%20threadApi.updateMessage(%0A%20msgId%2C%20%0A%20this.strToUint8(%22some%20new%20message%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(%22some%20new%20message%20private%20meta-data%22)%2C%20%0A%20this.strToUint8(%22message%20data%22)%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Deleting%20Message%0A%0ATo%20successfully%20delete%20a%20message%2C%20you%20must%20be%20the%20message%20creator%20or%20a%20Thread%20moderator.%0A%0ABelow%20there%20is%20an%20example%20of%20deleting%20a%20Thread%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20threadApi.deleteThread(threadId)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0A%20%60%60%60js%0A%20await%20threadApi.deleteThread(threadId)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C---%0Atitle%3A%20Thread%20Events%0A---%0A%0A%0AListening%20for%20events%20related%20new%20messages%20and%20updating%20your%20app's%20state%20accordingly%20will%20allow%20you%20to%20build%20e.g.%2C%20instant%20messaging%20features.%0A%0A%23%23%20Types%20of%20Events%0AThe%20lists%20below%20outline%20all%20the%20event%20types%20available%20in%20Threads%20and%20messages%20in%20PrivMX.%0A%0AThread%20events%3A%20%0A-%20%60threadCreated%60%20-%20triggers%20when%20a%20new%20Thread%20is%20created%20in%20your%20Context%0A-%20%60threadDeleted%60%20-%20triggers%20when%20a%20Thread%20is%20deleted%20from%20your%20Context%0A-%20%60threadUpdated%60%20-%20triggers%20when%20a%20Thread%20is%20updated%0A-%20%60threadStatsChanged%60%20-%20triggers%20when%20a%20message%20is%20sent%20to%20a%20thread%20or%20a%20message%20has%20been%20deleted%0A%0AMessage%20events%3A%20%0A-%20%60threadNewMessage%60%20-%20triggers%20a%20message%20was%20sent%20to%20a%20Thread%0A-%20%60threadDeletedMessage%60%20triggers%20when%20a%20message%20was%20deleted%20from%20a%20Thread%0A-%20%60threadMessageUpdated%60%20-%20triggers%20when%20a%20message%20was%20updated%0A%0A%23%23%20Handling%20Thread%20and%20Message%20Events%0A%0A%3A%3A%3Ainfo%0A%0AThe%20sample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Fmanaging%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0ABefore%20receiving%20Events%2C%20your%20application%20has%20to%20start%20an%20event%20loop%20and%20subscribe%20to%20a%20specific%20channel.%0AAfterwards%20you%20can%20setup%20a%20listener.%0A%0AHere%20is%20an%20example%20how%20to%20do%20it%20in%20your%20own%20project%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B'cpp'%2C'js'%2C'java'%2C'kotlin'%2C'swift'%5D%7D%3E%0A%0A%3CTab%20value%3D%22cpp%22%20label%3D%22C%2B%2B%22%3E%0A%0A%60%60%60cpp%0A%2F%2F%20handle%20events%0Acore%3A%3AEventQueue%20eventQueue%20%7Bcore%3A%3AEventQueue%3A%3AgetInstance()%7D%3B%0Astd%3A%3Athread%20t(%5B%26%5D()%7B%0A%20while(true)%20%7B%0A%20core%3A%3AEventHolder%20event%20%3D%20eventQueue.waitEvent()%3B%0A%20std%3A%3Acout%20%3C%3C%20%22onEvent%3A%20%22%20%3C%3C%20event.type()%20%3C%3C%20std%3A%3Aendl%3B%0A%20std%3A%3Acout%20%3C%3C%20event.toJSON()%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%7D)%3B%0At.detach()%3B%0A%0A%2F%2F%20subscribe%20for%20threads%20general%20events%0AthreadsApi.subscribeForThreadEvents()%3B%0A%0A%2F%2F%20subscribe%20for%20particular%20thread%20events%0AthreadsApi.subscribeForMessageEvents(threadId)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%20value%3D%22js%22%20label%3D%22JavaScript%22%3E%0A%0A%60%60%60js%0A%2F%2F%20Getting%20the%20Event%20Queue%0Aconst%20eventQueue%20%3D%20await%20EndpointFactory.getEventQueue()%3B%0A%0A%2F%2F%20Simple%20function%20to%20listen%20for%20events%20in%20a%20loop%0Afunction%20listenForEvents(eventsQueue)%20%7B%0A%20eventsQueue.waitEvent().then(event%20%3D%3E%20%7B%0A%20console.log(%22onEvent%22%2C%20event)%3B%0A%20listenForEvents(eventsQueue)%3B%0A%20%7D)%3B%0A%7D%0A%2F%2F%20Start%20listening%20to%20events%0AlistenForEvents(eventQueue)%3B%0A%60%60%60%0A%0A%3C%2FTab%3E%0A%3CTab%20value%3D%22java%22%20label%3D%22Java%22%3E%0A%0A%60%60%60java%0AString%20callbacksID%20%3D%20%22CALLBACK_ID%22%3B%0AString%20threadID%20%3D%20%22THREAD_ID%22%3B%0A%2F%2F%20Starting%20the%20Event%20Loop%0AendpointContainer.startListening()%3B%0A%0A%2F%2F%20Handling%20Thread%20events%0AendpointSession.registerCallback(%0A%20callbacksID%2C%0A%20EventType.ThreadCreatedEvent%2C%0A%20newThread%20-%3E%20%7B%0A%20System.out.println(newThread.threadId)%3B%0A%20%7D%0A)%3B%0A%0A%2F%2FHandling%20message%20Events%0AendpointSession.registerCallback(%0A%20callbacksID%2C%0A%20EventType.ThreadNewMessageEvent(threadID)%2C%0A%20newMessage%20-%3E%20%7B%0A%20System.out.println(newMessage.info.messageId)%3B%0A%20%7D%0A)%3B%0A%60%60%60%0A%3C%2FTab%3E%0A%3CTab%20value%3D%22kotlin%22%20label%3D%22Kotlin%22%3E%0A%0A%60%60%60kotlin%0Aval%20callbacksID%20%3D%20%22CALLBACK_ID%22%0Aval%20threadID%20%3D%20%22THREAD_ID%22%0A%2F%2F%20Starting%20the%20Event%20Loop%0AendpointContainer.startListening()%0A%0A%2F%2F%20Handling%20Thread%20events%0AendpointSession.registerCallback(%0A%20callbacksID%2C%0A%20EventType.ThreadCreatedEvent%0A)%7B%20newThread%20-%3E%0A%20println(newThread.threadId)%0A%7D%0A%0A%2F%2FHandling%20message%20Events%0AendpointSession.registerCallback(%0A%20callbacksID%2C%0A%20EventType.ThreadNewMessageEvent(threadID)%0A)%7B%20newMessage%20-%3E%0A%20println(newMessage.info%3F.messageId)%0A%7D%0A%60%60%60%0A%3C%2FTab%3E%0A%3CTab%20value%3D%22swift%22%20label%3D%22Swift%22%3E%0A%0A%60%60%60swift%0A%20try%3F%20endpointSession%3F.registerCallback(%0A%20for%3A%20privmx.endpoint.thread.ThreadCreatedEvent.self%2C%0A%20from%3A%20.thread%2C%20%0A%20identified%3A%20%22SOME_UNIQUE_IDENTIFIER%22%2C%0A%20%7B%20eventData%20in%0A%20%2F%2F%20some%20actions%20when%20new%20thread%20created%0A%20%7D)%0A%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%2C---%0Atitle%3A%20Managing%20Threads%0A---%0A%0AAt%20their%20core%2C%20Threads%20provide%20a%20secure%20way%20for%20assigned%20members%20to%20exchange%20encrypted%20messages.%0A%0A-%20Threads%20allow%20users%20to%20communicate%20using%20topic-specific%20communication%20channels.%0A-%20Each%20Context%20can%20contain%20any%20number%20of%20Threads%20with%20a%20unique%20identifier%20(%60threadId%60)%20used%20to%20distinguish%20them.%0A-%20Threads%20do%20not%20need%20to%20have%20unique%20names%20or%20assigned%20public%20keys.%0A%0A%23%23%20Permissions%0AThreads%20differentiate%20two%20types%20of%20users%20-%20Managers%20and%20Regular%20Users.%20The%20table%20below%20shows%20the%20differences%20in%20their%20permissions%3A%0A%0A%7C%20**Activity**%20%7C%20**User**%20%7C%20**Manager**%20%7C%0A%7C-------------------%7C----------------%7C--------------%7C%0A%7C%20Sending%20messages%20%7C%20yes%20%7C%20yes%20%7C%0A%7C%20Editing%20Thread%20%7C%20no%20%7C%20yes%20%7C%0A%7C%20Deleting%20messages%20%7C%20only%20their%20own%20%7C%20all%20messages%20%7C%0A%0AThe%20values%20above%20are%20the%20default%20policy%20values%20defined%20by%20PrivMX.%20To%20read%20more%20about%20Policies%20and%20learn%20how%20to%20modify%20them%2C%20go%20to%20%5BPolicies%5D(..%2Fconcepts%2Fpolicies).%0A%0A%0A%23%23%20Initial%20Assumptions%0AThe%20initial%20assumptions%20for%20all%20the%20code%20examples%20below%20are%20as%20follows%3A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%20%22Kotlin%22%20%2C%22Swift%22%5D%7D%3E%0A%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FConnection.hpp%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fthread%2FThreadApi.hpp%3E%0A%20%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FBuffer.hpp%3E%0A%20%2F%2F%20...%0A%0A%20%2F*%20%0A%20All%20the%20values%20below%20like%20BRIDGE_URL%2C%20SOLUTION_ID%2C%20CONTEXT_ID%0A%20should%20be%20replaced%20by%20the%20ones%20corresponding%20to%20your%20Bridge%20Server%20instance.%0A%20%0A%20The%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%20%0A%20Normally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0A%20or%20generated%20from%20a%20password%20(see%20the%20derivePrivateKey2()%20method%20in%20the%20Crypto%20API).%0A%20*%2F%0A%0A%20std%3A%3Astring%20BRIDGE_URL%20%7B%22http%3A%2F%2Flocalhost%3A9111%22%7D%3B%0A%20std%3A%3Astring%20SOLUTION_ID%20%7B%22YOUR_SOLUTION_ID%22%7D%3B%0A%20std%3A%3Astring%20CONTEXT_ID%20%7B%22YOUR_CONTEXT_ID%22%7D%3B%0A%0A%20std%3A%3Astring%20USER1_ID%20%7B%22user_1%22%7D%3B%0A%20std%3A%3Astring%20USER1_PUBLIC_KEY%20%7B%22PUBLIC_KEY_1%22%7D%3B%0A%20std%3A%3Astring%20USER1_PRIV%20%7B%22PRIVATE_KEY_1%22%7D%3B%0A%0A%20std%3A%3Astring%20USER2_ID%20%7B%22user_2%22%7D%3B%0A%20std%3A%3Astring%20USER2_PUBLIC_KEY%20%7B%22PUBLIC_KEY_2%22%7D%3B%0A%0A%20std%3A%3Astring%20USER3_ID%20%7B%22user_3%22%7D%3B%0A%20std%3A%3Astring%20USER3_PUBLIC_KEY%20%7B%22PUBLIC_KEY_3%22%7D%3B%0A%0A%20%2F%2F%20initialize%20Endpoint%20connection%20and%20Threads%20API%0A%20auto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIV%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0A%20auto%20threadApi%20%7Bthread%3A%3AThreadApi%3A%3Acreate(connection)%7D%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0A%20%60%60%60