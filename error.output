%20on%3A%20BRIDGE_URL%0A%20)%0A%60%60%60%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0A%23%23%20Creating%20Threads%0A%0ATo%20create%20a%20Thread%2C%20you%20need%20a%20name%20and%20a%20list%20of%20**public%20key%20-%20userID**%20pairs.%0ADue%20to%20the%20fact%20that%20each%20Thread%20is%20inside%20a%20Context%2C%20all%20the%20public%20keys%20have%20to%20be%20registered%20inside%20the%20given%20Context.%20%0AYou%20can%20do%20it%20using%20%5BPrivMX%20Bridge%20API%5D(https%3A%2F%2Fbridge.privmx.dev%2F).%0A%0AAfter%20creating%20a%20Thread%2C%20all%20the%20users%20with%20management%20rights%20will%20be%20able%20to%20edit%20the%20Thread.%0A%0ABelow%20you%20can%20see%20some%20examples%20of%20creating%20Threads%20that%20function%20as%20a%20chat%20feature%20in%20your%20application%2C%20with%20access%20management%20capabilities%20similar%20to%20those%20found%20in%20other%20popular%20collaboration%20tools.%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%2C%22Java%22%2C%22Kotlin%22%2C%22Swift%22%5D%7D%3E%0A%20%3CTab%3E%0A%20%60%60%60cpp%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%0A%20%7D%3B%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%2C%0A%20core%3A%3AUserWithPubKey%7BUSER2_ID%2C%20USER2_PUBLIC_KEY%7D%0A%20%7D%3B%0A%20auto%20threadId%20%7BthreadApi.createThread(CONTEXT_ID%2C%20users%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20thread's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20thread's%20private%20meta-data%22)%0A%20)%7D%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%0A%20%3CTab%3E%0A%20%60%60%60js%0A%20const%20managers%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%0A%20%5D%3B%0A%0A%20const%20users%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%0A%20%5D%3B%0A%0A%20%2F%2F%20create%20a%20new%20Thread%20with%20access%20for%20user_1%20as%20manager%20and%20user_2%20as%20regular%20user%0A%20%2F%2F%20for%20example%2C%20let's%20put%20the%20name%20of%20the%20thread%20as%20an%20object%20in%20the%20thread's%20private%20meta%0A%20const%20threadId%20%3D%20await%20threadApi.createThread(CONTEXT_ID%2C%20users%2C%20managers%2C%20%0A%20this.strToUint8(%22some%20thread's%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(JSON.stringify(%7Bname%3A%20%22some_thread%22%7D))%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60java%0A%20PrivmxEndpointContainer%20container%20%3D%20new%20PrivmxEndpointContainer()%3B%0A%20Long%20connectionID%20%3D%200L%3B%20%2F%2F%20your%20connection%20ID%0A%20String%20threadID%20%3D%20%22YOUR_THREAD_ID%22%3B%0A%0A%20ThreadApi%20threadApi%20%3D%20container.getEndpoint(connectionID).threadApi%3B%0A%20com.simplito.java.privmx_endpoint.model.Thread%20thread%20%3D%20threadApi.getThread(threadID)%3B%0A%0A%20List%3CUserWithPubKey%3E%20newUsers%20%3D%20thread.users.stream().map(userID%20-%3E%20%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%0A%20return%20new%20UserWithPubKey(%0A%20userID%2C%0A%20%22USER_PUBLIC_KEY%22%0A%20)%3B%0A%0A%20%7D).toList()%3B%0A%20List%3CUserWithPubKey%3E%20newManagers%20%3D%20thread.managers.stream().map(userID%20-%3E%20%7B%0A%20%2F%2FYour%20application%20must%20provide%20a%20way%2C%0A%20%2F%2Fto%20get%20user's%20public%20key%20from%20their%20userId.%0A%20return%20new%20UserWithPubKey(%0A%20userID%2C%0A%20%22USER_PUBLIC_KEY%22%0A%20)%3B%0A%0A%20%7D).toList()%3B%0A%20byte%5B%5D%20newPrivateMeta%20%3D%20%22New%20thread%20name%22.getBytes(StandardCharsets.UTF_8)%3B%0A%0A%20container.getEndpoint(connectionID).threadApi.updateThread(%0A%20threadID%2C%0A%20newUsers%2C%0A%20newManagers%2C%0A%20thread.publicMeta%2C%0A%20newPrivateMeta%2C%0A%20thread.version%2C%0A%20false%0A%20)%3B%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60kotlin%0A%20val%20container%20%3D%20PrivmxEndpointContainer()%0A%20val%20connectionID%20%3D%200L%20%2F%2F%20your%20connection%20ID%0A%20val%20threadID%20%3D%20%22YOUR_THREAD_ID%22%0A%0A%20val%20threadApi%20%3D%20container.getEndpoint(connectionID).threadApi%0A%20val%20thread%20%3D%20threadApi.getThread(threadID)%0A%0A%20val%20newUsers%20%3D%20thread.users.map%20%7B%20userID%20-%3E%0A%20UserWithPubKey(%0A%20userID%2C%0A%20%22USER_PUBLIC_KEY%22%0A%20)%0A%20%7D.toList()%0A%20val%20newManagers%20%3D%20thread.managers.map%20%7B%20userID%20-%3E%0A%20UserWithPubKey(%0A%20userID%2C%0A%20%22USER_PUBLIC_KEY%22%0A%20)%0A%20%7D.toList()%0A%20val%20newPrivateMeta%20%3D%20%22New%20thread%20name%22.toByteArray(StandardCharsets.UTF_8)%0A%0A%20container.getEndpoint(connectionID).threadApi.updateThread(%0A%20threadID%2C%0A%20newUsers%2C%0A%20newManagers%2C%0A%20thread.publicMeta%2C%0A%20newPrivateMeta%2C%0A%20thread.version%2C%0A%20false%0A%20)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%3E%0A%20%60%60%60swift%0A%20let%20users%20%3D%20%5Bprivmx.endpoint.core.UserWithPubKey%5D()%20%2F%2Fshould%20be%20prepared%20by%20developer%0A%20let%20managers%20%3D%20%5Bprivmx.endpoint.core.UserWithPubKey%5D()%20%2F%2Fshould%20be%20prepared%20by%20developer%0A%20let%20publicMeta%20%3D%20Data()%0A%20let%20privateMeta%20%3D%20Data()%0A%0A%20threadApi.updateThread(%0A%20threadInfo.threadId%2C%0A%20users%3Ausers%2C%0A%20managers%3Amanagers%2C%0A%20title%3AthreadInfo.data.title%2C%0A%20version%3AthreadInfo.version%2C%0A%20force%3Afalse%2C%0A%20generateNewKeyId%3Afalse%0A%20)%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%0A%23%23%20Listing%20Threads%0A%0AYour%20application%20may%20include%20multiple%20Threads%2C%20each%20associated%20with%20different%20Contexts.%20%0AYou%20can%20retrieve%20a%20**list%20of%20all%20Threads%20within%20a%20given%20Context.**%20%0AThis%20list%20will%20include%20useful%20metadata%20about%20the%20Threads%2C%20such%20as%20the%20creation%20date%2C%20the%20last%20message%20upload%20date%2C%20user%20list%2C%20and%20information%20about%20the%20last%20modification.%20%0AHowever%2C%20to%20optimize%20performance%2C%20the%20list%20will%20only%20include%20the%20total%20number%20of%20messages%20in%20each%20Thread%2C%20not%20the%20full%20message%20content.%0A%0AHere's%20an%20example%20of%20how%20to%20download%20the%20last%2030%20Threads%20created%20within%20a%20Context%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20%2F%2F%20list%20threads%0A%20core%3A%3APagingQuery%20query%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%2030%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%20%0A%20auto%20result%20%7BthreadApi.listThreads(CONTEXT_ID%2C%20query)%7D%3B%0A%20for%20(const%20auto%26%20thread%20%3A%20result.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22Thread%20ID%3A%20%22%20%3C%3C%20thread.threadId%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0A%20%60%60%60js%0A%20const%20query%3A%20Types.PagingQuery%20%3D%20%7Bskip%3A%200%2C%20limit%3A%2030%2C%20sortOrder%3A%20%22desc%22%7D%3B%0A%0A%20const%20result%20%3D%20await%20threadApi.listThreads(CONTEXT_ID%2C%20query)%3B%0A%20for%20(const%20thread%20of%20result.readItems)%20%7B%0A%20console.log(%22Thread%20ID%3A%20%22%2C%20thread.threadId)%3B%0A%20%7D%0A%20%60%60%60%0A%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0ATo%20limit%20collecting%20too%20much%20data%20when%20downloading%20Threads%2C%20specify%20the%20page%20index%20(starting%20from%200)%20and%20the%20number%20of%20items%20to%20be%20included%20on%20each%20page.%0A%0A%0A%23%23%20Modifying%20Threads%0A%0ADepending%20on%20your%20project's%20specification%2C%20it%20may%20be%20necessary%20to%20modify%20a%20Thread.%0AIt%20could%20be%20e.g.%20changing%20the%20name%20or%20adding%2Fremoving%20users.%0AEach%20user%20with%20management%20rights%20is%20able%20to%20modify%20Thread%2C%20delete%20them%20as%20a%20whole%20or%20only%20particular%20messages.%0A%0AUpdating%20a%20Thread%20means%20overwriting%20it%20with%20the%20provided%20data.%20%0ATo%20successfully%20update%20a%20Thread%2C%20you%20must%20specify%20its%20current%20%60version%60.%20%0AThe%20%60version%60%20field%20is%20mandatory%20to%20handle%20multiple%20updates%20on%20the%20server%20and%20it%20is%20incremented%20by%201%20with%20each%20update.%0A%0ABelow%20there%20is%20an%20example%20of%20modifying%20a%20Thread%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20std%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20newUsersList%7B%0A%20core%3A%3AUserWithPubKey%7BUSER1_ID%2C%20USER1_PUBLIC_KEY%7D%2C%0A%20core%3A%3AUserWithPubKey%7BUSER2_ID%2C%20USER2_PUBLIC_KEY%7D%0A%20core%3A%3AUserWithPubKey%7BUSER3_ID%2C%20USER3_PUBLIC_KEY%7D%0A%20%7D%3B%0A%0A%20auto%20threadInfo%20%7BthreadApi.getThread(threadId)%7D%3B%0A%0A%20threadApi.updateThread(threadId%2C%20newUsersList%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20new%20thread's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20new%20thread's%20private%20meta-data%22)%2C%20threadInfo.version%2C%20false%2C%20false%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0A%20%60%60%60js%0A%20%2F%2F%20Let's%20add%20a%20new%20user%20to%20the%20existing%20ones%20in%20the%20Thread%0A%20const%20newUsersList%20%3D%20%5B%0A%20%7BuserId%3A%20USER1_ID%2C%20pubKey%3A%20USER1_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER2_ID%2C%20pubKey%3A%20USER2_PUBLIC_KEY%7D%2C%0A%20%7BuserId%3A%20USER3_ID%2C%20pubKey%3A%20USER3_PUBLIC_KEY%7D%0A%20%5D%3B%20%0A%0A%20const%20threadInfo%20%3D%20await%20threadApi.getThread(threadId)%3B%0A%0A%20await%20threadApi.updateThread(threadId%2C%20newUsersList%2C%20managers%2C%20%0A%20this.strToUint8(%22some%20new%20thread's%20public%20meta-data%22)%2C%20%0A%20this.strToUint8(%22some%20new%20thread's%20private%20meta-data%22)%2C%20threadInfo.version%2C%20false%2C%20false%0A%20)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0AThree%20additional%20options%20are%20available%20when%20changing%20the%20list%20of%20users%20inside%20a%20Thread%3A%0A-%20%60force%60%20-%20applies%20an%20update%2C%20without%20checking%20the%20current%20version%3B%0A-%20%60forceGenerateNewKey%60%20-%20re-encrypts%20messages%20in%20the%20Thread.%20It's%20useful%20when%20a%20user%20is%20removed%20and%20we%20want%20to%20prevent%20them%20from%20accessing%20the%20Thread.%0A-%20%60policies%60%20-%20allow%20you%20to%20manage%20access%20to%20Threads%20and%20messages.%20%5BRead%20more%20about%20Policies%5D(..%2Fconcepts%2Fpolicies).%0A%0A%23%23%20Deleting%20Threads%0A%0ADeleting%20a%20Thread%20also%20removes%20all%20message%20data%20associated%20with%20it.%20%0A%0ABelow%20there%20is%20an%20example%20of%20deleting%20a%20Thread%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22C%2B%2B%22%2C%22JavaScript%22%5D%7D%3E%0A%0A%3CTab%3E%0A%20%60%60%60cpp%0A%20threadApi.deleteThread(threadId)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%0A%3CTab%3E%0A%20%60%60%60js%0A%20await%20threadApi.deleteThread(threadId)%3B%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%2C%7B%0A%20%22icon%22%3A%20%22threads%22%2C%0A%20%22pages%22%3A%20%5B%22overview%22%2C%20%22managing%22%2C%20%22messages%22%2C%20%22thread-events%22%5D%0A%7D%0A%2C---%0Atitle%3A%20SMS%20Notifications%0A---%0A%0APrivMX%20Bridge%20features%20WebSocket%20support.%0AThis%20allows%20you%20to%20receive%20instant%20notifications%20about%20changes%2C%20for%20example%3A%0A*%20new%20messages%20in%20Threads%0A*%20new%20files%20in%20Stores%0A*%20new%20items%20in%20Inboxes%0A%0AA%20common%20use%20case%20is%20to%20send%20SMS%20notifications%20when%20a%20specific%20event%20occurs.%0AThe%20following%20example%20shows%20how%20to%20build%20an%20SMS%20notification%20system%20using%20%5BSMSAPI%5D(https%3A%2F%2Fwww.smsapi.com%2F).%0AHowever%2C%20you%20can%20use%20any%20other%20notification%20service%20provider%20%E2%80%93%20just%20remove%20all%20the%20references%20to%20SMSAPI%20and%20reimplement%20the%20%60sendSms()%60%20function.%0A%0A%23%23%20Prerequisites%0A%0ATo%20send%20SMS%20notifications%2C%20you%20need%20to%20have%20an%20%5BSMSAPI%5D(https%3A%2F%2Fwww.smsapi.com%2F)%20account.%0AYou%20also%20need%20a%20running%20PrivMX%20Bridge%20instance.%20Follow%20the%20%5Bgetting%20started%5D(..%2Finstallation)%20guide%20to%20set%20it%20up.%0A%0A%23%23%20Subscribing%20to%20Notifications%0A1.%20Connect%20to%20your%20PrivMX%20Bridge%20instance%20using%20WebSockets.%20See%20%5BPrivMX%20Bridge%20docs%5D(https%3A%2F%2Fbridge.privmx.dev%2F)%20for%20more%20information.%0A2.%20Use%20the%20%5Bmanager%2FsubscribeToChannel%5D(https%3A%2F%2Fbridge.privmx.dev%2F%23manager-subscribetochannel)%20method%20to%20subscribe%20to%20notification%20channel(s).%0A3.%20Handle%20the%20incoming%20notifications%20and%20send%20SMS%20messages%20when%20needed.%20See%20%5BSMSAPI%20docs%5D(https%3A%2F%2Fwww.smsapi.com%2Fdocs%2F%3Fshell%232-single-sms)%20for%20more%20information.%0A%0AJavaScript%20example%3A%0A%60%60%60javascript%0Aimport%20%7B%20SMSAPI%20%7D%20from%20%22smsapi%22%3B%0Aimport%20WebSocket%20from%20%22ws%22%3B%0A%0A%2F%2F%20Config%20-%20replace%20with%20your%20data%0Aconst%20config%20%3D%20%7B%0A%20httpApiUrl%3A%20%22http%3A%2F%2Flocalhost%3A9111%2Fapi%22%2C%0A%20wsApiUrl%3A%20%22ws%3A%2F%2Flocalhost%3A9111%2Fapi%22%2C%0A%20apiKeyId%3A%20%22YOUR_API_KEY_ID%22%2C%0A%20apiKeySecret%3A%20%22YOUR_API_KEY_SECRET%22%2C%0A%20channels%3A%20%5B%22thread%22%2C%20%22store%22%2C%20%22stream%22%2C%20%22inbox%22%5D%2C%0A%20smsApi%3A%20%7B%0A%20url%3A%20%22https%3A%2F%2Fapi.smsapi.com%2Fsms.do%22%2C%0A%20oAuthToken%3A%20%22YOUR_SMSAPI_OAUTH_TOKEN%22%2C%0A%20phoneNumber%3A%20%22YOUR_SMSAPI_PHONE_NUMBER%22%2C%0A%20senderName%3A%20%22YOUR_SMSAPI_SENDER_NAME%22%2C%0A%20%7D%2C%0A%7D%3B%0A%0A%2F%2F%20Auth%0Aconst%20accessToken%20%3D%20(%0A%20await%20(%0A%20await%20fetch(config.httpApiUrl%2C%20%7B%0A%20method%3A%20%22POST%22%2C%0A%20headers%3A%20%7B%20%22Content-Type%22%3A%20%22application%2Fjson%22%20%7D%2C%0A%20body%3A%20JSON.stringify(%7B%0A%20jsonrpc%3A%20%222.0%22%2C%0A%20id%3A%20128%2C%0A%20method%3A%20%22manager%2Fauth%22%2C%0A%20params%3A%20%7B%0A%20grantType%3A%20%22api_key_credentials%22%2C%0A%20apiKeyId%3A%20config.apiKeyId%2C%0A%20apiKeySecret%3A%20config.apiKeySecret%2C%0A%20%7D%2C%0A%20%7D)%2C%0A%20%7D)%0A%20).json()%0A).result.accessToken%3B%0A%0A%2F%2F%20Create%20WebSocket%0Aconst%20ws%20%3D%20new%20WebSocket(config.wsApiUrl)%3B%0Alet%20reqId%20%3D%201%3B%0Aconst%20reqMap%20%3D%20new%20Map()%3B%0A%0A%2F%2F%20Bind%20access%20token%20and%20subscribe%20to%20channels%20when%20WebSocket%20opens%0Aws.onopen%20%3D%20async%20()%20%3D%3E%20%7B%0A%20await%20request(%22manager%2FbindAccessToken%22%2C%20%7B%0A%20accessToken%3A%20accessToken%2C%0A%20%7D)%3B%0A%20await%20request(%22manager%2FsubscribeToChannel%22%2C%20%7B%0A%20channels%3A%20config.channels%2C%0A%20%7D)%3B%0A%7D%3B%0A%0A%2F%2F%20Handle%20incoming%20messages%0Aws.onmessage%20%3D%20(e)%20%3D%3E%20%7B%0A%20const%20data%20%3D%20JSON.parse(e.data)%3B%0A%20const%20req%20%3D%20reqMap.get(data.id)%3B%0A%20if%20(req)%20%7B%0A%20if%20(data.error)%20%7B%0A%20req.reject(data.error)%3B%0A%20%7D%20else%20%7B%0A%20req.resolve(data.result)%3B%0A%20%7D%0A%20%7D%20else%20%7B%0A%20%2F%2F%20Act%20on%20selected%20messages%20-%20customize%20as%20needed%0A%20if%20(%0A%20data.channel%20%3D%3D%3D%20%22thread%22%20%26%26%0A%20data.type%20%3D%3D%3D%20%22threadNewMessage%22%20%26%26%0A%20data.data.contextId%20%3D%3D%3D%20%2266f76cdc06848d6a6494f783%22%20%26%26%0A%20data.data.threadId%20%3D%3D%3D%20%226757b81daafe67cb6e19180e%22%0A%20)%20%7B%0A%20sendSms(%22New%20message%20in%20thread%20LoremIpsum%22)%3B%0A%20%7D%0A%20%7D%0A%7D%3B%0A%0A%2F%2F%20Log%20errors%0Aws.onerror%20%3D%20(e)%20%3D%3E%20%7B%0A%20console.error(%22WebSocket%20error%3A%22%2C%20e)%3B%0A%7D%3B%0A%0A%2F%2F%20WebSocket%20request%20helper%0Afunction%20request(method%2C%20params)%20%7B%0A%20const%20id%20%3D%20reqId%2B%2B%3B%0A%20ws.send(%0A%20JSON.stringify(%7B%0A%20jsonrpc%3A%20%222.0%22%2C%0A%20id%3A%20id%2C%0A%20method%3A%20method%2C%0A%20params%3A%20params%2C%0A%20%7D)%2C%0A%20)%3B%0A%20return%20new%20Promise((resolve%2C%20reject)%20%3D%3E%20%7B%0A%20reqMap.set(id%2C%20%7B%20resolve%2C%20reject%20%7D)%3B%0A%20%7D)%3B%0A%7D%0A%0A%2F%2F%20SMS%20sending%20function%20that%20uses%20SMSAPI%0Aconst%20smsapi%20%3D%20new%20SMSAPI(config.smsApi.oAuthToken)%3B%0Aasync%20function%20sendSms(message)%20%7B%0A%20try%20%7B%0A%20const%20result%20%3D%20await%20smsapi.sms.sendSms(config.smsApi.phoneNumber%2C%20message)%3B%0A%20console.log(%22sendSms%20result%22%2C%20result)%3B%0A%20%7D%20catch%20(err)%20%7B%0A%20console.error(%22sendSms%20error%22%2C%20err)%3B%0A%20%7D%0A%7D%0A%60%60%60%0A%0A%23%23%20Unsubscribing%20from%20Notifications%0AWhen%20you%20no%20longer%20want%20to%20receive%20notifications%2C%20use%20the%20%5Bmanager%2FunsubscribeFromChannel%5D(https%3A%2F%2Fbridge.privmx.dev%2F%23manager-unsubscribefromchannel)%20method%20to%20unsubscribe%20from%20the%20channel(s).%0A%0AJavaScript%20example%20(uses%20%60request()%60%20and%20%60config%60%20from%20the%20previous%20example)%3A%0A%60%60%60javascript%0Aawait%20request(%22manager%2FunsubscribeFromChannel%22%2C%20%7B%0A%20channels%3A%20config.channels%2C%0A%7D)%3B%0A%60%60%60%0A%2C---%0Atitle%3A%20Managing%20Keys%0A---%0A%0AThis%20page%20outlines%20a%20structured%20approach%20to%20managing%20private%20keys%20(in%20case%20of%20e.g.%20changing%20a%20password)%2C%20ensuring%20secure%20authentication%20and%20data%20access%20integrity.%0A%0A%23%23%20Step%201%3A%20Private%20Key%20Generation%20and%20Storage%0A%0A%23%23%23%20Step%201A%3A%20Generating%20Private%20Key%20from%20Password%20and%20Username%0A%0A-%20Private%20key%20is%20generated%20automatically%20using%20password%20and%20username.%0A-%20**Password%20Change%20Impact%3A**%20Changing%20the%20password%20automatically%20results%20in%20generating%20a%20new%20private%20key%2C%20as%20it%20is%20derived%20directly%20from%20the%20updated%20password%20and%20username.%0A%0A%23%23%23%20Step%201B%3A%20Private%20Key%20Stored%20on%20Application%20Server%0A%0A-%20Password%20and%20username%20are%20used%20for%20authentication%20with%20the%20application%20server.%0A-%20The%20private%20key%20is%20stored%20securely%20on%20the%20server%2C%20encrypted%20with%20either%20the%20user's%20password%20or%20a%20key%20derived%20from%20the%20password.%0A%0A%23%23%23%23%20Password%20Change%20Process%0A%0A1.%20Password%20is%20updated%20on%20the%20server%20only.%0A2.%20The%20old%20private%20key%20is%20re-encrypted%20on%20the%20client%20side%20using%20the%20new%20password%20or%20a%20derived%20key%2C%20and%20then%20saved%20back%20on%20the%20server.%0A3.%20If%20the%20private%20key%20requires%20regeneration%3A%0A%20-%20The%20new%20private%20key%20is%20encrypted%20(with%20the%20new%20password%20or%20derived%20key)%20and%20replaces%20the%20private%20key%20stored%20on%20the%20server.%0A4.%20If%20regeneration%20is%20not%20required%2C%20the%20process%20ends.%0A%0A%23%23%23%20Step%201C%3A%20Regenerating%20Private%20Key%20Without%20Changing%20Password%0A%0A-%20A%20new%20private%20key%20is%20generated.%0A-%20The%20new%20key%20replaces%20the%20existing%20private%20key%20on%20the%20server%2C%20encrypted%20with%20the%20current%20password%20or%20a%20derived%20key.%0A%0A%23%23%20Step%202%3A%20Updating%20Public%20Key%0A%0A-%20The%20new%20public%20key%20is%20sent%20to%20the%20application%20server.%0A%0A%23%23%20Step%203%3A%20Registering%20Public%20Key%20in%20Bridge%0A%0A-%20The%20application%20server%20registers%20the%20new%20public%20key%20in%20PrivMX%20Bridge.%0A%0A**Data%20Access%20Impact%3A**%0A%0A-%20The%20user%20temporarily%20loses%20access%20to%20existing%20data%20(containers%20like%20Thread%20or%20Store)%20they%20previously%20had%20access%20to.%0A-%20The%20application%20server%20has%20to%20notify%20the%20Container%20Manager%20that%20access%20to%20the%20data%20must%20be%20refreshed.%0A-%20Only%20the%20users%20with%20management%20access%20to%20the%20specific%20container%20can%20restore%20access%20for%20the%20user.%0A%0A%23%23%20Step%204%3A%20Restoring%20Data%20Access%0A%0A-%20The%20Container%20Manager%20in%20the%20Endpoint%20initiates%20a%20recovery%20procedure%20to%20refresh%20data%20access.%0A%0A%23%23%23%23%20Recovery%20Procedure%0A%0A1.%20All%20containers%20are%20updated%20with%20functions%20such%20as%20%60threadUpdate%60%20or%20%60storeUpdate%60%20etc.%0A2.%20The%20old%20public%20key%20associated%20with%20the%20specific%20user%20is%20replaced%20with%20a%20new%20public%20key%20in%20the%20containers.%0A3.%20The%20option%20%60force%60%20while%20updating%20should%20be%20set%20to%20%60True%60.%0A%0AThis%20structured%20approach%20ensures%20secure%20management%20of%20private%20and%20public%20keys%20while%20maintaining%20data%20access%20integrity%20during%20key%20updates%20or%20password%20changes.%0A%0A%2C---%0Atitle%3A%20Access%20Management%0A---%0A%0APrivMX%20platform%20offers%20versatile%20containers%20like%20Threads%2C%20Stores%2C%20and%20Inboxes%20to%20support%20secure%20collaboration%20and%20communication.%0AAccess%20to%20these%20containers%20is%20managed%20based%20on%20different%20user%20roles%20and%20the%20type%20of%20container%20setup.%20This%20ensures%20that%20only%20authorized%20participants%20can%20view%20and%20modify%20the%20content.%0AHere%E2%80%99s%20a%20breakdown%20of%20how%20these%20elements%20function%3A%0A%0A-%20**Private%20Users**%20-%20Private%20containers%20are%20created%20and%20managed%20by%20one%20of%20the%20participants%20(not%20the%20owner).%0AIn%20this%20scenario%2C%20access%20to%20the%20container's%20content%20is%20controlled%20by%20the%20participants%2C%20not%20by%20the%20system%20owner.%0AThe%20owner%20can%20view%20content%20they%E2%80%99ve%20been%20granted%20access%20to%20by%20participants%2C%20but%20cannot%20modify%20it.%20The%20keys%20remain%20entirely%20with%20the%20users%2C%20ensuring%20a%20high%20level%20of%20privacy.%0A%0A-%20**Managed%20Users**%20-%20Managed%20containers%2C%20on%20the%20other%20hand%2C%20are%20created%20and%20managed%20directly%20by%20the%20owner%2C%20who%20has%20access%20to%20all%20the%20content%20within%20the%20container.%0AWhile%20this%20setup%20allows%20the%20owner%20to%20monitor%20and%20modify%20everything%20that%20flows%20through%20the%20container%2C%0Ait%20also%20provides%20a%20standardized%20access%20experience%20common%20in%20many%20communication%20systems.%0A%0AIn%20practice%2C%20these%20two%20modes%20allow%20PrivMX%20to%20balance%20privacy%20and%20control%2C%20enabling%20both%20highly%20secure%20user-controlled%20spaces%20and%20owner-managed%20containers%20suited%20to%20organizational%20needs.%0A%0A%23%23%20Scenarios%0A%7C%20%7C%20**Private%20Channel**%20%7C%20**Managed%20Channel**%20%7C%0A%7C-------------------%7C---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------%7C------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------%7C%0A%7C%20**Private%20Users**%20%7C%20%5BFull%20User%20Privacy%5D(%23full-user-privacy.mdx)%20-%20The%20owner%20can%20only%20access%20the%20content%20they%20were%20granted%20permission%20to%20by%20the%20other%20participants%20of%20the%20container.%20Therefore%2C%20the%20owner%20should%20be%20directly%20added%20as%20a%20participant%20to%20gain%20the%20necessary%20access.%20%7C%20%5BPartially%20Managed%20Accounts%5D(%23partially-managed-accounts-and-containers%20)%20-%20The%20owner%20has%20access%20to%20the%20entire%20content%20of%20the%20container.%20However%2C%20without%20the%20necessary%20private%20keys%2C%20they%20cannot%20make%20any%20modifications%20to%20the%20content.%20%7C%0A%7C%20**Managed%20Users**%20%7C%20%5BManaged%20Users%20with%20Impersonation%5D(%23managed-accounts-with-impersonation)%20-%20The%20owner%20can%20access%20the%20content%20by%20using%20the%20users'%20private%20keys.%20This%20is%20possible%20because%20the%20system%20owner%20has%20ownership%20of%20the%20keys%2C%20which%20are%20stored%20in%20the%20management%20system.%20%7C%20%5BFull%20Access%20Management%5D(%23fully-managed-accounts-and-containers-with-full-access)%20-%20The%20owner%20can%20view%20and%20modify%20everything%20that%20is%20transmitted%20through%20the%20container%20-%20it's%20a%20full%20access%20mode%20to%20the%20container's%20content%20(which%20is%20the%20standard%20in%20typical%20communication%20systems).%20%7C%0A%0A%23%23%23%20Potential%20Threats%0AEach%20scenario%20introduces%20distinct%20security%20challenges%20and%20privacy%20implications%3A%0A%0A-%20**Full%20User%20Privacy**%20%E2%80%93%20ensures%20maximum%20privacy%2C%20but%20carries%20the%20risk%20of%20data%20loss%20if%20users%20lose%20access%20to%20their%20accounts.%20Additionally%2C%20there%20is%20a%20potential%20for%20undetected%20breaches%20if%20a%20user%E2%80%99s%20device%20is%20compromised%20(if%20the%20private%20key%20is%20stored%20locally).%20However%2C%20the%20keys%20can%20be%20deterministically%20generated%20from%20user-provided%20data%20as%20an%20alternative.%0A-%20**Partially%20Managed%20Accounts**%20%E2%80%93%20faces%20risks%20related%20to%20insider%20threats%20and%20potential%20misuse%20of%20read-only%20access%2C%20as%20administrators%20may%20still%20view%20sensitive%20data%20under%20certain%20conditions.%0A-%20**Managed%20Users%20with%20Impersonation**%20%E2%80%93%20introduces%20the%20risk%20of%20unauthorized%20access%2C%20if%20the%20owner's%20credentials%20or%20users'%20private%20keys%20are%20compromised.%20Since%20the%20users'%20private%20keys%20are%20stored%20by%20the%20system's%20owner%2C%20they%20could%20be%20vulnerable%20to%20breaches.%20It's%20up%20to%20the%20developer%20to%20secure%20them%20properly.%0A-%20**Full%20Access%20Management**%20%E2%80%93%20presents%20a%20heightened%20risk%20of%20data%20manipulation%2C%20insider%20threats%2C%20and%20challenges%20in%20securely%20managing%20and%20storing%20private%20keys%20within%20the%20system.%0A%0APrivMX%20offers%20flexible%20configurations%20to%20address%20diverse%20privacy%20and%20management%20needs.%0AThe%20selected%20scenario%20should%20align%20with%20the%20organization's%20specific%20security%2C%20compliance%2C%20and%20operational%20requirements.%0A%0A%23%23%20Full%20User%20Privacy%0A%20Private%20Users%20-%20Private%20Containers%0A%0AA%20Private%20Channel%20is%20set%20up%20by%20one%20of%20the%20participants%2C%20not%20the%20system%20owner%2C%20and%20managed%20by%20the%20users%20within%20the%20container.%0AThe%20owner%20does%20not%20have%20access%20to%20the%20users'%20private%20keys%20and%20can%20only%20view%20the%20content%20if%20participants%20directly%20grant%20them%20access.%0A%0AThis%20setup%20is%20ideal%20when%20privacy%20is%20the%20priority%2C%20but%20some%20oversight%20may%20occasionally%20be%20necessary.%0AAny%20external%20access%20can%20be%20granted%20only%20by%20the%20participants%20who%20set%20up%20the%20container.%0A%0A%23%23%23%20System%20Roles%0AThe%20table%20below%20outlines%20system%20roles%20in%20this%20scenario%3A%0A%0A%7C%20%7C%20**Application**%20%7C%20**Application%20Server**%20%7C%20**PrivMX%20Bridge**%7C%0A%7C%20---%20%7C%20%3A---%3A%20%7C%20%3A---%3A%20%7C%3A---%3A%20%7C%0A%7C%20**Generating%20Users'%20Key%20Pair**%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%20%7C%0A%7C%20**Storing%20Users'%20Private%20Keys**%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%20%7C%0A%7C%20**Storing%20Users'%20Public%20Keys**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Registering%20Users'%20Public%20Keys%20in%20Bridge**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Creating%20and%20managing%20containers**%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%20%7C%0A%7C%20**Managing%20System%20Owner's%20Public%20Key**%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%20%7C%0A%7C%20**Storing%20always%20encrypted%20data**%20%7C%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%0A%0A%23%23%23%20Example%20Applications%0A%0A-%20**Research%20Teams**%3A%20Researchers%20working%20on%20sensitive%20projects%20or%20developing%20new%20technologies%20may%20use%20this%20setup%20to%20restrict%20access%20only%20to%20authorized%20team%20members%2C%20thereby%20protecting%20their%20intellectual%20property.%0A-%20**Investigative%20Journalism**%3A%20Journalists%20working%20on%20sensitive%20material%20can%20securely%20communicate%20and%20store%20information%20within%20a%20container%20inaccessible%20to%20platform%20administrators%2C%20safeguarding%20journalistic%20sources%20and%20data%20privacy.%0A%0A%0A%23%23%20Partially%20Managed%20Accounts%20and%20Containers%0A%23%23%23%20Private%20Users%20-%20Managed%20Containers%0A%0AIn%20this%20scenario%2C%20accounts%20and%20containers%20are%20managed%20in%20a%20limited%20way.%0AManaged%20containers%20are%20established%20by%20the%20system%20owner%2C%20who%20has%20read-only%20access%20without%20the%20ability%20to%20modify%20any%20content%2C%20as%20private%20keys%20remain%20entirely%20with%20the%20users.%0A%0AThis%20model%20prioritizes%20privacy%2C%20as%20the%20owner%20cannot%20interfere%20or%20alter%20content%20within%20the%20container.%0A%0A%23%23%23%20System%20Roles%0AThe%20table%20below%20outlines%20system%20roles%20in%20this%20scenario%3A%0A%0A%7C%20%7C%20**Application**%20%7C%20**Application%20Server**%20%7C%20**PrivMX%20Bridge**%0A%7C%20---%20%7C%20%3A---%3A%20%7C%20%3A---%3A%20%7C%20%3A---%3A%20%7C%0A%7C%20**Generating%20Users'%20Key%20Pair**%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%20%7C%0A%7C%20**Storing%20Users'%20Private%20Keys**%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%20%7C%0A%7C%20**Storing%20Users'%20Public%20Keys**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Registering%20Users'%20Public%20Keys%20in%20Bridge**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Creating%20and%20managing%20containers**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Managing%20System%20Owner's%20Public%20Key**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Storing%20always%20encrypted%20data**%20%7C%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%0A%0A%0A%23%23%23%20Example%20Applications%0A%0A-%20**Corporate%20Work%20Environment**%3A%20In%20workplaces%20with%20strict%20compliance%20requirements%2C%20administrators%20may%20have%20read-only%20access%20to%20certain%20documents%20in%20exceptional%20circumstances%2C%20such%20as%20when%20HR%20personnel%20need%20to%20resolve%20conflicts%20or%20retrieve%20lost%20data.%0A-%20**Public%20Institutions**%3A%20In%20departments%20that%20manage%20sensitive%20documents%2C%20administrators%20can%20have%20restricted%20access%2C%20which%20preserves%20data%20integrity%20without%20allowing%20them%20to%20modify%20the%20content.%0A%0A%0A%23%23%20Managed%20Accounts%20with%20Impersonation%0A%23%23%23%20Managed%20Users%20-%20Private%20Containers%0A%0AIn%20this%20model%2C%20private%20containers%20are%20still%20set%20up%20by%20a%20participant%2C%20but%20the%20system%20owner%20has%20access%20to%20private%20keys%20and%20can%20utilize%20these%20to%20access%20content.%0AThis%20access%20allows%20administrators%20to%20%22impersonate%22%20users%20when%20necessary%2C%20to%20access%20information%20stored%20in%20these%20containers.%0AIt%20is%20suited%20to%20environments%20that%20require%20stricter%20oversight%2C%20but%20do%20not%20necessitate%20regular%20content%20modification.%0A%0ASuch%20a%20setup%20requires%20the%20system%20owner%20to%20generate%20and%20store%20all%20Private%20Keys%20in%20a%20safe%20place%20and%20use%20them%20only%20in%20extreme%20situations.%0ASince%20the%20users%20still%20create%20their%20containers%2C%20only%20impersonation%20(using%20participant's%20Private%20Key)%20can%20grant%20full%20access%20to%20the%20container%20content.%0A%0A%23%23%23%20System%20Roles%0AThe%20table%20below%20outlines%20system%20roles%20in%20this%20scenario%3A%0A%0A%7C%20%7C%20**Application**%20%7C%20**Application%20Server**%20%7C%20**PrivMX%20Bridge**%0A%7C%20---%20%7C%20%3A---%3A%20%7C%20%3A---%3A%20%7C%20%3A---%3A%20%7C%0A%7C%20**Generating%20Users'%20Key%20Pair**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Storing%20Users'%20Private%20Keys**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Storing%20Users'%20Public%20Keys**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Registering%20Users'%20Public%20Keys%20in%20Bridge**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Creating%20and%20managing%20containers**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Managing%20System%20Owner's%20Public%20Key**%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%20%7C%0A%7C%20**Storing%20always%20encrypted%20data**%20%7C%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%0A%0A%0A%23%23%23%20Example%20Applications%0A%0A-%20**Data%20Management%20in%20Healthcare**%3A%20Hospitals%20may%20require%20administrators%20to%20access%20patient%20records%20or%20test%20results%20during%20emergencies%2C%20where%20key%20management%20enables%20rapid%20access%20without%20direct%20user%20involvement.%0A-%20**Compliance%20in%20Financial%20Systems**%3A%20Financial%20institutions%20may%20need%20administrators%20to%20monitor%20client%20resources%20to%20comply%20with%20regulatory%20standards%2C%20ensuring%20the%20information%20remains%20auditable.%0A%0A%0A%23%23%20Fully%20Managed%20Accounts%20and%20Containers%20with%20Full%20Access%0A%23%23%23%20Managed%20Users%20-%20Managed%20Containers%0A%0AIn%20this%20scenario%2C%20both%20accounts%20and%20containers%20are%20fully%20managed%20by%20the%20system%20owner%2C%20granting%20them%20full%20access%20to%20all%20content.%0AThey%20can%20view%20and%20modify%20any%20data%20within%20the%20container%2C%20as%20private%20keys%20are%20stored%20and%20controlled%20by%20the%20system%20owner.%0AThis%20model%20is%20typically%20used%20in%20cases%20requiring%20comprehensive%20control%20over%20data%20for%20security%2C%20compliance%2C%20or%20operational%20efficiency.%0A%0A%23%23%23%20System%20Roles%0AThe%20table%20below%20outlines%20system%20roles%20in%20this%20scenario%3A%0A%0A%7C%20%7C%20**Application**%20%7C%20**Application%20Server**%20%7C%20**PrivMX%20Bridge**%0A%7C%20---%20%7C%20%3A---%3A%20%7C%20%3A---%3A%20%7C%20%3A---%3A%20%7C%0A%7C%20**Generating%20Users'%20Key%20Pair**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Storing%20Users'%20Key%20Pair**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Storing%20Users'%20Public%20Keys**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Registering%20Users'%20Public%20Keys%20in%20Bridge**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Creating%20and%20managing%20containers**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Managing%20System%20Owner's%20Public%20Key**%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%20%7C%0A%7C%20**Storing%20always%20encrypted%20data**%20%7C%20%7C%20%7C%3CIcon%20icon%3D%22check%22%2F%3E%20%7C%0A%0A%23%23%23%20Example%20Applications%0A%0A-%20**Hospital%20Data%20Management**%3A%20Full%20access%20allows%20administrators%20and%20authorized%20staff%20to%20easily%20share%20and%20update%20patient%20records%20as%20needed.%20This%20facilitates%20prompt%20decision-making%20and%20coordination%20between%20specialists.%0A-%20**Financial%20Regulatory%20Compliance**%3A%20Financial%20services%20often%20require%20extensive%20monitoring%20and%20control%20over%20sensitive%20documents%2C%20enabling%20administrators%20to%20oversee%20client%20interactions%20and%20document%20transactions%20to%20meet%20regulatory%20standards.%0A%2C---%0Atitle%3A%20Policies%0A---%0A%0A%0APolicies%20determine%20who%20is%20allowed%20to%20perform%20specific%20actions.%20You%20can%20define%20your%20policy%20on%20three%20levels%3A%20for%20a%20Context%2C%20for%20a%20Container%20(Thread%2C%20Store%2C%20etc)%2C%20and%20for%20items%20such%20as%20messages%20or%20files%2C%20in%20case%20of%20Containers%20that%20include%20them.%0A%0AThis%20section%20covers%20policies%20in%20the%20Containers'%20scope.%0A%0A%23%23%20Overview%0ASetting%20a%20policy%20in%20the%20Container%20overwrites%20the%20policy%20from%20the%20Context.%0AThe%20property%20of%20the%20policy%20can%20be%20set%20to%20one%20of%20the%20following%20values%3A%0A%0A-%20%22default%22%20-%20takes%20the%20default%20value%2C%20%5Blisted%20below%5D(%23default-policy-values)%0A-%20%22inherit%22%20-%20always%20takes%20value%20from%20the%20Context%20(can%20only%20be%20used%20in%20Container%20and%20item%20policies)%0A-%20%22none%22%20-%20no%20one%20can%20perform%20this%20action%0A-%20%22all%22%20-%20all%20Context%20users%20can%20perform%20this%20action%0A-%20%22user%22%20-%20all%20Container%20users%20can%20perform%20this%20action%0A-%20%22manager%22%20-%20all%20Container%20managers%20can%20perform%20this%20action%0A-%20%22owner%22%20-%20only%20Container%20owner%20can%20perform%20this%20action%0A-%20%22itemOwner%22%20-%20only%20item%20owner%20can%20perform%20this%20action%20(can%20only%20be%20used%20in%20the%20item%20policy)%0A%0ALeaving%20an%20empty%20policy%20in%20a%20Container%20or%20item%20policy%20results%20in%20%60inherit%60.%20In%20Context%20it%20results%20in%20%60default%60.%0A%0AYou%20can%20also%20combine%20the%20values%20listed%20above.%20If%20you%20want%20to%20allow%20item%20updates%20to%20be%20executed%20only%20by%20the%20item%20owner%2C%20with%20the%20additional%20assumption%20that%20they%20must%20be%20an%20active%20user%20of%20the%20Container%2C%20you%20can%20write%20%60itemOwner%26user%60.%20But%20if%20you%20want%20to%20allow%20the%20Container%20managers%20to%20also%20update%20the%20item%2C%20you%20can%20write%20%60itemOwner%26user%2Cmanager%60.%20In%20the%20policy%20entry%2C%20the%20%60%26%60%20character%20means%20'and'%2C%20and%20the%20coma%20%60%2C%60%20means%20%60or%60.%20Operations%20with%20%60%26%60%20are%20always%20performed%20first.%0A%0A%23%23%20Default%20Policy%20Values%0AThe%20Endpoint%20can%20only%20define%20policies%20on%20the%20level%20of%20Containers%20and%20items.%0AContext%20level%20policies%20include%20rules%20connected%20to%2C%20for%20example%2C%20creating%20Containers%20%E2%80%93%20so%20they%20have%20to%20be%20defined%20using%20Bridge%20API.%0A%0AThe%20following%20tables%20list%20the%20default%20policy%20values%20in%20PrivMX%3A%0A%0A%23%23%23%20Context%0A%7C%20**Policy**%20%7C%20**Value**%20%7C%0A%7C------------------------%7C-----------%7C%0A%7C%20listUsers%20%7C%20all%20%7C%0A%7C%20sendCustomNotification%20%7C%20all%20%7C%0A%0A%0A%0A%20%23%23%23%20General%0A%20%7C%20**Policy**%20%7C%20**Value**%20%7C%0A%20%7C---------------------------------%7C-----------%7C%0A%20%7C%20get%20%7C%20user%20%7C%0A%20%7C%20listMy%20%7C%20all%20%7C%0A%20%7C%20listAll%20%7C%20none%20%7C%0A%20%7C%20create%20%7C%20all%20%7C%0A%20%7C%20update%20%7C%20manager%20%7C%0A%20%7C%20delete%20%7C%20manager%20%7C%0A%20%7C%20updatePolicy%20%7C%20manager%20%7C%0A%20%7C%20creatorHasToBeManager%20%7C%20yes%20%7C%0A%20%7C%20updaterCanBeRemovedFromManagers%20%7C%20no%20%7C%0A%20%7C%20ownerCanBeRemovedFromManagers%20%7C%20yes%20%7C%0A%20%7C%20canOverwriteContextPolicy%20%7C%20yes%20%7C%0A%20%7C%20sendCustomNotification%20%7C%20all%20%7C%0A%0A%20%23%23%23%23%20Thread%20Items%0A%20%7C%20**Policy**%20%7C%20**Value**%20%7C%0A%20%7C------------%7C------------------------%7C%0A%20%7C%20get%20%7C%20user%20%7C%0A%20%7C%20listMy%20%7C%20user%20%7C%0A%20%7C%20listAll%20%7C%20user%20%7C%0A%20%7C%20create%20%7C%20user%20%7C%0A%20%7C%20update%20%7C%20itemOwner%26user%2Cmanager%20%7C%0A%20%7C%20delete%20%7C%20itemOwner%26user%2Cmanager%20%7C%0A%0A%20%23%23%23%20Store%0A%20%7C%20**Policy**%20%7C%20**Value**%20%7C%0A%20%7C---------------------------------%7C-----------%7C%0A%20%7C%20get%20%7C%20user%20%7C%0A%20%7C%20listMy%20%7C%20all%20%7C%0A%20%7C%20listAll%20%7C%20none%20%7C%0A%20%7C%20create%20%7C%20all%20%7C%0A%20%7C%20update%20%7C%20manager%20%7C%0A%20%7C%20delete%20%7C%20manager%20%7C%0A%20%7C%20updatePolicy%20%7C%20manager%20%7C%0A%20%7C%20creatorHasToBeManager%20%7C%20yes%20%7C%0A%20%7C%20updaterCanBeRemovedFromManagers%20%7C%20no%20%7C%0A%20%7C%20ownerCanBeRemovedFromManagers%20%7C%20yes%20%7C%0A%20%7C%20canOverwriteContextPolicy%20%7C%20yes%20%7C%0A%20%7C%20sendCustomNotification%20%7C%20all%20%7C%0A%0A%20%23%23%23%23%20Store%20Item%0A%20%7C%20**Policy**%20%7C%20**Value**%20%7C%0A%20%7C------------%7C------------------------%7C%0A%20%7C%20get%20%7C%20user%20%7C%0A%20%7C%20listMy%20%7C%20user%20%7C%0A%20%7C%20listAll%20%7C%20user%20%7C%0A%20%7C%20create%20%7C%20user%20%7C%0A%20%7C%20update%20%7C%20itemOwner%26user%2Cmanager%20%7C%0A%20%7C%20delete%20%7C%20itemOwner%26user%2Cmanager%20%7C%0A%0A%20%23%23%23%20Inbox%0A%20%7C%20**Policy**%20%7C%20**Value**%20%7C%0A%20%7C---------------------------------%7C-----------%7C%0A%20%7C%20get%20%7C%20user%20%7C%0A%20%7C%20listMy%20%7C%20all%20%7C%0A%20%7C%20listAll%20%7C%20none%20%7C%0A%20%7C%20create%20%7C%20all%20%7C%0A%20%7C%20update%20%7C%20manager%20%7C%0A%20%7C%20delete%20%7C%20manager%20%7C%0A%20%7C%20updatePolicy%20%7C%20manager%20%7C%0A%20%7C%20creatorHasToBeManager%20%7C%20yes%20%7C%0A%20%7C%20updaterCanBeRemovedFromManagers%20%7C%20no%20%7C%0A%20%7C%20ownerCanBeRemovedFromManagers%20%7C%20yes%20%7C%0A%20%7C%20canOverwriteContextPolicy%20%7C%20yes%20%7C%0A%20%7C%20sendCustomNotification%20%7C%20all%20%7C%0A%0A%20%2C---%0Atitle%3A%20Metrics%0A---%0A%0APrivMX%20Bridge%20provides%20a%20%60%2Fmetrics%60%20endpoint%20that%20returns%20various%20metrics%20in%20a%20format%20compatible%20with%20%5BPrometheus%5D(https%3A%2F%2Fprometheus.io%2F).%20The%20endpoint%20is%20protected%20by%20HTTP%20Basic%20Authorization%20for%20security.%0A%0A%23%23%20Metrics%20Endpoint%0A%0A-%20**Endpoint**%3A%20%60%2Fmetrics%60%0A-%20**Access%20Control**%3A%20Requires%20HTTP%20Basic%20Authorization%0A-%20**Scrape%20Interval**%3A%201%20minute%20(data%20older%20than%201%20minute%20is%20discarded)%0A-%20**Bucket%20Clearing**%3A%20After%20each%20metric%20collection%20via%20the%20%60%2Fmetrics%60%20endpoint%2C%20the%20internal%20metrics%20bucket%20is%20cleared.%20This%20enables%20the%20endpoint%20to%20support%20scrape%20intervals%20shorter%20than%201%20minute%2C%20if%20desired.%0A%0A%23%23%20Metrics%20Collected%0AThe%20following%20metrics%20are%20available%20from%20the%20%60%2Fmetrics%60%20endpoint%3A%0A%0A1.%20%60privmx_bridge_error_gauge%60%0A%20-%20Type%3A%20Gauge%0A%20-%20Description%3A%20Tracks%20the%20number%20of%20errors.%0A2.%20%60privmx_bridge_cpu_execution_time_gauge%60%0A%20-%20Type%3A%20Gauge%0A%20-%20Description%3A%20Measures%20the%20CPU%20time%20taken%20for%20executions.%0A3.%20%60privmx_bridge_in_traffic_gauge%60%0A%20-%20Type%3A%20Gauge%0A%20-%20Description%3A%20Records%20incoming%20traffic%20volume%20in%20bytes.%0A4.%20%60privmx_bridge_out_traffic_gauge%60%0A%20-%20Type%3A%20Gauge%0A%20-%20Description%3A%20Records%20outgoing%20traffic%20volume%20in%20bytes.%0A5.%20%60privmx_bridge_request_gauge%60%0A%20-%20Type%3A%20Gauge%0A%20-%20Description%3A%20Counts%20the%20number%20of%20requests.%0A%0AEach%20of%20these%20metrics%20is%20exposed%20with%20the%20%60%23%20TYPE%20%3Cmetric_name%3E%60%20gauge%20format.%0A%2C---%0Atitle%3A%20Access%20Control%20List%0A---%0AAccess%20Control%20List%20(**ACL**)%20is%20a%20set%20of%20**rules%20that%20determine%20which%20functions%20a%20user%20can%20access**.%0AIt%20consists%20of%20simple%20instructions%20using%20the%20terms%20%22**ALLOW**%22%20or%20%22**DENY**%22%20followed%20by%20the%20name%20of%20a%20function%20or%20group.%0ABy%20default%2C%20an%20ACL%20is%20set%20to%20%22**DENY%20ALL**%22.%20Instructions%20are%20executed%20in%20the%20order%20they%20are%20listed.%0AIf%20group%20scopes%20overlap%2C%20the%20second%20instruction%20will%20override%20the%20overlapping%20portion.%0A%0AThe%20example%20below%20allows%20the%20user%20to%20browse%20Stores%2C%20create%20files%2C%20and%20use%20Threads%2C%20but%20doesn't%20allow%20to%20delete%20Threads%20or%20messages%3A%0A%0A%60%60%60%0AALLOW%20store%2FREAD%0AALLOW%20store%2FstoreFileCreate%0AALLOW%20thread%2FALL%0ADENY%20thread%2FdeleteThread%0ADENY%20thread%2FdeleteMessage%0ADENY%20thread%2FdeleteManyMessages%0ADENY%20thread%2FdeleteMessagesOlderThan%0A%60%60%60%0A%0AA%20more%20detailed%20explanation%20and%20breakdown%20of%20the%20example%3A%0A%60%60%60%0AALLOW%20store%2FREAD%20%3D%3E%20Grants%20access%20to%20all%20methods%20in%20the%20store%2FREAD%20group%0AALLOW%20store%2FstoreFileCreate%20%3D%3E%20Grants%20access%20to%20the%20storeFileCreate%20method%0AALLOW%20thread%2FALL%20%3D%3E%20Grants%20access%20to%20all%20methods%20in%20the%20thread%20group%0ADENY%20thread%2FdeleteThread%20%3D%3E%20Revokes%20access%20to%20the%20thread%2FdeleteThread%20method%2C%20other%20thread%20methods%20remain%20unchanged%0ADENY%20thread%2FdeleteMessage%20%3D%3E%20Revokes%20access%20to%20the%20thread%2FdeleteMessage%20method%2C%20other%20thread%20methods%20remain%20unchanged%0ADENY%20thread%2FdeleteManyMessages%20%3D%3E%20Revokes%20access%20to%20the%20thread%2FdeleteManyMessages%20method%2C%20other%20thread%20methods%20remain%20unchanged%0ADENY%20thread%2FdeleteMessagesOlderThan%20%3D%3E%20Revokes%20access%20to%20the%20thread%2FdeleteMessagesOlderThan%20method%2C%20other%20thread%20methods%20remain%20unchanged%0A%60%60%60%0A%0AIt's%20also%20possible%20to%20bind%20an%20ACL%20rule%20to%20a%20specific%20object%20by%20using%20function%20arguments%3A%0A%0A%60%60%60%0A%5BDIRECTIVE%5D%20%5Bscope%2Fmethod%5D%20%5Bparameter%5D%3D%5Bargument%5D%0A%60%60%60%0A%0AFor%20example%3A%0A%60%60%60%0AALLOW%20store%2FstoreFileWrite%20storeId%3D65ad8f6c2e4f4f1adb40bf81%0A%60%60%60%0A%0ACheck%20all%20ACL%20groups%20in%20%5BPrivMX%20Bridge%20API%20Reference%5D(https%3A%2F%2Fbridge.privmx.dev%2F%23acl-groups-and-functions).%0A%2C---%0Atitle%3A%20Performance%20%0A---%0A%0A%23%23%20Native%20C%2B%2B%20Version%0A%0AThe%20following%20tables%20show%20the%20estimated%20PrivMX%20Endpoint%20performance%20on%20chosen%20platforms.%0AThe%20assumptions%20of%20the%20tests%20are%20as%20follows%3A%0A-%20each%20operation%20is%20repeated%20100%20times%0A-%20the%20file%20used%20for%20the%20test%20(if%20applicable)%20has%20a%20size%20of%201%20MB%0A-%20network%20latency%20is%20negligible%2C%20because%20the%20tests%20are%20performed%20using%20a%20local%20server%20instance%0A-%20%60getMessage()%2FsendMessage%60%20gets%2Fsends%20a%201KB%20message%0A-%20entries%20used%20by%20the%20%60readEntry()%2FsendEntry()%60%20have%20a%201MB%20file%20attached%0A%0A%23%23%23%20Platform%3A%20Core%20i7%2012gen%0A%0A%7C%20**Container**%20%7C%20**Operation%20(x100)**%20%7C**min%20(ms)**%20%7C**max%20(ms)**%20%7C**avg%20(ms)**%20%7C%0A%7C--------%7C---------------%20%7C------%20%7C-------%7C-------%7C%0A%7CThread%20%7CgetMessage%20%7C19%20%7C44%20%7C25%0A%7CThread%20%7CsendMessage%20%7C7%20%7C18%20%7C8%0A%7CStore%20%7CreadFromFile%20%7C53%20%7C75%20%7C58%0A%7CStore%20%7CwriteToFile%20%7C51%20%7C78%20%7C63%0A%7CInbox%20%7CreadEntry%20%7C71%20%7C137%20%7C81%0A%7CInbox%20%7CsendEntry%20%7C59%20%7C116%20%7C73%0A%0A%23%23%23%20Platform%3A%20ARMv7%2032bit%20(RPi2)%0A%0A%7C%20**Container**%20%7C%20**Operation%20(x100)**%20%7C**min%20(ms)**%20%7C**max%20(ms)**%20%7C**avg%20(ms)**%20%7C%0A%7C--------%7C---------------%20%7C------%20%7C-------%7C-------%7C%0A%7CThread%20%7CgetMessage%20%7C122%20%7C163%20%7C142%0A%7CThread%20%7CsendMessage%20%7C119%20%7C161%20%7C136%0A%7CStore%20%7CreadFromFile%20%7C1251%20%7C1476%20%7C1292%0A%7CStore%20%7CwriteToFile%20%7C763%20%7C851%20%7C801%0A%7CInbox%20%7CreadEntry%20%7C1594%20%7C1853%20%7C1682%0A%7CInbox%20%7CsendEntry%20%7C817%20%7C900%20%7C854%0A%0AMore%20examples%20on%20different%20platforms%20are%20in%20progress%2C%20this%20page%20will%20be%20updated.%2C---%0Atitle%3A%20Managing%20Users%0Adescription%3A%20Learn%20about%20how%20to%20add%20and%20manage%20users%20in%20your%20app.%0A---%0A%0A%23%23%20Introduction%0A%0APrivMX%20does%20not%20provide%20a%20user%20management%20service.%20However%2C%20each%20application%20user%20has%20to%20be%20granted%20access%20to%20specific%20resources%20within%20the%20Platform.%0A%0AFor%20user%20management%2C%20you%20must%20provide%20your%20own%20**application%20server**%20that%20can%20perform%20the%20following%20tasks%3A%0A%0A-%20Registering%20new%20user%20ID%20-%20public%20key%20pairs%20in%20%5BContext%5D(%2Fdocs%2Fstart%2Ffeatures%23context)%20(e.g.%2C%20during%20a%20sign-up%20process).%0A-%20Storing%20information%20about%20user%20profiles.%0A-%20Providing%20a%20set%20of%20users%20with%20whom%20the%20user%20can%20establish%20communication%20(e.g.%2C%20creating%20new%20Thread).%0A%0AWhen%20a%20user's%20key%20pair%20is%20generated%20(which%20should%20happen%20on%20the%20user%E2%80%99s%20device%2C%20not%20the%20server)%2C%20**only%20the%20public%20key**%20needs%20to%20be%20sent%20to%20the%20**application%20server**.%0AThe%20server%20can%20then%20assign%20the%20user%20to%20the%20desired%20Context.%0A%0AThis%20process%20ensures%20secure%20key%20management%20while%20allowing%20the%20application%20to%20control%20user%20access.%0A%0A%23%23%23%20Requirements%0A%0ATo%20enable%20communication%20between%20the%20application%20server%20and%20PrivMX%2C%20the%20server%20needs%20to%20use%20an%20**API%20Key**.%0A%0AEach%20generated%20API%20key%20consists%20of%20an%20%60API_KEY_ID%60%20and%20a%20**secret**%20%60API_KEY_SECRET%60.%20Both%20need%20to%20be%20stored%20in%20environment%20variables.%0AAPI%20key%20also%20has%20an%20associated%20access%20control%20list%2C%20which%20defines%20the%20PrivMX%20functions%20it%20can%20execute.%0A%0AIf%20you%20are%20using%20%5BPrivMX%20Bridge%20Docker%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-bridge-docker)%2C%0Ayour%20first%20API%20Key%20will%20be%20provided%20after%20the%20initial%20PrivMX%20Bridge%20setup.%0A%0A%23%23%23%20Public%20Key%20Registration%0A%0AFor%20authorization%20requests%20to%20PrivMX%20Bridge%2C%20use%20your%20API%20Key%20to%20request%20an%20Access%20Token.%0AAccess%20Tokens%20have%20a%20TTL%20but%20can%20be%20refreshed%20using%20refresh%20tokens.%0AHere%20is%20an%20example%20in%20Node.js%3A%0A%0A%0A%0A%20%60%60%60ts%20title%3D%22TypeScript%22%0Aasync%20function%20getAccessToken()%20%7B%0A%20const%20requestBody%20%3D%20%7B%0A%20jsonrpc%3A%20%222.0%22%2C%0A%20id%3A%20128%2C%0A%20method%3A%20%22manager%2Fauth%22%2C%0A%20params%3A%20%7B%0A%20scope%3A%20%5B%22solution%3A*%22%2C%20%22context%22%5D%2C%0A%20grantType%3A%20%22api_key_credentials%22%2C%0A%20apiKeyId%3A%20API_KEY_ID%2C%0A%20apiKeySecret%3A%20API_KEY_SECRET%2C%0A%20%7D%2C%0A%20%7D%3B%0A%0A%20const%20tokenRequest%20%3D%20await%20fetch(BRIDGE_URL%2C%20%7B%0A%20method%3A%20%22POST%22%2C%0A%20headers%3A%20%7B%0A%20%22Content-Type%22%3A%20%22application%2Fjson%22%2C%0A%20%7D%2C%0A%20body%3A%20JSON.stringify(requestBody)%2C%0A%20%7D)%3B%0A%0A%20const%20response%20%3D%20await%20tokenRequest.json()%3B%0A%0A%20if%20(tokenRequest.status%20%3D%3D%3D%20200)%20%7B%0A%20return%20response.result.accessToken%3B%0A%20%7D%20else%20if%20(%22error%22%20in%20response)%20%7B%0A%20throw%20new%20Error(%60Unable%20to%20get%20access%20token%60)%3B%0A%20%7D%20else%20%7B%0A%20throw%20new%20Error(%60Unknown%20error%60)%3B%0A%20%7D%0A%7D%0A%60%60%60%0A%0AThe%20Access%20Token%20can%20be%20used%20to%20authorize%20your%20request%20by%20placing%20it%20in%20the%20Authorization%20header.%0ATo%20add%20a%20public%20key%20to%20a%20Context%20use%20%5B%60context%2FaddUserToContext%60%5D(https%3A%2F%2Fbridge.privmx.dev%2F%23context-addusertocontext)%20Rpc%20method.%0A%0A%0A%0A%20%60%60%60ts%20title%3D%22TypeScript%22%0Aexport%20async%20function%20addUserToContext(userId%3A%20string%2C%20pubKey%3A%20string)%20%7B%0A%20%2F%2Fusing%20function%20from%20earlier%0A%20const%20accessToken%20%3D%20await%20getAccessToken()%3B%0A%0A%20const%20response%20%3D%20await%20fetch(YOUR_BRIDGE_URL%2C%20%7B%0A%20method%3A%20%22POST%22%2C%0A%20body%3A%20JSON.stringify(%7B%0A%20jsonrpc%3A%20%222.0%22%2C%0A%20id%3A%20128%2C%0A%20method%3A%20%22context%2FaddUserToContext%22%2C%0A%20params%3A%20%7B%0A%20contextId%3A%20CONTEXT_ID%2C%0A%20userId%3A%20USER_ID_ASSOCIATED_WITH_PUBLIC_KEY%2C%0A%20userPubKey%3A%20PUBLIC_KEY%2C%0A%20%7D%2C%0A%20%7D)%2C%0A%20headers%3A%20%7B%0A%20%22Content-type%22%3A%20%22application%2Fjson%22%2C%0A%20Authorization%3A%20%60Bearer%20%24%7BaccessToken%7D%60%2C%0A%20%7D%2C%0A%20%7D)%3B%0A%7D%0A%60%60%60%0A%0AYour%20user%20can%20now%20connect%20to%20your%20PrivMX%20Bridge%20providing%20a%20matching%20private%20key%20to%20PrivMX%20Endpoint%20in%20your%0Aclient%20app.%0AFor%20guidance%20on%20how%20to%20do%20this%20in%20your%20app's%20stack%2C%20refer%20to%20our%20language-specific%20documentation%3A%0A%0A%3CCards%3E%0A%20%3CCard%0A%20href%3D%7B%22..%2Freference%2Fendpoint%2Fgetting-started%22%7D%0A%20title%3D%7B%22C%2B%2B%22%7D%0A%20icon%3D%7B%3CIcon%20icon%3D%7B%22cpp%22%7D%20%2F%3E%7D%0A%20%2F%3E%0A%20%3CCard%0A%20href%3D%7B%22%2Fdocs%2Fjs%2Fintroduction%22%7D%0A%20title%3D%7B%22JavaScript%22%7D%0A%20icon%3D%7B%3CIcon%20icon%3D%7B%22js%22%7D%20%2F%3E%7D%0A%20%2F%3E%0A%20%3CCard%0A%20href%3D%7B%22%2Fdocs%2Fjava%2Fgetting-started%22%7D%0A%20title%3D%7B%22Java%2FKotlin%22%7D%0A%20icon%3D%7B%3CIcon%20icon%3D%7B%22java%22%7D%20%2F%3E%7D%0A%20%2F%3E%0A%20%3CCard%0A%20href%3D%7B%22%2Fdocs%2Fswift%2Fgetting-started%22%7D%0A%20title%3D%7B%22Swift%22%7D%0A%20icon%3D%7B%3CIcon%20icon%3D%7B%22swift%22%7D%20%2F%3E%7D%0A%20%2F%3E%0A%3C%2FCards%3E%0A%0A%2C---%0Atitle%3A%20Authorization%0A---%0A%0A%23%23%20API%20Keys%0AYou%20can%20access%20the%20API%20methods%20using%20API%20Keys.%20These%20keys%20have%20no%20time-to-live%20(TTL)%20but%20can%20be%20disabled%20or%20deleted.%0AEach%20key%20is%20assigned%20a%20specific%20scope.%20You%20can%20create%20up%20to%2010%20API%20Keys%20by%20calling%20the%20method%20%60manager%2FcreateApiKey%60.%0A%0A%3A%3A%3Ainfo%0A%0AWhen%20you%20install%20PrivMX%20Bridge%2C%20you%20receive%20your%20first%20API%20Key%20with%20full%20API%20access.%0A%0A%3A%3A%3A%0A%0AAn%20API%20Key%20can%20be%20created%20without%20public%20key%3A%0A%60%60%60shell%0Acurl%20-X%20POST%20-H%20%22Content-Type%3A%20application%2Fjson%22%20%5C%0A%20-H%20%22Authorization%3A%20one-of-our-authorization-methods%22%20%5C%0A%20--data-binary%20'%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%200%2C%0A%20%22method%22%3A%20%22manager%2FcreateApiKey%22%2C%0A%20%22params%22%3A%20%7B%0A%20%22name%22%3A%20%22My%20ApiKey%22%2C%0A%20%22scope%22%3A%20%5B%22apikey%22%2C%20%22context%22%2C%20%22solution%22%5D%2C%0A%20%7D%0A%20%7D'%20%5C%0A%20https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%0A%60%60%60%0AOr%20with%20an%20ED25519%20PEM-encoded%20public%20key%3A%0A%60%60%60shell%0Acurl%20-X%20POST%20-H%20%22Content-Type%3A%20application%2Fjson%22%20%5C%0A%20-H%20%22Authorization%3A%20one-of-our-authorization-methods%22%20%5C%0A%20--data-binary%20'%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%200%2C%0A%20%22method%22%3A%20%22manager%2FcreateApiKey%22%2C%0A%20%22params%22%3A%20%7B%0A%20%22name%22%3A%20%22My%20ApiKey%22%2C%0A%20%22scope%22%3A%20%5B%22apikey%22%2C%20%22context%22%2C%20%22solution%22%5D%2C%0A%20%22publicKey%22%3A%20%22-----BEGIN%20PUBLIC%20KEY-----%5CnMCowBQYDK2VwAyEADsSTjY2wnm1iwWamIWwLTPVhtTIb8TVlI8tts3wkhkQ%3D%5Cn-----END%20PUBLIC%20KEY-----%22%2C%0A%20%7D%0A%20%7D'%20%5C%0A%20https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%0A%60%60%60%0AYou%20will%20receive%20an%20ID%20and%20secret%20of%20API%20Key%3A%0A%60%60%60json%0A%7B%0A%20%22jsonrpc%22%3A%222.0%22%2C%0A%20%22id%22%3A0%2C%0A%20%22result%22%3A%20%7B%0A%20%22id%22%3A%20%22hysd62jsd7823nasd03%22%2C%0A%20%22secret%22%3A%20%22759a1d8edba555badf1216b0f381b94950141%22%0A%20%7D%0A%7D%0A%60%60%60%0A%0AYou%20can%20now%20authorize%20requests%20using%20your%20API%20Key%20in%20one%20of%20the%20following%20ways%3A%0A%0A%23%23%23%20Signatures%0AYou%20can%20sign%20your%20request%20using%20your%20API%20Key.%0A%0A1.%20First%2C%20prepare%20the%20data%20to%20be%20signed%3A%0A%20%60%60%60js%0A%20apiKeyId%20%3D%20%226XMc4VMf3q54YNarSn9CWUn4htStNu1ry9ajamemdo23sS1y21%22%3B%0A%20requestPayload%20%3D%20'%7B%22jsonrpc%22%3A%222.0%22%2C%22id%22%3A0%2C%22method%22%3A%22solution%2FlistSolutions%22%2C%22params%22%3A%7B%7D%7D'%3B%0A%20requestData%20%3D%20%60POST%5Cn%2Fapi%5Cn%24%7BrequestPayload%7D%5Cn%60%3B%20%2F%2F%20UPPERCASE(HTTP_METHOD())%20%2B%20%22%5Cn%22%20%2B%20URI()%20%2B%20%22%5Cn%22%20%2B%20RequestBody%20%2B%20%22%5Cn%22%3B%0A%20timestamp%20%3D%201702555410352%3B%0A%20nonce%20%3D%20%223xUee4EA0gr8dg%3D%3D%22%3B%0A%20dataToSign%20%3D%20%60%24%7Btimestamp%7D%3B%24%7Bnonce%7D%3B%24%7BrequestData%7D%60%3B%0A%20%60%60%60%0A%0A2.%20Next%2C%20generate%20a%20signature%20corresponding%20to%20your%20API%20Key%20credentials%3A%0A%0A%20-%20HMAC%20signature%3A%0A%20%60%60%60%0A%20apiKeySecret%20%3D%20%22CspXxVtTyE3sf6jB7z4CSjxoymuS2H67ZjNDfovTu3i8%22%3B%0A%20signature%20%3D%20BASE64(HMACSHA256(apiKeySecret%2C%20dataToSign).SUBARRAY(0%2C%2020))%0A%20%60%60%60%0A%20-%20If%20you%20provided%20a%20%60publicKey%60%20%E2%80%93%20ECC%20signature%3A%0A%20%60%60%60%0A%20privateKey%20%3D%20%22-----BEGIN%20PRIVATE%20KEY-----%5CnMC4CAQAwBQYDK2VwBCIEIOBVFGaSFtfqbNvZWctFKg3k%2BI0T5YXRavpKAD9%2BBgCX%5Cn-----END%20PRIVATE%20KEY-----%22%3B%0A%20signature%20%3D%20BASE64(SIGN(dataToSign%2C%20privateKey))%0A%20%60%60%60%0A%0A3.%20To%20sign%20a%20request%2C%20include%20the%20following%20in%20the%20%60Authorization%60%20header%3A%0A%0A%20%60%60%60js%0A%20%60pmx-hmac-sha256%20%24%7BapiKeyId%7D%3B1%3B%24%7Btimestamp%7D%3B%24%7Bnonce%7D%3B%24%7Bsignature%7D%60%0A%20%60%60%60%0A%0A%20%60%60%60shell%0A%20curl%20-X%20POST%20-H%20%22Content-Type%3A%20application%2Fjson%22%20%5C%0A%20-H%20%22Authorization%3A%20pmx-hmac-sha256%206XMc4VMf3q54YNarSn9CWUn4htStNu1ry9ajamemdo23sS1y21%3B1%3B1702555410352%3B3xUee4EA0gr8dg%3BJN5llLladWZ%2B1rGu6yrkbIQzme0%3D%22%20%5C%0A%20--data-binary%20'%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%200%2C%0A%20%22method%22%3A%20%22solution%2FlistSolutions%22%2C%0A%20%22params%22%3A%20%7B%7D%0A%20%7D'%20%5C%0A%20https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%0A%20%60%60%60%0A%0A%23%23%23%20API%20Key%20Credentials%0AYou%20can%20authorize%20the%20request%20by%20placing%20your%20API%20Key%20credentials%20in%20the%20%60Authorization%60%20header%3A%0A%60%60%60js%0AbasicAuthorization%20%3D%20BASE64(%60%24%7BapiKeyId%7D%3A%24%7BapiKeySecret%7D%60)%3B%0AauthorizationHeaderValue%20%3D%20%60Basic%20%24%7BbasicAuthorization%7D%60%3B%0A%60%60%60%0A%0A%60%60%60shell%0Acurl%20-X%20POST%20-H%20%22Content-Type%3A%20application%2Fjson%22%20%5C%0A%20-H%20%22Authorization%3A%20Basic%20YWxpY2U6dGhlc2NlcmV0%22%20%5C%0A%20--data-binary%20'%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%200%2C%0A%20%22method%22%3A%20%22solution%2FlistSolutions%22%2C%0A%20%22params%22%3A%20%7B%7D%0A%20%7D'%20%5C%0A%20https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%0A%60%60%60%0A%0A%3A%3A%3Ainfo%0A%0ANote%20that%20you%20cannot%20use%20this%20authorization%20method%20if%20your%20API%20Key%20includes%20a%20public%20key.%0AIn%20such%20a%20case%2C%20only%20ECC%20signatures%20are%20available%20for%20this%20API%20Key.%0A%0A%3A%3A%3A%0A%0A%23%23%23%20Access%20Tokens%0AAccess%20tokens%20have%20a%20TTL%20but%20can%20be%20refreshed%20using%20refresh%20tokens.%20You%20can%20generate%20them%20by%20calling%20%5Bmanager%2Fauth%5D(https%3A%2F%2Fbridge.privmx.dev%2F%23manager-auth)%3A%0A%0A%60%60%60shell%0Acurl%20-X%20POST%20%5C%0A%20-H%20%22Content-Type%3A%20application%2Fjson%22%20%5C%0A%20--data-binary%20'%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%20128%2C%0A%20%22method%22%3A%20%22manager%2Fauth%22%2C%0A%20%22params%22%3A%20%7B%0A%20%22scope%22%3A%20%5B%22apikey%22%2C%20%22solution%22%5D%2C%0A%20%22grantType%22%3A%20%22api_key_credentials%22%2C%0A%20%22apiKeyId%22%3A%20%2265ad8f6b2e4f4f1adb40bf68%22%2C%0A%20%22apiKeySecret%22%3A%20%225ZTUQ7VBxoqRKn3pEyPjHeavXHVw7JcJF3MvAV43yfsR%22%0A%20%7D%0A%20%7D'%20%5C%0A%20https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%0A%60%60%60%0AYou%20will%20receive%20an%20%60access_token%60%20and%20a%20%60refresh_token%60%3A%0A%0A%60%60%60json%0A%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%20128%2C%0A%20%22result%22%3A%20%7B%0A%20%22accessToken%22%3A%20%22SXRzIGEgcmFuZG9tIHRleHQgZW5jb2RlZCBmb3IgdGhlIHRlc3RpbmcgcHVycG9zZSwgaWYgeW91IGRlY29kZWQgdGhpcyB0ZXh0LCB0cmVhdCBpcyBhcyBhIHNvcnQgb2YgZWFzdGVyIGVnZyA6KS4%3D%22%2C%0A%20%22accessTokenExpiry%22%3A%201726652150623%2C%0A%20%22refreshToken%22%3A%20%22TG9yZW0gaXBzdW1Mb3JlbSBpcHN1bUxvcmVtIGlwc3VtTG9yZW0gaXBzdW1Mb3JlbSBpcHN1bUxvcmVtIGlwc3VtTG9yZW0gaXBzdW0%3D%22%2C%0A%20%22refreshTokenExpiry%22%3A%201726952150623%2C%0A%20%22tokenType%22%3A%20%22Bearer%22%2C%0A%20%22scope%22%3A%20%5B%0A%20%22apiKey%22%2C%0A%20%22solution%22%2C%0A%20%22context%22%0A%20%5D%0A%20%7D%0A%7D%0A%60%60%60%0AThe%20access%20token%20can%20be%20used%20to%20authorize%20your%20request%20by%20placing%20it%20in%20the%20%60Authorization%60%20header%3A%0A%0A%60%60%60shell%0Acurl%20-X%20POST%20%5C%0A%20-H%20%22Content-Type%3A%20application%2Fjson%22%20%5C%0A%20-H%20%22Authorization%3A%20Bearer%20SXRzIGEgcmFuZG9tIHRleHQgZW5jb2RlZCBmb3IgdGhlIHRlc3RpbmcgcHVycG9zZSwgaWYgeW91IGRlY29kZWQgdGhpcyB0ZXh0LCB0cmVhdCBpcyBhcyBhIHNvcnQgb2YgZWFzdGVyIGVnZyA6KS4%3D%22%20%5C%0A%20--data-binary%20'%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%20128%2C%0A%20%22method%22%3A%20%22solution%2FlistSolutions%22%2C%0A%20%22params%22%3A%20%7B%7D%0A%20%7D'%20%5C%0A%20https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%0A%60%60%60%0AAccess%20tokens%20can%20be%20refreshed%20using%20refresh%20tokens%20by%20calling%20the%20%5Bmanager%2Fauth%5D(https%3A%2F%2Fbridge.privmx.dev%2F%23manager-auth)%20method%3A%0A%0A%60%60%60shell%0Acurl%20-X%20POST%20%5C%0A%20-H%20%22Content-Type%3A%20application%2Fjson%22%20%5C%0A%20--data-binary%20'%7B%0A%20%22jsonrpc%22%3A%20%222.0%22%2C%0A%20%22id%22%3A%20128%2C%0A%20%22method%22%3A%20%22manager%2Fauth%22%2C%0A%20%22params%22%3A%20%7B%0A%20%22grantType%22%3A%20%22refresh_token%22%2C%0A%20%22refreshToken%22%3A%20%22TG9yZW0gaXBzdW1Mb3JlbSBpcHN1bUxvcmVtIGlwc3VtTG9yZW0gaXBzdW0%3D%22%2C%0A%20%7D%0A%20%7D'%20%5C%0A%20https%3A%2F%2Fmy-privmx-bridge-instance%2Fapi%0A%60%60%60%0AIn%20response%2C%20you%20will%20receive%20a%20new%20pair%20of%20tokens%2C%20and%20the%20old%20pair%20will%20be%20revoked.%0A%0A%23%23%23%20API%20Scopes%0AWhen%20requesting%20an%20access%20token%2C%20you%20can%20specify%20the%20scope%2C%20which%20defines%20the%20level%20of%20granted%20access.%0AHere's%20a%20breakdown%20of%20the%20available%20scopes%3A%0A%0A%7C%20**Scope**%20%7C%20**Description**%20%7C%0A%7C--------------%7C-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------%7C%0A%7C%20%60session%3ANAME%60%20%7C%20Creates%20a%20new%20session%20with%20the%20provided%20name%2C%20generating%20tokens%20bound%20to%20that%20session.%20Access%20is%20granted%20for%20the%20session's%20lifetime.%20A%20user%20can%20have%20up%20to%2016%20sessions%3B%20when%20this%20limit%20is%20reached%2C%20the%20oldest%20session%20is%20removed.%20%7C%0A%7C%20%60ipAddr%3AADDR%60%20%7C%20Restricts%20the%20token%20to%20connections%20from%20a%20specific%20IPv4%20address%20(ADDR).%20%7C%0A%7C%60expiresIn%3ANUMBER%60%20%7C%20Access%20token%20will%20expire%20after%20%60NUMBER%60%20of%20milliseconds.%20Max%20value%20is%20TTL%20of%20the%20refresh%20token.%20%7C%0A%7C%20%60solution%60%20%7C%20Restricts%20the%20token%20to%20Solution%20API%20scope.%20%7C%0A%7C%20%60context%60%20%7C%20Restricts%20the%20token%20to%20Context%20API%20scope.%20%7C%0A%7C%60thread%60%20%7CRestricts%20the%20token%20to%20Thread%20API%20scope.%7C%0A%7C%60store%60%20%7CRestricts%20the%20token%20to%20Store%20API%20scope.%7C%0A%7C%60inbox%60%20%7CRestricts%20the%20token%20to%20Inbox%20API%20scope.%7C%0A%7C%60stream%60%20%7CRestricts%20the%20token%20to%20Stream%20API%20scope.%7C%0A%7C%60solution%3ASOLUTION_ID%60%20%7CRestricts%20the%20token%20to%20manage%20Contexts%20only%20under%20given%20%60SOLUTION_ID%60.%7C%0A%7C%60solution%3A*%60%20%7CRestricts%20the%20token%20to%20manage%20all%20Contexts.%7C%0A%0AThese%20scopes%20allow%20fine-grained%20control%20over%20what%20actions%20can%20be%20performed%20with%20the%20generated%20tokens%2C%0Amaking%20it%20easier%20to%20manage%20permissions%20across%20different%20parts%20of%20the%20system.%0A%2C---%0Atitle%3A%20Deploy%20to%20VPS%0Adescription%3A%20This%20guide%20will%20walk%20you%20through%20deploying%20PrivMX%20Bridge%20Instance.%0A---%0A%0A%23%23%20Prerequisites%0A%0AThis%20guide%20requires%20access%20to%20VPS%20server.%0AYou%20can%20choose%20any%20provider%20you%20prefer%2C%20e.g.%3A%0A%0A-%20AWS%20EC2%0A-%20Google%20Cloud%20Compute%20Engine%0A-%20Digital%20Ocean%20Droplets%0A-%20Azure%20Virtual%20Machine%0A%0AWe%20recommend%20choosing%20an%20option%20with%20at%20least%201%20CPU%20and%20500MB%20of%20RAM%20for%20PrivMX%20Bridge%20itself%2C%0Aand%20if%20you%20decide%20to%20host%20your%20MongoDB%20instance%20on%20the%20same%20machine%20to%20increase%20RAM%20to%204GB.%0A%0AYou%20will%20need%20also%20a%20domain%20name%20for%20your%20server.%0AThis%20tutorial%20will%20guide%20you%20through%20how%20to%20generate%20certificates%20for%20it%20for%20https%20connection.%0A%0A%23%23%20Setup%20Environment%0A%0A%3A%3A%3Awarning%0A%0AThis%20guides%20requires%20access%20to%20your%20server%20with%20sudo%20privileges.%0A%0A%3A%3A%3A%0A%0A%23%23%23%20Installing%20Docker%0A%0A1.%20Add%20Docker's%20official%20GPG%20key.%0A%60%60%60shell%0A%20sudo%20apt-get%20update%0A%20sudo%20apt-get%20install%20ca-certificates%20curl%0A%20sudo%20install%20-m%200755%20-d%20%2Fetc%2Fapt%2Fkeyrings%0A%20sudo%20curl%20-fsSL%20https%3A%2F%2Fdownload.docker.com%2Flinux%2Fubuntu%2Fgpg%20-o%20%2Fetc%2Fapt%2Fkeyrings%2Fdocker.asc%0A%20sudo%20chmod%20a%2Br%20%2Fetc%2Fapt%2Fkeyrings%2Fdocker.asc%0A%20%60%60%60%0A2.%20Add%20the%20repository%20to%20Apt%20sources.%0A%60%60%60sh%0A%20echo%20%5C%0A%20%22deb%20%5Barch%3D%24(dpkg%20--print-architecture)%20signed-by%3D%2Fetc%2Fapt%2Fkeyrings%2Fdocker.asc%5D%20https%3A%2F%2Fdownload.docker.com%2Flinux%2Fubuntu%20%5C%0A%20%24(.%20%2Fetc%2Fos-release%20%26%26%20echo%20%22%24%7BUBUNTU_CODENAME%3A-%24VERSION_CODENAME%7D%22)%20stable%22%20%7C%20%5C%0A%0A%20sudo%20tee%20%2Fetc%2Fapt%2Fsources.list.d%2Fdocker.list%20%3E%20%2Fdev%2Fnull%0A%20sudo%20apt-get%20update%0A%20%60%60%60%0A3.%20Install%20docker.%0A%20%60%60%60shell%0A%20sudo%20apt-get%20install%20docker-ce%20docker-ce-cli%20containerd.io%20docker-buildx-plugin%20docker-compose-plugin%0A%20%60%60%60%0A%0A%23%23%23%20Setup%20nginx%0A%0A1.%20Install%20nginx%20and%20certbot.%0A%20%60%60%60shell%0A%20sudo%20apt-get%20update%0A%20sudo%20apt%20install%20certbot%20python3-certbot-nginx%20nginx%0A%20%60%60%60%0A2.%20Create%20site%20config.%0A%0ACreate%20files%20in%20%60%2Fetc%2Fnginx%2Fsites-available%2FYOUR_DOMAIN_NAME%60%0A%20%60%60%60shell%0A%20touch%20%2Fetc%2Fnginx%2Fsites-available%2FYOUR_DOMAIN_NAME%0A%20%60%60%60%0Aopen%20it%20in%20your%20favourite%20text%20editor%20and%20add%20the%20following%20configuration%3A%0A%20%60%60%60%0Aserver%20%7B%0Alisten%2080%3B%0Aserver_name%20YOUR_DOMAIN_NAME%3B%0A%0A%20location%20%2F%20%7B%0A%20proxy_pass%20http%3A%2F%2Flocalhost%3A9111%3B%0A%20proxy_set_header%20Host%20%24host%3B%0A%20proxy_set_header%20X-Forwarded-For%20%24remote_addr%3B%0A%20proxy_set_header%20Upgrade%20%24http_upgrade%3B%0A%20proxy_set_header%20Connection%20%22Upgrade%22%3B%0A%20%7D%0A%7D%0A%60%60%60%0A3.%20Create%20a%20link%20to%20sites-enabled.%0A%20%60%60%60shell%0Asudo%20ln%20-s%20%2Fetc%2Fnginx%2Fsites-available%2FYOUR_DOMAIN_NAME%20%2Fetc%2Fnginx%2Fsites-enabled%2FYOUR_DOMAIN_NAME%0A%20%60%60%60%0A%0A%0A%23%23%23%20PrivMX%20Bridge%20Setup%0APrivMX%20Bridge%20requires%20%5BMongoDB%5D(https%3A%2F%2Fwww.mongodb.com%2F)%20instance.%0AYou%20can%20host%20it%20alongside%20PrivMX%20Bridge%20using%20our%20docker%20compose%20file%20or%20provide%20connection%20string%0Ato%20external%20MongoDB%20instance%2C%20for%20example%2C%20from%20%5BMongoDB%20Atlas%5D(https%3A%2F%2Fwww.mongodb.com%2Fatlas).%0A%0A%3CCallout%3E%0APrivMX%20Bridge%20requires%20MongoDB%20instance%20with%20an%20initialized%20replica%20set.%0A%60.%2Fsetup.sh%60%20script%20takes%20care%20of%20initializing%20a%20replica%20set%20for%20local%20MongoDB%20instance%20in%20docker%20compose.%0A%3C%2FCallout%3E%0A%0A%0A1.%20Start%20by%20cloning%20PrivMX%20Bridge%20docker%20repo%20containing%20setup%20scripts.%0A%20%60%60%60shell%0A%20git%20clone%20https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-bridge-docker.git%20privmx-bridge%0A%20cd%20privmx-bridge%0A%20%60%60%60%0A2.%20Run%20setup%20script.%0A%3CTabs%20items%3D%7B%5B%22contained%22%2C%22external%22%5D%7D%3E%0A%20%3CTab%20value%3D%7B%22contained%22%7D%20label%3D%7B%22Coupled%20%3F%3F%3F%22%7D%3E%0A%20%60%60%60shell%0A%20sudo%20.%2Fsetup.sh%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%20%3CTab%20value%3D%7B%22external%22%7D%20label%3D%7B%22External%20Database%22%7D%3E%0A%20%60%60%60shell%0A%20sudo%20.%2Fsetup.sh%20--db-uri%3D%22YOUR_MONGODB_CONNECTION_STRING%22%0A%20%60%60%60%0A%20%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0AThis%20script%20will%20pull%20all%20necessary%20docker%20images%2C%20and%20setup%20your%20first%20Solution%20and%20Context.%0AAfter%20setup%20PrivMX%20Bridge%2C%20you%20will%20be%20prompted%20with%20variables%20required%20for%20connection.%0A%0ABy%20default%2C%20new%20instance%20will%20be%20available%20on%20%60http%3A%2F%2Flocalhost%3A9111%60%0A%0A%0A%23%23%20Exposing%20Application%0A1.%20Check%20Nginx%20config.%0A%20%60%60%60shell%0A%20sudo%20nginx%20-t%0A%20%60%60%60%0A2.%20Restart%20nginx.%0A%20%60%60%60shell%0A%20sudo%20systemctl%20restart%20nginx%0A%20%60%60%60%0A3.%20Generate%20certificates%20using%20certbot.%0A%20%60%60%60shell%0A%20sudo%20certbot%20--nginx%20-d%20YOUR_DOMAIN%0A%20%60%60%60%0A4.%20In%20your%20firewall%20settings%20expose%20port%20%6080%60%20and%20%60443%60.%0ADuring%20certificate%20generation%2C%20Certbot%20adds%20redirects%20from%20http%20connections%20to%20https.%0A%0AYou%20can%20now%20open%20domain%20URL%20in%20your%20browser.%20PrivMX%20Bridge%20instance%20should%20return%20starting%20page.%0A%0A%23%23%20Next%20Steps%0A%0ACheckout%20Containers%20documentation%20for%20guides%20on%20how%20you%20can%20use%20your%20PrivMX%20Bridge%20for%20E2E%20encrypted%20communication.%0A%0ALearn%20how%20to%20use%3A%0A%0A-%20%5B**Threads**%5D(..%2Fthreads%2Foverview)%20-%20for%20exchanging%20encrypted%20messages%3B%0A-%20%5B**Stores**%5D(..%2Fstores%2Foverview)%20-%20for%20saving%20and%20sharing%20encrypted%20files%3B%0A-%20%5B**Inboxes**%5D(..%2Finboxes%2Foverview)%20-%20for%20one%20way%20communication%20with%20external%20users.%0A%0A%2C---%0Atitle%3A%20Getting%20Started%0A---%0A%0A%0A%0A%23%23%20PrivMX%20Bridge%0A%0APrivMX%20Bridge%20is%20a%20server-side%20software%20that%20intermediates%20in%20the%20transfer%20of%20encrypted%20data%20and%20notifications%20between%20PrivMX%20Endpoints%20and%20stores%20encrypted%20data%20for%20Threads%2C%20Stores%2C%20Inboxes%2C%20and%20KVDBs.%0A%0A-%20PrivMX%20Bridge%20is%20a%20**Zero-Knowledge%20software**%20%E2%80%93%20it%20has%20no%20possibility%20of%20reading%20(decrypting)%20data%20it%20transmits%20and%20stores.%0A%0A-%20PrivMX%20Bridge%20organizes%20the%20structure%20of%20the%20developer's%20applications%20(**Solutions**)%20by%20offering%20a%20universal%20mechanism%20of%20independent%20access%20groups%20called%20**Contexts**.%20Each%20Context%20is%20a%20set%20of%20containers%20(Threads%2C%20Stores%2C%20Inboxes%2C%20KVDBs%20created%20by%20PrivMX%20Endpoints)%20together%20with%20a%20list%20of%20users%20that%20have%20rights%20to%20create%20and%20access%20them.%20Each%20Solution%20can%20contain%20any%20number%20of%20freely%20configurable%20Contexts.%0A%0A-%20**User%E2%80%99s%20registration%20in%20PrivMX%20Bridge%20Contexts%20requires%20providing%20only%20user%E2%80%99s%20public%20key%20and%20any%20textual%20%60userId%60%20assigned%20by%20the%20application.**%20As%20a%20result%2C%20PrivMX%20communication%20channels%20can%20be%20easily%20used%20in%20existing%20applications%2C%20with%20no%20necessary%20changes%20to%20the%20authorization%20system%20currently%20in%20use.%20To%20learn%20more%20about%20private%20and%20public%20keys%2C%20browse%20our%20%5Bdedicated%20section%5D(..%2Fstart%2Fgenerating-keys).%0A%0A-%20In%20short%3A%20the%20user's%20access%20to%20a%20Context%20and%20the%20containers%20included%20is%20granted%20after%20PrivMX%20Bridge%20(using%20a%20registered%20public%20key)%20successfully%20verifies%20the%20user's%20signature%20sent%20by%20PrivMX%20Endpoint%20(signature%20made%20on%20the%20client-side%20with%20the%20valid%2C%20corresponding%20private%20key).%0A%0A-%20PrivMX%20Bridge%20offers%20an%20%5BAPI%5D(https%3A%2F%2Fbridge.privmx.dev%2F)%20and%20a%20system%20of%20OAuth2%20access%20tokens%2C%20so%20that%20Solution%20and%20Context%20objects%20can%20be%20managed%20by%20developers.%0A%0A%2C---%0Atitle%3A%20Installation%0A---%0A%0A%3CCallout%3E%0ABefore%20you%20start%2C%20make%20sure%20you%20have%20Docker%20installed%20on%20your%20machine.%20If%20you%20don't%20have%20it%20yet%2C%20you%20can%20download%20it%20from%20the%20%5Bofficial%20website%5D(https%3A%2F%2Fwww.docker.com%2Fget-started).%0AYou%20might%20also%20want%20to%20use%20PrivMX%20Bridge%20in%20non%20dockerized%20version%2C%20which%20requires%20more%20configuration%20and%20is%20recommended%20for%20advanced%20users.%20In%20that%20case%2C%20please%20refer%20to%20the%20%5Bofficial%20repository%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-bridge)%0A%3C%2FCallout%3E%0A%0ATo%20install%20PrivMX%20Bridge%20on%20your%20machine%20you%20can%20use%20our%20CLI.%0A%0A1.%20Clone%20Bridge%20CLI%0A%20%60%60%60shell%0A%20git%20clone%20https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-bridge-docker%0A%20%60%60%60%0A2.%20Run%20setup%20script%0A%20%60%60%60shell%0A%20.%2Fsetup.sh%0A%20%60%60%60%0A%0AThis%20will%20fetch%20the%20necessary%20Docker%20images%2C%20create%20Access%20Keys%20and%20your%20first%20Context.%20After%20a%20successful%20setup%2C%20CLI%0Awill%0Adisplay%20all%20the%20API%20keys%20necessary%20for%20connection.%20%3Cbr%2F%3E%0A%0A%23%23%23%20Registering%20First%20Users%20(optionally)%0A%0AYou%20can%20create%20first%20two%20users%20using%20provided%20CLI.%20This%20can%20come%20handy%20if%20you%20want%20to%20just%20test%20PrivMX%20in%20one%20of%20our%20example%20projects.%0A%0A1.%20Generate%20keys%0A%20In%20your%20terminal%2C%20generate%20private-public%20key%20pair%20for%20your%20user.%20The%20keys%20must%20be%20in%20WIF%20format%3A%0A%20%60%60%60shell%0A%20.%2FgenKeyPair.sh%0A%20%60%60%60%0A2.%20Register%20user%0A%20With%20the%20keys%20ready%2C%20register%20%60userId%60%20-%20public%20key%20pair%20in%20your%20Context.%20Don't%20forget%20to%20replace%20placeholder%20values%0A%20with%20the%20ones%20created%20earlier%3A%0A%20%60%60%60shell%0A%20.%2Fcli.sh%20context%2FaddUserToContext%20'%7B%22contextId%22%3A%20%22CONTEXT_ID%22%2C%20%22userId%22%3A%22USER_ID%22%2C%20%22userPubKey%22%3A%22USER_PUBLIC_KEY%22%20%7D'%0A%20%60%60%60%0A%23%23%23%20After%20Installing%0A%0AAfter%20you've%20successfully%20installed%20a%20PrivMX%20Bridge%20instance%2C%20browse%20our%20SDKs%20and%20APIs%20to%20learn%20what%20you%20can%20do%20next%3A%0A-%20%5BJavaScript%5D(..%2Fjs%2Fintroduction)%0A-%20%5BJava%2FKotlin%5D(..%2Fjava%2Fintroduction)%0A-%20%5BKotlin%5D(..%2Fkotlin%2Fintroduction)%0A-%20%5BSwift%5D(..%2Fswift%2Fgetting-started)%0A-%20%5BC%23%5D(..%2F..%2Flatest%2Fcsharp%2Fintroduction)%0A-%20%5BAPI%20Reference%5D(..%2Freference%2Fstart)%0A%0A%23%23%20Integrations%0A%0A%E2%80%A2%20**Server%20API**%20-%20Managing%20the%20base%20of%20user%20keys%20-%20assigning%2Fremoving%20them%20to%2Ffrom%20Contexts.%0A%0A%E2%80%A2%20**Server%20Event%20Channels**%20(Coming%20Soon)%20-%20The%20ability%20to%20wait%20for%20changes%20in%20the%20Bridge%20and%20send%20notifications%20about%20them.%20The%20Developer's%20server%20could%20for%20example%20react%20to%20a%20new%20message%20or%20file.%20The%20server%20can%20only%20access%20metadata%20(UUID%2C%20User%20IDs%20assigned%20by%20the%20Developer)%2C%20so%20the%20information%20about%20who%2C%20when%20and%20where%20sent%20or%20modified%20data.%0A%0A%E2%80%A2%20**Server%20Data%20Management**%20-%20Data%20management%20based%20on%20metadata.%20The%20server%20can%20list%20and%20delete%20data%20collected%20in%20PrivMX%20Bridge.%20Use%20%5BPrivMX%20Bridge%20API%5D(https%3A%2F%2Fbridge.privmx.dev)%20to%20manage%20data.%0A%0A%2C---%0Atitle%3A%20Project%20Map%0Adescription%3A%20This%20page%20is%20the%20reference%20for%20all%20the%20GitHub%20repositories%20and%20projects%20necessary%20to%20work%20with%20PrivMX.%20%0A%0A---%0A%23%23%20PrivMX%20Bridge%20%0A-%20%5BBridge%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-bridge)%3A%20Zero-knowledge%20server%20for%20secure%20storage%20and%20transfer%20of%20E2E%20encrypted%20data.%0A-%20%5BBridge%20Docker%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-bridge-docker)%3A%20Docker%20Compose%20for%20PrivMX%20Bridge.%0A%23%23%20PrivMX%20Endpoint%0A%23%23%23%20C%2B%2B%0A-%20%5BPrivMX%20Endpoint%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint)%3A%20Library%20written%20in%20C%2B%2B%20allowing%20applications%20to%20build%20E2EE%20communication%20channels.%0A-%20%5BExample%20projects%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint%2Ftree%2Fmain%2Fexamples)%3A%20Example%20use%20of%20PrivMX%20Endpoint%20in%20C%2B%2B.%0A%23%23%23%23%20Dependencies%0A-%20%5BECC%20Driver%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-drv-ecc-openssl)%3A%20Interface%20for%20elliptic-curve%20cryptography%20for%20PrivMX%20Endpoint.%0A-%20%5BNet%20Driver%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-drv-net-poco)%3A%20Interface%20for%20networking%20for%20PrivMX%20Endpoint.%0A-%20%5BCrypto%20Driver%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-drv-crypto-openssl)%3A%20Interface%20for%20the%20base%20cryptographic%20functions%20for%20PrivMX%20Endpoint.%0A-%20%5Bpson-cpp%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fpson-cpp)%0A%23%23%23%20Wrappers%0A%23%23%23%23%20Web%0A-%20%5BPrivMX%20Endpoint%20Web%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-webendpoint)%3A%20JavaScript%20library%20designed%20to%20work%20in%20browser%20environment%2C%20used%20by%20PrivMX%20communication%20channels.%0A%23%23%23%23%23%20npm%0A-%20%5BWeb%20Endpoint%5D(https%3A%2F%2Fwww.npmjs.com%2Fpackage%2F%40simplito%2Fprivmx-webendpoint)%0A-%20%5BWeb%20Endpoint%20Manager%5D(https%3A%2F%2Fwww.npmjs.com%2Fpackage%2F%40simplito%2Fwebendpoint-manager)%3A%20CLI%20tool%20for%20managing%20PrivMX%20Endpoint%20Web%20assets.%0A%23%23%23%23%20Java%0A-%20%5BPrivMX%20Endpoint%20Java%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-java)%3A%20Java%20wrappers%20for%20the%20native%20C%2B%2B%20library%20used%20by%20PrivMX%20to%20handle%20end-to-end%20encryption.%0A-%20%5BPrivMX%20Java%20Tools%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-java-tools)%3A%20Tools%20which%20simplify%20using%20PrivMX%20libraries%20in%20JVMs.%0A%23%23%23%23%20Kotlin%0A-%20%5BPrivMX%20Endpoint%20Kotlin%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-kotlin)%3A%20Kotlin%20wrappers%20for%20the%20native%20C%2B%2B%20library%20used%20by%20PrivMX%20to%20handle%20end-to-end%20encryption.%0A%23%23%23%23%20Swift%0A-%20%5BEndpoint%20Swift%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-swift)%3A%20Swift%20wrapper%20for%20the%20native%20C%2B%2B%20library%20used%20by%20PrivMX%20to%20handle%20end-to-end%20encryption.%0A-%20%5BEndpoint%20Swift%20Extra%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-swift-extra)%3A%20Extension%20wrapper%20for%20PrivMX%20Endpoint%20Swift.%0A%23%23%23%23%20C%23%20%0A-%20%5BPrivMX%20Endpoint%20C%23%20Extra%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-csharp-extra)%3A%20the%20recommended%20library%20for%20using%20PrivMX%20in%20C%23.%20The%20package%20provides%20asynchronous%20methods%2C%20additional%20abstraction%20of%20event%20dispatching%2C%20reading%20and%20writing%20files%2C%20and%20more.%0A-%20%5BPrivMX%20Endpoint%20C%23%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-csharp)%3A%20the%20fundamental%20wrapper%20library%2C%20essential%20for%20the%20platform%E2%80%99s%20operational%20functionality.%20As%20the%20most%20minimalist%20library%20available%2C%20it%20provides%20the%20highest%20degree%20of%20flexibility%20in%20customizing%20PrivMX%20to%20meet%20your%20specific%20requirements.%0A%0A%23%23%20Apps%20and%20Plugins%0A%23%23%23%20Web%0A-%20%5BChatee%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-chatee)%3A%20End-to-end%20encrypted%20chat%2C%20written%20in%20Next.js.%0A-%20%5BWeb%20Endpoint%20Examples%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-webendpoint%2Ftree%2Fmain%2Fexamples)%3A%20Example%20usage%20of%20PrivMX%20Endpoint%20methods%20in%20JavaScript%2FTypeScript.%0A%23%23%23%20iOS%2FmacOS%0A-%20%5BChatee%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-chatee-swift)%3A%20End-to-end%20encrypted%20chat%2C%20written%20in%20Swift.%0A-%20%5BEndpoint%20Minimal%20Swift%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-minimal-swift)%3A%20Console%20app%20written%20in%20Swift%20demonstrating%20the%20use%20of%20PrivMX%20Endpoint%20Swift%20library%20to%20work%20with%20PrivMX%20Bridge.%0A%23%23%23%20Android%0A-%20%5BChatee%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-chatee-android)%3A%20End-to-end%20encrypted%20chat%2C%20built%20for%20Android.%0A%23%23%23%20Java%20Desktop%0A-%20%5BPrivMX%20Endpoint%20Minimal%20Java%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-minimal-java)%3A%20Console%20app%20written%20in%20Java%20demonstrating%20the%20use%20of%20PrivMX%20Endpoint%20Java%20library%20to%20work%20with%20PrivMX%20Bridge.%0A%23%23%23%20Unity%0A-%20%5BPrivMX%20Endpoint%20Unity%20Plugin%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint-unity-plugin)%3A%20Unity%20plugin%20used%20by%20PrivMX%20to%20handle%20end-to-end%20encryption.%20It%20can%20be%20used%20for%20desktop%20or%20mobile%20Unity%20applications%20and%20VR%20projects.%2C%7B%0A%20%22title%22%3A%20%22Version%202.5%22%2C%0A%20%22description%22%3A%20%22%22%2C%0A%20%22root%22%3A%20true%2C%0A%20%22pages%22%3A%20%5B%0A%20%22---Start---%22%2C%0A%20%22index%22%2C%0A%20%22features%22%2C%0A%20%22quick-start%22%2C%0A%20%22api-reference%22%2C%0A%20%22---Fundamentals---%22%2C%0A%20%22architecture%22%2C%0A%20%22managing-users%22%2C%0A%20%22encryption%22%2C%0A%20%22public-private-meta%22%2C%0A%20%22---Containers---%22%2C%0A%20%22threads%22%2C%0A%20%22stores%22%2C%0A%20%22inboxes%22%2C%0A%20%22kvdbs%22%2C%0A%20%22---Concepts---%22%2C%0A%20%22policies%22%2C%0A%20%22events%22%2C%0A%20%22pagination%22%2C%0A%20%22certificates%22%2C%0A%20%22---Client%20Libraries---%22%2C%0A%20%22%5Bcpp%5D%5BC%2B%2B%5D(%2Fdocs%2Fcpp%2Fintroduction)%22%2C%0A%20%22%5Bjs%5D%5BJavaScript%5D(%2Fdocs%2Fjs%2Fintroduction)%22%2C%0A%20%22%5Bjava%5D%5BJava%2FKotlin%5D(%2Fdocs%2Fjava%2Fintroduction)%22%2C%0A%20%22%5Bkotlin%5D%5BKotlin%5D(%2Fdocs%2Fkotlin%2Fintroduction)%22%2C%0A%20%22%5Bswift%5D%5BSwift%5D(%2Fdocs%2Fswift)%22%2C%0A%20%22%5Bcsharp%5D%5BC%23%5D(%2Fdocs%2Fcsharp%2Fintroduction)%22%2C%0A%20%22---PrivMX%20Bridge---%22%2C%0A%20%22privmx-bridge%22%2C%0A%20%22installation%22%2C%0A%20%22authorization%22%2C%0A%20%22generating-keys%22%2C%0A%20%22concepts%22%2C%0A%20%22production%22%2C%0A%20%22guides%22%2C%0A%20%22---Resources---%22%2C%0A%20%22project-map%22%2C%0A%20%22versioning%22%2C%0A%20%22performance%22%2C%0A%20%22%5BSupport%5D(mailto%3Asupport%40privmx.com)%22%2C%0A%20%22%5Bprivmx.dev%5D(https%3A%2F%2Fprivmx.dev%2F)%22%2C%0A%20%22%5BChangelog%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint%2Freleases)%22%0A%20%5D%0A%7D%0A%2C---%0Atitle%3A%20Certificates%0A---%0A%0AEach%20wrapper%20uses%20SSL%20connection%20for%20all%20the%20communication%20between%20PrivMX%20Endpoint%20and%20PrivMX%20Bridge.%0ASince%20Bridge%20is%20locally%20installed%20by%20the%20developer%2C%20it's%20necessary%20to%20provide%20certificates%20for%20this%20connection.%0A%0AYou%20can%20use%20proper%20function%20in%20each%20language%20for%20setting%20the%20certificates%3A%0A%0A%3CTabs%20groupId%3D%22lang%22%20items%3D%7B%5B%22Kotlin%22%2C%20%22Swift%22%5D%7D%3E%0A%3CTab%20%3E%0A%20%60%60%60kotlin%0A%20val%20endpointContainer%20%3D%20PrivmxEndpointContainer()%0A%20endpointContainer.setCertsPath(%22YOUR-PATH-TO-CERTS-FILE.pem%22)%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3CTab%20%3E%0A%20%60%60%60swift%0A%20var%20endpointContainer%3A%20PrivMXEndpointContainer%20%3D%20PrivMXEndpointContainer()%0A%20%0A%20guard%20let%20pathToCerts%20%3D%20FileManager.default%0A%20.urls(for%3A%20.documentDirectory%2C%20in%3A%20.userDomainMask)%0A%20.first%3F.appendingPathComponent(%22cert.pem%22).path()%0A%20else%20%7Breturn%7D%0A%0A%20try%3F%20endpointContainer.setCertsPath(to%3A%20pathToCerts)%0A%0A%20%60%60%60%0A%3C%2FTab%3E%0A%3C%2FTabs%3E%0A%0A%23%23%20Source%20of%20Certificates%0A%0AIf%20you%20use%20properly%20signed%20certificates%20issued%20by%20a%20trusted%20CA%2C%20you%20can%20provide%20them%20for%20the%20Endpoint.%20For%20example%20CA%20Certificates%20from%20Mozilla%3A%0A%0A-%20%5BMozilla's%20Included%20Certificates%5D(https%3A%2F%2Fwiki.mozilla.org%2FCA%2FIncluded_Certificates)%0A-%20%5BCURL%20-%20CA%20certificates%20extracted%20from%20Mozilla%5D(https%3A%2F%2Fcurl.se%2Fdocs%2Fcaextract.html)%0A%0A%23%23%20Custom%20Certificates%0A%0AIf%20your%20Bridge%20has%20custom%20signed%20certificates%2C%20provide%20them%20accordingly.%0A%0A%0A%3CCallout%20type%3D%7B%22info%22%7D%20title%3D%7B%22On%20the%20Web%22%7D%3E%0A%20If%20you%20use%20PrivMX%20Endpoint%20in%20web%20environment%20with%20custom%20certificates%2C%20you%20should%20add%20them%20as%20trusted%20to%20your%20system.%0A%3C%2FCallout%3E%0A%0A%23%23%20Using%20PrivMX%20Endpoint%20with%20a%20Non-Secure%20Bridge%20Installation%0A%0AFor%20development%20purposes%2C%20the%20Bridge%20can%20be%20installed%20locally%20and%20accessed%20by%20a%20non-secure%20HTTP%20connection.%0AIn%20such%20a%20case%2C%20you%20can%20omit%20adding%20certificates%20to%20PrivMX%20Endpoint%20and%20configure%20your%20app%20properly%20by%20editing%20the%20%60Info.plist%60%20file%3A%0A%0A%60%60%60%0AApp%20Transport%20Security%20Settings%20%3E%20Allow%20Arbitrary%20Loads%20%3E%20YES%0A%60%60%60%0A%2C---%0Atitle%3A%20Handling%20Events%0Adescription%3A%20Events%20allow%20your%20application%20to%20respond%20to%20changes%20in%20user%20context%20instantly.%20These%20events%20are%20automatically%20captured%20when%20relevant%20changes%20occur.%20You%20can%20subscribe%20to%20them%20by%20registering%20event%20listeners.%0A---%0A%0A%0A%0A%23%23%20The%20EventQueue%20And%20Handling%20Events%0A%0A%3A%3A%3Ainfo%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%23%23%23%20Key%20Considerations%0A%0APlease%20note%20the%20following%3A%0A%0A-%20Events%20will%20only%20trigger%20for%20active%20connections.%0A-%20Events%20are%20not%20captured%20unless%20explicitly%20listened%20for.%0A-%20A%20single%20instance%20of%20the%20%60eventQueue%60%20is%20shared%20across%20all%20connections.%0A%0A%0A%23%23%23%20Handling%20The%20Incoming%20Event%0ABelow%20there%20is%20simple%20code%20example%20of%20how%20to%20handle%20an%20event%20coming%20after%20new%20message%20has%20been%20sent%20to%20the%20Thread.%0A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FConnection.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fthread%2FThreadApi.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FBuffer.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FEventQueue.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fthread%2FEvents.hpp%3E%0A%0A%2F%2F%20...%0Acore%3A%3AEventQueue%20eventQueue%20%7Bcore%3A%3AEventQueue%3A%3AgetInstance()%7D%3B%0A%0A%2F%2F%20Start%20the%20EventQueue%20reading%20loop%0Astd%3A%3Athread%20t(%5B%26%5D()%7B%0A%20while(true)%20%7B%0A%20core%3A%3AEventHolder%20event%20%3D%20eventQueue.waitEvent()%3B%0A%20if%20(thread%3A%3AEvents%3A%3AisThreadNewMessageEvent(event))%20%7B%0A%20auto%20msgEvent%20%3D%20thread%3A%3AEvents%3A%3AextractThreadNewMessageEvent(event)%3B%0A%20auto%20message%20%3D%20msgEvent.data%3B%0A%20std%3A%3Acout%20%3C%3C%20%22Message%3A%20%22%20%3C%3C%20message.data.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%20std%3A%3Acout%20%3C%3C%20%22Author%3A%20%22%20%3C%3C%20message.info.author%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20std%3A%3Athis_thread%3A%3Asleep_for(std%3A%3Achrono%3A%3Amilliseconds(5))%3B%0A%20%7D%0A%7D)%3B%0A%0A%2F%2F%20...%0A%0A%2F%2F%20initialize%20the%20connection%20to%20the%20Bridge%20and%20the%20Threads%20API%0Aauto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIVATE_KEY%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0Aauto%20threadApi%20%7Bthread%3A%3AThreadApi%3A%3Acreate(connection)%7D%3B%0Acore%3A%3APagingQuery%20defaultListQuery%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%20100%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%0A%2F%2F%20Get%20a%20Thread%20to%20work%20with%0Aauto%20currentThread%20%7BthreadApi.listThreads(CONTEXT_ID%2C%20defaultListQuery).readItems%5B0%5D%7D%3B%0A%0A%2F%2F%20Subscribe%20for%20the%20Thread's%20events%0AthreadApi.subscribeForMessageEvents(currentThread.threadId)%3B%0A%0A%2F%2F%20Send%20a%20sample%20message%0AthreadApi.sendMessage(currentThread.threadId%2C%20core%3A%3ABuffer%3A%3Afrom(%22%22)%2C%20core%3A%3ABuffer%3A%3Afrom(%22%22)%2C%20core%3A%3ABuffer%3A%3Afrom(%22some%20message%22))%3B%0A%0At.join()%3B%0A%60%60%60%0AAs%20soon%20as%20the%20new%20message%20arrives%20to%20the%20Thread%20-%20the%20%60ThreadNewMessageEvent%60%20will%20be%20emitted%20and%20handled%20by%20the%20%60EventQueue%60.%2C---%0Atitle%3A%20Files%0Adescription%3A%20Uploading%20and%20managing%20files.%0A---%0A%0A%0A%3A%3A%3Ainfo%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%23%23%20Managing%20Files%0A%0A%23%23%23%20Uploading%20a%20File%0ATo%20place%20a%20file%20in%20the%20Store%2C%20you%20need%20to%20create%20a%20file%20handle%20using%20the%20%60createFile(...)%60%20function.%20The%20function%20accepts%20a%20%60StoreId%60%2C%20%0Apublic%20and%20private%20metadata%2C%20and%20the%20total%20size%20of%20the%20file%20that%20will%20be%20uploaded.%0A%0AThen%20you%20need%20to%20call%20%60writeToFile(...)%60%20providing%20the%20created%20file%20handle%20and%20a%20portion%20of%20data%20to%20write.%20For%20small%20files%2C%20you%20can%20write%20the%20entire%20file%20with%20one%20request.%20For%20large%20files%2C%20it's%20more%20optimal%20to%20write%20them%20piece%20by%20piece%2C%20loading%20them%20in%20portions%2C%20for%20example%20from%20the%20disk%2C%20and%20then%20calling%20%60writeToFile(...)%60%20on%20each%20piece.%0ATo%20complete%20the%20entire%20file%20upload%20process%20-%20call%20%60closeFile(...)%60%20with%20the%20file%20handle%20as%20a%20parameter.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20sampleData%20%7Bcore%3A%3ABuffer%3A%3Afrom(%22some%20sample%20data%22)%7D%3B%0Aauto%20fh%20%7BstoreApi.createFile(STORE_ID%2C%20core%3A%3ABuffer%3A%3Afrom(%22%22)%2C%20core%3A%3ABuffer%3A%3Afrom(%22%22)%2C%20sampleData.size())%7D%3B%20%0AstoreApi.writeToFile(fh%2C%20sampleData)%3B%0AstoreApi.closeFile(fh)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%23%20Listing%20Files%0A%0ATo%20retrieve%20the%20contents%20of%20the%20Store%2C%20you%20can%20call%20the%20%60listFiles(...)%60%20function%20to%20get%20a%20list%20of%20files%20from%20the%20specified%20Store.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0Aauto%20filesList%20%7BstoreApi.listFiles(STORE_ID%2C%20defaultListQuery)%7D%3B%0Afor%20(auto%20file%3A%20filesList.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22FileId%3A%20%22%20%3C%3C%20file.info.fileId%20%3C%3C%20%22%20%2F%20Size%3A%20%22%20%3C%3C%20file.size%20%3C%3C%20std%3A%3Aendl%3B%0A%7D%0A%2F%2F%20...%0A%60%60%60%0A%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60cpp%0A%2F%2F%20filesList%3A%0A%7B%0A%20readItems%3A%20%5B%3CfileObject1%3E%2C%20%3CfileObject2%3E%2C...%2C%20%3CfileObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_files_in_the_Store%3E%0A%7D%0A%60%60%60%0AA%20detailed%20description%20of%20the%20%60File%60%20object%20fields%20can%20be%20found%20in%20%5BAPI%20Reference%5D(..%2Freference%2Fendpoint%2Fstore%2Ftypes%23file).%0A%0A%0A%23%23%23%20Reading%20a%20File%0ATo%20read%20a%20file%2C%20you%20can%20do%20it%20with%20a%20single%20request%20or%20-%20which%20is%20usually%20a%20better%20solution%20for%20large%20files%20-%20by%20reading%20it%20piece%20by%20piece.%0AYou%20must%20start%20by%20opening%20the%20file%20for%20reading%20using%20the%20%60openFile(fileId)%60%20function.%20As%20a%20result%2C%20you'll%20receive%20a%20file%20handle%20that%20%0Ayou%20then%20use%20when%20calling%20%60readFromFile(...)%60%20to%20read%20portions%20of%20data%20from%20the%20file.%20At%20the%20same%20time%2C%20you%20have%20the%20ability%20to%20move%20through%20%0Athe%20file%20and%20indicate%20from%20which%20position%20you%20want%20to%20read%20it%20using%20the%20%60seekInFile(...)%60%20function.%0A%60%60%60cpp%0A%2F%2F%20...%0Aauto%20lastFile%20%7BfilesList.readItems%5B0%5D%7D%3B%0A%0A%2F%2F%20Reading%20file%0Aauto%20readHandle%20%7BstoreApi.openFile(lastFile.info.fileId)%7D%3B%0Acore%3A%3ABuffer%20read%20%7BstoreApi.readFromFile(readHandle%2C%20lastFile.size)%7D%3B%0Astd%3A%3Acout%20%3C%3C%20read.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%2F%2F%20...%0A%60%60%60%0A%0A%0A%0A%0A%23%23%20Modifying%20Files%0A%0AFile%20modification%20can%20be%20considered%20in%20two%20categories%3A%0A%0A1.%20Modifying%20file%20information.%0A2.%20Modifying%20data%20in%20the%20file.%0A%0ATo%20update%20information%20about%20a%20file%2C%20you%20need%20to%20use%20the%20%60updateFileMeta(...)%60.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0AstoreApi.updateFileMeta(%0A%20lastFile.info.fileId%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22new%20public%20meta%22)%2C%20%0A%20lastFile.privateMeta%0A)%3B%0A%2F%2F%20...%0A%60%60%60%0ATo%20update%20the%20data%20of%20the%20particular%20file%20you%20have%20to%20use%20%60updateFile(...)%60%20method.%0AThis%20method%20can%20also%20be%20used%20to%20modify%20metadata%20(just%20like%20%60updateFileMeta(...)%60)%2C%20but%20additionally%20it%20creates%20a%20file%20handle%20allowing%20for%20writing%20data%20to%20the%20file.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0Aauto%20fileNewData%20%7Bcore%3A%3ABuffer%3A%3Afrom(%22some%20new%20data%22)%7D%3B%0A%0Aauto%20updateHandle%20%7BstoreApi.updateFile(%0A%20lastFile.info.fileId%2C%0A%20lastFile.publicMeta%2C%0A%20lastFile.privateMeta%2C%0A%20fileNewData.size()%0A)%7D%3B%20%0AstoreApi.writeToFile(updateHandle%2C%20fileNewData)%3B%0AstoreApi.closeFile(updateHandle)%3B%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Deleting%20a%20File%0A%0ATo%20delete%20a%20file%2C%20you%20need%20to%20use%20the%20%60deleteFile(...)%60%20method.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0AstoreApi.deleteFile(fileId)%3B%0A%2F%2F%20...%0A%60%60%60%0A%2C---%0Atitle%3A%20KVDB%20Entries%0Adescription%3A%20Setting%20Entries%20in%20KVDB.%0A---%0A%0A%3A%3A%3Ainfo%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%23%23%20Entries%20Inside%20KVDB%0A%0AEntries%20inside%20KVDBs%20are%20set%20in%20binary%20format.%20Before%20creating%20an%20entry%2C%20you%20need%20to%20decide%20on%20the%20entry%20format.%0A%0AFor%20more%20information%20about%20the%20KVDB's%20architecture%20and%20best%20practices%20for%20creating%20entries%2C%20visit%20the%0A%5BKVDBs%20Documentation%5D(..%2Fstart%2Fkvdbs%2Foverview).%0A%0A%23%23%20Creating%20or%20Updating%20an%20Entry%0A%0ATo%20create%20or%20update%20an%20entry%20in%20the%20given%20KVDB%2C%20you%20need%20to%20use%20the%20%60setEntry(...)%60%20method%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0A%2F%2F%20creating%2Fupdating%20entry%20to%20the%20KVDB%20represented%20by%20its%20kvdbId%2C%0A%2F%2F%20When%20you%20create%20entry%20ENTRY_VERSION%20must%20be%20set%20to%200.%20When%20updating%20it%20myst%20be%20set%20to%20current%20version%20of%20given%20entry%0AkvdbApi.setEntry(%0A%20kvdbId%2C%20%0A%20%22entry%20key%22%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20private%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22serialized%20entry%20data%22)%2C%0A%20ENTRY_VERSION%20%0A)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%23%23%20Listing%20All%20Keys%20in%20a%20KVDB%20%0ATo%20get%20a%20list%20of%20entry%20keys%20inside%20a%20KVDB%2C%20use%20%60listEntriesKeys%60%20method.%0AReading%20the%20entry%20keys%20of%20the%20KVDB%20(limited%20to%20the%20100%20newest%20entries%20as%20described%20by%20the%20%60PagingQuery%60%20object)%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20entriesKeys%20%7BkvdbApi.listEntriesKeys(%0A%20kvdbId%2C%0A%20kvdb%3A%3APagingQuery%7B%0A%20.skip%3D0%2C%20%0A%20.limit%3D100%2C%20%0A%20.sortOrder%3D%22desc%22%0A%20%7D%0A)%7D%3B%0Afor%20(const%20auto%26%20keys%20%3A%20entriesKeys.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22KVDB%20entry%20key%3A%20%22%20%3C%3C%20keys%20%3C%3C%20std%3A%3Aendl%3B%0A%7D%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Listing%20All%20Entries%20in%20a%20KVDB%20%0A%0ATo%20get%20a%20list%20of%20entries%20inside%20a%20KVDB%2C%20use%20%60listEntries%60%20method.%0AReading%20the%20entry%20keys%20of%20the%20KVDB%20(limited%20to%20the%20100%20newest%20entries%20as%20described%20by%20the%20%60PagingQuery%60%20object)%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20entries%20%7BkvdbApi.listEntries(%0A%20kvdbId%2C%0A%20kvdb%3A%3APagingQuery%7B%0A%20.skip%3D0%2C%20%0A%20.limit%3D100%2C%20%0A%20.sortOrder%3D%22desc%22%0A%20%7D%0A)%7D%3B%0Afor%20(const%20auto%26%20entry%20%3A%20entries.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22KVDB%20entry%20key%3A%20%22%20%3C%3C%20entry.info.key%20%3C%3C%20std%3A%3Aendl%3B%0A%20std%3A%3Acout%20%3C%3C%20%22KVDB%20entry%20data%3A%20%22%20%3C%3C%20entry.data.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%7D%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Getting%20an%20Entry%20from%20KVDB%20%0ATo%20get%20an%20entry%20from%20a%20KVDB%2C%20use%20%60getEntry%60%20method.%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20entry%20%7BkvdbApi.getEntry(%0A%20kvdbId%2C%0A%20entryKey%0A)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Deleting%20an%20Entry%20from%20KVDB%0A%0ATo%20delete%20an%20entry%2C%20you%20need%20to%20use%20the%20%60deleteEntry(...)%60%20method.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0AkvdbApi.deleteEntry(%0A%20kvdbId%2C%0A%20entryKey%0A)%3B%0A%2F%2F%20...%0A%60%60%60%0A%2C---%0Atitle%3A%20Overview%0Adescription%3A%20Threads%20are%20a%20secure%20way%20for%20assigned%20members%20to%20exchange%20encrypted%20messages.%0A---%0A%0A%0A%0A%3A%3A%3Ainfo%0A%0ABefore%20working%20with%20Threads%2C%20follow%20our%20%5BGetting%20Started%20Guide%5D(.%2Fintroduction).%20It%20will%20show%20you%20how%20to%20set%20up%20your%20project%20to%20work%20with%20PrivMX%20Bridge.%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%0A%23%23%20Working%20with%20Threads%0A%0AWhen%20working%20with%20Threads%2C%20you%20will%20use%20the%20following%3A%0A-%20%60ThreadApi%60%20-%20provides%20methods%20used%20to%20manage%20Threads%20in%20given%20Context%0A%0A%0ALet's%20modify%20the%20program%20from%20the%20%5BFirst%20App%5D(.%2Ffirst-app)%20chapter%20to%20connect%20to%20the%20Bridge%20server%2C%20create%20a%20Thread%2C%20and%20send%20the%20first%20message%20in%20it.%0A%0A**%60CMakeLists.txt%60**%0A%60%60%60cmake%0A...%0Atarget_link_libraries(test_program%20PUBLIC%20%0A%20privmxendpoint%3A%3Aprivmxendpointcore%0A%20privmxendpoint%3A%3Aprivmxendpointthread%0A%20privmxendpoint%3A%3Acrypto%0A)%0A%60%60%60%0A%0A**%60main.cpp%60**%0A%0A%60%60%60cpp%0A%2F%2F%20setup%20some%20defaults%0Acore%3A%3APagingQuery%20defaultListQuery%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%20100%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%0A%2F%2F%20initialize%20Endpoint%20connection%20and%20Threads%20API%0Aauto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIVATE_KEY%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0Aauto%20threadApi%20%7Bthread%3A%3AThreadApi%3A%3Acreate(connection)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%23%23%20Creating%20Threads%0ACreating%20a%20basic%2C%20unnamed%20Thread%2C%20which%20can%20act%20as%20an%20encrypted%20data%20container%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%2C%0A%20%7B.userId%20%3D%20USER2_ID%2C%20.pubKey%20%3D%20USER2_PUBLIC_KEY%7D%0A%7D%3B%0A%0A%2F%2F%20create%20a%20new%20Thread%20with%20access%20for%20USER_1%20as%20manager%20and%20USER_2%20as%20regular%20user%0Aauto%20threadId%20%7BthreadApi.createThread(%0A%20CONTEXT_ID%2C%20%0A%20users%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20thread's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20thread's%20private%20meta-data%22)%0A)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0AHint%3A%20You%20can%20assign%20any%20data%20to%20private%20and%20public%20meta%20fields%20(e.g.%20the%20Thread's%20name)%2C%20as%20long%20as%20it%20is%20serialized%20and%20can%20be%20given%20as%20the%20%60core%3A%3ABuffer%60.%0A%0A%23%23%20Fetching%20Threads%0A%0AGetting%20a%20list%20of%20Threads%20available%20for%20the%20user%20in%20the%20given%20Context%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20threadsList%20%3D%20threadApi.listThreads(CONTEXT_ID%2C%20defaultListQuery)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60cpp%0A%2F%2F%20threadsList%3A%0A%7B%0A%20readItems%3A%20%5B%3CthreadObject1%3E%2C%20%3CthreadObject2%3E%2C...%2C%20%3CthreadObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_threads%3E%0A%7D%0A%60%60%60%0A%0AGetting%20a%20single%20Thread%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20thread%20%3D%20threadApi.getThread(threadId%2C%20defaultListQuery)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0AA%20detailed%20description%20of%20the%20%60Thread%60%20object%20fields%20can%20be%20found%20in%20%5BAPI%20Reference%5D(..%2Freference%2Fendpoint%2Fthread%2Ftypes%23thread).%0A%0A%23%23%20Modifying%20Threads%0A%0A%0A%23%23%23%20How%20Updates%20Work%0ATo%20update%20a%20Thread%20you%20must%20always%20provide%20a%20full%20list%20of%20parameters.%0A%0AThe%20%60updateThread(...)%60%20method%20needs%20all%20the%20parameters%20as%20in%20the%20%60createThread(...)%60%20method%20and%20a%20few%20more.%20If%20you%20want%20to%20update%0Aone%20of%20the%20parameters%20%E2%80%93%20provide%20it%20in%20a%20new%20modified%20form.%20If%2C%20on%20the%20other%20hand%2C%20you%20want%20to%20leave%0Athe%20parameter%20unchanged%20%E2%80%93%20provide%20it%20as%20it%20was%20before.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0Aauto%20currentThread%20%7BthreadApi.getThread(threadId%2C%20defaultListQuery)%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0A%2F%2F%20update%20a%20new%20Thread%20with%20access%20for%20USER_1%20as%20the%20only%20user.%0Aauto%20threadId%20%7BthreadApi.updateThread(%0A%20threadId%2C%20%0A%20users%2C%20managers%2C%20%0A%20currentThread.publicMeta%2C%20%0A%20currentThread.privateMeta%2C%0A%20currentThread.version%2C%20%2F%2F%20%3C-%20pass%20the%20version%20of%20the%20Thread%20you%20will%20perform%20the%20update%20on%0A%20false%2C%20%2F%2F%20%3C-%20force%20update%20(without%20checking%20version)%0A%20false%20%2F%2F%20%3C-%20force%20to%20regenerate%20a%20key%20for%20the%20Thread%0A)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Deleting%20a%20Thread%0A%0ATo%20delete%20a%20Thread%2C%20you%20need%20to%20use%20the%20%60deleteThread(...)%60%20method.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0AthreadApi.deleteThread(threadId)%3B%0A%2F%2F%20...%0A%60%60%60%0A%2C---%0Atitle%3A%20Overview%0Adescription%3A%20Inboxes%20are%20a%20way%20for%20users%20to%20send%20encrypted%20data%20to%20your%20app.%0A---%0A%0A%0A%0AThe%20advantage%20of%20Inboxes%20is%20that%20they%20don't%20require%20the%20user%20to%20be%20registered%20in%20order%20to%20send%20encrypted%20data.%0AThis%20opens%20up%20various%20possibilities%20in%20environments%20where%20you%20need%20to%20gather%20sensitive%20information%20from%20unregistered%20users%20(e.g.%20on%20your%20website).%0A%0ATo%20learn%20more%20about%20Inboxes%2C%20their%20structure%2C%20how%20they%20are%20encrypted%2C%20and%20what%20are%20their%20use%20cases%20-%20read%20%5BInbox%20Docs%5D(..%2Fstart%2Finboxes%2Foverview).%0A%0A%3A%3A%3Ainfo%0A%0ABefore%20working%20with%20Inboxes%2C%20follow%20our%20%5BGetting%20Started%20Guide%5D(.%2Fintroduction).%20It%20will%20show%20you%20how%20to%20set%20up%20your%20project%20to%20work%20with%20PrivMX%20Bridge.%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%23%23%20Working%20with%20Inboxes%0A%0ALet's%20start%20with%20the%20includes%20required%20to%20use%20the%20Inbox%20API%3A%0A%60%60%60cpp%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FConnection.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fthread%2FThreadApi.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fstore%2FStoreApi.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Finbox%2FInboxApi.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FBuffer.hpp%3E%0A%60%60%60%0A%0AInboxes%20can%20be%20used%20in%20two%20different%20contexts%2Fmodes%3A%0A1.%20in%20the%20management%20context%20-%20through%20a%20logged-in%20user%2C%20such%20as%20when%20we%20want%20to%20create%20or%20modify%20the%20Inbox%2C%0A2.%20in%20the%20context%20of%20sending%20the%20Entries%20to%20the%20Inbox%20-%20from%20the%20public%20access%20level.%0A%0A%23%23%20Working%20as%20a%20Logged-in%20User%0A%0ATo%20start%20using%20Inboxes%20you%20need%20to%20create%20the%20instances%20of%20the%20dependent%20modules%3A%20%60ThreadApi%60%20and%20%60StoreApi%60%3A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIVATE_KEY%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0Aauto%20threadApi%20%7Bthread%3A%3AThreadApi%3A%3Acreate(connection)%7D%3B%0Aauto%20storeApi%20%7Bstore%3A%3AStoreApi%3A%3Acreate(connection)%7D%3B%0Aauto%20inboxApi%20%7Binbox%3A%3AInboxApi%3A%3Acreate(connection%2C%20threadApi%2C%20storeApi)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%23%20Creating%20an%20Inbox%0A%0A%0AIn%20Inboxes%2C%20%60publicMeta%60%20is%20exposed%20as%20the%20%60InboxPublicView%60.%0A%0AIn%20short%3A%20this%20is%20a%20place%20where%20you%20can%20store%20any%20data%20that%20needs%20to%20be%20publicly%20accessible%20using%20%60getInboxPublicView(...)%60.%0ANote%20that%20users%20don't%20have%20to%20be%20added%20to%20the%20Inbox%20to%20have%20access%20to%20this%20method%20-%20they%20only%20need%20Inbox'%20ID.%0A%0APutting%20data%20inside%20%60publicMeta%60%20also%20gives%20your%20own%20server%20the%20ability%20to%20access%20it%20using%20%5BPrivMX%20Bridge%20API%5D(https%3A%2F%2Fbridge.privmx.dev%2F).%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%2C%0A%20%7B.userId%20%3D%20USER2_ID%2C%20.pubKey%20%3D%20USER2_PUBLIC_KEY%7D%0A%7D%3B%0A%0Astd%3A%3Astring%20privateMeta%20%3D%20R%22(%7B%22name%22%3A%20%22Album%22%7D)%22%3B%0Astd%3A%3Astring%20publicMeta%20%3D%20R%22(%0A%20%7B%0A%20%22formScheme%22%3A%20%5B%0A%20%7B%22question%22%3A%22Your%20name%22%7D%2C%0A%20%7B%22question%22%3A%22E-mail%22%7D%0A%20%5D%0A%20%7D%0A)%22%3B%0A%0A%0A%2F%2F%20create%20a%20new%20Inbox%20with%20access%20for%20USER_1%20as%20manager%20and%20USER_2%20as%20regular%20user%0Aauto%20inboxId%20%7BinboxApi.createInbox(%0A%20CONTEXT_ID%2C%20%0A%20users%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(publicMeta)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(privateMeta)%2C%0A%20std%3A%3Anullopt%0A)%7D%3B%0A%0A%2F%2F%20auto%20inboxId%20%7B%2268078618c34be32ff95cfd01%22%7D%3B%0Astd%3A%3Acout%20%3C%3C%20%22InboxId%3A%20%22%20%3C%3C%20inboxId%20%3C%3C%20std%3A%3Aendl%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Fetching%20Inboxes%0A%0AGetting%20a%20list%20of%20Inboxes%20available%20for%20the%20user%20in%20the%20given%20Context%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0Aauto%20inboxesList%20%7BinboxApi.listInboxes(CONTEXT_ID%2C%20defaultListQuery)%7D%3B%0Afor%20(auto%20inbox%3A%20inboxesList.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22InboxId%3A%20%22%20%3C%3C%20inbox.inboxId%20%3C%3C%20std%3A%3Aendl%3B%0A%7D%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Modifying%20Inboxes%0A%0A%23%23%23%20How%20Updates%20Work%0ATo%20update%20an%20Inbox%20you%20must%20always%20provide%20a%20full%20list%20of%20parameters.%0A%0AThe%20%60updateInbox(...)%60%20method%20needs%20all%20the%20parameters%20as%20in%20the%20%60createInbox(...)%60%20method%20and%20a%20few%20more.%20If%20you%20want%20to%20update%0Aone%20of%20the%20parameters%20%E2%80%93%20provide%20it%20in%20a%20new%20modified%20form.%20If%2C%20on%20the%20other%20hand%2C%20you%20want%20to%20leave%0Athe%20parameter%20unchanged%20%E2%80%93%20provide%20it%20as%20it%20was%20before.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20currentInbox%20%7BinboxApi.getInbox(inboxId%2C%20defaultListQuery)%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0A%2F%2F%20update%20an%20Inbox%20with%20access%20for%20USER_1%20as%20the%20only%20user.%0Aauto%20inboxId%20%7BinboxApi.updateInbox(%0A%20inboxId%2C%20%0A%20users%2C%20managers%2C%20%0A%20currentInbox.publicMeta%2C%20%0A%20currentInbox.privateMeta%2C%0A%20currentInbox.filesConfig%2C%0A%20currentInbox.version%2C%20%2F%2F%20%3C-%20pass%20the%20version%20of%20the%20Inbox%20you%20will%20perform%20the%20update%20on%0A%20false%2C%20%2F%2F%20%3C-%20force%20update%20(without%20checking%20version)%0A%20false%20%2F%2F%20%3C-%20force%20to%20regenerate%20a%20key%20for%20the%20Inbox%0A)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%2C---%0Atitle%3A%20Overview%0Adescription%3A%20Stores%20provide%20encrypted%20block%20storage%2C%20enabling%20simple%20file%20uploading%20and%20downloading.%0A---%0A%0A%0A%0A%3A%3A%3Ainfo%0A%0ABefore%20working%20with%20Stores%2C%20follow%20our%20%5BGetting%20Started%20Guide%5D(.%2Fintroduction).%20It%20will%20show%20you%20how%20to%20set%20up%20your%20project%20to%20work%20with%20PrivMX%20Bridge.%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%23%23%20Working%20with%20Stores%0A%0AWhen%20working%20with%20Stores%2C%20you%20will%20use%20the%20following%3A%0A-%20%60StoreApi%60%20-%20provides%20methods%20used%20to%20manage%20Stores%20in%20given%20Context%0A%0A%0ALet's%20modify%20the%20program%20from%20the%20%5BFirst%20App%5D(.%2Ffirst-app)%20chapter%20to%20connect%20to%20the%20Bridge%20server%2C%20create%20a%20Store%2C%20and%20put%20the%20first%20file%20in%20it.%0A%0A**%60CMakeLists.txt%60**%0A%60%60%60cmake%0A...%0Atarget_link_libraries(test_program%20PUBLIC%20%0A%20privmxendpoint%3A%3Aprivmxendpointcore%0A%20privmxendpoint%3A%3Aprivmxendpointstore%0A%20privmxendpoint%3A%3Acrypto%0A)%0A%60%60%60%0A%0A**%60main.cpp%60**%0A%60%60%60cpp%0A%2F%2F%20setup%20some%20defaults%0Acore%3A%3APagingQuery%20defaultListQuery%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%20100%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%0A%2F%2F%20initialize%20Endpoint%20connection%20and%20Stores%20API%0Aauto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIVATE_KEY%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0Aauto%20storeApi%20%7Bstore%3A%3AStoreApi%3A%3Acreate(connection)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%23%23%20Creating%20Stores%0ACreating%20a%20basic%2C%20unnamed%20Store%2C%20which%20can%20act%20as%20an%20encrypted%20data%20container%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%2C%0A%20%7B.userId%20%3D%20USER2_ID%2C%20.pubKey%20%3D%20USER2_PUBLIC_KEY%7D%0A%7D%3B%0A%0A%2F%2F%20create%20a%20new%20Store%20with%20access%20for%20USER_1%20as%20manager%20and%20USER_2%20as%20regular%20user%0Aauto%20storeId%20%7BstoreApi.createStore(%0A%20CONTEXT_ID%2C%20%0A%20users%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20Store's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20Store's%20private%20meta-data%22)%0A)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0AHint%3A%20You%20can%20assign%20any%20data%20to%20private%20and%20public%20meta%20fields%20(e.g.%20the%20Store's%20name)%2C%20as%20long%20as%20it%20is%20serialized%20and%20can%20be%20given%20as%20the%20%60core%3A%3ABuffer%60.%0A%0A%23%23%20Fetching%20Stores%0A%0AGetting%20a%20list%20of%20Stores%20available%20for%20the%20user%20in%20the%20given%20Context%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20storesList%20%3D%20storeApi.listStores(CONTEXT_ID%2C%20defaultListQuery)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60cpp%0A%2F%2F%20storesList%3A%0A%7B%0A%20readItems%3A%20%5B%3CstoreObject1%3E%2C%20%3CstoreObject2%3E%2C...%2C%20%3CstoreObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_stores%3E%0A%7D%0A%60%60%60%0A%0AGetting%20a%20single%20Store%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20store%20%3D%20storeApi.getStore(storeId%2C%20defaultListQuery)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0AA%20detailed%20description%20of%20the%20%60Store%60%20object%20fields%20can%20be%20found%20in%20%5BAPI%20Reference%5D(..%2Freference%2Fendpoint%2Fstore%2Ftypes%23store).%0A%0A%23%23%20Modifying%20Stores%0A%0A%0A%23%23%23%20How%20Updates%20Work%0ATo%20update%20a%20Store%2C%20you%20must%20always%20provide%20a%20full%20list%20of%20parameters.%0A%0AThe%20%60updateStore(...)%60%20method%20needs%20all%20the%20parameters%20as%20in%20the%20%60createStore(...)%60%20method%20and%20a%20few%20more.%20If%20you%20want%20to%20update%0Aone%20of%20the%20parameters%20%E2%80%93%20provide%20it%20in%20a%20new%20modified%20form.%20If%2C%20on%20the%20other%20hand%2C%20you%20want%20to%20leave%0Athe%20parameter%20unchanged%20%E2%80%93%20provide%20it%20as%20it%20was%20before.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0Aauto%20currentStore%20%7BstoreApi.getStore(storeId)%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0A%2F%2F%20update%20a%20new%20Store%20with%20access%20for%20USER_1%20as%20the%20only%20user.%0AstoreApi.updateStore(%0A%20storeId%2C%20%0A%20users%2C%20managers%2C%20%0A%20currentStore.publicMeta%2C%20%0A%20currentStore.privateMeta%2C%0A%20currentStore.version%2C%20%2F%2F%20%3C-%20pass%20the%20version%20of%20the%20Store%20you%20will%20perform%20the%20update%20on%0A%20false%2C%20%2F%2F%20%3C-%20force%20update%20(without%20checking%20version)%0A%20false%20%2F%2F%20%3C-%20force%20to%20regenerate%20a%20key%20for%20the%20Store%0A)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Deleting%20a%20Store%0A%0ATo%20delete%20a%20Store%2C%20you%20need%20to%20use%20the%20%60deleteStore(...)%60%20method.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0AstoreApi.deleteStore(storeId)%3B%0A%2F%2F%20...%0A%60%60%60%0A%2C---%0Atitle%3A%20Custom%20Fields%20and%20Queries%0Adescription%3A%20Using%20custom%20fields%20and%20querying%20them%20in%20Thread%20and%20Store%20containers.%20%0A---%0A%0ACustom%20fields%20and%20querying%20them%20is%20a%20functionality%20that%20works%20with%20Threads%20and%20Stores%20containers.%0A%0AIt%20allows%20you%20to%20define%20new%20fields%20by%20placing%20them%20in%20the%20%60publicMeta%60%20of%20a%20container%20or%20an%20object%20within%20a%20given%20container%2C%20%0Aand%20then%20querying%20the%20PrivMX%20Endpoint%20Client%20(using%20existing%20listing%20methods)%20for%20elements%20containing%20these%20previously%20defined%20fields.%0A%0A%3A%3A%3Ainfo%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%0A%23%23%20Working%20with%20Custom%20Fields%20and%20Queries%0A%0ABelow%20there%20is%20a%20simple%20code%20example%20of%20how%20to%20add%20a%20**custom%20field**%20to%20a%20batch%20of%20Threads%2C%20and%20then%20search%20for%20them%20using%20**custom%20query**.%0A%0A%0A%23%23%23%20Initial%20Setup%0A%0ALet's%20add%20some%20required%20includes%20and%20initialize%20the%20PrivMX%20Endpoint%20Client%20with%20the%20Thread%20API%3A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FConnection.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fthread%2FThreadApi.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FBuffer.hpp%3E%0A%0A%2F%2F%20...%0A%0A%2F%2F%20initialize%20Endpoint%20connection%20and%20Threads%20API%0Aauto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIVATE_KEY%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0Aauto%20threadApi%20%7Bthread%3A%3AThreadApi%3A%3Acreate(connection)%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20threadUsers%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%60%60%60%0A%0A%23%23%23%20Defining%20a%20Sample%20Custom%20Field%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Astd%3A%3Astring%20threadCustomField%20%3D%20R%22(%0A%20%7B%0A%20%22threadType%22%3A%20%22special%22%0A%20%7D%0A)%22%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%23%20Creating%20Threads%0A%0AThe%20following%20code%20will%20create%20a%20total%20of%206%20new%20Threads.%203%20of%20them%20will%20contain%20a%20Custom%20Field.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0A%2F%2F%20Creating%20some%20ordinary%20Threads%0Afor%20(int%20i%20%3D%200%3B%20i%20%3C%203%3B%20%2B%2Bi)%20%7B%0A%20threadApi.createThread(%0A%20CONTEXT_ID%2C%20%0A%20threadUsers%2C%20threadUsers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22%22)%2C%0A%20core%3A%3ABuffer%3A%3Afrom(%22Ordinary%20thread%22)%0A%20)%3B%0A%7D%0A%0A%2F%2F%20Creating%20some%20Threads%20with%20the%20custom%20field%0Afor%20(int%20i%20%3D%200%3B%20i%20%3C%203%3B%20%2B%2Bi)%20%7B%0A%20threadApi.createThread(%0A%20CONTEXT_ID%2C%20%0A%20threadUsers%2C%20threadUsers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(threadCustomField)%2C%0A%20core%3A%3ABuffer%3A%3Afrom(%22Thread%20with%20the%20custom%20field%22)%0A%20)%3B%0A%7D%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%23%20Listing%20Threads%0AThe%20next%20piece%20of%20code%20will%20demonstrate%20how%20you%20can%20filter%20the%20results%20of%20the%20%60listThreads(...)%60%20method%20using%20built-in%20it%20Custom%20Queries%20functionality%0Ato%20get%20the%20Threads%20containing%20the%20previously%20defined%20Custom%20Field.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0A%2F%2F%20Quering%20over%20Threads%0Acore%3A%3APagingQuery%20defaultListQuery%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%2010%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0Aauto%20threadsList1%20%7BthreadApi.listThreads(CONTEXT_ID%2C%20defaultListQuery)%7D%3B%0A%0Acore%3A%3APagingQuery%20customQuery%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%2010%2C%20.sortOrder%20%3D%20%22desc%22%2C%20.queryAsJson%20%3D%20threadCustomField%7D%3B%0Aauto%20threadsList2%20%7BthreadApi.listThreads(CONTEXT_ID%2C%20customQuery)%7D%3B%0A%0Astd%3A%3Acout%20%3C%3C%20%22The%20list%20of%20all%20Threads%3A%22%20%3C%3C%20std%3A%3Aendl%3B%0Afor%20(auto%20t%3A%20threadsList1.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22ThreadId%3A%20%22%20%3C%3C%20t.threadId%20%3C%3C%20%22%20%2F%20privateMeta%3A%20%22%20%3C%3C%20t.privateMeta.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%7D%0A%0Astd%3A%3Acout%20%3C%3C%20%22The%20list%20of%20Threads%20with%20the%20custom%20field%3A%22%20%3C%3C%20std%3A%3Aendl%3B%0Afor%20(auto%20t%3A%20threadsList2.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22ThreadId%3A%20%22%20%3C%3C%20t.threadId%20%3C%3C%20%22%20%2F%20privateMeta%3A%20%22%20%3C%3C%20t.privateMeta.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%7D%0A%0A%2F%2F%20...%0A%60%60%60%0A%0AThe%20results%20of%20the%20example%20above%20will%20look%20similar%20to%20those%20below%3A%0A%0A%60%60%60%0AThe%20list%20of%20all%20Threads%3A%0AThreadId%3A%206809fb0b57a381d1a23f10ec%20%2F%20privateMeta%3A%20Thread%20with%20the%20custom%20field%0AThreadId%3A%206809fb0b57a381d1a23f10eb%20%2F%20privateMeta%3A%20Thread%20with%20the%20custom%20field%0AThreadId%3A%206809fb0b57a381d1a23f10ea%20%2F%20privateMeta%3A%20Thread%20with%20the%20custom%20field%0AThreadId%3A%206809fb0b57a381d1a23f10e9%20%2F%20privateMeta%3A%20Ordinary%20thread%0AThreadId%3A%206809fb0b57a381d1a23f10e8%20%2F%20privateMeta%3A%20Ordinary%20thread%0AThreadId%3A%206809fb0b57a381d1a23f10e7%20%2F%20privateMeta%3A%20Ordinary%20thread%0A%0AThe%20list%20of%20Threads%20with%20the%20custom%20field%3A%0AThreadId%3A%206809fb0b57a381d1a23f10ec%20%2F%20privateMeta%3A%20Thread%20with%20the%20custom%20field%0AThreadId%3A%206809fb0b57a381d1a23f10eb%20%2F%20privateMeta%3A%20Thread%20with%20the%20custom%20field%0AThreadId%3A%206809fb0b57a381d1a23f10ea%20%2F%20privateMeta%3A%20Thread%20with%20the%20custom%20field%0A%60%60%60%0A%0AA%20full%20code%20example%20can%20be%20found%20on%20%5BSimplito's%20GitHub%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint%2Ftree%2Fmain%2Fexamples).%0A%2C---%0Atitle%3A%20Entries%0A---%0A%0AAll%20the%20data%20sent%20by%20someone%20to%20an%20Inbox%20is%20called%20an%20Entry.%0AIn%20Threads%20and%20Stores%2C%20a%20user%20must%20be%20assigned%20to%20the%20container%20to%20send%20data.%20In%20Inboxes%2C%20however%2C%20%0Aanyone%20who%20has%20Inbox%20ID%20can%20send%20a%20reply%20(assuming%20they%20have%20the%20Bridge%20URL%20and%20Solution%20ID).%0A%0A%3A%3A%3Ainfo%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20same%20**%5Bassumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%23%23%20Public%20Access%20to%20an%20Inbox%0A%0APrivMX%20Endpoint%20client%20provides%20different%20ways%20to%20connect%20to%20a%20Bridge%20instance.%0A%0AWhen%20using%20%22public%22%20connection%20(%60connectPublic(...)%60)%20you%20don't%20have%20to%20pass%20a%20private%20key.%20A%20random%20private%20key%20will%20be%20generated%20for%20each%20connection.%0A**The%20public%20connection%20provides%20only%20the%20methods%20related%20to%20sending%20Inbox%20entries%20and%20retrieving%20public%20metadata**%20related%20to%20the%20Inbox.%0A%0A%0A%23%23%23%20Connect%20to%20the%20Public%20Inbox%20API%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20publicConnection%20%7Bcore%3A%3AConnection%3A%3AconnectPublic(SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0Aauto%20threadPubApi%20%7Bthread%3A%3AThreadApi%3A%3Acreate(publicConnection)%7D%3B%0Aauto%20storePubApi%20%7Bstore%3A%3AStoreApi%3A%3Acreate(publicConnection)%7D%3B%0Aauto%20inboxPubApi%20%7Binbox%3A%3AInboxApi%3A%3Acreate(publicConnection%2C%20threadPubApi%2C%20storePubApi)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%23%20Reading%20Inbox%20Public%20View%0A%60getInboxPublicView(...)%60%20gets%20all%20the%20data%20stored%20inside%20the%20Inbox'%20publicMeta.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20publicView%20%7BinboxPubApi.getInboxPublicView(inboxId)%7D%3B%0Astd%3A%3Acout%20%3C%3C%20%22Public%20view%3A%20%22%20%3C%3C%20publicView.publicMeta.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%0A%23%23%20Submitting%20Entries%0A%23%23%23%20Adding%20a%20Simple%20Entry%20(without%20Files)%0A%60%60%60cpp%0A%2F%2F%20...%0A%20%0Aauto%20entryHandle%20%7BinboxPubApi.prepareEntry(inboxId%2C%20core%3A%3ABuffer%3A%3Afrom(%22sample%20data%22))%7D%3B%0AinboxPubApi.sendEntry(entryHandle)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%23%20Adding%20an%20Entry%20with%20Files%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Astd%3A%3Avector%3Cint64_t%3Efiles%7B%7D%3B%0Aauto%20sampleData%20%7Bcore%3A%3ABuffer%3A%3Afrom(%22some%20file%20sample%20data%22)%7D%3B%0Aauto%20fileHandle%20%7BinboxPubApi.createFileHandle(core%3A%3ABuffer%3A%3Afrom(%22%22)%2C%20core%3A%3ABuffer%3A%3Afrom(%22%22)%2C%20sampleData.size())%7D%3B%20%0Afiles.push_back(fileHandle)%3B%0A%0Aauto%20entryHandle2%20%7BinboxPubApi.prepareEntry(inboxId%2C%20core%3A%3ABuffer%3A%3Afrom(%22sample%20data%22)%2C%20files)%7D%3B%0AinboxPubApi.writeToFile(entryHandle2%2C%20fileHandle%2C%20sampleData)%3B%0AinboxPubApi.sendEntry(entryHandle2)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Fetching%20Entries%0A%0AFetching%20Entries%20requires%20a%20secure%20private%20connection.%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIVATE_KEY%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0Aauto%20threadApi%20%7Bthread%3A%3AThreadApi%3A%3Acreate(connection)%7D%3B%0Aauto%20storeApi%20%7Bstore%3A%3AStoreApi%3A%3Acreate(connection)%7D%3B%0Aauto%20inboxApi%20%7Binbox%3A%3AInboxApi%3A%3Acreate(connection%2C%20threadApi%2C%20storeApi)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%23%20Reading%20Simple%20Text%20Entries%0A%60%60%60cpp%0A%2F%2F%20...%0A%20%0Aauto%20entriesList%20%7BinboxApi.listEntries(inboxId%2C%20defaultListQuery)%7D%3B%0Afor%20(auto%20entry%3A%20entriesList.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22EntryId%3A%20%22%20%3C%3C%20entry.entryId%20%3C%3C%20%22%20%2F%20data%3A%20%22%20%3C%3C%20entry.data.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%7D%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%23%20Reading%20Entries%20Containing%20Files%0A%60%60%60cpp%0A%2F%2F%20...%0A%20%0Aauto%20entriesList%20%7BinboxApi.listEntries(inboxId%2C%20defaultListQuery)%7D%3B%0Afor%20(auto%20entry%3A%20entriesList.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22EntryId%3A%20%22%20%3C%3C%20entry.entryId%20%3C%3C%20%22%20%2F%20data%3A%20%22%20%3C%3C%20entry.data.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%0A%20for%20(auto%20file%3A%20entry.files)%20%7B%0A%20auto%20fh%20%7BinboxApi.openFile(file.info.fileId)%7D%3B%0A%20auto%20data%20%7BinboxApi.readFromFile(fh%2C%20file.size)%7D%3B%0A%20std%3A%3Acout%20%3C%3C%20%22File%20data%3A%20%22%20%3C%3C%20data.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%7D%0A%0A%2F%2F%20...%0A%60%60%60%0A%2C---%0Atitle%3A%20Overview%0Adescription%3A%20KVDBs%20provide%20encrypted%20key-value%20databases.%0A---%0A%0A%3A%3A%3Ainfo%0A%0ABefore%20working%20with%20KVDBs%2C%20follow%20our%20%5BGetting%20Started%20Guide%5D(.%2Fintroduction).%20It%20will%20show%20you%20how%20to%20set%20up%20your%20project%20to%20work%20with%20PrivMX%20Bridge.%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%0A%23%23%20Working%20with%20KVDBs%0A%0AWhen%20working%20with%20KVDBs%2C%20you%20will%20use%20the%20following%3A%0A-%20%60KvdbApi%60%20-%20provides%20methods%20used%20to%20manage%20KVDBs%20in%20given%20Context%0A%0A%0ALet's%20modify%20the%20project%20from%20the%20%5BFirst%20App%5D(.%2Ffirst-app)%20chapter%20to%20connect%20to%20PrivMX%20Bridge%2C%20create%20a%20KVDB%2C%20and%20set%20the%20first%20entry%20in%20it.%0A%0A**%60CMakeLists.txt%60**%0A%60%60%60cmake%0A...%0Atarget_link_libraries(test_program%20PUBLIC%20%0A%20privmxendpoint%3A%3Aprivmxendpointcore%0A%20privmxendpoint%3A%3Aprivmxendpointkvdb%0A%20privmxendpoint%3A%3Acrypto%0A)%0A%60%60%60%0A%0A**%60main.cpp%60**%0A%0A%60%60%60cpp%0A%2F%2F%20setup%20some%20defaults%0Acore%3A%3APagingQuery%20defaultListQuery%20%3D%20%7B.skip%20%3D%200%2C%20.limit%20%3D%20100%2C%20.sortOrder%20%3D%20%22desc%22%7D%3B%0A%0A%2F%2F%20initialize%20Endpoint%20connection%20and%20KVDBs%20API%0Aauto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIVATE_KEY%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0Aauto%20kvdbApi%20%7Bkvdb%3A%3AKvdbApi%3A%3Acreate(connection)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%23%23%20Creating%20KVDBs%0ACreating%20a%20basic%2C%20unnamed%20KVDB%2C%20which%20can%20act%20as%20an%20encrypted%20key-value%20database%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%2C%0A%20%7B.userId%20%3D%20USER2_ID%2C%20.pubKey%20%3D%20USER2_PUBLIC_KEY%7D%0A%7D%3B%0A%0A%2F%2F%20create%20a%20new%20KVDB%20with%20access%20for%20USER_1%20as%20manager%20and%20USER_2%20as%20regular%20user%0Aauto%20kvdbId%20%7BkvdbApi.createKvdb(%0A%20CONTEXT_ID%2C%20%0A%20users%2C%20managers%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20kvdb's%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20kvdb's%20private%20meta-data%22)%0A)%7D%3B%0A%0A%2F%2F%20...%0A%60%60%60%0AHint%3A%20You%20can%20assign%20any%20data%20to%20private%20and%20public%20meta%20fields%20(e.g.%20the%20KVDB's%20name)%2C%20as%20long%20as%20it%20is%20serialized%20and%20can%20be%20given%20as%20the%20%60core%3A%3ABuffer%60.%0A%0A%23%23%20Fetching%20KVDBs%0A%0AGetting%20a%20list%20of%20KVDBs%20available%20for%20the%20user%20in%20the%20given%20Context%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20kvdbList%20%3D%20kvdbApi.listKvdbs(CONTEXT_ID%2C%20defaultListQuery)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0AAs%20a%20result%20you%20will%20receive%20an%20object%3A%0A%60%60%60cpp%0A%2F%2F%20kvdbsList%3A%0A%7B%0A%20readItems%3A%20%5B%3CkvdbObject1%3E%2C%20%3CkvdbObject2%3E%2C...%2C%20%3CkvdbObjectN%3E%5D%2C%0A%20totalAvailable%3A%20%3Cnumber_of_all_kvdb%3E%0A%7D%0A%60%60%60%0A%0AGetting%20a%20Single%20KVDB%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20kvdb%20%3D%20kvdbApi.getKvdb(kvdbId)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0AA%20detailed%20description%20of%20the%20%60Kvdb%60%20object%20fields%20can%20be%20found%20in%20%5BAPI%20Reference%5D(..%2Freference%2Fendpoint%2Fkvdb%2Ftypes).%0A%0A%23%23%20Modifying%20KVDBs%0A%0A%0A%23%23%23%20How%20Updates%20Work%0ATo%20update%20a%20KVDB%20you%20must%20always%20provide%20a%20full%20list%20of%20parameters.%0A%0AThe%20%60updateKvdb(...)%60%20method%20needs%20all%20the%20parameters%20as%20in%20the%20%60createKvdb(...)%60%20method%20and%20a%20few%20more.%20If%20you%20want%20to%20update%0Aone%20of%20the%20parameters%20%E2%80%93%20provide%20it%20in%20a%20new%20modified%20form.%20If%2C%20on%20the%20other%20hand%2C%20you%20want%20to%20leave%0Athe%20parameter%20unchanged%20%E2%80%93%20provide%20it%20as%20it%20was%20before.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0Aauto%20currentKvdb%20%7BkvdbApi.getKvdb(kvdbId%2C%20defaultListQuery)%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20managers%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20users%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0A%2F%2F%20update%20a%20new%20KVDB%20with%20access%20for%20USER_1%20as%20the%20only%20user.%0AkvdbApi.updateKvdb(%0A%20kvdbId%2C%20%0A%20users%2C%20managers%2C%20%0A%20currentKvdb.publicMeta%2C%20%0A%20currentKvdb.privateMeta%2C%0A%20currentKvdb.version%2C%20%2F%2F%20%3C-%20pass%20the%20version%20of%20the%20KVDB%20you%20will%20perform%20the%20update%20on%0A%20false%2C%20%2F%2F%20%3C-%20force%20update%20(without%20checking%20version)%0A%20false%20%2F%2F%20%3C-%20force%20to%20regenerate%20a%20key%20for%20the%20KVDB%0A)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%23%20Deleting%20KVDBs%0A%0ATo%20delete%20a%20KVDB%2C%20you%20need%20to%20use%20the%20%60deleteKvdb(...)%60%20method.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0AkvdbApi.deleteKvdb(kvdbId)%3B%0A%2F%2F%20...%0A%60%60%60%0A%2C---%0Atitle%3A%20Getting%20Started%20%0A---%0A%0A%23%23%20Initial%20Requirements%0A%0ATo%20start%20developing%20end-to-end%20encrypted%20applications%20using%20PrivMX%20Endpoint%20you%20need%20a%20**PrivMX%20Bridge**%20instance%2C%20you%20can%20find%20quick%20start%20guide%20%5Bhere%5D(..%2Fstart%2Fquick-start).%0A%0ATo%20connect%20it%20to%20your%20environment%2C%20you%20need%3A%0A%20-%20%60Bridge%20URL%60%20-%20URL%20address%20of%20the%20instance%20of%20your%20PrivMX%20Bridge%0A%20-%20%60Solution%20ID%60%20-%20ID%20of%20the%20Solution%20provided%20by%20PrivMX%20Bridge%20during%20its%20initialization%20process%0A%20-%20%60User%20Private%20Key%60%20-%20the%20private%20key%20from%20the%20user's%20public-private%20key%20pair%0A%20-%20%60Verification%20Options%60%20-%20options%20for%20verifying%20a%20PrivMX%20Bridge%20instance%0A%0A%3A%3A%3Ainfo%0A%0AVerification%20options%20include%20the%20public%20key%20and%20ID%20of%20the%20PrivMX%20Bridge%20instance.%0AThey%20are%20optional%20for%20development%2C%20but%20required%20in%20the%20release%20version%20to%20add%20extra%20protection.%0AThese%20options%20let%20Endpoint%20verify%20the%20Bridge%20instance%20during%20connection%20setup%20and%20ensure%20no%20one%20is%20impersonating%20it%20or%20redirecting%20traffic.%0A%0A%3A%3A%3A%0A%0AYou%20also%20need%20to%20use%20your%20own%20application%20server%20to%20manage%20users%20(and%20their%20keys)%20and%20Contexts.%0A%0A%23%23%20Using%20Public%20and%20Private%20Keys%0AYou%20need%20a%20private%20key%20to%20connect%20PrivMX%20Endpoint%20to%20your%20Bridge.%20**Private%20key%20will%20never%20leave%20PrivMX%20Endpoint**.%0A-%20PrivMX%20Endpoint%20uses%20the%20user's%20private%20key%20to%20encrypt%2C%20decrypt%20and%20verify%20data%20on%20the%20client%20side%20only.%0A-%20PrivMX%20Bridge%20stores%20only%20the%20public%20part%2C%20i.e.%2C%20the%20user's%20public%20key%20and%20user's%20ID.%0A%0A%23%23%20Setting%20up%20PrivMX%20Endpoint%20Client%0A%0A%23%23%23%20Install%20and%20Configure%20Conan%0ATo%20use%20PrivMX%20Endpoint%20you%20need%20to%20add%20it%20to%20your%20project%20using%20Conan%20Repository%20Manager.%20%0A%5BHow%20to%20install%20Conan%5D(https%3A%2F%2Fdocs.conan.io%2F2%2Finstallation.html).%0A%0A%23%23%23%23%20Setup%20Conan%20with%20our%20Repository%0A%60%60%60bash%0Aconan%20profile%20detect%20--force%0Aconan%20remote%20add%20privmx%20https%3A%2F%2Flibs.simplito.com%2Fartifactory%2Fapi%2Fconan%2Fprivmx%0A%60%60%60%0A%23%23%20Next%20Steps%0A%0AWith%20everything%20ready%20to%20go%2C%20now%20it's%20time%20to%20start%20using%20all%20the%20capabilities%20of%20PrivMX%20Endpoint%20and%20PrivMX%20Bridge.%0A%0ALearn%20how%20to%20use%3A%0A%0A-%20%5B**Threads**%5D(..%2Fstart%2Fthreads%2Foverview)%20-%20for%20exchanging%20encrypted%20messages.%0A-%20%5B**Stores**%5D(..%2Fstart%2Fstores%2Foverview)%20-%20for%20saving%20and%20sharing%20encrypted%20files.%0A-%20%5B**Inboxes**%5D(..%2Fstart%2Finboxes%2Foverview)%20-%20for%20one%20way%20communication%20with%20external%20users.%0A-%20%5B**KVDBs**%5D(..%2Fstart%2Fkvdbs%2Foverview)%20-%20for%20key-value%20database.%0A%0A%2C---%0Atitle%3A%20Messages%0Adescription%3A%20Sending%20messages%20in%20Threads.%0A---%0A%0A%0A%3A%3A%3Ainfo%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%23%23%20Messages%20Inside%20Threads%0A%0AMessages%20inside%20Threads%20are%20sent%20in%20binary%20format.%20Before%20sending%20a%20message%2C%20you%20need%20to%20decide%20on%20the%20message%20format.%0A%0AFor%20more%20information%20about%20the%20Threads%20architecture%20and%20best%20practices%20for%20sending%20messages%2C%20visit%20the%0A%5BThreads%20Documentation%5D(..%2Fstart%2Fthreads%2Foverview).%0A%0A%23%23%20Sending%20Messages%0A%0ASending%20a%20simple%20message%20to%20the%20given%20Thread%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0A%2F%2F%20send%20messages%20to%20the%20Thread%20represented%20by%20its%20threadId%0AthreadApi.sendMessage(%0A%20threadId%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20public%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20private%20meta-data%22)%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22serialized%20message%20data%22)%0A)%3B%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Getting%20Messages%0A%0ATo%20get%20a%20list%20of%20messages%20inside%20a%20Thread%2C%20use%20%60getMessages%60%20method.%20Because%20data%20inside%20messages%20is%20in%20%60core%3A%3ABuffer%60%0Ayou%20have%20to%20deserialize%20it%20to%20human-readable%20string.%0A**PrivMX%20Endpoint%20library%20takes%20care%20of%20encrypting%20your%20data%20before%20sending%20it%20to%20PrivMX%20Bridge.**%0A%0AReading%20the%20messages%20of%20the%20Thread%20(limited%20to%20the%20100%20newest%20entries%20as%20described%20by%20the%20%60defaultListQuery%60%20object)%3A%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0Aauto%20messages%20%3D%20threadApi.listMessages(threadId%2C%20defaultListQuery)%3B%0Afor%20(auto%20msg%3A%20messages.readItems)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22message%3A%20%22%20%3C%3C%20msg.data.stdString()%0A%20%3C%3C%20%22%20%2F%20public%20meta%3A%20%22%20%3C%3C%20msg.publicMeta.stdString()%20%0A%20%3C%3C%20%22%20%2F%20private%20meta%3A%20%22%20%3C%3C%20msg.privateMeta.stdString()%20%0A%20%3C%3C%20std%3A%3Aendl%3B%0A%7D%0A%0A%2F%2F%20...%0A%60%60%60%0A%0A%23%23%20Deleting%20a%20Message%0A%0ATo%20delete%20a%20message%2C%20you%20need%20to%20use%20the%20%60deleteMessage(...)%60%20method.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0AthreadApi.deleteMessage(messageId)%3B%0A%2F%2F%20...%0A%60%60%60%0A%2C---%0Atitle%3A%20First%20app%0A---%0A%0AA%20step-by-step%20tutorial%20that%20will%20guide%20you%20through%20creating%20your%20first%20app%20using%20PrivMX%20Endpoint%20C%2B%2B%20client%20with%20PrivMX%20Bridge.%0A%0A%23%23%23%20PrivMX%20Bridge%0ATo%20proceed%20with%20this%20tutorial%2C%20you%20should%20already%20have%20your%20PrivMX%20Bridge%20Server%20up%20and%20running.%20If%20you%20don't%2C%20you%20can%20find%20step-by-step%20instructions%20on%20%5Bquick%20start%5D(..%2Fstart%2Fquick-start)%20page.%0A%0A%23%23%20Initial%20Assumptions%0A%0AAll%20the%20values%20below%20like%20%60BRIDGE_URL%60%2C%20%60SOLUTION_ID%60%2C%20%60CONTEXT_ID%60%0Ashould%20be%20replaced%20by%20the%20ones%20corresponding%20to%20your%20PrivMX%20Bridge%20instance.%0A%0AThe%20private%20keys%20here%20are%20for%20demonstration%20purposes%20only.%0ANormally%2C%20they%20should%20be%20kept%20separately%20by%20each%20user%20and%20stored%20in%20a%20safe%20place%2C%0Aor%20generated%20from%20a%20password%20(see%20the%20%60derivePrivateKey2()%60%20method%20in%20the%20Crypto%20API).%0A%0AThe%20initial%20assumptions%20for%20all%20the%20code%20examples%20below%20are%20as%20follows%3A%0A%60%60%60cpp%0Aauto%20BRIDGE_URL%20%7B%22http%3A%2F%2Flocalhost%3A9111%22%7D%3B%0Aauto%20SOLUTION_ID%20%7B%22YOUR_SOLUTION_ID%22%7D%3B%0Aauto%20CONTEXT_ID%20%7B%22YOUR_CONTEXT_ID%22%7D%3B%0A%0Aauto%20USER1_ID%20%7B%22user_1%22%7D%3B%0Aauto%20USER1_PUBLIC_KEY%20%7B%22PUBLIC_KEY_1%22%7D%3B%0Aauto%20USER1_PRIVATE_KEY%20%7B%22PRIVATE_KEY_1%22%7D%3B%0A%0Aauto%20USER2_ID%20%7B%22user_2%22%7D%3B%0Aauto%20USER2_PUBLIC_KEY%20%7B%22PUBLIC_KEY_2%22%7D%3B%0A%0Aauto%20USER3_ID%20%7B%22user_3%22%7D%3B%0Aauto%20USER3_PUBLIC_KEY%20%7B%22PUBLIC_KEY_3%22%7D%3B%0A%60%60%60%0A%0A%0A%23%23%23%20Create%20First%20Client%20App%0AFirst%2C%20you%20have%20to%20create%20a%20Conan%20config%20file%20in%20the%20root%20dir%20of%20your%20project%3A%0A%0A**%60conanfile.txt%60**%0A%60%60%60%0A%5Brequires%5D%0Aprivmx-endpoint%2F2.3.3%0A%0A%5Bgenerators%5D%0ACMakeDeps%0ACMakeToolchain%0A%0A%5Blayout%5D%0Acmake_layout%0A%60%60%60%0A%0A%0ANext%2C%20add%20the%20PrivMX%20Endpoint%20library%20dependency%20to%20your%20CMakeLists.txt%3A%0A%0A**%60CMakeLists.txt%60**%0A%60%60%60cmake%0Acmake_minimum_required(VERSION%203.15)%0Aproject(test_program)%0Aset(CMAKE_CXX_STANDARD%2017)%0A%0Afind_package(privmxendpoint%20REQUIRED)%0A%0Aadd_executable(%24%7BPROJECT_NAME%7D%20%24%7BCMAKE_CURRENT_SOURCE_DIR%7D%2Fmain.cpp)%0Atarget_link_libraries(test_program%20PUBLIC%20%0A%20privmxendpoint%3A%3Aprivmxendpointcore%20%0A%20privmxendpoint%3A%3Acrypto%0A)%0A%60%60%60%0A%0ANow%20that%20you%20have%20configured%20the%20foundation%20of%20the%20application%20project%2C%20you%20can%20perform%20a%20simple%20operation%20using%20the%20PriVMX%20Endpoint%20library's%20Crypto%20API.%0ALet's%20generate%20a%20pair%20of%20keys%20for%20the%20user.%0A%0A**%60main.cpp%60**%0A%60%60%60cpp%0A%23include%20%3Coptional%3E%0A%23include%20%3Ciostream%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fcrypto%2FCryptoApi.hpp%3E%0A%0Ausing%20namespace%20privmx%3A%3Aendpoint%3A%3Acrypto%3B%0Aint%20main()%20%7B%0A%20auto%20cryptoApi%20%7BCryptoApi%3A%3Acreate()%7D%3B%0A%20auto%20priv%20%7BcryptoApi.generatePrivateKey(%7B%7D)%7D%3B%0A%20auto%20pub%20%7BcryptoApi.derivePublicKey(priv)%7D%3B%0A%20std%3A%3Acout%20%3C%3C%20%22Generated%20private%20key%3A%20%22%20%3C%3C%20priv%20%3C%3C%20std%3A%3Aendl%0A%20%3C%3C%20%22Generated%20public%20key%3A%20%22%20%3C%3C%20pub%20%3C%3C%20std%3A%3Aendl%3B%0A%20return%200%3B%0A%7D%0A%60%60%60%0A%23%23%23%20Build%20Project%0A%0A%60%60%60bash%0Aconan%20install%20.%20--output-folder%3Dbuild%20--build%3Dmissing%0Acd%20build%0Acmake%20..%20-G%20%22Unix%20Makefiles%22%20-DCMAKE_TOOLCHAIN_FILE%3Dbuild%2FRelease%2Fgenerators%2Fconan_toolchain.cmake%20%5C%0A%20-DCMAKE_POLICY_DEFAULT_CMP0091%3DNEW%20-DCMAKE_BUILD_TYPE%3DRelease%0Acmake%20--build%20.%0A%60%60%60%0A%0A%23%23%23%20Run%20Project%0A%0A%60%60%60bash%0Asource%20build%2FRelease%2Fgenerators%2Fconanrun.sh%0A.%2Ftest_program%0A%60%60%60%0A%2C---%0Atitle%3A%20Context%20Users%0Adescription%3A%20Get%20information%20about%20users%20from%20a%20Context.%0A---%0A%0AThe%20method%20%60getContextUsers(...)%60%20from%20the%20Connection%20API%20lets%20you%20retrieve%20a%20list%20of%20users%20from%20a%20given%20Context.%20%0AAdditionally%2C%20it%20returns%20the%20user's%20activity%20status.%0A%0A%3A%3A%3Ainfo%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%23%23%23%20Retrieving%20Users%20from%20a%20Context%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FConnection.hpp%3E%0A%0A%2F%2F%20...%0A%0A%2F%2F%20initialize%20Endpoint%20connection%0Aauto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIVATE_KEY%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0A%0A%2F%2F%20Get%20users%20of%20the%20Context%0Aauto%20contextUsers%20%7Bconnection.getContextUsers(CONTEXT_ID)%7D%3B%0Afor%20(auto%20ctxUser%3A%20contextUsers)%20%7B%0A%20std%3A%3Acout%20%3C%3C%20%22UserId%3A%20%22%20%3C%3C%20ctxUser.user.userId%20%3C%3C%20%22%20%2F%20UserPubKey%3A%20%22%20%3C%3C%20ctxUser.user.pubKey%20%3C%3C%20std%3A%3Aendl%3B%0A%20std%3A%3Acout%20%3C%3C%20%22isActive%3A%20%22%20%3C%3C%20ctxUser.isActive%20%3C%3C%20std%3A%3Aendl%3B%20%0A%7D%0A%0A%0A%60%60%60%0A%0AThe%20results%20of%20the%20example%20above%20will%20look%20similar%20to%20those%20below%3A%0A%0A%60%60%60%0AUserId%3A%20user1%20%2F%20UserPubKey%3A%2051WPnnGwztNPWUDEbhncYDxZCZWAFS4M9Yqv94N2335nL92fEn%0AisActive%3A%201%0AUserId%3A%20user2%20%2F%20UserPubKey%3A%2083NSj4JTAXTPLrTKf7kXwT2XPxAE3ATudFb7vrWmhizKStkU48%0AisActive%3A%200%0AUserId%3A%20user3%20%2F%20UserPubKey%3A%207qaaU47RdiTFqQZtRWcyHRgSBVbxBxeS9USyhStXqN14Pc4xxt%0AisActive%3A%200%0A%60%60%60%0A%0AA%20full%20code%20example%20can%20be%20found%20on%20%5BSimplito's%20GitHub%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint%2Ftree%2Fmain%2Fexamples).%0A%2C---%0Atitle%3A%20Custom%20Events%0Adescription%3A%20Custom%20events%20allow%20emitting%20and%20receiving%20data%20of%20any%20shape%20in%20a%20secure%2C%20end-to-end%20encrypted%20way.%0A---%0A%0ACustom%20events%20allow%20you%20to%20send%20information%20to%20specific%20groups%20of%20users.%20The%20data%20will%20not%20be%20stored%20anywhere.%20%0AFor%20an%20event%20to%20reach%20the%20recipient%2C%20the%20recipient%20must%20be%20subscribed%20to%20the%20channel%20on%20which%20you%20are%20emitting%20the%20event%20at%20that%20moment.%0A%0A%3A%3A%3Ainfo%0A%0ABefore%20working%20with%20Custom%20Events%2C%20follow%20our%20%5BGetting%20Started%20Guide%5D(.%2Fintroduction).%20It%20will%20show%20you%20how%20to%20set%20up%20your%20project%20to%20work%20with%20PrivMX%20Bridge.%0A%0ASample%20code%20on%20this%20page%20is%20based%20on%20the%20**%5Binitial%20assumptions%5D(.%2Ffirst-app%23initial-assumptions)**.%0A%0A%3A%3A%3A%0A%0A%0A%0A%23%23%20Working%20with%20Custom%20Events%0A%0A%23%23%23%20Key%20Considerations%0A%0APlease%20note%20the%20following%3A%0A%0A-%20Events%20will%20only%20trigger%20for%20active%20connections.%0A-%20Events%20are%20not%20captured%20unless%20explicitly%20listened%20for.%0A-%20A%20single%20instance%20of%20the%20%60eventQueue%60%20is%20shared%20across%20all%20connections.%0A%0A%0A%23%23%23%20Emitting%20and%20Handling%20Custom%20Events%0ABelow%20there%20is%20simple%20code%20example%20of%20how%20to%20emit%20an%20Event%20with%20the%20custom%20payload%20and%20then%20how%20to%20handle%20it%20when%20it%20arrives%20to%20the%20recipients.%0A%0A%60%60%60cpp%0A%2F%2F%20...%0A%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FConnection.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fevent%2FEventApi.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FBuffer.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fcore%2FEventQueue.hpp%3E%0A%23include%20%3Cprivmx%2Fendpoint%2Fevent%2FEvents.hpp%3E%0A%0A%2F%2F%20...%0A%0Acore%3A%3AEventQueue%20eventQueue%20%7Bcore%3A%3AEventQueue%3A%3AgetInstance()%7D%3B%0A%0A%2F%2F%20Start%20the%20EventQueue%20reading%20loop%0Astd%3A%3Athread%20t(%5B%26%5D()%7B%0A%20while(true)%20%7B%0A%20core%3A%3AEventHolder%20event%20%3D%20eventQueue.waitEvent()%3B%0A%20if%20(event%3A%3AEvents%3A%3AisContextCustomEvent(event))%20%7B%0A%20auto%20customEvent%20%3D%20event%3A%3AEvents%3A%3AextractContextCustomEvent(event)%3B%0A%20std%3A%3Acout%20%3C%3C%20%22Received%20event%3A%22%20%3C%3C%20std%3A%3Aendl%3B%0A%20std%3A%3Acout%20%3C%3C%20%22contextId%3A%20%22%20%3C%3C%20customEvent.data.contextId%20%3C%3C%20std%3A%3Aendl%3B%0A%20std%3A%3Acout%20%3C%3C%20%22sender%3A%20%22%20%3C%3C%20customEvent.data.userId%20%3C%3C%20std%3A%3Aendl%3B%0A%20std%3A%3Acout%20%3C%3C%20%22payload%3A%20%22%20%3C%3C%20customEvent.data.payload.stdString()%20%3C%3C%20std%3A%3Aendl%3B%0A%20%7D%0A%20std%3A%3Athis_thread%3A%3Asleep_for(std%3A%3Achrono%3A%3Amilliseconds(5))%3B%0A%20%7D%0A%7D)%3B%0A%0A%2F%2F%20initialize%20Endpoint%20connection%20and%20the%20Event%20API%0Aauto%20connection%20%7Bcore%3A%3AConnection%3A%3Aconnect(USER1_PRIVATE_KEY%2C%20SOLUTION_ID%2C%20BRIDGE_URL)%7D%3B%0Aauto%20eventApi%20%7Bevent%3A%3AEventApi%3A%3Acreate(connection)%7D%3B%0A%0A%2F%2F%20Subscribe%20for%20the%20Thread's%20events%0AeventApi.subscribeForCustomEvents(CONTEXT_ID%2C%20%22myChannel%22)%3B%0A%0A%2F%2F%20sending%20event%20to%20myself%0Astd%3A%3Avector%3Ccore%3A%3AUserWithPubKey%3E%20recipients%20%7B%0A%20%7B.userId%20%3D%20USER1_ID%2C%20.pubKey%20%3D%20USER1_PUBLIC_KEY%7D%0A%7D%3B%0A%0A%2F%2F%20Emit%20event%0AeventApi.emitEvent(%0A%20CONTEXT_ID%2C%20%0A%20recipients%2C%20%0A%20%22myChannel%22%2C%20%0A%20core%3A%3ABuffer%3A%3Afrom(%22some%20data%22)%0A)%3B%0A%0At.join()%3B%0A%0A%60%60%60%0A%0AA%20full%20code%20example%20can%20be%20found%20on%20%5BSimplito's%20GitHub%5D(https%3A%2F%2Fgithub.com%2Fsimplito%2Fprivmx-endpoint%2Ftree%2Fmain%2Fexamples).%0A%2C%7B%0A%20%22title%22%3A%20%22C%2B%2B%22%2C%0A%20%22description%22%3A%20%22%22%2C%0A%20%22root%22%3A%20true%2C%0A%20%22pages%22%3A%20%5B%0A%20%22---C%2B%2B---%22%2C%0A%20%22introduction%22%2C%0A%20%22first-app%22%2C%0A%20%22---Threads---%22%2C%0A%20%22threads%22%2C%0A%20%22messages%22%2C%0A%20%22---Stores---%22%2C%0A%20%22stores%22%2C%0A%20%22files%22%2C%0A%20%22---Inboxes---%22%2C%0A%20%22inboxes%22%2C%0A%20%22entries%22%2C%0A%20%22---KVDBs---%22%2C%0A%20%22kvdbs%22%2C%0A%20%22kvdb-entries%22%2C%0A%20%22---Events---%22%2C%0A%20%22events%22%2C%0A%20%22custom-events%22%2C%0A%20%22---Common%20Features---%22%2C%0A%20%22custom-fields-and-queries%22%2C%0A%20%22context-users%22%0A%20%5D%0A%7D%0A%2C---%0Atitle%3A%20CryptoApi%0Afull%3A%20true%0A---%0A%0AClass%20representing%20instance%20of%20Crypto%20API%0A%0A%0A%0A%0A%0A%0A%0A%23%23%20Methods%0A%0A%20%23%23%23%20signData%0A%0A%3Cdiv%20className%3D%7B'spec-container%20mb-20'%7D%3E%0A%3Cdiv%3E%0ACreates%20a%20signature%20of%20data%20using%20given%20key.%0A%0A%0A*