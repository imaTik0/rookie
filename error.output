div%20class%3D%22center-column%22%3E%3C%2Fdiv%3E%0A%0A%60%60%60json%0A%7B%0A%20%22score%22%3A%20%7B%20%22%24gt%22%3A%2020%20%7D%0A%7D%0A%60%60%60%0A%0A%23%23%23%20Multiple%20Conditions%20on%20a%20Single%20Field%0A%0AYou%20can%20apply%20multiple%20conditions%20to%20a%20single%20field%3A%0A%0A%3Cdiv%20class%3D%22center-column%22%3E%3C%2Fdiv%3E%0A%0A%60%60%60json%0A%7B%0A%20%22score%22%3A%20%7B%20%22%24gt%22%3A%2020%2C%20%22%24lt%22%3A%2035%20%7D%0A%7D%0A%60%60%60%0A%0A%23%23%23%20Accessing%20Nested%20Objects%0A%0AYou%20can%20query%20nested%20objects%20using%20%60dot%20notation%60%2C%20which%20allows%20you%20to%20reference%0Aproperties%20inside%20embedded%20structures.%0A%0A%3Cdiv%20class%3D%22center-column%22%3E%3C%2Fdiv%3E%0A%0A%60%60%60json%0A%7B%0A%20%22additionalInfo.category%22%3A%20%22finance%22%0A%7D%0A%60%60%60%0A%0A%23%23%23%20Multiple%20Conditions%0A%0ATo%20find%20records%20where%20score%20is%20greater%20than%2020%20and%20status%20is%20%22active%22%2C%20you%20can%0Awrite%20the%20query%20in%20two%20ways.%0A%0AImplicit%0A%0A%3Cdiv%20class%3D%22center-column%22%3E%3C%2Fdiv%3E%0A%0A%60%60%60json%0A%7B%0A%20%22score%22%3A%20%7B%20%22%24gt%22%3A%2020%20%7D%2C%0A%20%22status%22%3A%20%22active%22%0A%7D%0A%60%60%60%0A%0AExplicit%20AND%20using%20%24and%0A%0A%3Cdiv%20class%3D%22center-column%22%3E%3C%2Fdiv%3E%0A%0A%60%60%60json%0A%7B%0A%20%22%24and%22%3A%20%5B%0A%20%7B%20%22score%22%3A%20%7B%20%22%24gt%22%3A%2020%20%7D%20%7D%2C%0A%20%7B%20%22status%22%3A%20%22active%22%20%7D%0A%20%5D%0A%7D%0A%60%60%60%0A%0A%23%23%23%20Using%20%60%24or%60%0A%0AFind%20records%20where%20%60status%60%20is%20%22active%22%20or%20%60role%60%20is%20%22member%22%3A%0A%0A%3Cdiv%20class%3D%22center-column%22%3E%3C%2Fdiv%3E%0A%0A%60%60%60json%0A%7B%0A%20%22%24or%22%3A%20%5B%0A%20%7B%20%22status%22%3A%20%22active%22%20%7D%2C%0A%20%7B%20%22role%22%3A%20%22member%22%20%7D%0A%20%5D%0A%7D%0A%60%60%60%0A%0A%3Cbr%3E%0A%0A%23%23%20Query%20Structure%0A%0A%23%23%23%20Query%20Values%0A%0AQuery%20values%20can%20be%20%60Number%60%2C%20%60String%60%2C%20%60Boolean%60%2C%20or%20%60Null%60.%20A%20query%20value%0Acannot%20be%20an%20object%20or%20an%20array.%0A%0A%23%23%23%20Logical%20Operators%0A%0A%7C%20Parameter%20%7C%20Type%20%7C%20Description%20%7C%0A%7C%20---------%20%7C%20-----%20%7C%20---------------------------------------------------------------%20%7C%0A%7C%20%60%24and%60%20%7C%20Array%20%7C%20An%20array%20of%20query%20objects%20that%20must%20all%20be%20satisfied.%20%7C%0A%7C%20%60%24or%60%20%7C%20Array%20%7C%20An%20array%20of%20query%20objects%20where%20at%20least%20one%20must%20be%20satisfied.%20%7C%0A%0A%23%23%23%20Query%20Properties%0A%0A%7C%20Parameter%20%7C%20Type%20%7C%20Description%20%7C%0A%7C%20-------------%20%7C%20--------------------%20%7C%20----------------------------------------------%20%7C%0A%7C%20%60%24gt%60%20%7C%20Number%20%7C%20Greater%20than%20%7C%0A%7C%20%60%24gte%60%20%7C%20Number%20%7C%20Greater%20than%20or%20equal%20to%20%7C%0A%7C%20%60%24lt%60%20%7C%20Number%20%7C%20Less%20than%20%7C%0A%7C%20%60%24lte%60%20%7C%20Number%20%7C%20Less%20than%20or%20equal%20to%20%7C%0A%7C%20%60%24exists%60%20%7C%20Boolean%20%7C%20Property%20existence%20check%20%7C%0A%7C%20%60%24eq%60%20%7C%20Query%20Value%20%7C%20Equals%20%7C%0A%7C%20%60%24ne%60%20%7C%20Query%20Value%20%7C%20Not%20equals%20%7C%0A%7C%20%60%24in%60%20%7C%20Array%20of%20Query%20Value%20%7C%20Matches%20any%20value%20in%20the%20array%20%7C%0A%7C%20%60%24startsWith%60%20%7C%20String%20%7C%20Checks%20if%20the%20value%20starts%20with%20a%20given%20string%20%7C%0A%7C%20%60%24endsWith%60%20%7C%20String%20%7C%20Checks%20if%20the%20value%20ends%20with%20a%20given%20string%20%7C%0A%7C%20%60%24contains%60%20%7C%20String%20%7C%20Checks%20if%20the%20value%20contains%20a%20given%20substring%20%7C%0A%2C%23%20Context%0A%2C%23%23%20context%2FlistUsersFromContext%0A%0AGet%20list%20of%20all%20users%20in%20the%20given%20context%0A%0A%23%23%23%20Parameters%0A%0A%60%60%60javascript%0Aconst%20response%20%3D%20await%20fe